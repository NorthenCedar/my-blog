{
  "name": "beishan-notes",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "postinstall": "node scripts/patch-http-cache-semantics.mjs",
    "build": "node scripts/patch-http-cache-semantics.mjs && node scripts/gen-gallery-webp.mjs && astro build && node scripts/finalize-build.mjs",
    "preview": "astro preview",
    "preview:note": "看效果请用 npm run preview（不要双击 dist/index.html）—— 本站资源全走 / 开头的绝对路径，file:// 下会解析到盘根目录，整站 CSS 与 DNA/logo 素材全部 404。",
    "test": "vitest run",
    "verify": "npm run build && vitest run",
    "comments:init": "npm run db:init --",
    "db:init": "node scripts/migrate-d1.mjs --local",
    "db:init:remote": "node scripts/migrate-d1.mjs --remote",
    "dev:cf": "wrangler pages dev dist"
  },
  "devDependencies": {
    "happy-dom": "21.0.4",
    "vitest": "^5.0.1",
    "wrangler": "^4.139.0"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@hugeicons/core-free-icons": "4.3.3",
    "@hugeicons/react": "1.1.10",
    "@typegpu/noise": "0.12.1",
    "@typegpu/sdf": "0.12.1",
    "@use-gesture/react": "10.3.1",
    "astro": "^7.3.5",
    "gsap": "3.15.1",
    "markdown-it": "14.3.3",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.9",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typegpu": "0.12.8",
    "unplugin-typegpu": "0.12.6",
    "vgpu": "0.3.1",
    "wgpu-matrix": "3.4.2",
    "yaml": "2.9.1"
  },
  "overrides": {
    "http-cache-semantics": "4.3.0",
    "undici@7.29.0": "7.29.1",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "vite": "8.3.3"
  }
}
