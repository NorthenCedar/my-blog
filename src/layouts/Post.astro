---
import { render, type CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Meta from '../components/Meta.astro';
import Toc from '../components/Toc.astro';
import CommentSection from '../components/CommentSection.astro';
import ScrollRail from '../components/ScrollRail.astro';
import { headingTree, type PostMeta } from '../lib/post-meta';
import { getVisiblePosts } from '../lib/posts';
import { selectRelatedPosts } from '../lib/related-posts';

interface Props {
  entry: CollectionEntry<'posts'>;
  meta: PostMeta;
  adjacent: { prev?: PostMeta; next?: PostMeta };
}
const { entry, meta, adjacent } = Astro.props;
// 标题树在渲染时才有（deferRender 的代价，也是它换来"草稿素材不产出"的原因）
const { Content, headings } = await render(entry);
const toc = headingTree(headings);
const related = selectRelatedPosts(meta, await getVisiblePosts());
let topId = 'post-top';
while (headings.some(heading => heading.slug === topId)) topId += '-top';
// 封面由只枚举公开条目的静态端点生成，避免全目录图片 glob 把草稿素材带入产物。
const shareCover = !entry.data.draft && entry.data.cover ? `/post-covers/${meta.slug}.jpg` : undefined;
---
{
  /* 文章页迁移（2026-09-26）：外壳从 chrome='band' 换成 chrome='page'（浅色顶栏 + 切片档案背景）。
     **关键：'page' 不渲染 `<slot name="band" />`** —— 所以标题与 Meta 必须从那个槽搬进正文流
     （放进外壳提供的 `.pagehead`），漏搬任何一块都会**静默消失且构建照常成功**。
     版式照冻结原型 prototype/terminal/post.html L55-67：kicker（这里的 <Meta>）→ h1 → 导语。
     另按站主拍板 B：导语用内容层的 summary —— 首页 S2 只显示标题，文章页是它唯一露脸的地方。
     详见 docs/post-migration-notes.md。 */
}
{/* ===== 2026-10-03：文章页装「阅读尺」（READING RULE）+ 工程方格底纹 + 目录改右栏 =====
    站主拍板六条（先出实验台 `dist/_plate-lab.html`，看过真渲染才定的）：
      ① 底纹母题 = 9 个候选里的 **#7 方格 + 页边刻度轨**；② 强度 8%；③ **铺满整页**
         （不在正文范围里压掉图案 ⇒ 不加 mask）；
      ④ 映射 = **even**（读头必压齿）；⑤ 移动端阅读尺**完全不渲染**；
      ⑥ 「本文目录」从正文上方挪成**右侧 sticky 栏**。
    ★ 这一轮 src/ 只动三处：本文件、src/scripts/reading-rule.ts、styles/tokens.css。
      相册的 develop.ts / 归档的 index-tape.ts 一行未动。 */}
<Base
  title={meta.title}
  description={meta.summary}
  pageType="article"
  shareImage={shareCover}
  shareImageAlt={entry.data.coverAlt}
  chrome="page"
  current="archive"
  bodyClass="post-plate"
>
  {/* ★★ 装置与底纹都挂 `plate` 槽（= `.shell` **之外**）。
     为什么不能用普通 slot：页面过渡 `html.pt-play .shell { animation: pt-shell … }`
     会给 `.shell` 加 `transform: scale(.99)` + `filter: blur()`，而**被 transform
     （或 filter）的祖先会成为 `position: fixed` 的包含块** ⇒ 固定定位的底纹与阅读尺
     会从「视口」改挂到「.shell 盒」，过渡那 900ms 里整体跳位
     （关于页底纹当时实测跳 91px，见 Base.astro 的 plate 槽注释）。
     ⚠ 归档页的 `.tape` 现在就挂在 `.shell` 里，有同一个隐患（已记进 spec §6.28 的待办）。 */}
  <Fragment slot="plate">
    <ScrollRail />
    {/* 底纹层：工程方格（细格 1u + 粗格 6u）+ 左右视口刻度轨。纯装饰，不拦指针。 */}
    <div class="plate-grid" aria-hidden="true"></div>

    {/* ===== 阅读尺 READING RULE =====
        ★ 默认 `hidden` + `aria-hidden` ⇒ **无 JS 时装置不存在**（不是藏起来）；
          正文本身由 Astro 服务端渲染完整，尺只是叠加层。
        ★ 结构：条（bar，左右各留一个 gutter）→ 纸带（tape，被 translateX 抽出）
          + 读头（readhead，钉在条左端）+ 读数（readout，浮在尺上方）。 */}
    <aside class="rule" data-rule hidden aria-hidden="true">
      <div class="bar" data-rule-bar><div class="tape" data-rule-tape></div></div>
      <span class="readhead" aria-hidden="true"></span>
      <p class="readout">
        <em data-rule-sec>序</em><i data-rule-total></i><i data-rule-pct>0%</i>
      </p>
      <span class="hint" aria-hidden="true">READING RULE · RM-01</span>
    </aside>
  </Fragment>

  <div class="post-layout">
  <article class="post-body">
  <header class="pagehead" id={topId} tabindex="-1">
    <Meta post={meta} />
    <h1 class="hero-title">{meta.title}</h1>
    <p class="standfirst">{meta.summary}</p>
  </header>

  {/* 电脑目录与页头一起进入两栏；手机继续按页头、目录、正文的自然顺序阅读。 */}
    <aside class="post-rail" aria-label="阅读导航">
      <Toc headings={toc} />
      <div class="post-tools">
        <button type="button" data-copy-link hidden>复制链接</button>
        <a href={`#${topId}`}>回到顶部</a>
        <span class="post-copy-status" data-copy-status role="status" aria-live="polite"></span>
      </div>
      {related.length > 0 && (
        <section class="post-related" aria-label="相关札记">
          <h2>相关札记</h2>
          <ul>{related.map(post => <li><a href={post.url}>{post.title}</a><time datetime={post.date}>{post.date}</time></li>)}</ul>
        </section>
      )}
    </aside>
    <div class="prose"><Content /></div>
  </article>

  <nav class="adj" aria-label="相邻文章">
    {adjacent.prev && <a href={adjacent.prev.url}>← {adjacent.prev.title}</a>}
    {adjacent.next && <a class="next" href={adjacent.next.url}>{adjacent.next.title} →</a>}
  </nav>

  <!-- 评论放在「上一篇/下一篇」之后：让导航紧贴正文，评论在页面最底部 -->
  <CommentSection slug={meta.slug} />
  </div>
</Base>

<style>
  @media (prefers-reduced-motion: no-preference) {
    :global(html:has(body.post-plate)) { scroll-behavior: smooth; }
  }
  :global(body.post-plate .prose :is(h2,h3)) { scroll-margin-top: var(--sp-6); }
  /* 页头版心收成 --measure，与正文列对齐（站主拍板 D）—— 避免 1440 下那条下缘实线横跨 1312px。
     四角定位点与页头内边距由外壳的 .pagehead 提供（内页外壳基础设施，各页复用）。 */
  .pagehead {
    max-width: var(--measure);
  }
  .post-layout {
    max-width: var(--measure);
    margin-inline: auto;
  }
  .post-tools,
  .post-related { display: none; }
  .hero-title {
    font-size: var(--fs-title);
    line-height: var(--lh-title);
    letter-spacing: var(--ls-title);
    margin: var(--sp-4) 0 var(--sp-4);
    font-weight: 800;
    max-width: 24em;
  }
  .standfirst {
    font-size: var(--fs-lede);
    color: var(--muted);
    max-width: 32em;
    margin: 0;
  }

  /* ===== 底纹：工程方格 + 页边刻度轨（母题 #7，铺满整页）=====
     挂法逐条照抄百褶 ∞ / 关于页 ref-plate：fixed + inset:0 + z-index:-1 + 不拦指针。
     颜色只用 token（--deco-plate-*，8 位 hex 承载 alpha）；密度只用 --deco-plate-u。
     ★ 粗格 = 细格 ×6、刻度轨小齿 2u / 大齿 10u —— 这是配方，别单独改一处。 */
  .plate-grid {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    background-image:
      linear-gradient(to right, var(--deco-plate-fine) 1px, transparent 1px),
      linear-gradient(to bottom, var(--deco-plate-fine) 1px, transparent 1px),
      linear-gradient(to right, var(--deco-plate-coarse) 1px, transparent 1px),
      linear-gradient(to bottom, var(--deco-plate-coarse) 1px, transparent 1px);
    background-size:
      var(--deco-plate-u) var(--deco-plate-u),
      var(--deco-plate-u) var(--deco-plate-u),
      calc(var(--deco-plate-u) * 6) calc(var(--deco-plate-u) * 6),
      calc(var(--deco-plate-u) * 6) calc(var(--deco-plate-u) * 6);
  }
  /* 页边刻度轨：左右**视口**边缘，不随内容走。伪元素用 absolute 挂在满屏的
     .plate-grid 里 ⇒ 效果与 fixed 相同（实验台里两种都试过，逐帧一致）。 */
  .plate-grid::before,
  .plate-grid::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 16px;
    background-image:
      repeating-linear-gradient(
        to bottom,
        var(--deco-plate-fine) 0 1px,
        transparent 1px calc(var(--deco-plate-u) * 2)
      ),
      repeating-linear-gradient(
        to bottom,
        var(--deco-plate-coarse) 0 1px,
        transparent 1px calc(var(--deco-plate-u) * 10)
      );
    background-size: 6px 100%, 16px 100%;
    background-repeat: repeat-y;
  }
  .plate-grid::before {
    left: 0;
  }
  .plate-grid::after {
    right: 0;
  }

  /* ★★ 必须关掉本页的百褶 ∞（`.page-inf`，Topbar 渲染，全站内页共用）。
     两套母题叠着必脏 —— 与关于页换月相时同一个理由（Topbar 注释里记过这个教训）。
     ⚠ 用 `:global(...)`：`.page-inf` 是 Topbar 的元素、带的是**别的**作用域属性；
       且那边写的是 `body.chrome-page .page-inf`（0,2,1）⇒ 权重必须对齐才压得住。
     关法用 `display:none` 而不是 `opacity:0`：后者仍占一层满屏合成层，很贵。 */
  :global(body.post-plate .page-inf) {
    display: none;
  }

  /* ★ 文末让位（本轮探针实测补的）：阅读尺是**贴视口底部**的 52px 固定条
     ⇒ 滚到文档最末尾时，页脚最后一块（SiteFooter 的 `.stats-wrap`，即「本站已运行…」）
     正好落进这一条里。默认档「停手 900ms 收回」会自己让开，
     但 reduced-motion 档尺**常驻** ⇒ 会被**永久**压住。
     实测（iframe 1440×900，RM 档，滚到 5000/5000）：
       `.foot` 786.3 ~ 899.8（高 113.5）· `.stats-wrap` 845.0 ~ 867.8 · 尺顶 848
       ⇒ `.stats-wrap` 的 845~867.8 有 19.8px 在尺下，整条几乎读不到。
     加满尺高 + 一点余量后：`.stats-wrap` 底边移到 815.8，让开尺顶 32px。
     ★ **两档都留**、不写成只在 `@media (prefers-reduced-motion: reduce)` 里：
       两档几何完全一致，就少一类「只在某个档才出现的布局」这种最难查的差异。 */
  :global(body.post-plate .foot) {
    padding-bottom: calc(var(--sp-6) + 52px);
  }

  /* ===== 阅读尺 READING RULE =====
     形态（站主拍板 R1）：视口底部横向直尺，读头钉在条左端、纸带向左走；
     滚动抽出、停手 900ms 收回；点尺面 scrub 跳转。颜色全 token，
     尺面用首页那套玻璃参数（--glass-*）—— 与「浮起」的观测仪器语汇一致。 */
  .rule {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 3; /* 正文（.shell z-index:1）之上，跟手光标环/蒙版之下 */
    height: 52px;
    border-top: 1px solid var(--glass-line);
    background: linear-gradient(0deg, var(--glass-bg) 40%, transparent);
    -webkit-backdrop-filter: blur(var(--glass-blur));
    backdrop-filter: blur(var(--glass-blur));
    transform: translateY(110%);
    transition: transform var(--dur-enter) var(--ease);
  }
  .rule.is-out {
    transform: translateY(0);
  }
  /* reduced-motion：尺常驻（脚本加 is-out）+ 去掉出入过渡（脚本加 is-instant） */
  .rule.is-instant {
    transition: none;
  }
  /* 无 JS 时整块不出现（脚本到位才摘 [hidden]）；显式写，免得上游给 .rule 加 display */
  .rule[hidden] {
    display: none;
  }
  .rule .bar {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: 0;
    bottom: 0;
    overflow: hidden;
  }
  /* 纸带：宽 3×条宽（t 从 −1 排到 +2），靠 translateX 走纸；will-change 只给 transform */
  .rule .tape {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0;
    will-change: transform;
  }
  /* ★★ 刻度全部是**脚本创建**的节点（纸带要按条宽铺 3 倍长，301 根不适合写进 HTML），
     而 Astro 的 scoped 样式编译成 `.tk[data-astro-cid-…]` —— 脚本 createElement 出来的
     元素**身上没有这个属性**，于是这些规则**一条都命不中**（探针实测：
     `getComputedStyle(tick).backgroundColor` 是 `rgba(0,0,0,0)`，等于刻度根本没画出来；
     静态的 `.readhead` 有属性、颜色正常 —— 两边一对比就定位到了）。
     ⇒ 刻度这一族必须 `:global(...)`。但都挂在 `.rule` 之下，不会漏到别的页
       （同 BootIntro 的 `:global(path)`、以及评论组件把 CSS 放进全局 comments.css 的同一原因）。 */
  .rule :global(.tk) {
    position: absolute;
    bottom: 14px;
    width: 1px;
    background: var(--hair);
  }
  .rule :global(.tk-minor) {
    height: 6px;
  }
  .rule :global(.tk-mid) {
    height: 10px;
  }
  .rule :global(.tk-major) {
    height: 16px;
    background: var(--ink-2);
  }
  .rule :global(.tk b) {
    position: absolute;
    top: -12px;
    left: 2px;
    font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace;
    font-size: 9px;
    font-weight: 400;
    color: var(--muted);
  }
  /* 节齿：h2 = 长绿齿（带 §n 标签），h3 = 短绿齿（不带标签） */
  .rule :global(.tk-sec) {
    height: 24px;
    width: 2px;
    background: var(--accent);
  }
  .rule :global(.tk-sec.is-h3) {
    height: 16px;
    width: 1px;
    background: var(--accent);
    opacity: 0.55;
  }
  .rule :global(.tk-sec i) {
    position: absolute;
    bottom: 28px;
    left: 3px;
    font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace;
    font-size: 9px;
    font-style: normal;
    letter-spacing: 0.06em;
    white-space: nowrap;
    color: var(--accent-ink);
  }
  /* 读头：钉在条左端的一根绿竖线 + 顶端小三角（指示「你读到这里」） */
  .readhead {
    position: absolute;
    left: var(--gutter);
    top: 0;
    bottom: 0;
    width: 0;
    border-left: 2px solid var(--accent-ink);
    z-index: 2;
  }
  .readhead::after {
    content: '';
    position: absolute;
    left: -5px;
    top: 0;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid var(--accent-ink);
  }
  /* 读数与型号漂在尺**上方**（尺内让给刻度）—— 各带一小块纸色底，
     压在正文上也读得清。 */
  .readout {
    position: absolute;
    left: var(--gutter);
    bottom: calc(100% + 5px);
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 1px 0.4em;
    background: var(--paper);
    border: 1px solid var(--glass-line);
    font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace;
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .readout em {
    font-style: normal;
    font-weight: 700;
    color: var(--accent-ink);
  }
  .readout i {
    font-style: normal;
    font-variant-numeric: tabular-nums;
  }
  .hint {
    position: absolute;
    right: var(--gutter);
    bottom: calc(100% + 5px);
    padding: 1px 0.4em;
    background: var(--paper);
    border: 1px solid var(--glass-line);
    font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace;
    font-size: 9px;
    letter-spacing: 0.16em;
    color: var(--muted);
  }

  /* 约1100px的内容组：正文适度加宽，侧栏固定上限；容纳不下时优先单栏阅读。 */
  @media (min-width: 1120px) {
    .post-layout {
      --measure: var(--post-measure);
      max-width: calc(var(--post-measure) + var(--post-rail-width) + var(--post-rail-gap));
    }
    .post-body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, var(--post-rail-width));
      column-gap: var(--post-rail-gap);
      align-items: start;
    }
    .post-body > .pagehead { grid-column: 1; grid-row: 1; }
    .post-body > .prose {
      grid-column: 1;
      grid-row: 2;
    }
    /* 目录栏：sticky 生效的前提是「栅格项不拉伸 + 行高由正文撑开」——
       `align-items:start` 让本项只有内容高，而它的包含块仍是整个栅格行 ⇒ 可在行内粘住。 */
    .post-rail {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: start;
      position: sticky;
      top: var(--sp-6);
      margin-top: var(--sp-8);
      max-height: calc(100dvh - var(--sp-6) * 2);
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--hair) transparent;
    }
    .post-rail :global(.toc) {
      margin: 0;
      padding: var(--sp-3) 0;
      max-width: var(--post-rail-width);
    }
    .post-tools { display: flex; flex-wrap: wrap; gap: var(--sp-2); padding-top: var(--sp-4); }
    .post-tools a,
    .post-tools button {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      padding: var(--sp-2) var(--sp-3);
      border: 1px solid var(--hair);
      border-radius: var(--sp-2);
      background: transparent;
      color: var(--muted);
      text-decoration: none;
      font: inherit;
      font-size: var(--fs-sm);
      cursor: pointer;
      transition: color var(--dur-fast), border-color var(--dur-fast), background var(--dur-fast);
    }
    .post-tools a:hover,
    .post-tools button:hover { color: var(--accent-ink); border-color: var(--accent-ink); background: var(--accent-wash); }
    .post-tools [hidden] { display: none; }
    .post-copy-status { width: 100%; color: var(--muted); font-size: var(--fs-xs); }
    .post-copy-status:empty { display: none; }
    .post-related {
      display: block;
      border-top: 1px solid var(--hair);
      margin-top: var(--sp-5);
      padding-top: var(--sp-4);
    }
    .post-related h2 { font-size: var(--fs-sm); margin: 0 0 var(--sp-3); }
    .post-related ul { list-style: none; padding: 0; margin: 0; }
    .post-related li + li { margin-top: var(--sp-4); }
    .post-related a { display: block; font-size: var(--fs-sm); line-height: var(--lh-heading); color: inherit; text-decoration: none; }
    .post-related a:hover { color: var(--accent-ink); text-decoration: underline; }
    .post-related time { display: block; margin-top: var(--sp-1); color: var(--muted); font-size: var(--fs-xs); }
    .adj,
    .post-layout :global(.comments) { max-width: calc(100% - var(--post-rail-width) - var(--post-rail-gap)); }
  }

  .adj {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
    margin-top: var(--sp-8);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--ink);
    font-size: var(--fs-sm);
  }
  .adj a {
    color: inherit;
    text-decoration: none;
  }
  .adj a:hover {
    color: var(--accent-ink);
    text-decoration: underline;
  }
  .adj .next {
    margin-left: auto;
  }

  /* ===== 移动端（≤767px）：阅读尺**完全不渲染**（站主拍板 ⑤）=====
     ★ 底纹层不在降级之列 —— 它是背景不是装置（与站内 ∞ 底纹「窄屏不隐藏」同一口径）。 */
  @media (max-width: 767px) {
    .rule {
      display: none;
    }
  }
</style>

<script>
import '../scripts/copy-code';
import '../scripts/comments';
import '../scripts/reading-rule';
import '../scripts/scroll-rail';
import { initPostRail } from '../scripts/post-rail';
import type { createTocMotion } from '../scripts/toc-motion';
import { onPage } from '../scripts/page-lifecycle';
onPage(({ document, keep, addEventListener, IntersectionObserver }) => {
  const toc = document.querySelector<HTMLElement>('.post-rail .toc');
  let motion: ReturnType<typeof createTocMotion> | undefined;
  let active: HTMLAnchorElement | undefined;
  let live = true;
  const disposeRail = initPostRail(document, (link, changed) => {
    active = link;
    motion?.moveTo(link, changed);
  });

  const dispose = () => {
    if (!live) return;
    live = false;
    disposeRail();
    motion?.dispose();
  };
  keep(dispose);
  if (!toc) return;

  const observer = new IntersectionObserver(([entry]) => {
    if (!entry.isIntersecting) return;
    observer.disconnect();
    void import('../scripts/toc-motion').then(({ createTocMotion }) => {
      if (!live) return;
      motion = createTocMotion(toc);
      if (active) motion.moveTo(active, true);
    }).catch(() => { /* 目录锚点与当前位置仍可用。 */ });
  }, { rootMargin: '120px' });
  observer.observe(toc);
  addEventListener('pagehide', event => {
    if (!event.persisted) dispose();
  });
  addEventListener('pageshow', event => {
    if (event.persisted) motion?.finish();
  });
}, '.post-rail');
</script>
