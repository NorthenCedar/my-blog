---
import '../styles/fonts.css';
import '../styles/tokens.css';
// 光标位图已于 2026-09-27 按站主要求删除（"正常选择的光标删了，要不然有时会蹦出来"）：
// 现在有 JS = 跟手白点（CursorRing），没 JS = 系统光标；不再有构建期生成的光标 CSS。
import '../styles/base.css';
import '../styles/prose.css';
import '../styles/links.css';
import '../styles/transition.css';
// 全站 hover 统一基线（2026-10-03 站主：「把本站所有鼠标悬停的效果都改成主页那样」）。
// ★ 必须排在 base/prose/links **之后**：它只给参数（时长+曲线），
//   各页原有的颜色与形态仍以先引入的规则为准 —— 同特异性下后者胜，
//   这个顺序保证「基线补参数、不改形态」真的成立。
import '../styles/hover.css';
import Brandline from '../components/Brandline.astro';
import CursorRing from '../components/CursorRing.astro';
import Band from '../components/Band.astro';
import Topbar from '../components/Topbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getSite } from '../lib/site';
import type { NavKey } from '../lib/nav';

interface Props {
  /** 单册全屏陈列直接落在 main 内，避免 shell 的栏宽与过渡变换限制视口。 */
  fullWidth?: boolean;
  /** 页面自己的标题（不含站名）。不传就是首页。 */
  title?: string;
  description?: string;
  /** 当前页在主导航里的位置（驱动 aria-current 高亮）。取值来源是 src/lib/nav.ts，不在这里另立一份。 */
  current?: NavKey;
  /** 404 这类错误页不该有 canonical —— 它不是真实内容页 */
  noCanonical?: boolean;
  /**
   * 追加到 `<body>` 的额外类名（空格分隔）。
   * ★ 2026-10-03 新增：关于页要一张**从 body 背景就开始**的深色大图，
   *   而 `body { background: var(--paper) }`（base.css）铺满全页会把图盖住
   *   —— 元素再高的 z-index 也压不过 body 自身的背景。
   *   ⇒ 该页用这个 prop挂一个类，由页面自己的样式把 body 背景改成 transparent。
   *   只给需要的页面用，**不顺手改全站**。
   */
  bodyClass?: string;
  /**
   * 外壳形态（三选一）：
   *   不传 / `'band'`  = 深色带 + 品牌行 + 页脚（旧外壳，其余 10 页在用）
   *   `'console'`      = 首页专用：刻度尺 / HUD / 扫描带 / OS 状态条
   *   `'page'`         = 内页（文章 / 相册 / 项目共用）：浅色顶栏 + 切片档案背景，
   *                      无深色带、无仪器 —— 阅读与浏览优先。见 components/Topbar.astro
   *
   * 为什么做成参数而不是直接换掉：Base.astro 被全部 14 个页面共享，直接换会同时改 14 页输出、
   * 出问题分不清是哪一步。做成参数后，不传的页面输出**逐字节不变** —— 阶段 A 用
   * 构建产物全量 SHA256 diff 证明过（0 处差异），'page' 这一档同样是逐页可分辨的。
   *
   * 注意：`'page'` **不渲染 `<slot name="band" />`** —— 用它的页面不要把内容放 band 槽，
   * 否则那部分会静默消失（首页当初就是被这个坑过一次，见台账 f919fa1）。
   *
   * ★ 另有一个与 chrome 无关的具名槽 `plate`（2026-10-03 加），见结构处注记：
   *   它是给「视口装饰层」用的，必须落在 `.shell` 之外，否则会被页面过渡的
   *   transform 改变 fixed 的包含块 ⇒ 打开页面时装饰层从下往上跳（实测 91px）。
   */
  chrome?: 'band' | 'console' | 'page';
}
const { title, description, current, noCanonical, chrome, bodyClass, fullWidth = false } = Astro.props;
// 站名/简介/联系方式来自 content/site.md —— 主题不持有任何文案
const site = await getSite();
// 关于「Topbar 静态 import 的成本」：Astro 的样式图按 import 收集（不是按 render），
// 所以它的 ~2.6 KB CSS 会进共享包、被全部 14 页下载 —— 即使当前没有页面用 'page'。
// 试过改成条件 `await import(...)`，结果**更差**：Vite 会产出异步 chunk，
// 14 页 HTML 全变、产物反而 +42 KB（实测）。所以保持静态 import，接受这 2.6 KB；
// 等 'page' 真有了消费者（P5 起），这笔 CSS 就是名正言顺的共享代码。
const docTitle = title ? `${title} — ${site.name}` : site.name;
// canonical 指向 site 配置里的正式域名。即使有人从 personal-br4.pages.dev 访问，
// 也告诉搜索引擎「正式地址是 northcedar.top」，把两个域名的权重合到一起。
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* ★★ 2026-10-08 起，这一行的用途是**退出手机 Chrome 的「自动深色」**；这条至今没变。
        根因（`_probe/_shot-mobile.mjs` 复现，见下）：手机系统开深色时，
        Chrome/Edge 会对**没声明 color-scheme 的浅色页面**套一层
        「自动深色」（Auto Dark / WebContentsForceDark）—— 它是*按元素*做的
        亮度反转：**背景色亮的小块会被反成深色**，而**文字颜色会被保留**
        （算法要维持文字对比度）。
        于是首页顶栏那三条 1px 白线（`.navbtn .bars`，画法是 `background: currentColor`）
        被反成近黑，落在深墨绿的 `.band` 上 ⇒ **整枚汉堡凭空消失**；
        而同一行、同为白色的 wordmark 是**文字**，被保留 ⇒ 站主看到的就是
        「站名在、按钮不在」（截图里正是如此）。
        实测两行像素（390 视口，y=162/168 是汉堡的上下两条横线）：
          浅色    345-362、345-362（都在）
          强制深色  （无亮像素）       ← wordmark 那行文字一个没少
        ⇒ 不是几何问题、不是网络问题。退出的办法就是**在 head 里声明 color-scheme**
        （Chrome 官方口径，另见 developer.chrome.com/blog/new-in-chrome-98 的
        "Opting out of auto-dark themes"）。
        ★ 同一次改动里汉堡也从"背景块"改成了内联 SVG 图元（双保险），
          那条契约在 tests/nav-drawer-overflow.test.ts —— 与配色模式无关，**别一起动**。

        ★★ 2026-10-17：深色模式落地（Jelly Slider 主题开关），这一行由
          `content="only light"` 改成 `content="light dark"` —— 正是上面这条注释当初
          预告的改法（站主口径：「不看以前立的只要 light，现在就做暗色模式」）。
          · 为什么不是继续 `only light`：站上现在真有 `html.dark` 的 token（tokens.css 末尾）
            ⇒ 再声明"只有浅色"就是一句**假话**，会误导下一个读到这里的人；
          · 为什么 `light dark` 也挡得住自动深色：官方口径是"页面声明自己支持深色"
            ⇒ 浏览器不再代劳反色。两种写法都能挡，取与事实相符的那个；
          · 它还顺带让**原生控件**（滚动条 / 表单 / 日期选择器）跟着模式走。
          ⚠ 已知残余（记在这里，别再当成新 bug 查一遍）：原生控件跟的是**系统**偏好，
            不是站内那个开关 —— 系统浅色 + 站内选深色时滚动条仍是浅色。
            要彻底对齐得在 CSS 里按 `html.dark` 覆写 `color-scheme`，
            而那会把"退出自动深色"重新交回样式表层（下面这条注释说的"meta 早于样式表
            生效"就没了）⇒ 先不做。
        ★ 为什么写 meta 而不是 CSS 的 `:root{color-scheme}`：meta 在 head 里
          **早于样式表**被解析，首帧就已经生效，不给自动反色留下半秒的窗口。 */}
    <meta name="color-scheme" content="light dark" />
    <!-- 百度搜索资源平台的站点归属验证（公开标识符，不是密钥）。
         用途：在 ziyuan.baidu.com 证明这个站是你的，之后才能提交 sitemap。
         别删 —— 删了以后无法重新验证站点。换域名后需要在百度重新申请一个。 -->
    <meta name="baidu-site-verification" content="codeva-5aPQf9LUnL" />
    <title>{docTitle}</title>
    {description && <meta name="description" content={description} />}
    {!noCanonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — RSS`} href="/rss.xml" />
    <link rel="preload" href="/fonts/plex-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    {/* 首帧保险（**两块并成一块**，见下）。都是 inline + 同步（classic）脚本：
        type=module 会被 defer 到绘制之后，那就晚了。
        ① 页面过渡的蒙版（2026-09-27）：上一页在点击时把 pt 写进 sessionStorage 并盖上蒙版；
           这里必须在**首次绘制之前**把蒙版补上，否则会先闪一下目标页的内容再盖上
           （站主要求"严禁首帧闪烁"）。约 110 字节。
           ★ 2026-10-02 第九轮又加了**同一手法的第二个标记 tsl-nav**（时间切片剧场 →
           相册的交接，约 120 字节）：主页绿幕满屏后跳转前写下它，目标页据此在首帧
           直接铺一屏同款深绿（`.tsl-veil`，见 gallery/index.astro）—— 晚一步挂就等于
           先闪一下纸白。两个标记各自读掉即删，互不影响；不写进 sessionStorage 的
           场合（隐私模式）只是少一道入场动画，导航本身不受影响。
        ② 深色模式的 `dark` 类（2026-10-17）：规则与 src/scripts/theme.ts 的 getTheme()
           逐字对应（localStorage.theme > prefers-color-scheme）。不在这里挂上，
           选了深色的访客每次进站都会先闪一下纸白。
        ★★ 为什么**并进同一块**而不是各写一个 <script>：文章页的脚本条数预算
           （tests/build-output.test.ts「文章页脚本数量与体积都在预算内」，上限 5 条）
           —— 各写一块就是 6 条，当场红。两块都是"首帧前的同步小片段"、同一个用途，
           合成一块天经地义；**标签数少了，内联字节一个没多**（代码原样搬过来）。
           ⚠ 别为了看清楚再拆成两块 —— 那会撞那条预算，而且不是"预算太紧"，
             是这个页面上的脚本本来就该合并（5 条里已经有 4 条 module）。
        ⚠ 两块各自带 try/catch（隐私模式下 localStorage 会抛）：一块抛了不许拖累另一块。 */}
    <script is:inline>
      try {
        var __th = localStorage.getItem('theme');
        if (__th === 'dark' || (!__th && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {}

      try {
        if (sessionStorage.getItem('pt')) {
          sessionStorage.removeItem('pt');
          document.documentElement.classList.add('pt-on', 'pt-play');
        }
        if (sessionStorage.getItem('tsl-nav')) {
          sessionStorage.removeItem('tsl-nav');
          document.documentElement.classList.add('tsl-in');
        }
      } catch (e) {}
    </script>
  </head>
  <body
    class={[
      chrome === 'console' ? 'chrome-console' : chrome === 'page' ? 'chrome-page' : undefined,
      bodyClass,
    ]
      .filter(Boolean)
      .join(' ') || undefined}
  >
    <a class="skip" href="#main">跳到正文</a>
    {/* chrome='console'（首页）自带刻度尺 / HUD / 扫描带 / OS 状态条；
        chrome='page'（内页）自带浅色顶栏 + 切片档案背景 —— 两者都不渲染旧的深色 Band。
        不传 chrome 的 10 页走原路径，产物逐字节不变。 */}
    {chrome === 'page' && <Topbar wordmark={site.wordmark} current={current} />}
    {/* ★ `plate` 槽：**视口装饰层**，必须挂在 `.shell` **之外**（2026-10-03 加）。
        为什么不能用普通 slot（`slot` 会落进 `.shell` 内部）：
          页面过渡 `html.pt-play .shell { animation: pt-shell … }` 会给 `.shell`
          加 transform **和 `filter: blur()`**，而**这两样都会建立 `position: fixed`
          的包含块** ⇒ 装饰层的 `top:50%` 从「视口 50%」变成「.shell 盒 50%」。
          实测跳位幅度 **91px**（about 页：常态 plateY=266 → 过渡中 357 → 摘类后 266）。
          用户看到的就是「打开页面时背景从下面跳回上面」。
          ⚠ 判「谁建了包含块」时**必须查 filter / backdrop-filter / contain / will-change**，
            只查 transform 会漏 —— 归档页 `.tape` 就是这么被漏判过一次（实测偏 596px）。
        ⇒ 这个槽与 Topbar 的 `.page-inf`（百褶 ∞）**同一位置层级** ——
          那个装饰层一直没这个问题，正是因为它在 `.shell` 外面。
        ⚠ 用它的人必须自己保证 z-index 退到内容之下（百褶 ∞ 是 z-index:-1）。
          ★ 但这条**只对纯装饰层成立**：要压在正文**之上**的叠加层也能用这个槽，
            只要它的 z-index 高于 `body.chrome-page main`（Topbar.astro:81-85 给的
            `z-index:1` 层叠上下文）—— 归档页 `.tape`（z-index:2）就是这种。 */}
    <slot name="plate" />
    {chrome !== 'console' && chrome !== 'page' && (
      <Band>
        <Brandline current={current} name={site.name} wordmark={site.wordmark} />
        <slot name="band" />
      </Band>
    )}
    <main id="main">
      {fullWidth ? <slot /> : <div class="shell"><slot /></div>}
    </main>
    {chrome !== 'console' && <SiteFooter name={site.name} email={site.email} github={site.github} since={site.since ?? '2026-09-25'} />}
    {/* 页面过渡的蒙版（2026-09-30 v3：**原型 v10.6 的墨色浸染**，总长 900ms）。
        上一版 v2（2200ms 四段：无菌纸柔雾 / 坐标锁定 / 无菌舱门 / 内容落地）已整体作废 ——
        站主要「视觉包括风格全换成今天的最终版，页与页的过渡动画也换」。
        v3 只剩三个元素：墨色层（darken 斜切扫过）+ 描边关键词 + 一道读数线；
        内容自己模糊微缩后退，不是被盖住。时间线全在 src/styles/transition.css 里。
        标记由 JS 加（见 <head> 与 src/scripts/transition），没 JS 时 `.pt` 是 display:none —— 完全不存在，导航照旧。 */}
    <div class="pt" data-transition aria-hidden="true">
      <div class="pt-ink"></div>
      <div class="pt-word">{site.name}<em>RHINE LAB</em>NOTES</div>
      <div class="pt-scan"></div>
    </div>
    {/* 跟手光标环 + 点击涟漪：纯装饰，z-index 55（在内容与灯箱之上、开场覆盖层 60 之下） */}
    <CursorRing />
    <script>
      // 页面过渡的点击拦截（每一页都加载 ⇒ Astro 会抽成同源共享 chunk）。
      import '../scripts/transition';
    </script>
  </body>
</html>
