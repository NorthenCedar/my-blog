---
/** 留言页的机械环底纹。
 * 通过 Base 的 plate 槽挂在 .shell 外，避免页面过渡改变 fixed 的包含块。
 * 静态金属渲染来自 RhinE，许可和来源见 assets/tags/plates/README.md。
 */
import { Image } from 'astro:assets';
import plate from '../assets/tags/plates/mechanical-ring.webp';
import nightPlate from '../assets/tags/plates/mechanical-ring-night.webp';
---

<div class="mechanical-ring" aria-hidden="true">
  {/* 两种主题各用原版渲染；亮色沿用原库的色相换色方式，图片结构与材质不重绘，夜间保留原图反光。 */}
  <Image
    class="mechanical-ring-img ring-day"
    src={plate}
    alt=""
    widths={[700, 1400]}
    sizes="(max-width: 767px) 96vw, min(94vw, 1400px)"
    loading="eager"
    decoding="async"
  />
  <Image
    class="mechanical-ring-img ring-night"
    src={nightPlate}
    alt=""
    width={1400}
    height={900}
    widths={[700, 1400]}
    sizes="(max-width: 767px) 96vw, min(94vw, 1400px)"
    quality={95}
    loading="eager"
    decoding="async"
  />
</div>

<style>
  .mechanical-ring {
    position: fixed;
    left: 50%;
    top: 50%;
    width: var(--plate-w, min(94vw, 1400px, 150vh));
    aspect-ratio: 1400 / 900;
    /* ★★ 2026-11-13 站主报障「留言页的底纹为什么跑上面去了」：交叉淡入改造后
       day / night 两张 img 都在**文档流**里，各占容器宽 × 9/14 的高度，
       把 fixed 容器从 450 高撑到 900 —— day 图被顶到视口上缘外。
       修复：两图同格叠放（grid-area 1/1），容器高度重新由 aspect-ratio 决定。 */
    display: grid;
    grid-template: 1fr / 1fr;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: -1;
  }
  .mechanical-ring :global(img) {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
  }
  /* ★★ 2026-11-13：两张图原来靠 `display: none/block` 在 `html.dark` 下整块换 ——
     拖动软条时那是松手才发生的一次跳变（整屏大图从绿环瞬变铜环）。
     现在两层**同时在场、按 --theme-w 交叉**：亮档只见 day、暗档只见 night，
     中间是两张同构图的叠加 —— 因为两张完全重合并共用同一浓度，叠加结果就是线性交叉，
     不会有第三张"叠影"。 */
  .mechanical-ring :global(img.ring-day) {
    filter: var(--ring-day-filter);
    opacity: calc(var(--plate-op, var(--ring-plate-light-opacity)) * (1 - var(--theme-w)));
  }
  .mechanical-ring :global(img.ring-night) {
    opacity: calc(var(--plate-op, var(--ring-plate-dark-opacity)) * var(--theme-w));
  }
  @media (max-width: 767px) {
    .mechanical-ring {
      width: var(--plate-w, min(96vw, 700px, 150vh));
    }
  }
</style>
