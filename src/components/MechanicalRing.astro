---
/** 留言页的机械环底纹。
 * 通过 Base 的 plate 槽挂在 .shell 外，避免页面过渡改变 fixed 的包含块。
 * 静态金属渲染与光槽数据来自 RhinE，许可和来源见 assets/tags/plates/README.md。
 */
import { Image } from 'astro:assets';
import plate from '../assets/tags/plates/mechanical-ring.webp';
import nightPlate from '../assets/tags/plates/mechanical-ring-night.webp';
import ring from '../assets/tags/plates/ring.json';
import { projectRingLight } from '../lib/mechanical-ring';

const light = projectRingLight(ring.fiber);
const lap = light.length.toFixed(3);
---

<div class="mechanical-ring" data-ring-frame aria-hidden="true">
  <div class="ring-motion" data-ring-motion>
  {/* 两种主题各用原版渲染；亮色沿用原库的色相换色方式，图片结构与材质不重绘，夜间保留原图反光。 */}
  <Image
    class="mechanical-ring-img ring-day"
    src={plate}
    alt=""
    widths={[700, 1400]}
    sizes="(max-width: 767px) 96vw, min(94vw, 1400px)"
    loading="eager"
    decoding="async"
  />
  <Image
    class="mechanical-ring-img ring-night"
    src={nightPlate}
    alt=""
    width={1400}
    height={900}
    widths={[700, 1400]}
    sizes="(max-width: 767px) 96vw, min(94vw, 1400px)"
    quality={95}
    loading="eager"
    decoding="async"
  />
  <svg
    class="ring-light"
    viewBox={`0 0 ${ring.resolution.join(' ')}`}
    fill="none"
    focusable="false"
    style={`--ring-lap: ${lap};`}
  >
    <metadata>RhinE / Audio Archive authors · MIT · /licenses/rhine-mechanical-ring.txt</metadata>
    {light.segments.map(({ d, offset }) => (
      <g style={`--ring-offset: ${offset.toFixed(3)};`}>
        <path class="ring-inlay" d={d} />
        <path class="ring-pulse ring-pulse-halo" d={d} />
        <path class="ring-pulse ring-pulse-core" d={d} />
      </g>
    ))}
  </svg>
  </div>
</div>
<script>
  import '../scripts/ring-motion';
</script>

<style>
  .mechanical-ring {
    position: fixed;
    left: 50%;
    top: 50%;
    width: var(--plate-w, min(94vw, 1400px, 150vh));
    aspect-ratio: 1400 / 900;
    transform: translate(-50%, -50%);
    perspective: var(--ring-perspective);
    pointer-events: none;
    z-index: -1;
  }
  .ring-motion { width: 100%; height: 100%; transform-origin: center; }
  :global(body[data-ring-dragging]) { user-select: none; }
  .mechanical-ring :global(img) {
    opacity: var(--plate-op, var(--ring-plate-opacity));
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
  }
  .mechanical-ring :global(img.ring-night) {
    display: none;
  }
  .mechanical-ring :global(img.ring-day) {
    filter: var(--ring-day-filter);
  }
  :global(html.dark) .mechanical-ring :global(img.ring-day) {
    display: none;
  }
  :global(html.dark) .mechanical-ring :global(img.ring-night) {
    display: block;
  }
  .ring-light {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    opacity: var(--ring-light-opacity);
  }
  .ring-inlay { stroke: var(--ring-inlay-color); stroke-width: var(--ring-inlay-width); stroke-linecap: round; }
  .ring-pulse {
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: ring-flow var(--dur-ring-flow) linear infinite;
  }
  .ring-pulse-halo {
    stroke: var(--ring-light-halo);
    stroke-width: var(--ring-light-halo-width);
    stroke-dasharray: var(--ring-light-halo-length) calc(var(--ring-lap) - var(--ring-light-halo-length));
  }
  .ring-pulse-core {
    stroke: var(--ring-light-core);
    stroke-width: var(--ring-light-core-width);
    stroke-dasharray: var(--ring-light-core-length) calc(var(--ring-lap) - var(--ring-light-core-length));
  }
  @keyframes ring-flow {
    from { stroke-dashoffset: var(--ring-offset); }
    to { stroke-dashoffset: calc(var(--ring-offset) - var(--ring-lap)); }
  }
  @media (max-width: 767px) {
    .mechanical-ring {
      width: var(--plate-w, min(96vw, 700px, 150vh));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ring-pulse { display: none; animation: none; }
  }
</style>
