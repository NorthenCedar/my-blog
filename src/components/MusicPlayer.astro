---
import { MUSIC_PLAYLIST } from '../lib/music';
import GlassFilters from './GlassFilters.astro';
import '../styles/music-panel-glass.css';
import musicOrder from '../../content/music-order.json';
if (musicOrder.playlist !== MUSIC_PLAYLIST) throw new Error('音乐顺序配置与歌单编号不一致');
---
<GlassFilters />
<button class="music-access" data-music-access transition:persist="music-access" type="button" hidden>音乐播放器</button>
<aside transition:persist="music-player" class="music" data-music data-music-order={musicOrder.ids.join(',')} hidden aria-label="音乐播放器">
  <audio data-music-audio preload="none" playsinline></audio>
  <div class="music-bar liquid-glass liquid-glass--player">
    <button class="music-play liquid-glass liquid-glass--round" type="button" data-music-play aria-label="播放音乐" title="播放或暂停">
      <svg class="mp-glyph-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5.5 19 12 9 18.5Z" fill="currentColor" stroke="currentColor" stroke-linejoin="round" /></svg>
      <svg class="mp-glyph-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M16 6v12" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg>
    </button>
    <button class="music-expand" type="button" aria-label="打开音乐播放器" data-music-expand aria-expanded="false" aria-controls="music-panel">
      <span class="music-bar-copy"><span data-music-title>听听我的歌单</span><small data-music-caption>博客 南屿北杉</small></span>
      <span class="music-signal" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
    </button>
  </div>
  <div class="music-morph music-glass" data-music-morph hidden aria-hidden="true"></div>
  <section id="music-panel" class="music-panel music-glass" data-scrollbars hidden aria-label="歌单与播放控制">
    <div class="music-panel-content" data-music-content>
    <div class="music-heading">
    <button class="music-play liquid-glass liquid-glass--round" type="button" data-music-play aria-label="播放音乐" title="播放或暂停">
      <svg class="mp-glyph-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5.5 19 12 9 18.5Z" fill="currentColor" stroke="currentColor" stroke-linejoin="round" /></svg>
      <svg class="mp-glyph-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M16 6v12" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg>
    </button>
      <div class="music-heading-copy"><strong data-music-title>听听我的歌单</strong><small data-music-caption>博客 南屿北杉</small></div>
      <button class="music-close" type="button" data-music-close aria-label="收起播放器"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17"/></svg></button>
    </div>
    <p class="music-status" data-music-status role="status">点击播放，或从歌单选择一首。</p>
    <label class="music-position"><span>播放进度</span><span data-music-time>0:00 / 0:00</span><input data-music-seek aria-label="播放进度" type="range" min="0" max="1000" value="0" disabled /></label>
    <div class="music-controls">
      <div class="music-skip">
        <button type="button" data-music-shuffle aria-label="随机播放" aria-pressed="true" title="开启或关闭随机播放"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h3c5 0 7 12 12 12h3m-3-3 3 3-3 3M3 18h3c1.5 0 2.7-1.2 4-3m4-6c1.3-1.8 2.5-3 4-3h3m-3-3 3 3-3 3"/></svg></button>
        <button type="button" data-music-prev aria-label="上一首" title="上一首"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5v14M18 6l-9 6 9 6Z"/></svg></button>
        <button type="button" data-music-next aria-label="下一首" title="下一首"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 5v14M6 6l9 6-9 6Z"/></svg></button>
      </div>
      <label class="music-volume"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4ZM15 8a6 6 0 0 1 0 8M18 5a10 10 0 0 1 0 14"/></svg><input data-music-volume aria-label="音量" type="range" min="0" max="1" step="0.05" value="0.35" /></label>
    </div>
    <div class="music-search-wrap"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6"/><path d="m15 15 5 5"/></svg><input class="music-search" data-music-search aria-label="搜索歌单" type="search" placeholder="搜索歌名或歌手" /></div>
    <ol class="music-list" data-music-list data-scrollbars aria-label="歌曲列表"></ol>
    <div class="music-footer"><button type="button" data-music-reload><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5M5 8a8 8 0 0 1 13-3l2 2M4 17l2 2a8 8 0 0 0 13-3"/></svg>重新载入</button><a href={'https://music.163.com/playlist?id=' + MUSIC_PLAYLIST} target="_blank" rel="noopener noreferrer">去网易云听<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a></div>
    </div>
  </section>
</aside>
<style>
  .music{--music-safe-top:env(safe-area-inset-top,0px);--music-safe-right:env(safe-area-inset-right,0px);--music-safe-bottom:env(safe-area-inset-bottom,0px);--music-safe-left:env(safe-area-inset-left,0px);position:fixed;left:var(--music-dock-x,calc(100vw - 236px));top:var(--music-dock-y,calc(100dvh - 64px));z-index:35;width:min(224px,calc(100vw - 24px));pointer-events:none;font-size:var(--fs-xs);color:var(--music-page-ink,var(--ink))}
  .music[hidden],.music-panel[hidden],.music-morph[hidden],.mp-glyph-pause{display:none}
  .music-morph{position:absolute;z-index:2;pointer-events:none;border-radius:var(--morph-rx,28px) / var(--morph-ry,28px);will-change:transform;transform-origin:0 0}
  .music .mp-filter{position:absolute;width:0;height:0;pointer-events:none}
  .music button,.music input{font:inherit}
  .music button{pointer-events:auto;color:inherit;border:0;background:transparent;min-width:44px;min-height:44px;padding:var(--sp-2);border-radius:50%;transition:background .18s,transform .18s}
  .music button:focus-visible,.music input:focus-visible,.music a:focus-visible{outline:2px solid var(--music-glass-accent);outline-offset:3px}
  .music svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}

  .music-bar{position:relative;display:flex;align-items:center;gap:var(--sp-2);width:100%;height:52px;max-width:100%;padding:6px;border-radius:999px;pointer-events:none;transition:opacity .14s,visibility 0s}
  .music .music-play{display:grid;place-items:center;min-width:40px;min-height:40px;width:40px;height:40px;padding:0;flex-shrink:0;color:var(--music-glass-accent)}
  .music-play svg{grid-area:1/1;width:22px;height:22px}
  .music.is-playing .mp-glyph-play{display:none}.music.is-playing .mp-glyph-pause{display:block}
  .music .music-expand{display:flex;align-items:center;gap:var(--sp-2);flex:1;min-width:0;min-height:40px;padding:0 var(--sp-1) 0 0;border-radius:20px;text-align:left;}
  .music-bar-copy{flex:1;min-width:0;}
  .music-expand .music-bar-copy>span,.music-expand small{display:block;width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .music-expand .music-bar-copy>span{font-size:.75rem;font-weight:600;letter-spacing:-.015em;line-height:1.4}
  .music-expand small{color:var(--music-glass-muted);font-size:.68rem;line-height:1.4}
  .music-signal{display:flex;gap:2px;align-items:center;justify-content:center;width:22px;height:28px;margin-right:0;color:var(--music-glass-accent);flex-shrink:0}
  .music-signal i{display:block;width:2px;height:8px;border-radius:999px;background:currentColor;transform-origin:center}
  .music-signal i:nth-child(2),.music-signal i:nth-child(4){height:15px}.music-signal i:nth-child(3){height:21px}
  .music.is-playing .music-signal i{animation:music-pulse .7s ease-in-out infinite alternate}
  .music.is-playing .music-signal i:nth-child(2n){animation-delay:-.4s}.music.is-playing .music-signal i:nth-child(3){animation-delay:-.2s}
  .music-panel{pointer-events:auto;position:fixed;top:var(--music-panel-y,12px);left:var(--music-panel-x,12px);z-index:3;display:flex;flex-direction:column;width:min(352px,calc(100vw - var(--sp-6)));max-height:calc(100dvh - 124px);padding:var(--sp-4);border-radius:28px;transform-origin:var(--sp-6) bottom}
  .music-panel-content{display:flex;flex-direction:column;flex:1;min-height:0}
  .music-heading{display:flex;align-items:center;gap:var(--sp-3);flex-shrink:0}
  .music[data-over-footer] .music-bar{color:var(--music-surface-ink,var(--footer-value));--music-glass-accent:var(--music-surface-ink,var(--footer-value));--music-glass-muted:var(--music-surface-ink,var(--footer-link));}
  .music[data-over-develop] .music-bar{color:var(--gallery-bath-ink);--music-glass-accent:var(--gallery-bath-ink);--music-glass-muted:var(--gallery-bath-faint);}
  .music[data-music-open] .music-bar{background:var(--music-glass);}
  .music .music-bar.liquid-glass{border:0;}
  .music[data-dock-hidden],.music[data-modal-hidden],.music[data-modal-hidden] *{visibility:hidden!important;pointer-events:none!important;}
  :global(html.boot-reveal) .music:not([data-dock-yielding]) .music-bar{animation:music-boot-in 480ms var(--ease-glass) 60ms both}
  .music[data-dock-yielding] .music-bar{opacity:0;visibility:hidden;transition:opacity .14s,visibility 0s .14s;}
  .music[data-dock-yielding] .music-bar *{pointer-events:none;}
  .music[data-dock-yielding] .music-morph{visibility:hidden!important;}
  .music-access{display:block;margin:var(--sp-4) var(--gutter) var(--sp-4) auto;min-height:44px;padding:var(--sp-2) var(--sp-4);font:inherit;color:var(--ink);border:1px solid var(--hair);background:var(--paper);border-radius:999px;}
  .music-access[hidden]{display:none;}
  .music-heading-copy{flex:1;min-width:0;}
  .music-heading-copy strong,.music-heading-copy small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .music-heading-copy small{font-size:.68rem;color:var(--music-glass-muted);line-height:1.6;}
  .music-heading strong{flex:1;font-size:var(--fs-sm);font-weight:600;letter-spacing:-.02em}
  .music-emblem{display:grid;place-items:center;flex-shrink:0;width:40px;height:40px;background:var(--music-glass-control);border-radius:14px;box-shadow:inset 0 1px 1px var(--music-glass-glint);color:var(--music-glass-accent)}
  .music .music-close{margin-right:calc(-1 * var(--sp-2));color:var(--music-glass-muted)}
  .music .music-status{margin:var(--sp-3) 0 var(--sp-4);font-size:.7rem;color:var(--music-glass-muted);line-height:1.6;min-height:1.6em;flex-shrink:0}
  .music-position{display:flex;flex-wrap:wrap;justify-content:space-between;gap:0 var(--sp-2);font-size:.67rem;color:var(--music-glass-muted);flex-shrink:0}
  .music-position span:last-of-type{font-variant-numeric:tabular-nums;letter-spacing:.02em}
  .music-position input{width:100%;margin:0;min-height:28px}
  .music input[type=range]{accent-color:var(--music-glass-accent);cursor:inherit}
  .music-controls{display:flex;align-items:center;justify-content:space-between;gap:var(--sp-3);margin-bottom:var(--sp-3);flex-shrink:0}
  .music-skip{display:flex;gap:var(--sp-1)}
  .music-skip button{background:var(--music-glass-control);box-shadow:inset 0 1px 1px var(--music-glass-inner)}
  .music-skip button[aria-pressed="true"]{color:var(--music-glass-accent);background:var(--music-glass-selected);box-shadow:inset 0 0 0 1px var(--music-glass-accent)}
  .music-volume{display:flex;align-items:center;gap:var(--sp-2);color:var(--music-glass-muted)}
  .music-volume svg{width:17px;height:17px}.music-volume input{width:76px;margin:0;min-height:44px}
  .music-search-wrap{display:flex;align-items:center;gap:var(--sp-2);background:var(--music-glass-control);border:1px solid var(--music-glass-inner);border-radius:14px;padding:0 var(--sp-3);flex-shrink:0;box-shadow:inset 0 1px 3px var(--music-glass-shade)}
  .music-search-wrap>svg{width:16px;height:16px;color:var(--music-glass-muted)}
  .music-search{width:100%;min-width:0;min-height:42px;padding:var(--sp-2) 0;color:var(--ink);background:transparent;border:0;outline-offset:0!important;border-radius:var(--sp-2);font-size:.75rem!important}
  .music-search::placeholder{color:var(--music-glass-muted);opacity:.85}
  .music-list{min-height:44px;max-height:228px;overflow:auto;overscroll-behavior:contain;scrollbar-width:thin;margin:var(--sp-3) calc(-1 * var(--sp-1));padding:var(--sp-1);list-style:none;flex:1 1 auto}
  .music-list :global(button){position:relative;display:flex;flex-direction:column;justify-content:center;gap:2px;width:100%;min-height:56px;padding:var(--sp-2) var(--sp-3);border:0;border-radius:12px;font:inherit;color:inherit;background:transparent;text-align:left;line-height:1.5;overflow-wrap:anywhere;transition:background .18s}
  .music-list :global(button span){font-size:.78rem;font-weight:500}.music-list :global(button small){font-size:.66rem;color:var(--music-glass-muted)}
  .music-list :global(button:focus-visible){outline:2px solid var(--music-glass-accent);outline-offset:0}
  .music-list :global(button[aria-current="true"]){color:var(--music-glass-accent);background:var(--music-glass-selected);box-shadow:inset 0 1px 0 var(--music-glass-inner);padding-left:var(--sp-5)}
  .music-list :global(button[aria-current="true"]::before){content:"";position:absolute;left:var(--sp-3);width:3px;height:18px;background:var(--music-glass-accent);border-radius:999px}
  .music-footer{display:flex;align-items:center;justify-content:space-between;gap:var(--sp-2);border-top:1px solid var(--music-glass-inner);padding-top:var(--sp-1);font-size:.65rem;flex-shrink:0;color:var(--music-glass-muted)}
  .music-footer button,.music-footer a{display:flex;align-items:center;gap:var(--sp-1);min-height:44px;font-size:inherit;color:inherit;border-radius:var(--sp-2)}
  .music-footer button{padding:0 var(--sp-1)}.music-footer a{text-decoration:none;padding:0 var(--sp-1)}.music-footer svg{width:13px;height:13px}
  @media(hover:hover){.music button:hover{background:var(--music-glass-hover)}.music button:active{transform:scale(.96)}.music .music-expand:hover{background:transparent}.music-list :global(button:hover){background:var(--music-glass-hover)}.music-footer a:hover{color:var(--music-glass-accent)}}
  @keyframes music-pulse{to{transform:scaleY(.35)}}
  @keyframes music-open{from{opacity:0;transform:translateY(8px) scale(.97)}to{opacity:1;transform:none}}
  @keyframes music-boot-in{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
  @media(max-width:600px){.music-panel{max-height:calc(100dvh - 108px)}}
  @media(max-height:540px){.music-panel{display:block;overflow:auto;overscroll-behavior:contain;padding:var(--sp-3);border-radius:22px}.music .music-status{margin:var(--sp-1) 0}.music-controls{margin-bottom:var(--sp-1)}.music-list{margin:var(--sp-1) 0}.music-footer{padding:0}}
  @media(prefers-reduced-transparency:reduce){.music-bar,.music[data-music-open] .music-bar{background:var(--music-glass-fallback)}}
  @media(prefers-reduced-motion:reduce){.music.is-playing .music-signal i,.music-panel,:global(html.boot-reveal) .music:not([data-dock-yielding]) .music-bar{animation:none}.music button,.music-bar,.music[data-dock-yielding] .music-bar,.music-list :global(button){transition:none}}
</style>
