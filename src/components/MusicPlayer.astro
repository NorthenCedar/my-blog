---
import { MUSIC_PLAYLIST } from '../lib/music';
---
<aside class="music" data-music hidden aria-label="音乐播放器">
  <audio data-music-audio preload="none" playsinline></audio>
  <div class="music-bar">
    <button type="button" data-music-play aria-label="播放音乐" title="播放或暂停">▶</button>
    <button class="music-expand" type="button" data-music-expand aria-expanded="false" aria-controls="music-panel">
      <span data-music-title>听听我的歌单</span>
      <small data-music-caption>博客 南屿北杉</small>
    </button>
    <span class="music-signal" aria-hidden="true"><i></i><i></i><i></i></span>
  </div>
  <section id="music-panel" class="music-panel" hidden aria-label="歌单与播放控制">
    <div class="music-heading"><strong>博客 南屿北杉</strong><button type="button" data-music-close aria-label="收起播放器">×</button></div>
    <p data-music-status role="status">点击播放，或从歌单选择一首。</p>
    <label class="music-position">播放进度 <span data-music-time>0:00 / 0:00</span><input data-music-seek aria-label="播放进度" type="range" min="0" max="1000" value="0" disabled /></label>
    <div class="music-controls">
      <button type="button" data-music-prev aria-label="上一首">上一首</button>
      <button type="button" data-music-next aria-label="下一首">下一首</button>
      <label>音量 <input data-music-volume aria-label="音量" type="range" min="0" max="1" step="0.05" value="0.35" /></label>
    </div>
    <input class="music-search" data-music-search aria-label="搜索歌单" type="search" placeholder="搜索歌名或歌手" />
    <ol class="music-list" data-music-list aria-label="歌曲列表"></ol>
    <div class="music-footer"><button type="button" data-music-reload>重新载入</button><a href={`https://music.163.com/playlist?id=${MUSIC_PLAYLIST}`} target="_blank" rel="noopener noreferrer">去网易云听</a></div>
  </section>
</aside>
<style>
  .music{position:fixed;left:var(--sp-4);bottom:calc(var(--sp-4) + env(safe-area-inset-bottom));z-index:35;max-width:calc(100vw - var(--sp-6));font-size:.8rem;color:var(--ink)}
  .music[hidden],.music-panel[hidden]{display:none}
  .music button,.music input{font:inherit}
  .music button{color:inherit;cursor:pointer;border:0;background:transparent;min-width:44px;min-height:44px;padding:var(--sp-2)}
  .music button:focus-visible,.music input:focus-visible,.music a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  .music-bar{display:flex;align-items:center;width:260px;max-width:100%;background:var(--paper);border:1px solid var(--muted);border-radius:4px}
  .music-expand{flex:1;min-width:0!important;text-align:left;display:flex;flex-direction:column;gap:var(--sp-1)}
  .music-expand span{max-width:170px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .music-expand small{color:var(--muted);font-size:.65rem}
  .music-signal{display:flex;gap:3px;align-items:center;padding:var(--sp-3);height:40px;color:var(--accent)}
  .music-signal i{display:block;width:2px;height:12px;background:currentColor}
  .music-signal i:nth-child(2){height:20px}
  .music.is-playing .music-signal i{animation:music-pulse .8s ease-in-out infinite alternate}
  .music.is-playing .music-signal i:nth-child(2){animation-delay:-.3s}
  .music.is-playing .music-signal i:nth-child(3){animation-delay:-.6s}
  .music-panel{position:absolute;bottom:calc(100% + var(--sp-2));left:0;width:min(360px,calc(100vw - var(--sp-6)));max-height:calc(100dvh - 140px);overflow:auto;overscroll-behavior:contain;background:var(--paper);border:1px solid var(--muted);border-radius:4px;padding:var(--sp-4)}
  .music-heading,.music-controls,.music-footer{display:flex;align-items:center;justify-content:space-between;gap:var(--sp-2)}
  .music-panel p{font-size:.75rem;color:var(--muted);margin:var(--sp-2) 0}
  .music-position{display:block}.music-position span{float:right}
  .music-position input{display:block;width:100%;accent-color:var(--accent);min-height:32px}
  .music-controls label{display:flex;align-items:center;gap:var(--sp-1)}
  .music-controls input{width:70px;accent-color:var(--accent)}
  .music-search{width:100%;padding:var(--sp-2);color:var(--ink);background:var(--paper);border:1px solid var(--muted);border-radius:2px}
  .music-list{margin:var(--sp-3) 0;padding:0;list-style:none;max-height:220px;overflow:auto;overscroll-behavior:contain}
  .music-list :global(button){display:block;width:100%;min-height:44px;padding:var(--sp-2);font:inherit;color:inherit;cursor:pointer;background:transparent;border:0;border-bottom:1px solid var(--panel);text-align:left;line-height:1.6;overflow-wrap:anywhere}
  .music-list :global(button:focus-visible){outline:2px solid var(--accent);outline-offset:-2px}
  .music-list :global(button[aria-current="true"]){color:var(--accent);background:var(--panel)}
  .music-footer{border-top:1px solid var(--muted);font-size:.7rem}
  @keyframes music-pulse{to{transform:scaleY(.35)}}
  @media(max-width:600px){.music{left:var(--sp-3);bottom:calc(var(--sp-3) + env(safe-area-inset-bottom))}.music-bar{width:230px}.music-expand span{max-width:145px}}
  @media(prefers-reduced-motion:reduce){.music.is-playing .music-signal i{animation:none}}
</style>
