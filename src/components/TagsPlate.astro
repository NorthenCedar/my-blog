---
/** 标签目录与单标签页共用：机械环底纹 + 准星。
 * 通过 Base 的 plate 槽挂在 .shell 外，避免页面过渡改变 fixed 的包含块。
 * 静态金属渲染与光槽数据来自 RhinE，许可和来源见 assets/tags/plates/README.md。
 */
import { Image } from 'astro:assets';
import plate from '../assets/tags/plates/mechanical-ring.webp';
import ring from '../assets/tags/plates/ring.json';
import { projectRingLight } from '../lib/mechanical-ring';
import Crosshair from './Crosshair.astro';

const light = projectRingLight(ring.fiber);
const lap = light.length.toFixed(3);
---

<div class="tags-inf" aria-hidden="true">
  <Image
    class="tags-inf-img"
    src={plate}
    alt=""
    widths={[700, 1400]}
    sizes="(max-width: 767px) 96vw, min(94vw, 1400px)"
    loading="eager"
    decoding="async"
  />
  <svg
    class="ring-light"
    viewBox={`0 0 ${ring.resolution.join(' ')}`}
    fill="none"
    focusable="false"
    style={`--ring-lap: ${lap};`}
  >
    <metadata>RhinE / Audio Archive authors · MIT · /licenses/rhine-mechanical-ring.txt</metadata>
    {light.segments.map(({ d, offset }) => (
      <g style={`--ring-offset: ${offset.toFixed(3)};`}>
        <path class="ring-pulse ring-pulse-halo" d={d} stroke-dasharray={`48 ${light.length - 48}`} />
        <path class="ring-pulse ring-pulse-core" d={d} stroke-dasharray={`28 ${light.length - 28}`} />
      </g>
    ))}
  </svg>
</div>
<Crosshair />

<style>
  .tags-inf {
    position: fixed;
    left: 50%;
    top: 50%;
    width: var(--plate-w, min(94vw, 1400px, 150vh));
    aspect-ratio: 1400 / 900;
    transform: translate(-50%, -50%);
    opacity: var(--plate-op, var(--ring-plate-opacity));
    pointer-events: none;
    z-index: -1;
  }
  .tags-inf :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
  }
  .ring-light {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .ring-pulse {
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: ring-flow var(--dur-ring-flow) linear infinite;
  }
  .ring-pulse-halo {
    stroke: var(--ring-light-halo);
    stroke-width: 9;
  }
  .ring-pulse-core {
    stroke: var(--ring-light-core);
    stroke-width: 3;
  }
  @keyframes ring-flow {
    from { stroke-dashoffset: var(--ring-offset); }
    to { stroke-dashoffset: calc(var(--ring-offset) - var(--ring-lap)); }
  }
  :global(body.tags-plate .page-inf) {
    display: none;
  }
  @media (max-width: 767px) {
    .tags-inf {
      width: var(--plate-w, min(96vw, 700px, 150vh));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ring-light { display: none; }
    .ring-pulse { animation: none; }
  }
</style>
