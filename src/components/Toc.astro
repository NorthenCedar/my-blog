---
import type { Heading } from '../lib/post-meta';

interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
---
{headings.length > 0 && (
  <nav class="toc" aria-label="本文目录">
    <h2 class="label">本文目录</h2>
    <ol>
      {headings.map((h) => (
        <li class={`lv${h.depth}`}><a href={`#${h.id}`}>{h.text}</a></li>
      ))}
    </ol>
  </nav>
)}

<style>
  .toc {
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--hair);
    padding: var(--sp-4) 0;
    margin: 0 0 var(--sp-7);
  }
  .label {
    font-size: var(--fs-sm);
    font-weight: 600;
    margin: 0 0 var(--sp-2);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 1;
    column-gap: var(--sp-6);
    font-size: var(--fs-sm);
  }
  li.lv3 {
    padding-left: var(--sp-4);
    color: var(--muted);
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: var(--accent-ink);
    text-decoration: underline;
  }
  @media (min-width: 860px) {
    ol {
      columns: 2;
    }
  }
</style>
