---
import type { Heading } from '../lib/post-meta';

interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
---
{headings.length > 0 && (
  <nav class="toc" aria-label="本文目录">
    <h2 class="label">本文目录</h2>
    <ol>
      {headings.map((h) => (
        <li class={`lv${h.depth}`}><a href={`#${h.id}`}>{h.text}</a></li>
      ))}
    </ol>
  </nav>
)}

<style>
  .toc {
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--hair);
    padding: var(--sp-4) 0;
    margin: 0 0 var(--sp-7);
  }
  .label {
    font-size: var(--fs-sm);
    font-weight: 600;
    margin: 0 0 var(--sp-2);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 1;
    column-gap: var(--sp-6);
    font-size: var(--fs-sm);
  }
  li.lv3 {
    padding-left: var(--sp-4);
    color: var(--muted);
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: var(--accent-ink);
    text-decoration: underline;
  }
  @media (min-width: 860px) {
    ol {
      columns: 2;
    }
  }
  /* 站主 2026-09-26 的折中：宽屏下把目录压成「横向索引条」——
     去掉标题、两列改四列、压缩纵向留白。**不碰版心**（宽度仍是 shell 宽），
     窄屏行为完全不变（窄屏上「本文目录」这个标题对可发现性有用，不能一起删）。
     为什么值得做：1440 下 5 个条目原本撑出 140px 高、右列只放得下 2 项、下半块是空的。 */
  @media (min-width: 1440px) {
    .label {
      display: none;
    }
    ol {
      columns: 4;
    }
    .toc {
      padding: var(--sp-2) 0;
      margin-bottom: var(--sp-6);
    }
  }
</style>
