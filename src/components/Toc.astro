---
import type { Heading } from '../lib/post-meta';
import { SAILING_SHIP_PATHS } from '../vendor/leibox/sailing-toc-ship.mjs';

interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
---
{headings.length > 0 && (
  <nav class="toc" aria-label="本文目录">
    <h2 class="label">本文目录</h2>
    <div class="toc-index">
      <div class="st-visual" aria-hidden="true">
        <svg class="st-rail" viewBox="0 0 90 100" preserveAspectRatio="none" focusable="false">
          <path class="st-route" d="M22 6V94" />
          <circle class="st-end" cx="22" cy="6" r="3.5" />
          <circle class="st-end-dot" cx="22" cy="6" r="1" />
          <circle class="st-end" cx="22" cy="94" r="3.5" />
          <circle class="st-end-dot" cx="22" cy="94" r="1" />
        </svg>
        <div class="st-ship" hidden>
          <svg class="st-wake" viewBox="0 0 100 88" focusable="false">
            <ellipse cx="51" cy="79" rx="24" ry="6" />
            <ellipse cx="51" cy="79" rx="45" ry="12" />
          </svg>
          <svg viewBox="0 0 100 88" focusable="false">
            {SAILING_SHIP_PATHS.map((d, index) => <path class:list={{ 'st-line': [1, 2, 10].includes(index) }} d={d} />)}
          </svg>
        </div>
      </div>
      <ol data-scrollbar>
        {headings.map((h) => (
          <li class={'lv' + h.depth}><a class="st-link" href={'#' + h.id}>{h.text}</a></li>
        ))}
      </ol>
    </div>
  </nav>
)}

<style>
  .toc {
    --st-rail-width: calc(var(--sp-7) + var(--sp-5));
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--hair);
    padding: var(--sp-4) 0;
    margin: 0 0 var(--sp-7);
  }
  .label {
    font-size: var(--fs-sm);
    font-weight: 600;
    margin: 0 0 var(--sp-2);
  }
  .toc-index {
    position: relative;
    overflow: clip;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: var(--sp-5) var(--sp-3) var(--sp-5) var(--st-rail-width);
    max-block-size: min(48svh, 28rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    font-size: var(--fs-sm);
  }
  li.lv3 {
    padding-inline-start: var(--sp-3);
    color: var(--muted);
  }
  .st-link {
    display: block;
    padding-block: var(--sp-1);
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: transform .32s cubic-bezier(.22, 1, .36, 1), color .2s;
  }
  .st-link:hover, .st-link[aria-current='location'] { color: var(--accent-ink); }
  .st-link:hover { text-decoration: underline; }
  .st-link:focus-visible { outline-offset: -2px; }
  .toc[data-toc-enhanced] .st-link[aria-current='location'] { transform: translateX(var(--sp-2)); }

  .st-visual {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--st-rail-width);
    pointer-events: none;
    visibility: hidden;
  }
  .toc[data-toc-enhanced] .st-visual { visibility: visible; }
  .st-rail {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .st-route {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.1;
    stroke-dasharray: 3 3;
    opacity: .65;
  }
  .st-end {
    fill: var(--paper);
    stroke: var(--muted);
    stroke-width: 1.1;
  }
  .st-end-dot { fill: var(--muted); }
  .st-ship {
    position: absolute;
    top: 0;
    left: calc(var(--st-rail-width) * 16 / 90);
    width: calc(var(--st-rail-width) * 64 / 90);
    aspect-ratio: 1;
    transform-origin: center;
    will-change: transform;
  }
  .st-ship svg { width: 100%; height: 100%; overflow: visible; }
  .st-ship path {
    fill: var(--paper);
    stroke: var(--accent-ink);
    stroke-width: 1.1;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .st-ship path.st-line { fill: none; }
  .st-wake {
    position: absolute;
    inset: 0;
  }
  .st-wake ellipse {
    fill: none;
    stroke: var(--accent-ink);
    stroke-width: .65;
    opacity: 0;
  }
  @media (max-width: 767px) {
    .toc { --st-rail-width: calc(var(--sp-7) + var(--sp-2)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .st-link { transition: none; }
  }
</style>
