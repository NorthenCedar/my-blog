---
// 场景第一帧就绪后才淡入，加载期间由页面本身的纸色和点阵铺底。
---

<div class="fin-infinity" data-fin-infinity aria-hidden="true">
  <div class="fin-view" data-fin-view hidden>
    <canvas data-fin-cv></canvas>
  </div>
</div>

<script>
  import '../scripts/fin-infinity';
</script>

<style>
  .fin-infinity {
    position: fixed;
    left: 50%;
    top: 50%;
    width: min(100vw, 1480px, 165vh);
    aspect-ratio: 1.65;
    transform: translate(-50%, -50%);
    z-index: -1;
    /* 点击由窗口监听，场景按可见鳍片判命中；底纹本身不拦截正文操作。 */
    pointer-events: none;
  }
  .fin-view[hidden] { display: none; }
  .fin-view,
  .fin-view canvas {
    display: block;
    width: 100%;
    height: 100%;
    /* ⚠ 不用 max-width:none —— 那个是百褶那套为解决图片溢出加的，
       画布填满容器就是对的，加了反而会在容器比视口窄时留白。 */
  }
  .fin-view canvas {
    opacity: 0;
    transition: opacity 260ms ease;
  }
  /* 只有脚本判定可跑、场景真的起来之后才淡入（.fin-on 由控制器挂上） */
  .fin-infinity.fin-on .fin-view canvas { opacity: 1; }
</style>
