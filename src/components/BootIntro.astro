---
/**
 * 首页开场动画 · 覆盖层（2026-09-30 第七个版本：**方向 B「∞ 落笔 → 崩解成线 → 收束揭幕」**）
 *
 * ── 为什么整份重写（站主 2026-09-30 拍板）──────────────────────────────────
 *   上一版是「照着上游 RhineLabUI 的 25fps 原片逐帧复刻」的产物：20.16 s / 六段叙事
 *   （ACCESS 打字 → 品牌三行 → ∞ 描边 → 身份验证 → 权限扫描 → 欢迎段），
 *   专用资产 2831 行（boot-tracks 915 + boot-css 619 + boot.css 57 KB + 两个测试 + 一个校验脚本）。
 *   站主要的是「5 秒内、丝滑、有印象、符合本站视觉」，并且明确说可以**摒弃冷静机器感**。
 *   ⇒ 逐帧版无法剪枝（六段入场互相咬合），只能重写；顺带把这笔技术债一次还掉。
 *
 * ── 新时间轴（总长 --dur-boot = 5300 ms 硬上限，含退场）────────────────────
 *
 *   段落        起(ms)  时长   内容
 *   ────────────────────────────────────────────────────────────────────────
 *   落笔        180     1150   ∞ 轮廓自缺口端起笔、一笔画完（dashoffset 1 → 0）
 *   崩解        1400    1350   96 条竖线从 ∞ 上的采样点（--k）起飞、展开到各自列位（--x1）
 *   收束        3000    1100   整片竖线向中央收拢成一条横线（scaleY → .008）
 *   剪幕        4150    450    遮罩 clip-path 上下对开收成中央一条线
 *   退场        4600    700    残余淡出；5300 ms 时 clock 的 animationend 触发 close()
 *
 *   ★ 三段时间**故意重叠**（崩解尾巴压在收束头上、收束尾巴压在剪幕头上）——
 *     这是「丝滑」的第一因：观感是同一个东西在变形，不是「一段演完再演下一段」。
 *   ★ 全程只有 transform / opacity / clip-path / stroke-dashoffset —— 不碰 layout。
 *
 * ── 三条硬约束（别在改动时破坏）─────────────────────────────────────────
 *   1. **方向是 fail-safe**：覆盖层默认 `display:none`，只有 JS 判定"该播"才挂 `.boot-on`。
 *      反向（默认显示、靠 JS 隐藏）会在无 JS / JS 报错时把整站盖死。
 *   2. **绝不效仿上游的「整站 SSR opacity:0」**：上游把首页写成 `style="opacity:0"` 靠 JS 点亮，
 *      动画一丢内容就永久不可见 —— 这正是本仓 2026-09-30 第六轮修掉的 bug 类型。
 *      这里反过来：**内容默认可见**，入场动画只是"提前把它藏起来"、再用 CSS 终态放出来。
 *   3. 装饰子树 `aria-hidden="true"`，而 skip 按钮是它的**兄弟** ——
 *      `aria-hidden` 子树里不许有可聚焦元素。skip 的类名是 `.bi-skip`（**不是** `.skip`，
 *      base.css 已占了 `.skip` 当"跳到正文"，照抄会继承 `left:-9999px`）。
 *
 * ── 手机（≤767px）──────────────────────────────────────────────────────
 *   不取消，改成一版 1.5 s 的极简版：只做「∞ 落笔 + 线一闪 + 收束」，不做字标、不揭帘。
 *   实现方式是**同一套关键帧** + 另一组 `--bi-*` 时长变量（见 :global(html.boot-mini)）——
 *   不复制一份 CSS，也就不会两版各自跑偏。
 *   ★ 首屏的揭帘 / 逐字只在**非 mini** 下跑（`html.boot-on:not(.boot-mini)`）。
 */
// 竖线条数：与首屏 #rhGrid 的列距同量级（1280 视口下首屏约 105 条 / 12.2px 一列，
// 这里 96 条 / 12.8px 一列）⇒ 遮罩撤走时"线密度"几乎不变，人眼读作同一个东西换了密度。
const N = 96;
const TAU = Math.PI * 2;

/**
 * `--k`：这条线在 ∞ 路径上的**横向位置**（-1..1，双纽线 x = cos θ）。
 * 崩解的起始 x 就是它 —— 保住血缘：观众能认出"这是刚才那个 ∞ 散开的"，
 * 而不是一堆线凭空出现。采样按 i 递增 ⇒ 顺序即 ∞ 的描绘顺序。
 * `--x1`：最终列位（vw，遮罩期间没有滚动条 ⇒ 100vw 就是视口宽，与 .bi-stage 一致）。
 * `--d` / `--g`：崩解 / 收束的错峰延迟，**从两端向中间**（m = min(i, N-1-i)），
 *   与首屏 #rhGrid 的"从两端向中间被画出来"同向 —— 方向不打架才是"顺"的第一因。
 * `--h`：竖线高度（%），两个不同频率的正弦叠加造"不规则"；收束时按同一比例缩到看不见。
 */
const lines = Array.from({ length: N }, (_, i) => {
  const k = Math.cos((TAU * i) / N);
  const h = Math.min(72, Math.max(26, 34 + 30 * (0.5 + 0.5 * Math.sin(i * 2.3999)) + 6 * Math.sin(i * 0.7)));
  const m = Math.min(i, N - 1 - i);
  return {
    x1: (((i + 0.5) / N) * 100).toFixed(3),
    k: k.toFixed(4),
    h: h.toFixed(1),
    d: `${m * 7}ms`,
    g: `${m * 5}ms`,
  };
});

/**
 * ∞ 的单段连续轮廓（起点落在印刷缺口那一端）。
 * ★ 为什么必须**单段**：dash 图案在子路径边界上不能可靠环绕，两段路径会让第二段起点附近
 *   多出一处缺口 —— 现象就是 ∞ 的交叉处画不出来。静态标志（站点 `#rhine-logo`）是两段，
 *   这里描边必须用这一版。
 */
const MARK = 'M19.04 2.14a4 4 0 0 0-1.04-.14c-2 0-4 1.33-6 4c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4c2 2.67 4 4 6 4a4 4 0 0 0 2.83-6.83L19.04 2.14';
---

<div class="bi" data-boot-overlay>
  {/* .bi-stage 是**唯一**被剪幕裁切的东西 —— skip 按钮放在它里面，剪幕一开始
      （4150 ms）它就随裁切一起不可点，那正是想要的：开场已经结束了。 */}
  <div class="bi-stage">
    <div class="bi-field" aria-hidden="true">
      <div class="bi-wash"></div>

      {/* 竖线：由 96 个 <i> 组成，位置/高度/错峰全部走内联自定义属性（零 JS） */}
      <div class="bi-lines">
        {lines.map((l) => (
          <i class="bi-line" style={`--x1:${l.x1}vw;--k:${l.k};--h:${l.h}%;--d:${l.d};--g:${l.g}`} />
        ))}
      </div>

      <svg class="bi-mark" viewBox="0 0 24 12" aria-hidden="true">
        <path class="bi-mark-path" pathLength="1" d={MARK} />
      </svg>
    </div>

    <p class="bi-hint" role="status">开场动画播放中。按 Escape 或空格跳过。</p>
    <button class="bi-skip" type="button">跳过</button>
    {/* 时长钟：0 尺寸，只用来在总时长走完时触发一次 animationend（子元素事件会冒泡，必须认 target） */}
    <span class="bi-clock"></span>
  </div>
</div>

{/* ===== 开场行为（目标 <900 B）=====
     ① 点击 skip / Esc / 空格 → 同一条 close()
     ② 总时长走完（clock 的 animationend）→ close()
     ③ 收尾时**先**把焦点交回主标题、再移除覆盖层（反过来焦点会掉到 <body>）
     ★ 空格必须 preventDefault —— 默认行为是向下滚页；而"空格只在遮罩还在时劫持"
       靠的是 close() 之后本监听器随覆盖层一起失效（overlay.remove() + boot-on 摘掉）。
*/}
<script>
  (() => {
    const html = document.documentElement;
    const overlay = document.querySelector('[data-boot-overlay]');
    // 没播（reduced-motion / 无 JS / 本会话已播）就直接不注册任何东西
    if (!overlay || !html.classList.contains('boot-on')) return;

    const clock = overlay.querySelector('.bi-clock');
    let closed = false;

    const close = () => {
      if (closed) return;
      closed = true;
      // 焦点交接：遮罩收尾别把焦点掉到 <body>。h1 上的 tabindex="-1" 与
      // base.css 的 `[tabindex='-1']:focus-visible{outline:none}` 是这条链的另一半。
      const title = document.querySelector('.band-copy h1, h1.display, h1');
      if (title && typeof title.focus === 'function') title.focus();
      html.classList.remove('boot-on', 'boot-mini'); // 解锁滚动 + 让覆盖层消失
      overlay.remove();
      document.removeEventListener('keydown', onKey);
    };

    const onKey = (event: KeyboardEvent) => {
      if (event.key === 'Escape' || event.key === ' ' || event.key === 'Spacebar') {
        event.preventDefault();
        close();
      }
    };

    overlay.querySelector('.bi-skip')?.addEventListener('click', close);
    document.addEventListener('keydown', onKey);

    if (clock) {
      overlay.addEventListener('animationend', (event) => {
        if (event.target !== clock) return; // ← 子元素的事件会冒泡上来
        close();
      });
      setTimeout(close, 8000); // 兜底：animationend 万一不来，也别把滚动锁死
    }
  })();
</script>

<style>
  /* ============================================================================
     开场覆盖层样式（本组件唯一的一份；旧的 boot.css 57 KB 生成物已删除）
     ★ 时长**只有**这一组 --bi-* 变量是"设计决定"；各段的缓动与几何都在下面。
     ============================================================================ */
  :global(html) {
    /* 全量版：5300 ms（站主 2026-09-30 定的硬上限，参考站 wodniack.dev 实测 5.0 s） */
    --bi-total: var(--dur-boot);
    --bi-draw-at: 180ms;   --bi-draw: 1150ms;   /* 落笔 */
    --bi-scat-at: 1400ms;  --bi-scat: 1350ms;   /* 崩解 */
    --bi-gath-at: 3000ms;  --bi-gath: 1100ms;   /* 收束 */
    --bi-wipe-at: 4150ms;  --bi-wipe: 450ms;    /* 剪幕 */
    --bi-fade-at: 4600ms;  --bi-fade: 700ms;    /* 退场 */
    --bi-k: 1;                                   /* 错峰倍率（手机极简版压到 0.02） */
  }
  /* 手机极简版：1.5 s，只做「落笔 + 线一闪 + 收束」，不做剪幕后的任何东西 */
  :global(html.boot-mini) {
    --bi-total: var(--dur-boot-mini);
    --bi-draw-at: 60ms;    --bi-draw: 620ms;
    --bi-scat-at: 620ms;   --bi-scat: 480ms;
    --bi-gath-at: 1050ms;  --bi-gath: 300ms;
    --bi-wipe-at: 1150ms;  --bi-wipe: 180ms;
    --bi-fade-at: 1200ms;  --bi-fade: 300ms;
    --bi-k: 0.02;
  }

  /* ---------- 门控：默认不显示 ---------- */
  :global(html:not(.boot-on)) [data-boot-overlay] { display: none; }
  :global(html.boot-on) { overflow: hidden; }
  @media (prefers-reduced-motion: reduce) {
    [data-boot-overlay] { display: none !important; }
  }

  .bi {
    position: fixed;
    inset: 0;
    z-index: 60;
    overflow: hidden;
    /* 深墨绿空场：与首屏 .band 同一族色（撤走时不出现色相跳变） */
    background: radial-gradient(120% 80% at 12% 0%, #2d7d4626 0%, transparent 58%),
      linear-gradient(178deg, #090c0c 0%, #0e1512 46%, #141d18 100%);
  }
  .bi-stage {
    position: absolute;
    inset: 0;
    /* 剪幕与退场：两条动画、两个互不重叠的属性（clip-path / opacity）⇒ 不会互相顶掉 */
    animation:
      bi-wipe var(--bi-wipe) cubic-bezier(0.65, 0, 0.35, 1) var(--bi-wipe-at) both,
      bi-fade var(--bi-fade) linear var(--bi-fade-at) both;
  }
  @keyframes bi-wipe {
    from { clip-path: inset(0 0 0 0); }
    to { clip-path: inset(50% 0 50% 0); }
  }
  @keyframes bi-fade {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  .bi-field {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* 底部一层极淡绿洗色，呼应首页 .bg-wash */
  .bi-wash {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 52vh;
    background: linear-gradient(0deg, #2d7d4622, transparent);
  }

  /* ---------- 1. ∞ 落笔 ---------- */
  .bi-mark {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(46vw, 520px);
    aspect-ratio: 2 / 1;
    color: var(--logo-ink);
    filter: drop-shadow(0 0 18px #8fe0b040);
    animation: bi-mark-out var(--bi-scat) cubic-bezier(0.5, 0, 0.75, 0) var(--bi-scat-at) both;
  }
  @keyframes bi-mark-out {
    from { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    to { opacity: 0; transform: translate(-50%, -50%) scale(1.09); }
  }
  /* ★ :global(path)：SVG 子元素的作用域属性不可靠，写 :global 才一定命中 */
  .bi-mark :global(path) {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.32;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* 一笔画完：pathLength="1" ⇒ dasharray 取 1、dashoffset 1→0 就是"从起点长出来" */
    stroke-dasharray: 1;
    animation: bi-draw var(--bi-draw) cubic-bezier(0.16, 1, 0.3, 1) var(--bi-draw-at) both;
  }
  @keyframes bi-draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }

  /* ---------- 2/3. 竖线：崩解展开 → 收束成线 ---------- */
  .bi-lines {
    position: absolute;
    inset: 0;
    color: var(--logo-ink);
    opacity: 0.5;
  }
  .bi-line {
    position: absolute;
    top: 0;
    left: var(--x1);
    width: 1px;
    height: 100%;
    margin-left: -0.5px;
    opacity: 0;
    /* 外层管「横向展开」（transform + opacity）；竖向收束交给伪元素 ⇒ 属性不打架 */
    animation: bi-scatter var(--bi-scat) cubic-bezier(0.16, 1, 0.3, 1)
      calc(var(--bi-scat-at) + var(--d) * var(--bi-k)) both;
  }
  @keyframes bi-scatter {
    from {
      opacity: 0;
      /* 起点 = 这条线在 ∞ 上的采样点（--k × ∞ 的半宽）；min(23vw,260px) 与 .bi-mark 的 46vw/520px 对应 */
      transform: translate3d(calc(50vw - var(--x1) + var(--k) * min(23vw, 260px)), 0, 0);
    }
    22% { opacity: 0.78; }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }
  /* 竖线本体放在伪元素上：96 个元素干活，DOM 只要一半 */
  .bi-line::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: var(--h);
    top: calc(50% - var(--h) / 2);
    background: currentColor;
    transform-origin: 50% 50%;
    animation: bi-gather var(--bi-gath) cubic-bezier(0.65, 0, 0.35, 1)
      calc(var(--bi-gath-at) + var(--g) * var(--bi-k)) both;
  }
  @keyframes bi-gather {
    from { transform: scaleY(1); }
    /* 不同 --h 乘同一比例后落在 0.2%–0.6% 视口高（≈2–5px）⇒ 读作"一条横线" */
    to { transform: scaleY(0.008); }
  }

  /* ---------- skip / 提示 / 时长钟 ---------- */
  .bi-skip {
    position: absolute;
    right: clamp(1rem, 3.4vw, 3.4rem);
    bottom: clamp(1rem, 3.4vw, 3.4rem);
    padding: 0.5rem 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: var(--fs-mono);
    letter-spacing: 0.18em;
    color: var(--logo-ink);
    background: none;
    border: 0;
    opacity: 0.5;
  }
  .bi-skip:hover,
  .bi-skip:focus-visible { opacity: 1; }
  /* 视觉隐藏但留在无障碍树里：屏幕阅读器用户也要知道"有个遮罩、能跳过" */
  .bi-hint {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .bi-clock {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    animation: bi-clock var(--bi-total) linear both;
  }
  @keyframes bi-clock {
    from { opacity: 1; }
    to { opacity: 1; }
  }
</style>
