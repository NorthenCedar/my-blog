---
/**
 * 内页外壳（chrome='page'）—— post / gallery / projects 共用。
 *
 * ★ 2026-09-30 站主拍板：「内页套原型正文区语言」（视觉统一换成 rhine v10.6）。
 *
 * 装的是什么：**原型的纸白正文区语言** ——
 *   · `--ink-1` 墨绿描边（取代原来那条 `--ink` 的实心黑底线）
 *   · 百褶 ∞ 底纹（`/art/inf-orig.webp`，与首页同一张素材）
 *   · 玻璃质感（`--glass-bg` / `--glass-blur` / `--glass-line` / `--glass-shadow`）
 *   · 原型的 `.section-head` 排版（h2 在前、等宽编号在后）
 *
 * 没装的是什么（**刻意**，站主原话是「内容与信息架构一个不动」）：
 *   · 不装首页的深墨绿首屏、DNA、流场线、玻璃舱窗 —— 那是首页专属，内页是阅读场景
 *   · 不装原型那种「每个区块都做成卡片网格」的重新布局 —— 那会动信息架构
 *   · 原来的「切片档案」背景母题（等距发丝横线 + 右下切片素材 `/bg-slice.webp`）
 *     连同它的遮罩一起删除：与新的 ∞ 底纹是两套母题，叠在一起脏。
 *
 * ★ 2026-10-01（第十一版）**口径收窄**：上面第一条的适用范围缩小了。
 *   站主新提「除了主页其他页太素了，想让他们和主页风格相似，但每页都要不一样，
 *   且每页都要有个可互动的东西」⇒ 内页开始有**各页自己的装置**。
 *   收窄之后仍然成立的是：
 *     · **不搬首页那一套**（深墨绿首屏 / DNA / 流场线 / 玻璃舱窗）—— 首页的流场线
 *       只留在首页（站主原话：「主页的线只放在主页，其他页再想其他可互动设计」）；
 *     · 每个内页的装置是**机制上不同**的新东西，不是同一内核换参数；
 *     · 阅读型页面的装置**滚动即退场**，**正文排版一行不动**。
 *   第一台装置 = 相册页的「显影板」（`src/scripts/develop.ts`，契约见
 *   `docs/rhinelab-spec.md` §6.18）。★ 2026-10-01 二次改口径：它从"页头下方一条满宽板"
 *   收成了**页头右侧的一块小板**（`aspect-ratio` 跟着抽中的照片走，宽 ≤ 288px），
 *   而且**静止时只是一块纯色** —— 只有指针能把照片搅出来。
 *
 * 只用在本页渲染时才加载的样式（`is:global` + `body.chrome-page` 前缀），
 * 所以其余页面既不会多背字节，也不会被这些规则碰到。
 */
import type { NavKey } from '../lib/nav';
import NavDrawer from './NavDrawer.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  wordmark: string;
  current?: NavKey;
  home?: boolean;
}
const { wordmark, current, home = false } = Astro.props;
const scrolls = Astro.url.pathname !== '/gallery/';
---

{/* 百褶 ∞ 底纹：与首页同一张素材、同一套挂法（fixed 挂视口 ⇒ 滚动时始终居中）。
    纯装饰 ⇒ aria-hidden；不拦指针由 CSS 保证。
    素材自带右偏的墨迹（原型 v10.6 定案：不做居中补偿，要的就是原图本来的样子）。 */}
{!home && <div class="page-inf" aria-hidden="true"></div>}

<div class:list={['topbar', home && 'home-topbar']} data-scroll-topbar={scrolls ? '' : undefined}>
  <a class="site" href="/">{wordmark}</a>
  {!home && <button class="notices" type="button" data-notices aria-expanded="false" aria-label="回复提醒" hidden>
    <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false">
      <path d="M8 1.6a4.1 4.1 0 0 0-4.1 4.1v3.1L2.6 11.2h10.8L12.1 8.8V5.7A4.1 4.1 0 0 0 8 1.6Zm0 12.9a1.75 1.75 0 0 0 1.75-1.75H6.25A1.75 1.75 0 0 0 8 14.5Z" fill="currentColor" />
    </svg>
    <span class="notices-count" data-notices-count hidden></span>
  </button>}
  {/* 主题开关（2026-11-12 从关于页搬上来）：裁切小窗版，见 ThemeToggle.astro。 */}
  {!home && <ThemeToggle variant="nav" />}
  <NavDrawer current={current} />
</div>

<style is:global>
  /* ============================================================
     内页外壳（chrome='page'）—— 所有选择器都带 body.chrome-page 前缀。
     样式只在本组件被渲染的页面加载（Astro 按页面切 CSS 包），
     所以 band / console 那 13 页既不多背字节，也不会被这些规则影响。
     ============================================================ */

  body.chrome-page {
    background: var(--paper);
    /* 内页外壳提供的元信息配色（站主 2026-09-26 拍板 A）：
       Meta 组件消费 --meta-color / --meta-sub，外壳只提供值 —— 颜色仍归组件声明，
       不做跨组件覆盖。深色带外壳不设这两个变量，于是 Meta 落回它自己的默认值。 */
    --meta-color: var(--muted);
    --meta-sub: var(--muted);
  }

  /* 正文与页脚必须显式抬到装饰层之上。
     背景层是 position:fixed，若正文不给 z-index，定位元素会画在静态正文之上
     —— 这一条 B1 在首页水印上踩过，内页同理。 */
  body.chrome-page main,
  body.chrome-page footer {
    position: relative;
    z-index: 1;
  }

  /* ---------- 背景：百褶 ∞ 底纹（单层，fixed + z-index:-1 + 不拦指针） ----------
     ★ 2026-09-30 换母题：原来的「切片档案」四层（纸纹噪点 / 等距发丝横线 /
       底部绿洗 / 右下切片素材 + 纸色遮罩）整体删除，换成原型 v10.6 的 ∞ 底纹。
       与首页 .paper-inf 同一套参数（fixed 挂视口 / min(128vw,1600px) / opacity .2），
       保持全站只有一套纸白区语言。
       z-index:-1 而不是 0：底纹要退到正文**之下**，正文不需要额外抬升
       （原来用 0 时正文必须显式 z-index:1，现在那条还需要 —— 见下面 main/footer 那条）。 */
  body.chrome-page .page-inf {
    position: fixed;
    left: 50%;
    top: 50%;
    width: min(128vw, 1600px);
    aspect-ratio: 1572 / 878;
    transform: translate(-50%, -50%);
    background: url('/art/inf-orig.webp') center / contain no-repeat;
    opacity: 0.2;
    pointer-events: none;
    z-index: -1;
  }
  /* ★★ 2026-11-13：暗档从「整条规则切换」改成「按 --theme-w 连续算」。
     原来 `html.dark body.archive-plate .page-inf { filter: …; opacity: … }` 只有在
     松手落定、`html` 挂上 dark 类那一刻才成立 ⇒ 拖动全程停在亮档，落定才"啪"一下变铜。
     现在滤镜链与浓度都用权重表达（w=0 恒等 / w=1 等于原来的暗档值，见 tokens.css）。 */
  body.archive-plate .page-inf {
    filter: var(--plate-filter-pleat);
    opacity: calc(
      var(--pleat-light-opacity) * (1 - var(--theme-w)) + var(--pleat-dark-opacity) * var(--theme-w)
    );
  }

  /* ---------- 顶栏：极简，只有站名与主导航 ----------
     ★ 2026-09-30 换成原型 topbar 的**质感**（首页用的就是这套），但布局保持原样：
       内页顶栏是 `space-between` 的窄条（站名左、导航右），原型首页 topbar 在首屏里
       是同样的结构 ⇒ 只换"看得见的那层皮"，不动它怎么排。
       换的三样：底线从 --ink 实心黑改成 --glass-line（== --ink @ 8%），
       加一层玻璃薄片（backdrop-filter）+ 顶部高光，字距收一点。
       ★ 顺序有讲究：**前缀在前、标准在后**（理由见 pages/index.astro 里 .section-head 的注释）。 */
  body.chrome-page .topbar {
    /* ★★ 2026-10-08：顶栏自己**不再**承担背景 / 模糊 / 描边 —— 全部搬到 ::before。
       为什么必须这样（手机端「除了主页，其他页点不出导航菜单」的根因）：
       `backdrop-filter` **同时**做两件要命的事 ——
         ① 建立 `position:fixed` 后代的**包含块**：抽屉的 `.navshell` 是 `fixed; inset:0`，
            被收作 `.topbar` 的包含块之后只铺满顶栏那条细带（实测 62px），面板被裁成一条；
         ② 建立**层叠上下文**：把 `.navshell` 的 `z-index:40` 锁在顶栏内部，
            而 `body.chrome-page main` 是 `z-index:1` ⇒ 抽屉还会被正文压住。
       实测（`_probe/_nav-probe.mjs`）：首页 shell 780（=视口，正常）；
       七个内页 shell 全部 62（=顶栏高，被压扁），"建立包含块的祖先"写着 `div.topbar[backdrop-filter]`。
       挪到 ::before 之后：模糊的**底色仍然是页面**（不是顶栏自己的装饰），
       顶栏的字/链接在 ::before 之上 ⇒ 观感逐像素不变
       （`_probe/_nav/before|after/strip-about-1200.png` 对照 + `_probe/_nav/diff-strip.png`）；
       顶栏恢复为抽屉的普通祖先，固定层继续按视口测量。
       ⚠ 别再往 `.topbar` 上加 `backdrop-filter` / `filter` / `transform` / `perspective` /
          `will-change` / `contain` —— 任何一个都会把上面两个问题一起带回来
          （首页 `index.astro` 早有一条注释专门避开 `transform`，出处相同）。
          护栏：`tests/nav-drawer-overflow.test.ts` 的「顶栏不得建立 fixed 包含块」。 */
    position: sticky;
    top: 0;
    /* 顶栏高于正文，关于页向上延伸的透明画布也不会拦住菜单。 */
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: var(--topbar-pad-block) var(--gutter);
    /* 只占位、不着色：底线改由玻璃层画。留在这儿会被 ::before 的模糊一起吃掉。
       写 `transparent` 而不是删声明 —— 删了顶栏会矮 1px（"此处刻意不着色"也是给后来人看的）。 */
    border-bottom: 1px solid transparent;
    font-family: "IBM Plex Mono", Consolas, "Courier New", monospace;
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  /* 顶栏的**视觉层**：玻璃底 + 模糊 + 内高光 + 底线。
     ★ `z-index: 0`（**不能**写 -1）—— 这是本轮量出来的：
       写 -1 时它落进根层叠上下文的**负层**，Chrome 合成时**底纹（.page-inf，同为 z-index:-1）
       不进它的 backdrop** ⇒ 玻璃变成一层近乎纯纸白的白片（实测顶栏 rgb(246,246,243) → rgb(251,251,248)，
       即 ∞ 底纹不再透过玻璃可见）。写成 0（正常定位层）后与"玻璃挂在 .topbar 自己身上"的
       原始观感**逐值相同**（`_probe/_nav-var.mjs` 的 base/z0/ctrl 三档对照）。
       顶栏整体位于正文之上，抽屉层仍由固定定位铺满视口。 */
  body.chrome-page .topbar::before {
    content: '';
    position: absolute;
    inset: 0 0 -1px 0;    /* 多盖 1px：接住原来那条 border-bottom 的位置，顶栏总高不变 */
    z-index: 0;
    pointer-events: none;
    border-bottom: 1px solid var(--glass-line);
    background: linear-gradient(180deg, var(--glass-bg), transparent);
    -webkit-backdrop-filter: blur(var(--glass-blur));
    backdrop-filter: blur(var(--glass-blur));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 40%);
  }
  /* 顶栏的**药丸玻璃层**：滚动态收成圆条时出现的那一层。
     ★ 它必须是独立的一层、只做 opacity 淡入 —— 这是本轮定量量出来的：
       以前滚动态直接改 ::before 的 `border`/`background-image`/`box-shadow`/`backdrop-filter`，
       而这几样要么不可补间（背景图、边框宽度）、要么从 `currentColor` 起步（`border-top-color`
       在过渡第 0 帧是深色 #1a1a1a，再花 0.5s 淡成白色 ⇒ 圆条成形时先闪一道深描边），
       实测 `_tmp-navprobe.html` 在 T=0 的 ::before 计算值是 `border-top-color rgb(26,26,26)`、
       四层大阴影已就位、背景渐变已从 180° 换成 135° —— 三处硬跳，正是站主看到的「闪」。
       现在：::before 只负责静止态的纸面玻璃，::after 只负责药丸，
       两层的模糊/描边/阴影都是**静态**的，动起来的是 opacity、圆角与顶栏自身的几何。
     ★ 2026-11-16（站主：「往上滑那个圆条直接消失，想让它像往下滑的倒放」）：
       圆角也进补间（静止态 0 ↔ 滚动态 999px），并且**两层的交接错开**——
       上滑时先花 .42s 让药丸把圆角摊平成整条（这 .42s 里它完全不透明），
       最后 .18s 才淡出、纸面玻璃同时接上；下滑时反过来：纸面立刻让位、药丸随几何收成圆条。
       以前两边是 .5s 同步交叉淡化、圆角恒为 999px ⇒ 观感是「圆条化掉」而不是「圆条摊开」。
     ⚠ 别把 `backdrop-filter` 写回过渡列表：逐帧重算模糊区在 Chrome 上会抖。 */
  body > [data-scroll-topbar]::after {
    content: '';
    position: absolute;
    inset: 0 0 -1px 0;
    z-index: 0;
    pointer-events: none;
    /* 静止态是方角、滚动态才是圆条。
       ⚠ 上滑时**不能**一路补间圆角：条高 60px，半径一超过 30px 就看不出圆头了，
       用 .5s 摊平的话刚上滑 100ms 圆条就「没形了」，而文字还要再飞 400ms ——
       站主看到的就是「圆条还是消失了，文字自己飞回去」。所以圆角只在**最后 .18s**
       跟着淡出一起收：前 .42s 它一直是圆条，跟着几何一起放大。 */
    border-radius: 0;
    opacity: 0;
    visibility: hidden;
    /* 回静止态（上滑）：药丸先原样放大 .42s，等文字飞回原处，再用 .18s 收角+淡出交给纸面玻璃；
       visibility 拖到这一切结束才切，否则 Chrome 会在补间中途把这层藏掉。 */
    transition: border-radius .18s ease .42s, opacity .18s ease .42s, visibility 0s linear .62s;
  }
  body > [data-scroll-topbar][data-topbar-scrolled]::after {
    border-radius: 999px;
    opacity: 1;
    visibility: visible;
    /* 进滚动态（下滑）：圆角在头 .2s 就收成药丸（与淡入同步），随后整条继续缩小。 */
    transition: border-radius .2s ease, opacity .2s ease, visibility 0s linear 0s;
  }
  body.chrome-page .topbar::before {
    /* 回静止态（上滑）：等药丸摊平（.42s）再淡回来接住整条。 */
    transition: opacity .18s ease .42s, visibility 0s linear .42s;
  }
  body.chrome-page > [data-scroll-topbar][data-topbar-scrolled]::before {
    opacity: 0;
    visibility: hidden;
    /* 进滚动态（下滑）：纸面立刻让位给药丸。 */
    transition: opacity .18s ease, visibility 0s linear .18s;
  }
  /* 顶栏自己的**文字与图标**抬到玻璃层之上：玻璃层是 z-index:0 的定位元素，
     而定位元素画在内流内容**之后**，不抬的话站名/导航会被一起模糊掉。
     ⚠ 必须排除抽屉那两件：`.navshell` 是 `position:fixed`、`.navtog` 小屏下是 `position:absolute`
     —— 给它们加 `position` 会当场改坏抽屉（`.navbtn` 是静态定位，抬上来是对的）。
     消息面板也必须排除：其 absolute / z-index:30 要保持，不能参与顶栏 flex 布局。 */
  body.chrome-page .topbar > *:not(.navshell):not(.navtog):not(.notices-panel) {
    position: relative;
    z-index: 1;
  }
  body.chrome-page .topbar .site {
    color: var(--ink);
    letter-spacing: 0.14em;
    text-decoration: none;
    min-width: 0;
    margin-inline-end: auto;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* 回复提醒和菜单并排，面板由回复提醒控制器挂到顶栏。 */
  body.chrome-page .topbar > .notices {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.42rem 0.66rem;
    border-radius: 999px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    font: inherit;
    line-height: 1;
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-interact),
      background-color var(--dur-fast) var(--ease-interact),
      border-color var(--dur-fast) var(--ease-interact),
      transform var(--dur-fast) var(--ease-interact);
  }
  body.chrome-page .topbar > .notices:hover,
  body.chrome-page .topbar > .notices:focus-visible,
  body.chrome-page .topbar > .notices[aria-expanded='true'] {
    color: var(--ink);
    background: var(--accent-wash);
    border-color: var(--accent);
    /* 同排链接悬停时上浮 2px，铃铛跟着抬 —— 否则一排胶囊里只有它不动，像失效控件。
       （掠光那一道不加：那是给文字链的扫光，扫过一枚 13px 图标看不出来。） */
    transform: translateY(-2px);
  }
  /* ⚠ `display:inline-flex` 会压过 UA 的 `[hidden]{display:none}` —— 不补这一条，
     匿名访客也会看见一枚空铃铛（本站踩过一次同类：hidden 被组件自己的 display 顶掉）。 */
  body.chrome-page .topbar > .notices[hidden],
  .notices-count[hidden] {
    display: none;
  }
  body.chrome-page .topbar > .notices:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: 2px;
  }
  .notices-count {
    min-width: 1.15rem;
    padding: 0 0.26rem;
    border-radius: 999px;
    background: var(--accent-ink);
    color: var(--paper);
    /* 站内微字号那一档是 0.6rem（见 AlbumRow 的角标），对齐它，不另插 0.62 */
    font-size: 0.6rem;
    line-height: 1.15rem;
    text-align: center;
  }
  body.chrome-page .notices-panel {
    position: absolute;
    top: calc(100% + 0.45rem);
    right: var(--gutter);
    z-index: 30;
    width: min(22rem, calc(100vw - 2 * var(--gutter)));
    border-radius: 28px;
    overflow: clip;
    font-family: "IBM Plex Mono", Consolas, "Courier New", monospace;
    font-size: var(--fs-xs);
    color: var(--ink);
  }
  .notices-scroll {
    max-height: 60dvh;
    overflow-y: auto;
    overscroll-behavior: contain;
    border-radius: inherit;
    padding: var(--sp-2) var(--sp-3);
    scrollbar-width: thin;
  }
  .notices-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .notices-more {
    margin-top: var(--sp-3);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  .notice {
    border-bottom: 1px solid var(--glass-line);
  }
  .notice:last-child { border-bottom: 0; }
  .notice-link {
    display: block;
    padding: var(--sp-2);
    border-radius: var(--sp-2);
    color: inherit;
    text-decoration: none;
  }
