---
import { NAV_LINKS, type NavKey } from '../lib/nav';
import { getSite } from '../lib/site';
import '../vendor/react-bits/StaggeredMenu.css';

interface Props {
  current?: NavKey;
}

const { current } = Astro.props;
const { email, github } = await getSite();
const labels: Record<NavKey, string> = {
  index: 'Home', about: 'About', archive: 'Posts', links: 'Links', talks: 'Talks',
  guestbook: 'Wall', gallery: 'Album', forge: 'Forge', log: 'Log', tags: 'Tags',
};
const socialLinks = [
  { href: github, label: 'GitHub' },
  { href: `mailto:${email}`, label: 'Email' },
  { href: '/rss.xml', label: 'RSS' },
];
---

<button class="nav-trigger sm-toggle" type="button" lang="en" data-nav-open aria-label="Open menu" aria-haspopup="dialog" hidden>
  <span>Menu</span>
  <svg class="bars" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
    <path d="M1 7h12M7 1v12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  </svg>
</button>
<input type="checkbox" id="nav-toggle" class="navtog" aria-label="Open menu" aria-controls="site-menu" />
<label for="nav-toggle" class="navbtn sm-toggle" aria-hidden="true" lang="en">
  <span>Menu</span>
  <svg class="bars" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
    <path d="M1 7h12M7 1v12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  </svg>
</label>

<dialog class="navshell" id="site-menu" data-staggered-menu lang="en" aria-label="Site menu">
  <label for="nav-toggle" class="navmask" aria-hidden="true"></label>
  <nav class="navpanel staggered-menu-panel" aria-label="主导航">
    <label class="navclose sm-toggle" for="nav-toggle" aria-hidden="true">Close ×</label>
    <form method="dialog">
      <button class="navclose sm-toggle" type="submit" data-nav-close aria-label="Close menu" autofocus>Close ×</button>
    </form>
    <div class="sm-panel-inner">
      <ul class="sm-panel-list" data-numbering>
        {NAV_LINKS.map(link => (
          <li class="sm-panel-itemWrap">
            <a class="sm-panel-item" href={link.href} aria-current={current === link.key ? 'page' : undefined}>
              <span class="sm-panel-itemLabel">{labels[link.key]}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="sm-socials" aria-label="Social links">
        <h3 class="sm-socials-title">Socials</h3>
        <ul class="sm-socials-list">
          {socialLinks.map(link => (
            <li><a class="sm-socials-link" href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </nav>
</dialog>

<style is:global>
  @font-face {
    font-family: Geist;
    src: url('/fonts/geist-variable.woff2') format('woff2');
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
  }
  :is(.navbtn, .nav-trigger, .navshell, .site-staggered) {
    font-family: Geist, sans-serif;
    font-size: 1rem;
    letter-spacing: normal;
  }
  .navtog {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  .nav-trigger[hidden],
  .nav-trigger:not([hidden]) ~ :is(.navtog, .navbtn) { display: none; }
  :is(.navbtn, .nav-trigger, .site-staggered .sm-toggle) {
    padding: 0;
    color: inherit;
    white-space: nowrap;
  }
  /* 造物台与相册的页面级按钮字体会继承正文，菜单始终使用导航字体。 */
  body :is(button.nav-trigger, .navbtn, .navclose, .site-staggered .sm-toggle) {
    font: 500 1rem/1 Geist, sans-serif;
  }
  .nav-trigger[data-menu-mounted] { visibility: hidden; }
  /* 触区向外延伸，顶栏文字的位置和高度照旧。 */
  .nav-trigger::before {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--sp-4)) calc(-1 * var(--sp-2));
  }
  .nav-trigger:active { opacity: .72; }
  .navtog:focus-visible + .navbtn, .nav-trigger:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .navshell {
    position: fixed;
    inset: 0;
    overflow: hidden;
    visibility: hidden;
    pointer-events: none;
    z-index: 40;
  }
  .navmask {
    position: absolute;
    inset: 0;
  }
  .navshell .navpanel {
    position: absolute;
    pointer-events: none;
    /* 原生面板入场只移动位置，增强面板的透明度由其时间轴控制。 */
    opacity: 1;
    --sm-num-opacity: 1;
  }
  .navshell .navclose {
    position: absolute;
    /* ★ 2026-11-16（站主：「把抽屉里的 close 和原本其他页的 menu 对齐，现在 close 比 menu 高一点」）：
       Close 的文字纵向中心要压在顶栏 Menu 的文字中心上。实测（1440×900）：
       顶栏未滚动时 Menu 文字中心 31.5px ⇒ Close 的 1.5rem 顶边正好落在同一行；
       收成圆条后顶栏矮下去、Menu 跟着下移到 45.3px，所以滚动态再多让 13.8px。 */
    top: 1.5rem;
    right: 2rem;
    z-index: 1;
    color: var(--ink);
  }
  /* 圆条态：顶栏 padding 由 --topbar-pad-block 收到 --sp-1，Menu 随之整体下移。 */
  [data-topbar-scrolled] .navclose { top: 2.36rem; }
  .navtog:checked ~ .navshell { visibility: visible; display: block; }
  .navtog:checked ~ .navshell .navmask { pointer-events: auto; }
  .navtog:checked ~ .navshell .navpanel { pointer-events: auto; }
  .navshell[open] { visibility: visible; pointer-events: auto; }
  .navshell[open] .navpanel { pointer-events: auto; }
  @media (prefers-reduced-motion: no-preference) {
    .navtog:checked ~ .navshell .navpanel,
    .navshell[open] .navpanel {
      animation: nav-panel-in .65s var(--ease-glass);
    }
    @keyframes nav-panel-in {
      from { transform: translateX(100%); }
    }
  }
  .navshell [data-nav-close], .navshell[open] label { display: none; }
  .navshell[open] [data-nav-close] {
    display: inline-flex;
    right: var(--gutter);
    padding: 0;
  }
  .navshell[open] [data-nav-close]:focus-visible { outline-color: currentColor; }

  .site-menu-dialog {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 40;
  }
  :is(.site-menu-dialog, .navshell) {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }
  .site-menu-dialog:modal { pointer-events: auto; }
  :is(.site-menu-dialog, .navshell)::backdrop { background: transparent; }
  html:has(.site-menu-dialog:modal, .navshell[open], .navtog:checked) { overflow: hidden; }

  .site-staggered { line-height: 1.5; }
  .site-staggered .staggered-menu-header { padding: var(--sp-4) var(--gutter); }
  .site-staggered .sm-logo { display: none; }
  .site-staggered .sm-toggle {
    position: absolute;
    top: 0;
    right: 0;
  }
  .site-menu-dialog { --site-menu-toggle-ink: var(--site-menu-anchor-ink, var(--ink)); }
  .site-menu-dialog:has(.sm-toggle[aria-expanded='true']) { --site-menu-toggle-ink: var(--ink); }
  :is(.site-staggered, .navshell) .staggered-menu-panel {
    background: var(--nav-panel-surface);
    color: var(--ink);
    overscroll-behavior: contain;
  }
  :is(.site-staggered, .navshell) :is(.sm-panel-item, .sm-socials-link) { color: var(--ink); }
  :is(.site-staggered, .navshell) :is(.sm-panel-item, .sm-socials-link):is(:hover, :focus-visible, [aria-current='page']) {
    color: var(--accent-ink);
  }
  .site-staggered .sm-toggle:focus-visible { outline-color: currentColor; }
  :is(.site-staggered, .navshell) .sm-panel-item:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: -2px;
  }
  .navshell { --sm-accent: var(--accent-ink); }
  @media (min-width: 1025px) {
    :is(.site-staggered, .navshell) :is(.staggered-menu-panel, .sm-prelayers) {
      width: calc(100vw / 3);
    }
    :is(.site-staggered, .navshell) :is(.staggered-menu-panel, .sm-prelayer) {
      border-radius: var(--sp-2) 0 0 var(--sp-2);
    }
    .site-menu-dialog:modal .staggered-menu-panel,
    .navshell[open] .staggered-menu-panel,
    .navtog:checked ~ .navshell .staggered-menu-panel {
      box-shadow: -16px 0 42px var(--nav-panel-shadow);
    }
  }
  @media (max-width: 767px) {
    .navshell[open] [data-nav-close] { top: calc(var(--topbar-pad-block) + .4425rem); }
    [data-topbar-scrolled] .navshell[open] [data-nav-close] { top: calc(var(--sp-2) + var(--sp-1) + .4425rem); }
  }
</style>
