---
import type { CollectionEntry } from 'astro:content';
import ProjectVisual from './ProjectVisual.astro';
import ProjectGallery from './ProjectGallery.astro';
interface Props { project: CollectionEntry<'projects'>; index: number; }
const {project, index} = Astro.props, p = project.data;
---
<article class:list={['work-row', 'reveal', {'work-row-reverse':index % 2 === 1}]} id={`work-${project.id}`}>
  <ProjectVisual project={project} />
  <div class="work-copy"><span class="work-index mono">{String(index + 1).padStart(2,'0')} / {p.category}</span><h3><span data-project-card-title>{p.title}</span></h3><p class="work-line">{p.tagline}</p><p>{p.summary}</p><div class="work-tags"><span>{p.status}</span>{p.tags.map(tag => <span>{tag}</span>)}</div><a class="text-link" href={`/forge/${project.id}/`} data-project-open={project.id}>看看制作思路 <span>↗</span></a></div>
</article>
<dialog class="project-dialog" id={`project-${project.id}`} aria-labelledby={`title-${project.id}`}>
  <div class="dialog-scrim" aria-hidden="true"></div>
  <div class="dialog-scroll" data-scrollbar><div class="dialog-card"><button class="dialog-close" type="button" aria-label="关闭作品详情">关闭 <span>×</span></button><p class="eyebrow">{p.category} / {p.status}</p><h2 id={`title-${project.id}`}><span data-project-title>{p.title}</span><span class="heading-dot">.</span></h2><div class="dialog-hero" data-project-hero></div><p class="dialog-intro">{p.tagline}</p><ProjectGallery images={p.images} /><div class="dialog-copy"><slot /></div><div class="project-links">{p.links.map(link => <a class="dialog-link" href={link.href} target={link.href.startsWith('https:') ? '_blank' : undefined} rel={link.href.startsWith('https:') ? 'noopener noreferrer' : undefined}>{link.label}<span>↗</span></a>)}</div><a class="project-permalink" href={`/forge/${project.id}/`}>打开独立项目页 ↗</a></div></div>
  <div class="dialog-flight" aria-hidden="true" inert></div>
</dialog>
