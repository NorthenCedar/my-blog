---
import PhotoWall from './PhotoWall.astro';
import AlbumIndexHeading from './AlbumIndexHeading.astro';
import { scatterLayout } from '../scripts/album-scene-core';

type File = { w: number; h: number; actualW?: number; url: string };
type Frame = { alt: string; src: string; files: File[] };
type Album = { id: string; title: string; titleEn?: string; layout?: 'scatter' | 'slices' | 'wall'; date: string; total: number; frames: Frame[] };
interface Props { album: Album; no: number }
const { album, no } = Astro.props;
const layout = album.layout ?? 'scatter';
const placements = scatterLayout(album.id, album.frames.map((frame) => frame.src));
---

<section class="album-scene" data-album-scene data-layout={layout} data-placements={JSON.stringify(placements)}>
  <div class="scene-bar">
    <a class="scene-back liquid-glass" href="/gallery/#gallery-overview" data-album-return><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6"/></svg><span>相册</span></a>
    <span class="scene-name">{album.title}</span>
    <button class="liquid-glass" type="button" data-scene-toggle hidden aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></svg><span data-scene-toggle-label>查看全部</span></button>
  </div>
  <div class="scene-viewport" data-scene-viewport role="group" aria-label={`${album.title}，互动照片陈列`} aria-describedby="scene-help" tabindex="-1">
    <AlbumIndexHeading album={album} no={no} />
    <div class="scene-world" data-scene-world></div>
  </div>
  {/* 同一组真实链接和灯箱：增强时只把 .wf 放进画布，灯箱始终在变换层之外。 */}
  <PhotoWall albums={[album]} />
  <div class="scene-controls" data-scene-controls hidden>
    <p id="scene-help" data-scene-help></p>
    <div class="scene-actions">
      <button class="liquid-glass liquid-glass--round" type="button" data-scene-prev aria-label={layout === 'slices' ? '上一张' : '向左移动'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6"/></svg></button>
      <span class="scene-status" data-scene-status role="status" aria-live="polite">{album.total} 帧</span>
      <button class="liquid-glass liquid-glass--round" type="button" data-scene-next aria-label={layout === 'slices' ? '下一张' : '向右移动'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 6 6 6-6 6"/></svg></button>
      {layout === 'scatter' && <>
        <button class="liquid-glass liquid-glass--round" type="button" data-scene-zoom-out aria-label="缩小画布"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12h12"/></svg></button>
        <button class="liquid-glass liquid-glass--round" type="button" data-scene-zoom-in aria-label="放大画布"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12h12M12 6v12"/></svg></button>
      </>}
      <button class="liquid-glass liquid-glass--round" type="button" data-scene-home aria-label={layout === 'slices' ? '回到第一张' : '回到中心'} title={layout === 'slices' ? '回到第一张' : '回到中心'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10a8 8 0 1 1 1 7M4 4v6h6"/></svg></button>
    </div>
    {layout === 'slices' && album.total > 1 &&
      <div class="scene-ruler">
        <input data-scene-scrub type="range" min="1" max={album.total} value="1" aria-label="相册照片位置" />
      </div>
    }
  </div>
</section>

<style>
  .album-scene { position: relative; max-width: var(--wrap); margin: 0 auto; padding: var(--sp-7) var(--gutter) var(--sp-8); }
  .scene-bar { display: flex; align-items: center; gap: var(--sp-3); min-height: var(--scene-control-size); }
  .scene-back { color: var(--muted); text-decoration: none; }
  .scene-name { flex: 1; color: var(--muted); font-size: var(--fs-sm); }
  .scene-bar button, .scene-actions button {
    border: 1px solid var(--dark-glass-line-low); border-radius: var(--scene-button-radius);
    background: var(--dark-glass-bg); color: var(--on-band); padding: var(--sp-2) var(--sp-3);
    min-height: var(--scene-control-size); min-width: var(--scene-control-size);
    font: inherit; font-size: var(--fs-sm);
    transition: border-color var(--dur-hover) var(--ease-interact), background-color var(--dur-hover) var(--ease-interact);
  }
  .scene-bar button:hover, .scene-actions button:hover { border-color: var(--dark-glass-line); }
  .scene-actions button:hover:not(:disabled) { background: var(--dark-glass-bg-hot); }
  .scene-on .scene-back:focus-visible, .scene-bar button:focus-visible,
  .scene-actions button:focus-visible { outline: 2px solid var(--on-band); outline-offset: calc(-1 * var(--sp-1)); }
  .scene-actions button:disabled { color: var(--on-band-sub); opacity: var(--scene-disabled-opacity); }
  .scene-bar [hidden], .scene-controls[hidden] { display: none; }
  .scene-ruler {
    margin: 0 var(--sp-2);
    padding-inline: var(--sp-2);
    background: repeating-linear-gradient(90deg, var(--hair) 0 1px, transparent 1px 7px) center / 100% var(--sp-2) no-repeat;
    pointer-events: auto;
  }
  .scene-ruler input {
    display: block;
    width: 100%;
    height: var(--sp-4);
    margin: 0;
    appearance: none;
    background: transparent;
    cursor: pointer;
  }
  .scene-ruler input::-webkit-slider-thumb {
    appearance: none;
    width: var(--sp-2); height: var(--sp-3);
    border: 0; border-radius: 999px; background: var(--accent);
  }
  .scene-ruler input::-moz-range-thumb {
    width: var(--sp-2); height: var(--sp-3);
    border: 0; border-radius: 999px; background: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .scene-view-changed.scene-on .scene-viewport { animation: scene-exhibit-in 360ms var(--ease-glass) both; }
    .scene-view-changed:not(.scene-on) :global(.scene-title),
    .scene-view-changed:not(.scene-on) :global(.wf) { animation: scene-index-in 390ms var(--ease-glass) both; }
  }
  @keyframes scene-exhibit-in { from { opacity: 0.2; } }
  @keyframes scene-index-in { from { opacity: 0.18; translate: 0 var(--sp-2); } }
  .scene-controls { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); padding-block: var(--sp-3); border-top: 1px solid var(--hair); }
  .scene-controls p { margin: 0; font-size: var(--fs-xs); color: var(--muted); }
  .scene-actions { display: flex; align-items: center; gap: var(--sp-2); }
  .scene-status { min-width: var(--scene-status-width); text-align: center; font: var(--fs-xs) 'IBM Plex Mono', monospace; color: var(--muted); }

  :global(body.album-scene-active) { overflow: hidden; }
  :global(body.album-scene-active > .topbar), :global(body.album-scene-active > footer) { display: none; }
  .album-scene.scene-on { position: fixed; inset: 0; max-width: none; margin: 0; padding: 0; z-index: 2; }
  .scene-on .scene-bar { position: absolute; top: var(--sp-4); left: var(--sp-5); right: var(--sp-5); z-index: 4; }
  /* 画布控件共用暗玻璃，浅色照片和暗色底上都保留浅字；不支持模糊时用实底兜底。 */
  .scene-on .scene-back, .scene-on .scene-name,
  .scene-bar button, .scene-on .scene-controls p, .scene-on .scene-actions {
    border: 1px solid var(--dark-glass-line-low);
    border-top-color: var(--dark-glass-line);
    border-radius: var(--scene-button-radius);
    background: var(--code-bg); color: var(--on-band);
    -webkit-backdrop-filter: blur(var(--dark-glass-blur)) saturate(var(--dark-glass-sat));
    backdrop-filter: blur(var(--dark-glass-blur)) saturate(var(--dark-glass-sat));
    box-shadow: inset 0 1px 0 var(--dark-glass-line-low),
      inset 0 var(--sp-3) var(--sp-5) calc(-1 * var(--sp-3)) var(--dark-glass-glow),
      0 var(--sp-1) var(--sp-3) var(--dark-glass-drop);
  }
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .scene-on .scene-back, .scene-on .scene-name,
    .scene-bar button, .scene-on .scene-controls p, .scene-on .scene-actions {
      background: linear-gradient(var(--dark-glass-bg), var(--dark-glass-bg)),
        color-mix(in srgb, var(--code-bg) 72%, transparent);
    }
  }
  .scene-on .scene-back, .scene-on .scene-name {
    display: inline-flex; align-items: center;
    min-height: var(--scene-control-size); padding: var(--sp-2) var(--sp-3);
  }
  .scene-on .scene-name { flex: 0; white-space: nowrap; }
  .scene-on [data-scene-toggle] { margin-left: auto; }
  .scene-on .scene-controls {
    position: absolute; left: var(--sp-5); right: 316px; bottom: var(--sp-4);
    z-index: 4; border: 0; padding: 0; pointer-events: none;
  }
  .scene-on .scene-controls p, .scene-on .scene-actions { padding: var(--sp-2); }
  .scene-on .scene-controls p { min-width: 0; color: var(--on-band-sub); }
  .scene-on .scene-actions { pointer-events: auto; }
  .scene-on .scene-status { color: var(--on-band-sub); }
  .scene-on .scene-viewport {
    position: absolute; inset: 0; width: 100%; height: 100%; overflow: hidden;
    touch-action: pinch-zoom; user-select: none;
  }
  .scene-on .scene-world {
    position: absolute; left: 50%; top: 50%; width: 0; height: 0;
    transform: translate3d(var(--scene-pan-x, 0px), var(--scene-pan-y, 0px), 0) scale(var(--scene-scale, 1));
  }
  .scene-on :global(.scene-title) {
    position: absolute; width: var(--scene-title-width); padding: 0;
    transform: translate(-50%, -50%); pointer-events: none;
  }
  :global(.album-scene.scene-on .wf),
  :global(.album-scene.scene-on .wf .plate),
  :global(.album-scene.scene-on .wf .plate-body) { display: contents; transform-style: preserve-3d; }
  :global(.album-scene.scene-on .wf .plate-body > figure) {
    position: absolute; width: min(var(--scene-photo-width), calc(var(--scene-photo-height) * var(--scene-photo-ratio) + var(--scene-paper-edge) * 2)); margin: 0;
    transform: translate(calc(var(--scene-x) + var(--scene-drift-x, 0px) * var(--scene-depth)), calc(var(--scene-y) + var(--scene-drift-y, 0px) * var(--scene-depth))) translate(-50%, -50%) rotate(var(--scene-angle));
  }
  /* 定出图像比例才有可靠的 lazy 占位；花边只处理托纸，照片没有裁成统一格。 */
  :global(.album-scene.scene-on .wf .plate-body .frame) {
    box-sizing: content-box; aspect-ratio: auto; height: auto;
    width: min(calc(100% - var(--scene-paper-edge) * 2), calc(var(--scene-photo-height) * var(--scene-photo-ratio)));
    max-height: none; margin-inline: auto; padding: var(--scene-paper-edge);
    overflow: visible; background: transparent; filter: drop-shadow(var(--scene-paper-shadow));
  }
  :global(.album-scene.scene-on .wf .plate-body .frame::before) {
    content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background: var(--scene-photo-paper); mask-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20100%20100%22%20preserveAspectRatio%3D%22none%22%3E%3Cpath%20d%3D%22M2%201.5%20Q4%200%206%201.5%20T10%201.5%20T14%201.5%20T18%201.5%20T22%201.5%20T26%201.5%20T30%201.5%20T34%201.5%20T38%201.5%20T42%201.5%20T46%201.5%20T50%201.5%20T54%201.5%20T58%201.5%20T62%201.5%20T66%201.5%20T70%201.5%20T74%201.5%20T78%201.5%20T82%201.5%20T86%201.5%20T90%201.5%20T94%201.5%20T98%201.5%20Q100%202%2098.5%204%20Q100%206%2098.5%208%20T98.5%2012%20T98.5%2016%20T98.5%2020%20T98.5%2024%20T98.5%2028%20T98.5%2032%20T98.5%2036%20T98.5%2040%20T98.5%2044%20T98.5%2048%20T98.5%2052%20T98.5%2056%20T98.5%2060%20T98.5%2064%20T98.5%2068%20T98.5%2072%20T98.5%2076%20T98.5%2080%20T98.5%2084%20T98.5%2088%20T98.5%2092%20T98.5%2096%20Q100%20100%2096%2098.5%20Q94%20100%2092%2098.5%20T88%2098.5%20T84%2098.5%20T80%2098.5%20T76%2098.5%20T72%2098.5%20T68%2098.5%20T64%2098.5%20T60%2098.5%20T56%2098.5%20T52%2098.5%20T48%2098.5%20T44%2098.5%20T40%2098.5%20T36%2098.5%20T32%2098.5%20T28%2098.5%20T24%2098.5%20T20%2098.5%20T16%2098.5%20T12%2098.5%20T8%2098.5%20T4%2098.5%20Q0%20100%201.5%2096%20Q0%2094%201.5%2092%20T1.5%2088%20T1.5%2084%20T1.5%2080%20T1.5%2076%20T1.5%2072%20T1.5%2068%20T1.5%2064%20T1.5%2060%20T1.5%2056%20T1.5%2052%20T1.5%2048%20T1.5%2044%20T1.5%2040%20T1.5%2036%20T1.5%2032%20T1.5%2028%20T1.5%2024%20T1.5%2020%20T1.5%2016%20T1.5%2012%20T1.5%208%20T1.5%204%20Q0%200%202%201.5%20Z%22%2F%3E%3C%2Fsvg%3E"); mask-size: 100% 100%;
  }
  :global(.album-scene.scene-on .wf .plate-body img) {
    position: relative; z-index: 1; width: 100%; height: auto; max-height: none; max-width: 100%;
    aspect-ratio: var(--scene-photo-ratio);
    mask-image: linear-gradient(90deg, transparent, var(--ink) var(--scene-feather), var(--ink) calc(100% - var(--scene-feather)), transparent),
      linear-gradient(transparent, var(--ink) var(--scene-feather), var(--ink) calc(100% - var(--scene-feather)), transparent);
    mask-composite: intersect;
  }
  :global(.album-scene.scene-on .wf .plate-body .zoom) { display: none; }
  :global(.album-scene.scene-on .wf .plate-body .no) { background: transparent; left: 0; bottom: calc(-1 * var(--sp-4)); padding: 0; font-size: var(--fs-xs); }
  :global(.album-scene.scene-on .wf .plate-body figcaption) { text-align: right; max-width: 100%; margin-top: var(--sp-2); padding-left: var(--scene-caption-indent); }
  :global(.album-scene.scene-on .wf .plate-body figure:focus-within) { z-index: 2; }

  .scene-on[data-layout='slices'] .scene-viewport { perspective: var(--scene-perspective); touch-action: pan-y pinch-zoom; }
  .scene-on[data-layout='slices'] .scene-world { top: calc(50% + var(--scene-slice-center-shift)); transform: none; transform-style: preserve-3d; }
  .scene-on[data-layout='slices'] :global(.scene-title) { top: var(--sp-5); left: 50%; transform: translateX(-50%); width: min(var(--scene-title-width), calc(100vw - var(--gutter) * 2)); }
  :global(.album-scene.scene-on[data-layout='slices'] .wf .plate-body > figure) {
    width: min(var(--scene-slice-width), 74vw, calc(var(--scene-photo-height) * var(--scene-photo-ratio) + var(--scene-paper-edge) * 2));
    opacity: var(--scene-opacity, 0); transition: opacity var(--scene-fade-duration) var(--ease-interact);
    transform: translate3d(var(--scene-x), var(--scene-y), var(--scene-z)) translate(-50%, -50%) rotateY(var(--scene-angle));
  }
  :global(.album-scene.scene-on[data-layout='slices'] .wf .plate-body > figure[aria-hidden='true']) { pointer-events: none; }
  :global(.album-scene.scene-on[data-layout='slices'] .wf .plate-body > figure:focus-within) { z-index: auto; }
  @media (max-width: 680px) {
    .scene-name, .scene-on .scene-name { display: none; }
    .scene-bar { flex-wrap: wrap; }
    .scene-back { flex: 1; }
    .scene-controls { flex-direction: column; align-items: stretch; }
    .scene-actions { justify-content: center; flex-wrap: wrap; }
    .scene-controls p { text-align: center; }
    .scene-on .scene-bar { left: var(--sp-3); right: var(--sp-3); top: var(--sp-3); }
    .scene-on .scene-back { flex: 0; white-space: nowrap; }
    .scene-on .scene-controls { left: var(--sp-3); right: var(--sp-3); bottom: 84px; }
    .scene-on[data-layout='slices'] :global(.scene-title) { top: var(--scene-mobile-title-top); }
    :global(.album-scene.scene-on[data-layout='slices'] .wf .plate-body .frame) {
      width: min(calc(100% - var(--scene-paper-edge) * 2), calc(var(--scene-mobile-photo-height) * var(--scene-photo-ratio)));
    }
  }
  /* 紧凑镜片按钮：底部操作放在播放器正上方，提示退为轻文字。 */
  .scene-on .scene-bar{align-items:center;gap:var(--sp-2);}
  .scene-on .scene-back,.scene-on .scene-name,.scene-on .scene-bar button,.scene-on .scene-actions,.scene-on .scene-controls p{background:transparent;backdrop-filter:none;-webkit-backdrop-filter:none;border:0;box-shadow:none;color:var(--ink);}
  .scene-on .scene-back,.scene-on .scene-bar button{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:36px;padding:0 12px;border-radius:999px;font-size:12px;}
  .scene-on .scene-back.liquid-glass,.scene-on .scene-bar button.liquid-glass,.scene-on .scene-actions button.liquid-glass{box-shadow:none;}
  .scene-on .scene-name{font-size:11px;color:var(--muted);padding:0 6px;min-height:0;}
  .scene-on .scene-controls{position:absolute;left:auto;right:12px;bottom:78px;width:max-content;max-width:calc(100vw - 24px);display:block;padding:0;}
  .scene-on .scene-controls p{position:fixed;left:24px;bottom:20px;max-width:calc(100vw - 280px);padding:0;font-size:11px;color:var(--muted);pointer-events:none;}
  .scene-on .scene-actions{display:flex;align-items:center;justify-content:flex-end;gap:6px;padding:0;flex-wrap:nowrap;pointer-events:auto;}
  .scene-on .scene-actions button{display:grid;place-items:center;width:36px;height:36px;min-width:36px;min-height:36px;padding:0;border:0;border-radius:50%;color:var(--ink);background:transparent;}
  .scene-on .scene-actions button:hover:not(:disabled),.scene-on .scene-bar button:hover{background:var(--liquid-sheen);}
  .scene-on .scene-actions button:disabled{opacity:.3;}
  .scene-on .scene-status{min-width:42px;font-size:11px;color:var(--muted);}
  .scene-on .scene-actions svg,.scene-on .scene-bar svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round;}
  .scene-on .scene-back:focus-visible,.scene-on .scene-bar button:focus-visible,.scene-on .scene-actions button:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}
  @media(max-width:680px){.scene-on .scene-controls{right:12px;bottom:78px;}.scene-on .scene-controls p{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);}.scene-on .scene-actions{gap:5px;}.scene-on .scene-actions button{width:38px;height:38px;min-width:38px;min-height:38px;}.scene-on .scene-bar button,.scene-on .scene-back{min-height:40px;}}
  .scene-bar .scene-back.liquid-glass,.scene-bar button.liquid-glass{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:36px;padding:0 12px;border:0;border-radius:999px;color:var(--ink);background:var(--liquid-tint);backdrop-filter:none;-webkit-backdrop-filter:none;box-shadow:none;font-size:12px;text-decoration:none;}
  .scene-bar svg{width:16px;height:16px;flex-shrink:0;fill:none;stroke:currentColor;stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round;}
  @media(max-width:680px){.scene-bar .scene-back.liquid-glass,.scene-bar button.liquid-glass{min-height:40px;}}
</style>

<script>
  import '../scripts/album-scene';
</script>
