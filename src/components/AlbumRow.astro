---
/**
 * 相册入口条 ALBUM ROW（2026-10-07）—— `/gallery` 页「原来铺开照片的那一块」的新形态。
 *
 * 站主原话：
 *   「下面**不放现在全部铺开的**，放**入口**，类似这样的，**有几个文件夹就放几个**，
 *     就像现在有三个一样，**以后我加文件夹推送后也要同步多一个**，
 *     我给的那个入口**默认第一张是放大的**，点其他张那一张放大，之前放大的缩小，
 *     记得要有**流畅的过渡动画**，点击**放大的照片**就**进入这个文件夹**，
 *     就像现在本站的照片砖墙一样，**不过是单独的一页**」
 *
 * ⇒ 一条 = 一个相册。上面是板头一行编目（板号 · 相册名 · 帧数 · 日期，相册名可点），
 *   下面是一条**手风琴**：默认第一张放大，点别的张它放大、原来那张缩回细条；
 *   **点放大那张**才进相册页 `/gallery/<册名>/`（砖墙，独立成页，见 PhotoWall.astro）。
 *
 * ── 为什么"有几个文件夹就放几个"是真的（不用手工同步）────────────────
 *   相册清单从 public/gallery/manifest.json 读，而 manifest 由
 *   `npm run build` 的第一步（scripts/gen-gallery-webp.mjs）从 content/gallery/ 扫出来。
 *   ⇒ 站主往 content/gallery/ 丢一个新文件夹 + 推上去，这一页自己就多一条，
 *     相册页也自己多一页（getStaticPaths 同一份清单）。**这里没有一处写死"3"**。
 *
 * ── 一条里最多几张（2026-10-07 站主：「不要这样叠好多张，最大 15 张」）────
 *   原来一条 = **整册的每一帧**（第一册 57 张 ⇒ 57 个细条）。
 *   实测那不是"密"，是**渲染噪点**：每条只有 12.2px 宽，照片被压成 12px 的竖切面，
 *   连成一条看不出内容的彩色锯齿（第二册 15 张时每条 57.8px，同样 15 个细条就好看得多 ——
 *   差别只在槽宽）。⇒ 上限 `MAX = 15`。
 *   ★ 取哪 15 张：**等距抽样**，含首尾（`round(k·(total−1)/(MAX−1))`）。
 *     - 取前 15 张会让 57 帧的册看起来"只有开头那点"，与板头的「57 帧」对不上；
 *     - 抽样后编号显示的仍是**册内真实序号**（001, 005, 009 … 057），
 *       所以「点开那条」落进相册页后看到的仍是这一册的全片，不会"少了几张"。
 *   ★ `--ar-n` 与 `.ar-item` 的数量都按**抽样后**的数算 ⇒ 条宽算式自动跟着变，
 *     硬编码常数一个都不加。
 *
 * ── 退化（无 JS）────────────────────────────────────────────────
 *   CSS 让 `:first-child` 就是放大态 ⇒ 版面与有 JS 时**逐字节相同**；
 *   只是点任意一张都直接进相册页（不会先放大）。这是刻意的：
 *   入口条是**导航**，不该"没有 JS 就不能用"。
 *   ★ 脚本给容器挂 `.ar-on` 之后，放大态改由 `.on` 决定 ——
 *     两条规则是互斥的（`:not(.ar-on)` / `.ar-on`），否则切走之后第一张会赖着不缩回去。
 *
 * ── 与显影板的关系 ───────────────────────────────────────────────
 *   整屏显影板（src/scripts/develop.ts）的取片源就是这些条里的 `<figure>`（`data-bath-src`）：
 *   它划过哪一张就显哪一张。砖墙搬去相册页之后，这一页的素材池只剩这里 ——
 *   所以那个钩子**必须留**（契约在 tests/develop-bath.test.ts）。
 */
import manifest from '../../public/gallery/manifest.json';

interface Props {
  album: {
    id: string;
    title: string;
    date: string;
    total: number;
    frames: { alt: string; src: string; files: { w: number; h: number; url: string }[] }[];
  };
  /** 板号：相册在清单里的**固定位次**（编目号，不随任何筛选/排序变） */
  no: number;
}

type File = { w: number; h: number; url: string };
type Frame = { alt: string; src: string; files: File[] };

const { album, no } = Astro.props;

/* 相册页的地址。★ 册名是中文 ⇒ 走 encodeURIComponent（站上 /tags/<中文>/ 同一条口径）。
   它在 URL 上与磁盘上的图片目录**同名**：图片就在 /gallery/<册名>/01-800.webp
   ⇒「进入这个文件夹」这句话在地址栏上也成立。 */
const href = `/gallery/${encodeURIComponent(album.id)}/`;

const GRID_W = Math.min(...manifest.widths);
const at = (f: Frame, w: number) => f.files.find((x) => x.w === w) ?? f.files[0];
const pad2 = (n: number) => String(n).padStart(2, '0');
const pad3 = (n: number) => String(n).padStart(3, '0');

/* ★★ 一条里最多几张（见文件头「一条里最多几张」）。抽样**含首尾**，
   步长 `round(k·(total−1)/(MAX−1))` ⇒ 57 帧的那册取到 001 / 005 / … / 057，
   编号仍是册内真实序号（不是 001…015 的假连续）。 */
const MAX = 15;
const pick = (() => {
    const all = album.frames.map((f, i) => ({ f, i }));   // i = 册内下标（0 起）
    if (all.length <= MAX) return all;
    const out: { f: Frame; i: number }[] = [];
    for (let k = 0; k < MAX; k++) {
      const i = Math.round((k * (all.length - 1)) / (MAX - 1));
      if (out.length === 0 || out[out.length - 1].i !== i) out.push(all[i]);
    }
    return out;
  })();

/* ★ 算式里的分母是 (n − 1)：**1 张的相册**会让它变成 0 ⇒ 整条 width 失效。
   夹到 2 只是为了算式成立（1 张时那唯一一条永远处于放大态，宽度由 .on 那条规则给）。
   ★ n 取**抽样后**的长度 —— 57 帧那册也只按 15 算条宽（否则每条会窄到 12px）。 */
const n = Math.max(2, pick.length);
/* 抽样跳号时（001 / 005 / …）要在图注里说明这一条取的是本册第几张，
   否则「001 005 009 …」会被读成"缺号了"。窄槽藏掉编号、只有放大那张露出来。 */
const skipped = pick.length < album.total;
---

<section class="plate" data-plate={album.id} data-album-row={album.id} aria-labelledby={`plate-${no}`}>
  <header class="plate-hd">
    <p class="plate-no">板 {pad2(no)}</p>
    <h2 class="plate-title" id={`plate-${no}`}>
      <a class="plate-link" href={href}>{album.title}</a>
    </h2>
    <p class="plate-meta">
      <span>{album.total} 帧</span>
      {skipped && <span title={`这条只取了本册 ${pick.length} 张（每隔若干帧取一张），点进去看全部 ${album.total} 张`}>取样 {pick.length}</span>}
      <span>{album.date}</span>
    </p>
  </header>

  {/* data-bath-src：显影板的素材池（见文件头）。role="group" + aria-label 说明这一条是什么。 */}
  <div
    class="ar"
    data-ar
    data-bath-src
    style={`--ar-n:${n}`}
    role="group"
    aria-label={`${album.title}：${album.total} 张${skipped ? `，这条取样 ${pick.length} 张` : ''}，点放大那张进入`}
  >
    {pick.map(({ f, i }, k) => {
      const g = at(f, GRID_W);
      return (
        <figure
          class="ar-item"
          data-ar-item={k}
          data-album={album.id}
          data-album-title={album.title}
          data-cap={f.alt}
        >
          {/* ★ 每一张的 href 都指向**同一个相册页** —— 所以"哪一张在放大态"纯粹是视觉状态，
              键盘 Enter 永远落在正确的目的地，不存在"看着是 A、点下去进 B"的错位。
              ★ 不加 data-no-transition：这是真跳转（对比砖墙那条 —— 那次点击被灯箱接管了）。
              ★★ 不放任何「进入」按钮（站主 2026-10-07：「别加这个进入按钮，点大图就直接进」）：
              **放大那张本身就是链接**，多一个按钮只是把同一个目的地说了两遍，
              还会压在照片上、悬停时抢戏。行动召唤＝照片本身。
              ★★ 刻意**不加** `aria-label`：它会**顶掉 `img` 的 `alt`**
                （同一个元素上aria-label 优先），读屏就只听到"进入相册"、听不到照片是什么了。
                "点它会跳走"这句话由容器那条 `role="group"` 的 `aria-label` 一次性说清。 */}
          <a class="ar-frame" href={href}>
            <img src={g.url} width={g.w} height={g.h} alt={f.alt} loading="lazy" decoding="async" />
          </a>
          {/* 图注：细条上是**尺子刻度**（本册第几张），放大那张上多了照片说明。
              aria-hidden —— 图片自己的 alt 已经说过一遍了。 */}
          <figcaption class="ar-cap">
            <span class="ar-cap-no" aria-hidden="true">{pad3(i + 1)}</span>
            <em class="ar-cap-alt" aria-hidden="true">{f.alt}</em>
            {skipped && <em class="ar-cap-skip" aria-hidden="true">抽样</em>}
          </figcaption>
        </figure>
      );
    })}
  </div>
</section>

<style>
  /* ===== 板头：与砖墙同一套编目视觉（板号 · 相册名 · 帧数 · 日期）。
     它现在只出现在这里 —— 相册页的页头承担了同一组信息，那边不再重复印一行。 ===== */
  .plate {
    border-top: 1px solid var(--ink);   /* 上沿 = 一张纸的纸边（承托面靠这条线 + 留白，不靠染色） */
    padding-top: var(--sp-4);
    margin-bottom: var(--sp-8);
  }
  .plate-hd {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    margin-bottom: var(--sp-5);
  }
  .plate-no {
    margin: 0;
    font-family: "IBM Plex Mono", Consolas, "Courier New", monospace;
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    color: var(--accent-ink);
    font-variant-numeric: tabular-nums;
  }
  .plate-title {
    /* 站上 h2 的默认档会带上外边距 ⇒ 这里显式归零，只受本行 flex 控制 */
    margin: 0;
    font-size: var(--fs-h2);
    line-height: 1.2;
    font-weight: 700;
  }
  .plate-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-interact);
  }
  .plate-link:hover,
  .plate-link:focus-visible {
    color: var(--accent-ink);
  }
  .plate-meta {
    /* 读数靠右：`margin-left:auto` 在 flex 里把它推到行尾（窄屏 wrap 后自然落到下一行左起） */
    margin: 0 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    font-family: "IBM Plex Mono", Consolas, "Courier New", monospace;
    font-size: var(--fs-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* ===== 手风琴条 ===== */
  .ar {
    /* 放大那张的宽度。★ 百分比 ⇒ 窄屏自己收窄，不用为每个断点写一条。 */
    --ar-open: clamp(190px, 30%, 380px);
    --ar-gap: 3px;
    /* 照片的高度：放大那张与细条**同高**（高度不参与过渡 ⇒ 整条行不会上下抽动） */
    --ar-h: clamp(88px, 11vw, 152px);
    display: flex;
    align-items: flex-start;
    gap: var(--ar-gap);
  }
  .ar-item {
    margin: 0;
    min-width: 0;
    /* ★★ 关着的每一条**均分剩余空间** —— 算式里带着本册帧数（--ar-n）。
       所以「57 张的一册」与「10 张的一册」都是"正好铺满一行"，
       加相册、换断点都不必重算任何常数（写死条宽的话 57 张那一行会横向溢出）。
       ★ `max(0px, …)`：剩余空间为负时（窄屏 + 很多张）宽度落在 0，
         视觉上是**极细的梳齿**（参考图本来就是这个质感），不溢出、不横向滚动条。 */
    width: max(0px, calc((100% - var(--ar-open) - (var(--ar-n) - 1) * var(--ar-gap)) / (var(--ar-n) - 1)));
    /* ★ 容器查询单位（cqw）要用在下面那条 font-size 上 ⇒ 每条自己是一个 size container。
       它只有一个量：这一条有多宽。编号的字号跟着它缩，永远塞得进（见 .ar-cap-no）。 */
    container-type: inline-size;
  }
  /* ★★ 放大态。两条规则**互斥**（`:not(.ar-on)` / `.ar-on`）：
     无 JS 时是第一条（第一张放大），脚本到位后挂上 .ar-on，改由 .on 决定。
     两条若同时生效，切到第 5 张之后第一张会赖着不缩回去。 */
  .ar:not(.ar-on) .ar-item:first-child,
  .ar.ar-on .ar-item.on {
    width: var(--ar-open);
  }
  /* 过渡：只动 width。★ 两个受影响的那条（涨的、缩的）用同一条曲线同时长/短，
     和恒为 `--ar-open + 其余之和` ⇒ 过渡过程中**总宽一分不差**，不会挤一下再弹回来。
     ★ 站规：动效一律可撤 —— reduce 的读者直接切换，没有中间态。 */
  @media (prefers-reduced-motion: no-preference) {
    .ar-item {
      transition: width var(--dur-enter) var(--ease-interact);
    }
  }

  .ar-frame {
    position: relative;
    display: block;
    height: var(--ar-h);
    overflow: hidden;
    background: var(--deco-plate-fine);   /* 图没到之前是极淡绿洗，够看出"这儿有一条" */
    text-decoration: none;
    /* ★★★ 圆角＝**胶囊**（站主 2026-10-07 第二轮追认：「变圆角是让那些照片的四个角
       变成有弧度的，像胶囊一样」）。
       第一版给的是 `min(3px, 0.5cqw)` —— 那是**削角**，四个角只切掉 3px，
       细条上（57.8px 宽）半径算出来只有 0.289px，肉眼根本看不出弧度，等于没做。

       ★★★ 分两档（站主 2026-10-07 第三轮：「小图可以，大图的圆角小一点」）：
       - **细条**（关着的那些，57.8px 宽）＝ **胶囊** `999px`。
         浏览器把 999px 按框的**短边各自夹到一半** ⇒ 57.8×152 的框得到 28.9px 半径，
         正好是"细长胶囊"的比例（长短轴比 ≈ 1 : 2.6）。
       - **放大那张**（365×152）＝ **6px 小圆角**。若也用 999px，半径会被夹到 76px
         （长短轴比 1 : 2.4），观感上是一个"胖胶囊"，把照片的边角吃掉太多 ——
         目检实拍确认：那样的大图显得像按钮，不像照片。
       两条规则与"放大态"那两条**同样互斥**（`:not(.ar-on)` / `.ar-on`），
       否则切走之后第一张会保留 6px 而与其它细条不一致。
       ★ 为什么不用 `50%`：`50%` 在**非正方形**框上是椭圆而不是胶囊
         （横竖各按 50% 解析），细条会变成一个瘦长的椭圆而不是"胶囊"。
       ★ 落在**框**上而不是 img：框是 overflow:hidden 的那层，
         `cover` 裁出来的切面四角自然跟着切。 */
    border-radius: 999px;
    /* 悬停抬升需要一条过渡（transform/box-shadow 两项）。
       ★ 时长用 --dur-hover(260ms) + --ease-interact —— 与全站 hover 基线同一口径
         （hover.css §4 的卡片/条目三件套就是这一对）。 */
    transition:
      transform var(--dur-hover) var(--ease-interact),
      box-shadow var(--dur-hover) var(--ease-interact);
  }
  .ar-frame img {
    display: block;
    width: 100%;
    height: 100%;
    /* ★★ 细条**必须裁**：一条十几 px 宽的槽要的是"照片的一条竖切面"（参考图就是这样），
       换成 contain 会把整张照片压成一根发丝，什么都认不出。
       ⇒ 这是本站**唯一**允许 object-fit 的地方。档案视图那一侧仍然一律不裁，
         有门闩守着 `.plate-body` 整块没有它（tests/gallery-plate.test.ts）。 */
    object-fit: cover;
    object-position: center;
    /* ★ 悬停时照片轻微推近（1.03，与砖墙那条 .plate-body hover 同一幅度）。
       **不做**饱和度/亮度之类的滤镜 —— 照片是档案，不该被改色。 */
    transition: transform var(--dur-hover) var(--ease-interact);
  }
  /* 悬停/焦点：照片推近 + 框抬起来（影子）+ 绿框，三件同时。
     ★ 抬升用 --hover-lift（−2px，hover.css 的既有 token，不另造）。
       `z-index` 必须在悬停时提上来，否则抬起的那条会被右邻压住（DOM 顺序靠前的在下面）。
     ★ 不再有那个「进入」按钮的悬停露头层（按钮已删）：
       提示改由**绿框转浓 + 照片推近 + 抬升**三件承担。 */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .ar-frame:hover,
    .ar-frame:focus-visible {
      transform: translateY(calc(var(--hover-lift) * -1));
      box-shadow: var(--glass-shadow);
      z-index: 2;
    }
    .ar-frame:hover img,
    .ar-frame:focus-visible img {
      transform: scale(1.03);
    }
  }
  /* 绿框：常态一圈**很淡**的绿（"这一条是入口"），悬停/焦点时转浓。
     outline 不占布局 ⇒ 不影响 --ar-n 的条宽算式。 */
  .ar-frame:hover,
  .ar-frame:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: -1px;
  }
  .ar-frame:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  /* ★★★ 圆角分两档：**放大那张给小圆角，其余细条保持胶囊**。
     选择器与"放大态"那两条同构（`:not(.ar-on)` / `.ar-on`）—— 必须互斥，
     否则切走之后第一张会留着 6px，与左右那些胶囊不一致。
     ⚠ 顺序要紧：这两条**必须**在 `.ar-frame { border-radius: 999px }` 之后
       （同特异性下后者才会被这两条覆盖）。 */
  .ar:not(.ar-on) .ar-item:first-child .ar-frame,
  .ar.ar-on .ar-item.on .ar-frame {
    /* 365×152 的框上给 6px：长短轴比 1 : 1.9，看起来是"照片"而不是"按钮"
       （999px 在同一框上会被夹到 76px ⇒ 长短轴比 1 : 2.4，胖得像药丸）。 */
    border-radius: 6px;
  }

  /* 图注行：一行高，**高度固定** ⇒ 放大/缩小时这行不参与过渡，整条行不会上下跳。 */
  .ar-cap {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin-top: var(--sp-1);
    font-family: "IBM Plex Mono", Consolas, "Courier New", monospace;
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: var(--muted);
    overflow: hidden;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  /* ★★ 编号要跟着**这一条的宽度**缩：`cqw` = 容器（.ar-item）宽度的 1%。
     三位数字在等宽字体里是 1.8em 宽 ⇒ 字号取容器宽的 55% 时正好塞满并留一点边，
     再用 min() 压在上限 0.6rem 之下（宽条不会把编号放大到离谱）。
     ⇒ 一册 57 张（每条约 13px）与一册 10 张（每条约 80px）都**塞得进**，不裁字。 */
  .ar-cap-no {
    font-size: min(0.6rem, 55cqw);
    letter-spacing: 0;
  }
  /* ★★★ …但"塞得进"不等于"读得出"。目检实测（2026-10-07）：
     一册 57 张时每条只有 12.2px 宽 ⇒ 编号被压到 6.7px，
     57 个连排就是**一条灰色虚线污迹**（680 档更窄，污迹更明显）——
     看着像渲染没干净，不是信息。第二册（每条 57.8px）同样的编号却很好看。
     ⇒ 按**本槽宽度**决定印不印（`.ar-item` 本来就是 inline-size 容器）：
       加相册、换断点都不必改这里，判据是读者能不能读。
     ★★ 必须用 `visibility`，**不许** `display: none`：
       display:none 会让这一条的图注行不生成行盒 → 高度塌成 0 ⇒
       切换放大态时整条入口行会上下跳约 19px（与"高度固定、不参与过渡"那条设计相反）。
       visibility 隐藏文字但保留行盒，高度一分不变。 */
  @container (max-width: 20px) {
    .ar-cap-no {
      visibility: hidden;
    }
  }
  /* 照片说明只在**放大那张**上出现（细条上放不下，也没必要 —— 那一条本来就是刻度）。 */
  .ar-cap-alt {
    display: none;
    font-style: normal;
    font-size: 0.6rem;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ar:not(.ar-on) .ar-item:first-child .ar-cap-alt,
  .ar.ar-on .ar-item.on .ar-cap-alt {
    display: block;
  }
  .ar:not(.ar-on) .ar-item:first-child .ar-cap-no,
  .ar.ar-on .ar-item.on .ar-cap-no {
    font-size: var(--fs-xs);   /* 放大那张的编号回到正文档（它不再受条宽约束） */
    color: var(--accent-ink);
  }
  /* 「抽样」只在**放大那张**上出现：它说明"这条只有 15 张，不是全册"。
     细条上不出现（细条只有十几 px，本来就藏了编号）。
     ★ 位置排在照片说明**之后** —— 它是脚注，不是标题。 */
  .ar-cap-skip {
    display: none;
    margin-left: auto;
    padding-left: 0.4rem;
    font-style: normal;
    font-size: 0.6rem;
    color: var(--muted);
    letter-spacing: 0.08em;
    flex-shrink: 0;
  }
  .ar:not(.ar-on) .ar-item:first-child .ar-cap-skip,
  .ar.ar-on .ar-item.on .ar-cap-skip {
    display: block;
  }

  @media (max-width: 680px) {
    .ar {
      --ar-open: clamp(150px, 46%, 260px);
      --ar-gap: 2px;
      --ar-h: clamp(74px, 22vw, 110px);
    }
    .plate {
      margin-bottom: var(--sp-7);
    }
    .plate-hd {
      margin-bottom: var(--sp-4);
    }
  }
</style>

<script>
  /* 入口条：点**关着**的那张 ⇒ 只放大（不跳转）；点**放大**的那张 ⇒ 照常进相册页。
     一行只有一个入口，所有条目的 href 指向同一个相册页 ⇒ 哪一张在放大态纯粹是视觉状态。 */
  (() => {
    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-ar]'));

    /* ★★ 焦点激活必须区分**指针**与**键盘**：
       Chrome 里点链接的过程是 pointerdown → focus → click。
       若 focus 无条件激活，等 click 跑到的时候 `i === cur` 已经成立
       ⇒ 第一次点击会变成"直接进相册"（站主要的是"先放大"）。
       所以记一个最近一次指针按下的时刻，250ms 内的 focus 一律不算键盘。 */
    let pointerAt = -1e9;
    document.addEventListener('pointerdown', () => { pointerAt = performance.now(); }, true);

    for (const row of rows) {
      const items = Array.from(row.querySelectorAll<HTMLElement>('[data-ar-item]'));
      if (items.length === 0) continue;

      let cur = 0;
      const focus = (i: number) => {
        if (i === cur || !items[i]) return;
        items[cur].classList.remove('on');
        cur = i;
        items[cur].classList.add('on');
      };

      items[0].classList.add('on');
      row.classList.add('ar-on');   // ⇒ 放大态从此由 .on 决定（CSS 那两条规则互斥）

      items.forEach((it, i) => {
        const a = it.querySelector('a')!;
        a.addEventListener('click', (e) => {
          if (i === cur) return;      // 放大态 = 真链接 ⇒ 放行，进相册页
          e.preventDefault();
          focus(i);
        });
        a.addEventListener('focus', () => {
          if (performance.now() - pointerAt < 250) return;   // 指针点出来的焦点不算键盘
          focus(i);
        });
        a.addEventListener('keydown', (e) => {
          if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
          e.preventDefault();   // ← → 在条内是"挪一条"，不是滚页面
          const next = e.key === 'ArrowRight' ? Math.min(i + 1, items.length - 1) : Math.max(i - 1, 0);
          items[next].querySelector('a')?.focus();
        });
      });
    }
  })();
</script>
