---
import type { PostMeta } from '../lib/post-meta';
import DraftBadge from './DraftBadge.astro';

interface Props {
  post: PostMeta;
}
const { post } = Astro.props;
---
<p class="meta">
  <time datetime={post.date}>{post.date}</time>
  {post.updated && <span>更新于 <time datetime={post.updated}>{post.updated}</time></span>}
  <span>{post.charCount.toLocaleString('zh-CN')} 字</span>
  <span>约 {post.readingMinutes} 分钟</span>
  {post.draft && <DraftBadge />}
  {post.tags.map((t) => <span class="tag">{t}</span>)}
</p>

<style>
  /* 故意不用 · 连接元信息（那是生成页面的默认零件，design-spec.md §2），靠 gap 分组。
     日期与数字用正文字族 + tabular-nums，等宽族只留给代码。 */
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    margin: 0;
    font-size: var(--fs-xs);
    /* 颜色由外壳提供变量、组件自己声明（站主 2026-09-26 拍板 A：不跨组件覆盖）。
       默认值仍是深色带那套，所以 chrome='band' 下行为完全不变；
       内页外壳（Topbar）会把 --meta-color 设成 --muted。
       为什么必须这么改：文章页迁到浅底后，若继续用 --on-band-meta（深色带专用浅色），
       就是"浅灰压浅底"，肉眼一眼看得出、断言不一定覆盖。 */
    color: var(--meta-color, var(--on-band-meta));
    font-variant-numeric: tabular-nums;
  }
  .tag {
    color: var(--meta-sub, var(--on-band-sub));
  }
</style>
