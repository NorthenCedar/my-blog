---
/**
 * 跟手光标：白色中心点 + 半透明圆盘 + 点击涟漪（站主 2026-09-26 定的最终形态）
 *
 * 形态：**半透明圆盘**跟着指针缓动，盘心是**白色小点**（点不缓动，它就是指针本身）；
 * 原生光标全站隐藏（`cursor:none`），所以"光标"= 这个白点。悬停可点元素时圆盘缩小、变稠、描边转绿。
 * 站上曾经有过一枚 PRTS「正常选择」的位图光标，2026-09-27 站主让删了（"有时会蹦出来"——
 * 它只在 JS 加上 `html.cursor-none` 之后才被顶掉）。现在：**有 JS = 这个白点；没 JS = 系统光标**。
 *
 * 两处为了本站是**纸白底**（参考图那套是在深蓝底上做的，白给白会看不见）：
 *   · 白点带一圈发丝深色描边、圆盘用**极淡墨色纱**而不是半透明白 —— 这样"盘比点暗"的关系成立，
 *     白点才读得出来（参考图的观感正是靠这个关系，不是靠绝对颜色）
 *   · 深底（代码块/控制台）上纱几乎不可见，白点自然发光 ✓ 两边都读得出
 *
 * `cursor:none` 由 **JS 加类**（`html.cursor-none`）而不是写死在 CSS：脚本被拦时不至于"一个光标都没有"
 * （那时用的是系统光标，见 src/styles/base.css 的说明）。
 *
 * 层级 66/65/64：在开场覆盖层（60）之上 —— 原生光标已被隐藏，指针标记必须始终可见。
 */
---

<div class="cr-disc" aria-hidden="true"></div>
<div class="cr-dot" aria-hidden="true"></div>
<div class="cr-ripple" aria-hidden="true"></div>

<style>
  .cr-disc,
  .cr-dot,
  .cr-ripple {
    position: fixed;
    top: 0;
    left: 0;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    will-change: transform;
  }
  .cr-disc {
    z-index: 65;
    width: 34px;
    height: 34px;
    /* 盘用**极淡墨色纱**而不是半透明白：本站是纸白底，白盘在白底上看不见，
       而白点又需要"比盘更亮"才读得出来（参考图那种关系：盘偏暗、点亮）。 */
    border: 1px solid var(--cursor-disc-line);
    background: var(--cursor-disc-fill);
    transition:
      width 0.25s,
      height 0.25s,
      background-color 0.25s,
      border-color 0.25s;
  }
  /* 悬停到可点元素：缩小 + 变稠 + 描边转绿（参考实现的 hold 状态） */
  .cr-disc.is-hot {
    width: 22px;
    height: 22px;
    border-color: var(--accent-ink);
    background: var(--cursor-disc-hot-fill);
  }
  .cr-dot {
    z-index: 66;
    width: 8px;
    height: 8px;
    /* 白点 + 发丝深色边：纸面上"白上白"会消失，这圈边只是保证它读得出来 */
    background: var(--cursor-dot);
    box-shadow: 0 0 0 1px var(--cursor-dot-line);
  }
  .cr-ripple {
    z-index: 64;
    width: 68px;
    height: 68px;
    border: 2px solid var(--cursor-ripple);
    box-shadow: 0 0 0 1px var(--cursor-ripple-line);
    /* 位置走 --x/--y，scale 写在同一串 transform 里 —— 见文件底部注释：把 scale 当独立属性会连位移一起放大 */
    transform: translate3d(var(--x, 0px), var(--y, 0px), 0) translate(-50%, -50%) scale(1);
  }
  .cr-ripple.is-on {
    animation: cr-ripple 0.5s cubic-bezier(0.22, 0.61, 0.21, 1) forwards;
  }
  /* ⚠️ scale 必须写在 transform 串里（不能当独立属性）：独立属性与 transform 合成时位移会被一起放大，
     实测点击在 (500,300) 的涟漪圆心会一路飞到 (1152,672) —— 站主肉眼看到的就是"往右下角飞"。 */
  @keyframes cr-ripple {
    from {
      opacity: 0.85;
      transform: translate3d(var(--x, 0px), var(--y, 0px), 0) translate(-50%, -50%) scale(1);
    }
    to {
      opacity: 0;
      transform: translate3d(var(--x, 0px), var(--y, 0px), 0) translate(-50%, -50%) scale(2.4);
    }
  }
  /* 原生光标隐藏（`html.cursor-none *`）**必须写在全局样式 base.css 里**，不能在这里：
     Astro 会把组件样式作用域化成 `html.cursor-none [data-astro-cid-…]`，那样只有本组件那三个元素被隐藏，
     其余元素只能靠继承拿 none —— 而链接有 UA 的 `a{cursor:pointer}` 声明，继承会被它压过（实测链接上仍是箭头）。
     base.css 里那条带完整来龙去脉。 */
  /* 有 JS 且在动鼠标时才显形（用类控制，别用内联 opacity —— 内联会压过样式表） */
  html.cursor-live .cr-disc,
  html.cursor-live .cr-dot {
    opacity: 1;
  }
  /* 减少动态效果 / 触摸设备：整个效果不出现，也不加 cursor-none（JS 侧直接返回） */
  @media (prefers-reduced-motion: reduce), (hover: none) {
    .cr-disc,
    .cr-dot,
    .cr-ripple {
      display: none;
    }
  }
</style>

<script>

import { onPage } from '../scripts/page-lifecycle';
onPage(({document, addEventListener, matchMedia, requestAnimationFrame, MutationObserver}) => {

  (() => {
    const root = document.documentElement;
    const disc = document.querySelector('.cr-disc');
    const dot = document.querySelector('.cr-dot');
    const ripple = document.querySelector('.cr-ripple');
    if (!disc || !dot || !ripple) return;
    // 触摸设备与减少动态效果：不做（也**不加** cursor-none —— 那样会把原生光标藏掉却没有替代品）
    if (!matchMedia('(hover: hover)').matches || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.classList.add('cursor-none');

    // 原生 modal 位于浏览器顶层，普通页面的 z-index 再高也不能覆盖它。
    // 迁移同一组装饰节点，关闭/移除后归还 body；坐标仍由 fixed 定位指向视口。
    const layers = [disc, dot, ripple];
    const syncModalLayer = () => {
      // 访客界面只允许同时打开一个弹窗。
      const host = document.querySelector('dialog[open]') ?? document.body;
      for (const layer of layers) if (layer.parentNode !== host) host.append(layer);
    };
    // attributeFilter 已使属性观察默认开启，不监听每一帧的 style 变化。
    new MutationObserver(syncModalLayer).observe(document.body, { subtree: true, childList: true, attributeFilter: ['open'] });
    syncModalLayer();

    const HOT = 'a,button,input,textarea,select,summary,[role="button"],[role="tab"],[data-rail]';
    let x = 0;
    let y = 0;
    let tx = 0;
    let ty = 0;
    let raf = 0;
    let seen = false;
    const put = (el, a, b) => { el.style.transform = `translate3d(${a}px,${b}px,0) translate(-50%,-50%)`; };
    const step = () => {
      x += (tx - x) * 0.3;
      y += (ty - y) * 0.3;
      put(disc, x, y);
      raf = Math.abs(tx - x) > 0.2 || Math.abs(ty - y) > 0.2 ? requestAnimationFrame(step) : 0;
    };
    addEventListener(
      'pointermove',
      (e) => {
        tx = e.clientX;
        ty = e.clientY;
        put(dot, tx, ty); // 白点不缓动：它就是指针本身
        if (!seen) {
          seen = true;
          x = tx;
          y = ty;
          root.classList.add('cursor-live'); // 第一次移动前不显形，否则会从左上角滑过来
        }
        // 悬停可点元素：盘缩小 + 描边转绿（给"这里能点"的反馈）。文字上不再特殊处理 ——
        // 站主要的就是"页面上只有白点"，所以点与盘在任何地方都显形。
        if (e.target instanceof Element) disc.classList.toggle('is-hot', !!e.target.closest(HOT));
        if (!raf) raf = requestAnimationFrame(step);
      },
      { passive: true },
    );
    addEventListener(
      'pointerdown',
      (e) => {
        ripple.style.setProperty('--x', e.clientX + 'px');
        ripple.style.setProperty('--y', e.clientY + 'px');
        ripple.classList.remove('is-on');
        void ripple.offsetWidth; // 强制回流：同一位置连点也能重放
        ripple.classList.add('is-on');
      },
      { passive: true },
    );
  })();

},".cr-disc");
</script>
