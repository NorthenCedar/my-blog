---
interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---
<ul class="chips">
  {tags.map((t) => (
    <li><a href={`/tags/${encodeURIComponent(t)}/`}>{t}</a></li>
  ))}
</ul>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .chips a {
    font-size: var(--fs-xs);
    color: var(--muted);
    text-decoration: none;
    border: 1px solid var(--hair);
    padding: 0 var(--sp-2);
  }
  .chips a:hover {
    color: var(--accent-ink);
    border-color: var(--accent-ink);
  }
</style>
