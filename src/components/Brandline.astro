---
interface Props {
  current?: 'index' | 'tags' | 'archive' | 'about';
  name: string;
  wordmark: string;
}
const { current, name, wordmark } = Astro.props;
const links: { href: string; label: string; key: Props['current'] }[] = [
  { href: '/', label: '文章', key: 'index' },
  { href: '/tags/', label: '标签', key: 'tags' },
  { href: '/archive/', label: '归档', key: 'archive' },
  { href: '/about/', label: '关于', key: 'about' },
];
---
<div class="brandline">
  <a class="wm" href="/">{name}</a>
  <span class="sub">{wordmark}</span>
  <nav aria-label="主导航">
    {links.map((l) => (
      <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
    ))}
    <a href="/rss.xml">RSS</a>
  </nav>
</div>

<style>
  .brandline {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .wm {
    color: var(--on-band);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--fs-body);
  }
  .sub {
    font-size: var(--fs-xs);
    color: var(--on-band-meta);
  }
  nav {
    margin-left: auto;
  }
  nav a {
    color: var(--on-band-sub);
    font-size: var(--fs-xs);
    text-decoration: none;
    margin-left: var(--sp-4);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--on-band);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
</style>
