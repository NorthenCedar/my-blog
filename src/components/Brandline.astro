---
import type { NavKey } from '../lib/nav';
import NavDrawer from './NavDrawer.astro';

interface Props {
  current?: NavKey;
  name: string;
  wordmark: string;
}
const { current, name, wordmark } = Astro.props;
---
<div class="brandline">
  <a class="wm" href="/">{name}</a>
  <span class="sub">{wordmark}</span>
  <NavDrawer current={current} />
</div>

<style>
  .brandline {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .wm {
    color: var(--on-band);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--fs-body);
  }
  .sub {
    font-size: var(--fs-xs);
    color: var(--on-band-meta);
  }
  .brandline > :global(:is(.navbtn, .nav-trigger)) { margin-inline-start: auto; }
</style>
