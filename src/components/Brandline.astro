---
import { NAV_LINKS, type NavKey } from '../lib/nav';

interface Props {
  current?: NavKey;
  name: string;
  wordmark: string;
}
const { current, name, wordmark } = Astro.props;
// 链接清单在 src/lib/nav.ts（内页顶栏 Topbar 用的是同一份，避免两套外壳漂移）
const links = NAV_LINKS;
---
<div class="brandline">
  <a class="wm" href="/">{name}</a>
  <span class="sub">{wordmark}</span>
  <nav aria-label="主导航">
    {links.map((l) => (
      <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
    ))}
    <a href="/rss.xml">RSS</a>
  </nav>
</div>

<style>
  .brandline {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .wm {
    color: var(--on-band);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--fs-body);
  }
  .sub {
    font-size: var(--fs-xs);
    color: var(--on-band-meta);
  }
  nav {
    margin-left: auto;
  }
  nav a {
    color: var(--on-band-sub);
    font-size: var(--fs-xs);
    text-decoration: none;
    margin-left: var(--sp-4);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--on-band);
    /* 深色带上用亮绿：--accent 的深绿对 --ink 只有 3.43:1，
       够非文字门槛但不够 4.5；--accent-bright 是 6.26:1 */
    box-shadow: inset 0 -2px 0 var(--accent-bright);
  }
</style>
