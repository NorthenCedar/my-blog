---
interface Props {
  name: string;
  email: string;
  github: string;
}
const { name, email, github } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap">
    <span>© {year} {name}</span>
    <span class="links">
      <a href={`mailto:${email}`}>{email}</a>
      <a href={github} rel="me noopener">GitHub</a>
      <a href="/rss.xml">RSS</a>
    </span>
  </div>
</footer>

<style>
  .foot {
    background: var(--ink);
    color: var(--on-band-meta);
    padding: var(--sp-5) 0 var(--sp-6);
    font-size: var(--fs-xs);
  }
  .wrap {
    max-width: var(--wrap);
    margin: 0 auto;
    padding-inline: var(--gutter);
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .links a {
    color: var(--on-band-sub);
    margin-left: var(--sp-4);
  }
  .links a:hover {
    /* 13px 小字，必须用 AA 达标的 --accent-ink（5.18:1）。
       --accent 对白只有 3.68:1，只许用在 ≥24px 文字或非文字图形上（design-spec §3.1）。 */
    color: var(--accent-ink);
  }
</style>
