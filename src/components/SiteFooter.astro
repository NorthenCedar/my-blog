---
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap">
    <span>© {year} 北杉札记</span>
    <span class="links">
      <a href="mailto:a13655515876@163.com">a13655515876@163.com</a>
      <a href="https://github.com/NorthenCedar" rel="me noopener">GitHub</a>
      <a href="/rss.xml">RSS</a>
    </span>
  </div>
</footer>

<style>
  .foot {
    background: var(--ink);
    color: var(--on-band-meta);
    padding: var(--sp-5) 0 var(--sp-6);
    font-size: var(--fs-xs);
  }
  .wrap {
    max-width: var(--wrap);
    margin: 0 auto;
    padding-inline: var(--gutter);
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .links a {
    color: var(--on-band-sub);
    margin-left: var(--sp-4);
  }
  .links a:hover {
    color: var(--accent);
  }
</style>
