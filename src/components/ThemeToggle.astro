---
/**
 * Jelly Slider 主题切换按钮 —— 原版 WebGPU 实现（Software Mansion / TypeGPU，MIT）。
 * 原版代码在 src/vendor/jelly-slider/（三处本站改动见各文件 ★ 标注），
 * 接入逻辑在 src/scripts/theme-toggle.ts，主题契约见 src/scripts/theme.ts。
 *
 * ★ 2026-11-12 站主：「把关于页这个改亮色暗色的按钮移到顶部导航拦，不要影子了」。
 *   ⇒ 三件事一起改：
 *     · 位置：从关于页的 `.theme-dock`（绝对定位在场景右上）搬进 `components/Topbar.astro`，
 *       于是**所有内页**都能切主题，不再只有关于页有；
 *     · 形态：新增 `variant="nav"` —— 画布仍是 220×200（内部渲染尺寸一个字没动，
 *       改了会拉伸，见 theme-toggle.ts 的 W/H 注释），但用一个 52px 高的窗口
 *       把中间那条软条裁出来（上下本来全是透明），按 0.8 缩放塞进 46px 高的顶栏；
 *     · 影子：ground 那一层不再输出不透明度（`src/vendor/jelly-slider/scene.ts`），
 *       软条下面那片软影没有了，裁切边界上也就不会留一条硬线。
 * 顶栏先用原生按钮显示静态软条，图像取自本站 Jelly Slider 的两个 WebGPU 稳态。
 * 原版的透明凹槽、亮档暖橘和暗档墨绿在减少动效或无法增强时也会显示。
 * 指针靠近或点按后才按需加载可拖动的果冻渲染器。
 * 无障碍：role=switch + aria-checked + 键盘可操作；canvas 纯装饰 aria-hidden。
 */
interface Props {
  /** 'dock' = 关于页那种原尺寸；'nav' = 顶栏用的裁切小窗。 */
  variant?: 'dock' | 'nav';
}
const { variant = 'dock' } = Astro.props;
---
<button
  class:list={['theme-toggle', variant === 'nav' && 'theme-toggle--nav']}
  type="button"
  data-theme-toggle
  role="switch"
  aria-checked="false"
  aria-label="切换深色模式"
  title="切换深色 / 浅色"
  tabindex="0"
>
  <span class="tt-soft-strip" aria-hidden="true"></span>
  <canvas aria-hidden="true" width="220" height="200"></canvas>
</button>
<script>
import { onPage } from '../scripts/page-lifecycle';
import { setTheme } from '../scripts/theme';
onPage(({ document, addEventListener, matchMedia }) => {
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (!button) return;
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  const dark = () => document.documentElement.classList.contains('dark');
  const sync = () => button.setAttribute('aria-checked', String(dark()));
  let renderer: AbortController | undefined;
  const stop = () => { renderer?.abort(); renderer = undefined; };
  const boot = () => {
    if (renderer || motion.matches || !('gpu' in navigator)) return;
    const current = new AbortController();
    renderer = current;
    void import('../scripts/theme-toggle')
      .then(({ initJellyThemeToggle }) => initJellyThemeToggle(button, current.signal))
      .catch(() => current.abort());
  };
  button.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse') boot(); });
  button.addEventListener('click', event => {
    // 画布收到的指针手势由果冻处理，原生按钮负责基础点按与键盘点击。
    if (event.target instanceof HTMLCanvasElement) return;
    setTheme(dark() ? 'light' : 'dark');
    if (event.detail > 0) boot();
  });
  document.addEventListener('themechange', sync);
  motion.addEventListener('change', stop);
  addEventListener('pagehide', stop);
  sync();
  return stop;
}, '[data-theme-toggle]');
</script>
<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    flex: none;
    position: relative;
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    border-radius: 12px;
    outline-offset: 3px;
  }
  .theme-toggle canvas {
    display: block;
    visibility: hidden;
    width: 220px;
    /* ★★ 2026-10-17 第四轮：76 → 104（站主：「亮的时候软条的影子被截断了，让影子也可以透到
       下面来」）。影子是从软条往下铺的一大片软影，76px 的画布把它在下边界**硬切成一条直线**。
       ⇒ 画布加高 28px，给影子留出物理空间；同时 scene.ts 把 fov 23° → 31.1°、
       相机 target 下移 0.28 —— 三处是一组（加高改了宽高比，不调 fov 槽会变宽溢出，
       不下移相机则槽会悬在画面正中、下方空间仍然不够）。
       ⚠ 改这个高度必须同步 `src/pages/about.astro` 的 `.about-side { padding-top }`，
         按包含负外边距的实际占高留白（当前 200 - 32 = 168px）。 */
    /* 上下各扩展 32px；向上抵消新增取景，按钮留在原位，下方交给完整投影。 */
    height: 200px;
    margin-top: -32px;
    touch-action: none;
    /* ★★ 2026-10-17 第五轮：这一块仍然**只管尺寸**，别往这里加任何遮罩。
       历史（每次都失败，别重走）：
         · 第三轮试过 CSS `mask-image` 羽化 —— 带 SVG filter 的遮罩会让 canvas 被
           低分辨率合成、整块糊掉（`_tt-M1-knob.png`）；
         · 第三轮还在 blit 阶段按亮度抠过像、第四轮删掉，因为"地面 = 纸色、色差归零"
           当时看起来不需要透明度。
       ★ 第五轮站主定案：「直接把按钮背景改透明，影子直接出现在关于页的背景上」
         ⇒ 透明是真的做了，但**不在 CSS 这一层**：画布 `alphaMode: 'premultiplied'`，
           地面只画影（见 scene.ts 的 `renderBackground` / blit 注释）。CSS 里若再叠遮罩，
           会和着色器里的 alpha 相乘，出现双重淡出的一圈亮环。 */
    /* ★ 2026-10-17：这里**不写** `cursor: grab`（原来有）。站主口径：「光标确实不要，
       只显示站内的那个圆形光标」—— 站上那枚跟手圆点由 `html.cursor-none,
       html.cursor-none *{cursor:none}` 全局接管，任何 `cursor:` 都是重复的暗示，
       而 `grab`（抓取手）与"拖动果冻"这件事对不上，还不在测试允许的那几个值里。
       ⚠ 减少动效档（下面那条）**必须留着**：那一档站内圆点不注册（`cursor-none`
       不会被加上），没有任何提示会让按钮看起来像一块死图 —— 这是无障碍要求，
       不是风格选择。 */
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
  }
  /* ★ 2026-11-12：顶栏用的小窗版本。
     画布内部仍是 220×200（渲染尺寸写在 theme-toggle.ts，改这里不会改渲染），
     canvas 本地 y≈56…108 那一条正好是软条 —— 用一个 52px 的窗口把它裁出来，
     上下两截（本来就是透明）不占顶栏高度。
     `--tt-s` 是整体缩放：顶栏 46px 高，0.8 时窗口 41.6px；手机档再缩到 0.58。 */
  .theme-toggle--nav {
    --tt-s: 0.8;
    position: relative;
    flex: none;
    width: calc(220px * var(--tt-s));
    height: calc(52px * var(--tt-s));
    overflow: hidden;
  }
  .theme-toggle--nav canvas {
    position: absolute;
    left: 0;
    top: calc(-56px * var(--tt-s));
    width: 220px;
    height: 200px;
    margin: 0;
    transform: scale(var(--tt-s));
    transform-origin: 0 0;
  }
  @media (max-width: 767px) {
    .theme-toggle--nav { --tt-s: 0.58; }
  }
  /* 双帧按画布 y=56…108 原样裁切。原尺寸下的窗口起点是 56 − 32。 */
  .tt-soft-strip {
    position: absolute;
    left: 0;
    top: 24px;
    width: 220px;
    height: 52px;
    background: url('../assets/theme-soft-strip.webp') top / 100% 200% no-repeat;
    pointer-events: none;
  }
  .theme-toggle--nav .tt-soft-strip { inset: 0; width: auto; height: auto; }
  :global(html.dark) .tt-soft-strip { background-position: bottom; }
  .theme-toggle[data-tt-ready] canvas { visibility: inherit; }
  .theme-toggle[data-tt-ready] .tt-soft-strip { visibility: hidden; }
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle {
      cursor: pointer;
    }
  }
</style>
