---
/**
 * Jelly Slider 主题切换按钮 —— 原版 WebGPU 实现（Software Mansion / TypeGPU，MIT）。
 * 原版代码在 src/vendor/jelly-slider/（三处本站改动见各文件 ★ 标注），
 * 接入逻辑在 src/scripts/theme-toggle.ts，主题契约见 src/scripts/theme.ts。
 *
 * ★ 2026-11-12 站主：「把关于页这个改亮色暗色的按钮移到顶部导航拦，不要影子了」。
 *   ⇒ 三件事一起改：
 *     · 位置：从关于页的 `.theme-dock`（绝对定位在场景右上）搬进 `components/Topbar.astro`，
 *       于是**所有内页**都能切主题，不再只有关于页有；
 *     · 形态：新增 `variant="nav"` —— 画布仍是 220×200（内部渲染尺寸一个字没动，
 *       改了会拉伸，见 theme-toggle.ts 的 W/H 注释），但用一个 52px 高的窗口
 *       把中间那条软条裁出来（上下本来全是透明），按 0.8 缩放塞进 46px 高的顶栏；
 *     · 影子：ground 那一层不再输出不透明度（`src/vendor/jelly-slider/scene.ts`），
 *       软条下面那片软影没有了，裁切边界上也就不会留一条硬线。
 *   ⚠ 懒加载保留：那个 ~459 KB 的渲染器 chunk 仍然只在**空闲时**拉，且只拉一次。
 *
 * 无 WebGPU 的浏览器降级为普通文字开关（主题照样切）。
 * 无障碍：role=switch + aria-checked + 键盘可操作；canvas 纯装饰 aria-hidden。
 */
interface Props {
  /** 'dock' = 关于页那种原尺寸；'nav' = 顶栏用的裁切小窗。 */
  variant?: 'dock' | 'nav';
}
const { variant = 'dock' } = Astro.props;
---
<div
  class:list={['theme-toggle', variant === 'nav' && 'theme-toggle--nav']}
  data-theme-toggle
  role="switch"
  aria-checked="false"
  aria-label="切换深色模式"
  title="切换深色 / 浅色"
  tabindex="0"
>
  <canvas aria-hidden="true" width="220" height="200"></canvas>
</div>
<script>

import { onPage } from '../scripts/page-lifecycle';
onPage(({document, window, addEventListener, setTimeout}) => {

  /* ★ 2026-10-17 懒加载（站主：「只在放按钮的那几页懒加载它」）。
     渲染器是 ~460 KB 的 chunk（TypeGPU + 光追场景），不该挡关于页首屏。
     `import()` 是**动态**的 ⇒ Astro/Vite 把它切成独立 chunk，只有真调到这一行才下载。
     ⚠ 用 `requestIdleCallback` 而不是"第一次交互时再拉"：后者会让第一次摸到按钮时
       画布还是空的，观感是"点不动"；空闲加载则通常在用户看清标题之前就位。
       `timeout` 是上界：用户一直在滚也会在 2.5 s 内拉起来（Safari 没有 rIC ⇒ 退回 setTimeout）。 */
  type IdleWindow = Window & {
    requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => number;
  };
  const boot = () => {
    const el = document.querySelector<HTMLElement>('[data-theme-toggle]');
    if (!el || el.dataset.ttInit) return;
    el.dataset.ttInit = '1';
    void import('../scripts/theme-toggle')
      .then((m) => m.initJellyThemeToggle(el))
      .catch(() => {
        /* chunk 拉不下来（离线 / 被拦）⇒ 画布保持空白；
           降级 pill 也由那个模块创建，所以这里不补 —— 别在控制台吓唬访客 */
      });
  };
  const schedule = () => {
    const w = window as IdleWindow;
    if (typeof w.requestIdleCallback === 'function') w.requestIdleCallback(boot, { timeout: 2500 });
    else setTimeout(boot, 1200);
  };
  if (document.readyState === 'complete') schedule();
  else window.addEventListener('load', schedule, { once: true });

},"[data-theme-toggle]");
</script>
<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    flex: none;
    border-radius: 12px;
    outline-offset: 3px;
  }
  .theme-toggle canvas {
    display: block;
    width: 220px;
    /* ★★ 2026-10-17 第四轮：76 → 104（站主：「亮的时候软条的影子被截断了，让影子也可以透到
       下面来」）。影子是从软条往下铺的一大片软影，76px 的画布把它在下边界**硬切成一条直线**。
       ⇒ 画布加高 28px，给影子留出物理空间；同时 scene.ts 把 fov 23° → 31.1°、
       相机 target 下移 0.28 —— 三处是一组（加高改了宽高比，不调 fov 槽会变宽溢出，
       不下移相机则槽会悬在画面正中、下方空间仍然不够）。
       ⚠ 改这个高度必须同步 `src/pages/about.astro` 的 `.about-side { padding-top }`，
         按包含负外边距的实际占高留白（当前 200 - 32 = 168px）。 */
    /* 上下各扩展 32px；向上抵消新增取景，按钮留在原位，下方交给完整投影。 */
    height: 200px;
    margin-top: -32px;
    touch-action: none;
    /* ★★ 2026-10-17 第五轮：这一块仍然**只管尺寸**，别往这里加任何遮罩。
       历史（每次都失败，别重走）：
         · 第三轮试过 CSS `mask-image` 羽化 —— 带 SVG filter 的遮罩会让 canvas 被
           低分辨率合成、整块糊掉（`_tt-M1-knob.png`）；
         · 第三轮还在 blit 阶段按亮度抠过像、第四轮删掉，因为"地面 = 纸色、色差归零"
           当时看起来不需要透明度。
       ★ 第五轮站主定案：「直接把按钮背景改透明，影子直接出现在关于页的背景上」
         ⇒ 透明是真的做了，但**不在 CSS 这一层**：画布 `alphaMode: 'premultiplied'`，
           地面只画影（见 scene.ts 的 `renderBackground` / blit 注释）。CSS 里若再叠遮罩，
           会和着色器里的 alpha 相乘，出现双重淡出的一圈亮环。 */
    /* ★ 2026-10-17：这里**不写** `cursor: grab`（原来有）。站主口径：「光标确实不要，
       只显示站内的那个圆形光标」—— 站上那枚跟手圆点由 `html.cursor-none,
       html.cursor-none *{cursor:none}` 全局接管，任何 `cursor:` 都是重复的暗示，
       而 `grab`（抓取手）与"拖动果冻"这件事对不上，还不在测试允许的那几个值里。
       ⚠ 减少动效档（下面那条）**必须留着**：那一档站内圆点不注册（`cursor-none`
       不会被加上），没有任何提示会让按钮看起来像一块死图 —— 这是无障碍要求，
       不是风格选择。 */
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
  }
  /* ★ 2026-11-12：顶栏用的小窗版本。
     画布内部仍是 220×200（渲染尺寸写在 theme-toggle.ts，改这里不会改渲染），
     canvas 本地 y≈56…108 那一条正好是软条 —— 用一个 52px 的窗口把它裁出来，
     上下两截（本来就是透明）不占顶栏高度。
     `--tt-s` 是整体缩放：顶栏 46px 高，0.8 时窗口 41.6px；手机档再缩到 0.58。 */
  .theme-toggle--nav {
    --tt-s: 0.8;
    position: relative;
    flex: none;
    width: calc(220px * var(--tt-s));
    height: calc(52px * var(--tt-s));
    overflow: hidden;
  }
  .theme-toggle--nav canvas {
    position: absolute;
    left: 0;
    top: calc(-56px * var(--tt-s));
    width: 220px;
    height: 200px;
    margin: 0;
    transform: scale(var(--tt-s));
    transform-origin: 0 0;
  }
  @media (max-width: 767px) {
    .theme-toggle--nav { --tt-s: 0.58; }
  }
  /* 无 WebGPU 降级开关：极简 pill，不伪装成果冻 */
  .theme-toggle :global(.tt-fallback) {
    min-width: 3.2rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--hair);
    background: var(--panel);
    color: var(--ink);
    font: inherit;
    cursor: pointer;
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle canvas {
      cursor: pointer;
    }
  }
</style>
