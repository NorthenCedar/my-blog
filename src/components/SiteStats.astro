---
/**
 * 页脚统计：本站已运行 + 总访问量（PV）/ 总访客数（UV）。站主 2026-09-26 要求"在每页最底部"，
 * 由 SiteFooter 渲染。运行时长由客户端计算，PV/UV 由服务器提供。
 */
interface Props {
  since: string;
  /** 深色底（内页页脚）用 on-band 配色；浅色底（首页）用 ink/muted */
  tone?: 'band' | 'paper';
}
const { since, tone = 'band' } = Astro.props;
const sinceISO = /^\d{4}-\d{2}-\d{2}$/.test(since) ? since : '2026-09-25';
---
<div class="stats" data-stats data-since={sinceISO} data-tone={tone}>
  <span>本站已经运行 <span data-uptime>—</span></span>
  <span class="counts">
    总访问量（PV）：<span data-pv>—</span> ｜ 总访客数（UV）：<span data-uv>—</span>
  </span>
</div>

<style>
  .stats {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
  }
  .stats[data-tone='band'] {
    color: var(--on-band-sub);
  }
  .stats[data-tone='band'] [data-uptime],
  .stats[data-tone='band'] [data-pv],
  .stats[data-tone='band'] [data-uv] {
    color: var(--on-band);
  }
  .stats[data-tone='paper'] {
    color: var(--muted);
  }
  .stats[data-tone='paper'] [data-uptime],
  .stats[data-tone='paper'] [data-pv],
  .stats[data-tone='paper'] [data-uv] {
    color: var(--ink);
  }
  @media (max-width: 767px) {
    .stats {
      flex-direction: column;
      gap: 0.3em;
    }
  }
</style>

<script>
  import '../scripts/site-stats';
</script>
