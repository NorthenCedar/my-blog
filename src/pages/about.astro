-link:hover{background:var(--about-hover);color:var(--accent)}.copy-status{font-size:11px;color:var(--accent);position:absolute;bottom:-30px;right:0}.next-scene{position:absolute;bottom:34px;left:0;display:flex;align-items:center;gap:30px;font-size:12px;color:var(--accent)}.next-scene>span:last-child{border:1px solid var(--about-line);border-radius:50%;width:34px;height:34px;display:grid;place-items:center}
.technology-scene{grid-template-columns:.9fr 1.1fr;min-height:115svh;padding-top:140px;padding-bottom:140px}.technology-scene .scene-caption{right:auto;left:0;text-align:left}.kicker{font-size:13px;color:var(--accent);margin-bottom:24px;letter-spacing:.08em}.section-title{font-size:clamp(42px,4.5vw,66px);margin-bottom:40px}.stack-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 26px}.stack-group h3{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;font-size:14px;font-weight:400;color:var(--accent);margin-bottom:12px}.stack-group h3 small{font-size:10px;color:var(--muted)}.stack-group li{font-size:13px;line-height:1.95;margin-bottom:8px;padding-left:10px;position:relative;overflow-wrap:anywhere}.stack-group li:before{content:'';position:absolute;left:0;top:.82em;background:var(--accent);width:3px;height:3px}.group-2{grid-column:1/-1;padding-top:23px;border-top:1px solid var(--about-line)}.group-2 ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:26px}.language-scene{min-height:110svh}.language-scene .section-title{margin-bottom:24px}.section-intro{font-size:14px;color:var(--muted);margin-bottom:28px}.language-overview{height:7px;display:flex;gap:3px;border-radius:3px;overflow:hidden;margin-bottom:30px}.language-overview span{flex-basis:0;min-width:1px}.language-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:23px 35px}.language-label{display:flex;justify-content:space-between;gap:10px;align-items:baseline;font-size:15px;font-variant-numeric:tabular-nums}.language-label>span:last-child{color:var(--accent-ink);font-size:24px;line-height:1.4}.language-label small{font-size:11px;margin-left:2px}.language-meter{height:3px;background:var(--about-line);margin:8px 0 6px}.language-meter i{display:block;height:100%;min-width:1px}.lang-bytes{font-size:10px;color:var(--muted);font-variant-numeric:tabular-nums}.stats-scope{margin-top:27px;border-top:1px solid var(--about-line);padding-top:15px;font-size:12px;color:var(--muted)}.stats-scope summary{cursor:pointer;list-style:none}.stats-scope summary:after{content:'＋';float:right;color:var(--accent)}.stats-scope[open] summary:after{content:'－'}.stats-scope p{font-size:12px;line-height:1.9;margin-top:13px}
.personal{display:grid;grid-template-columns:.8fr 1.2fr;gap:90px;padding:100px 0;border-top:1px solid var(--about-line);background:transparent;position:relative;z-index:2}.personal h2{font-size:42px}.personal-copy>p{font-size:14px;color:var(--muted);line-height:2;max-width:45em}.interests{display:flex;gap:14px 24px;flex-wrap:wrap;font-size:12px;margin-top:24px;color:var(--accent)}.read-link{display:inline-block;font-size:12px;color:var(--accent);border-bottom:1px solid var(--accent);margin-top:25px;padding-bottom:6px}.chapter-nav{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);padding:5px 8px;border:1px solid var(--about-line);border-radius:35px;background:var(--about-glass);backdrop-filter:blur(16px);box-shadow:0 5px 25px var(--about-shade);z-index:8;display:flex;gap:4px;max-width:calc(100vw - 2 * var(--sp-2))}.chapter-nav a{position:relative;font-size:12px;white-space:nowrap;min-width:0;text-align:center;padding:8px 13px;border-radius:24px;color:var(--ink);text-decoration:none;transition:color var(--dur-hover) var(--ease-interact)}.chapter-nav a[aria-current=true]{background:var(--accent);color:var(--paper)}
@media(min-width:1600px){.scene{gap:100px}.stack-group li{font-size:15px}.intro{font-size:17px}.section-intro{font-size:16px}.language-label{font-size:17px}.lang-bytes{font-size:12px}.social-link>span:nth-child(2){font-size:18px}}
@media(max-width:1000px){.scene{gap:35px}.social-link{gap:10px}.social-list{column-gap:20px}.social-link>span:nth-child(2){font-size:14px}.intro{font-size:14px}.section-title{font-size:43px}.stack-group li{font-size:12px}.stack-group h3 small{display:none}.personal{gap:40px}.language-label{font-size:13px}.language-list{column-gap:23px}}
@media(max-width:767px){.topbar{padding:18px 24px}.brand{font-size:14px;gap:9px}.brand>span{font-size:30px}.topbar nav{gap:15px;font-size:11px}main{padding:0 24px}.scene{display:flex;flex-direction:column;align-items:stretch;gap:0;min-height:0;padding:95px 0 75px}.social-scene{padding-top:88px;padding-bottom:83px}.profile-mark{margin-bottom:25px}.profile-mark img{width:46px;height:46px}.profile-mark p{font-size:12px}.profile-mark p span{font-size:10px}h1{font-size:clamp(45px,12vw,68px)}.intro{font-size:14px;max-width:24em}.social-heading{margin-top:30px}.social-heading h2{font-size:13px}.social-link{padding:14px 0;gap:12px}.social-link>span:nth-child(2){font-size:16px}.social-link small{font-size:10px}.social-list{column-gap:24px}.social-icon{width:22px}.social-icon :global(svg){width:22px;height:22px}.visit{font-size:16px}.scene-space{min-height:280px;width:100%;margin-top:35px}.scene-caption{right:0;bottom:0;font-size:11px}.next-scene{bottom:20px;gap:22px;font-size:11px}.technology-scene .scene-copy{order:0}.technology-scene .scene-space{order:1;margin-top:20px;min-height:280px}.kicker{font-size:12px;margin-bottom:22px}.section-title{font-size:clamp(36px,10.4vw,58px);margin-bottom:32px}.stack-groups{column-gap:24px;row-gap:24px}.stack-group li{font-size:13px;line-height:1.95;margin-bottom:10px}.stack-group h3{font-size:14px}.group-2{padding-top:22px}.group-2 ul{column-gap:24px}.language-scene .scene-space{min-height:300px;margin-top:35px}.section-intro{font-size:14px;line-height:1.9}.language-label{font-size:14px}.language-label>span:last-child{font-size:23px}.language-list{gap:22px 28px}.lang-bytes{font-size:10px}.language-overview{margin-bottom:29px}.stats-scope{font-size:11px}.stats-scope p{font-size:11px}.personal{display:block;padding:65px 0 60px}.personal h2{font-size:35px}.personal .kicker{margin-bottom:16px}.personal-copy{margin-top:25px}.personal-copy>p{font-size:13px;line-height:2}.interests{font-size:11px;gap:12px 20px}.read-link{font-size:11px}footer{font-size:9px;flex-wrap:wrap;row-gap:8px;padding-bottom:100px}footer>span:nth-child(2){order:2;flex-basis:100%}.chapter-nav{bottom:15px}.chapter-nav a{font-size:11px;padding:9px clamp(6px,2.5vw,12px)}.fin-infinity{width:min(96vw,800px,150vh)}.fin-view{display:none}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition-duration:0s!important;animation:none!important}}
@media(max-width:360px){.topbar{align-items:flex-start;flex-direction:column;gap:12px}.brand{white-space:nowrap}.topbar nav{width:100%;justify-content:space-between;gap:12px}h1{font-size:40px}.section-title{font-size:31px}.language-list{column-gap:18px}.language-label{font-size:12px}.language-label>span:last-child{font-size:20px}}


@media(min-width:768px){.chapter-nav{left:auto;right:252px;transform:none;}}

.about-dots {
  --dot-grid-base: var(--about-dot-base);
  --dot-grid-gap: 34.4px;
  --about-dot-pitch: calc(var(--dot-grid-gap) + 2.6px);
  position: fixed;
  inset: 0;
  z-index: -2;
  pointer-events: none;
  mask-image: radial-gradient(ellipse at 62% 48%, var(--ink) 32%, transparent 93%);
}
.about-dots:not(:has(canvas[width]))::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle, var(--about-dot-base) 1px, transparent 1.6px) center / var(--about-dot-pitch) var(--about-dot-pitch);
  opacity: .55;
}
:global(body.about-plate [data-fin-infinity]) {
  opacity: .88;
  transition: opacity var(--dur-enter) var(--ease-interact);
}
:global(body.about-plate:has([data-about-current="personal"]) [data-fin-infinity]) { opacity: .3; }
.social-list { position: relative; isolation: isolate; }
.social-list::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    pointer-events: none;
    background: radial-gradient(10rem at var(--spotlight-x, 50%) var(--spotlight-y, 50%), var(--spotlight-stops, transparent));
    transition: opacity var(--dur-hover) var(--ease-interact);
  }
  .social-list[data-spotlight-active]::before { opacity: 1; }

.chapter-indicator {
    position: absolute;
    inset: var(--chapter-top, 0) auto auto 0;
    width: var(--chapter-width, 0);
    height: var(--chapter-height, 0);
    border-radius: 999px;
    background: var(--accent-ink);
    transform: translateX(var(--chapter-left, 0));
    transition: transform 380ms var(--ease-interact), width 380ms var(--ease-interact);
    pointer-events: none;
  }
  .chapter-nav[data-indicator-ready] a[aria-current='true'] { background: transparent; }
  .chapter-nav a:focus-visible, .social-link:focus-visible, .photo-links a:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: var(--sp-1);
  }


.interests { display: grid; gap: var(--sp-2); font-size: var(--fs-sm); margin-top: var(--sp-4); color: var(--muted); }
.interests a { color: var(--accent); text-underline-offset: .25em; }
.personal-copy :global(.prose) { max-width: 65ch; }
  .photo-links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-2); margin-block-start: var(--sp-5); }
  .photo-links a { display: block; }
  .photo-links img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--sp-2); transition: filter var(--dur-hover) var(--ease-interact); }
  .photo-links a:hover img { filter: brightness(1.07); }
  .photo-label { display: flex; justify-content: space-between; gap: var(--sp-1); padding-block-start: var(--sp-2); font-size: var(--fs-xs); overflow-wrap: anywhere; }
  .photo-label span { color: var(--accent); }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:has(body.about-plate)) { scroll-behavior: smooth; }
    .language-scene[data-meter-entered] [data-about-meter] {
      transform-origin: left center;
      animation: about-meter-in 680ms var(--ease-interact) both;
    }
    .language-scene[data-meter-entered] .lang-row:nth-child(2n) [data-about-meter] { animation-delay: 70ms; }
  }
  @keyframes about-meter-in { from { transform: scaleX(0); } }

  @supports selector(details::details-content) and (interpolate-size: allow-keywords) {
    @media (prefers-reduced-motion: no-preference) {
      .stats-scope { interpolate-size: allow-keywords; }
      .stats-scope::details-content { block-size: 0; overflow: clip; transition: block-size 300ms var(--ease-interact), content-visibility 300ms allow-discrete; }
      .stats-scope[open]::details-content { block-size: auto; }
    }
  }


@media (max-width: 767px) {
