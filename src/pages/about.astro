:global(body.about-plate > .foot){z-index:0;background:transparent;color:var(--muted);--on-band:var(--ink);--on-band-sub:var(--accent);--on-band-meta:var(--muted);--accent-ink:var(--accent);padding-bottom:100px}
:global(body.about-plate > main){padding:0}
