---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import SocialIcon from '../components/SocialIcon.astro';

// 关于页正文来自 content/pages/about.md —— 主题不持有任何正文（content-model.md §7）
const entry = await getEntry('pages', 'about');
const Content = entry ? (await render(entry)).Content : null;

/** 头像与社交账号（站主 2026-09-26 要求）也走内容层：文件在 src/assets/about/，配置在 about.md 的 frontmatter。
 *  头像必须放 src/ 才能参与构建期优化（转 WebP + 出 srcset）—— 与「说说配图」同一条例外。 */
interface Social {
  icon: string;
  name: string;
  href: string;
}
/** 技术栈（站主 2026-09-28 要求：放在社交账号下方）。同样走内容层 about.md 的 `stack`，
 *  与社交账号同一条例外理由：这是站主自己的信息，不该硬编码在主题里。 */
interface StackGroup {
  group?: string;
  items?: string[];
}
interface AboutData {
  avatar?: string;
  avatarName?: string;
  social?: Social[];
  stack?: StackGroup[];
  /** 手写签名（站主 2026-10-03 提供原件）。走内容层，与 avatar 同一条理由：
   *  图片放 src/assets/about/ 才能参与构建期优化（转 WebP + 出 srcset）。 */
  signature?: string;
  /** 签名切片底部那行小字（等宽字、读数感）。也在内容层——它是站主自己的话。 */
  signatureNote?: string;
}

/* ===== 语言占比条（站主 2026-09-30 要求「更新技术栈并加一个这个」）=====
   **数据是实测值，不是抄来的。** 站主第一次给的 GitHub 风格截图是旧数据，
   他随即纠正「那个图片里的是旧的还没更新，你根据现在的数据做」——
   所以这里按**本站当前源码**重新量，一行命令可复算：

     for e in astro ts css md; do
       find src content functions -name "*.$e" -type f \
         | xargs wc -c | tail -1
     done

   口径（与 GitHub linguist 一致）：
     · 只统计**自己写的代码**：src/ + content/ + functions/
     · 不含 node_modules/、dist/、public/、图片、字体 —— 语言占比统计的是代码，不是整站体积
     · 同扩展名合并为同一语言（.astro / .ts / .css / .md）

   实测（2026-09-30）：
     .astro 170,036 B · .ts 136,909 B · .css 95,103 B · .md 45,784 B → 合计 447,832 B

   配色按站主 2026-09-30 指定：「用我博客风格的颜色，绿色全色系，黑，白，灰和少量橙色系」
   —— 全部取自 tokens.css 真值，**没有一个自创色**：
     Astro（最大段）走绿的三档渐变 accent-ink → accent → accent-bright
     TypeScript 走 accent-ink（深绿）
     CSS 走 --muted（灰）
     Markdown 走 --signal（橙，唯一一处 —— 沿用它在 tokens 里「少量信号色」的语义） */
interface LangRow {
  name: string;
  bytes: string;
  pct: string;
  /** 条的宽度（与 pct 同值，内联 style 用） */
  w: string;
  /** 段底色：CSS 值，全部由 token 拼出 */
  fill: string;
  /** 图例圆点：必须纯色（渐变在图例小圆点上会渲染成全透明） */
  dot: string;
  note: string;
}
const LANGS: LangRow[] = [
  { name: 'Astro', bytes: '170,036 B', pct: '38.0%', w: '38.0%',
    fill: 'linear-gradient(90deg, var(--accent-ink) 0%, var(--accent) 55%, var(--accent-bright) 100%)',
    dot: 'var(--accent)', note: '页面与组件（29 个 .astro）' },
  { name: 'TypeScript', bytes: '136,909 B', pct: '30.6%', w: '30.6%',
    fill: 'var(--accent-ink)', dot: 'var(--accent-ink)', note: '内容集合 / 脚本 / Cloudflare Functions（23 个 .ts）' },
  { name: 'CSS', bytes: '95,103 B', pct: '21.2%', w: '21.2%',
    fill: 'var(--muted)', dot: 'var(--muted)', note: '设计令牌 / 开场 / 过渡 / 版式（9 个 .css）' },
  { name: 'Markdown', bytes: '45,784 B', pct: '10.2%', w: '10.2%',
    fill: 'var(--signal)', dot: 'var(--signal)', note: '文章与页面正文（14 篇 .md）' },
];
const LANG_TOTAL = '447,832 B';
const d = (entry?.data ?? {}) as unknown as AboutData;
const assets = import.meta.glob<{ default: ImageMetadata }>('/src/assets/about/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const avatar = d.avatar ? assets[`/src/assets/about/${d.avatar}`]?.default : undefined;
const signature = d.signature ? assets[`/src/assets/about/${d.signature}`]?.default : undefined;
const social = d.social ?? [];
// 空组不渲染（内容层写错分组时不至于留一个空卡片）
const stack = (d.stack ?? []).filter((g) => (g?.items ?? []).length > 0);
const isExternal = (h: string) => /^https?:/i.test(h);
---
{
  /* 关于页迁移（2026-09-26）：chrome='band' → 'page'（内页外壳：浅色顶栏 + 切片档案背景）。
     **'page' 不渲染 <slot name="band" />** —— 所以标题必须从那个槽搬进正文流（外壳提供的 .pagehead），
     漏搬会静默消失且构建照常成功（文章页同一个坑）。
     PageTitle 本身不写任何颜色（只有 margin/font-weight + 字号类 token），**靠继承取色** ——
      搬进浅底后自动继承外壳的 --ink，所以**无需主题化**（已读源码确认，见 docs/about-migration-notes.md）。
      版式依据不是原型：prototype/terminal/ 里没有关于页，依据是既有内页外壳的实测实现（/gallery 与文章页）。 */
}
<Base title="关于" current="about" chrome="page">
  {/* 头像（站主 2026-09-26 要、2026-09-27 改）：
      **必须和标题放在同一个页头里**，桌面靠 grid 排到右边、手机在标题下方居中。
      为什么不用 `position: fixed`（第一版就是这么写的，被站主抓了）：
        ① 它会**不跟页面滚**（站主："要求跟随鼠标滚轮上下而上下"）；
        ② 更要命的：过渡动画给 `.shell` 加了 `transform: scale(0.98→1)`，而被 transform 的祖先会成为
           `position: fixed` 的**包含块** ⇒ 头像按"相对 .shell"定位；动画结束、类被摘掉后 transform 变 none，
           包含块又换回视口 ⇒ **位置突变，视觉上就是"加载后跳一下"**（实测从 y=246 跳到 y=198，48px）。
      改成布局定位后这两个问题一起消失：位置由排版决定（不会变），元素在正文流里（自然跟着滚）。 */}
  <header class="pagehead">
    <PageTitle>关于</PageTitle>
    {avatar && (
      <div class="profile">
        <Image class="avatar" src={avatar} alt={`${d.avatarName ?? '站主'}的头像`} widths={[96, 192]} sizes="128px" />
        <p class="profile-name">{d.avatarName}</p>
      </div>
    )}
  </header>

  {/* ===== HAND 亲笔 · 签名切片（站主 2026-10-03）=====
      **全页唯一一处深底**（--dusk-2），其余切片都是纸白 —— 页面因此有一处视觉锚点，
      但「纸白阅读底」这条契约没被推翻（正文仍是纸白上的 .prose）。
      ★ 签名是站主手迹原件：已抠掉白底（转成带 alpha 的图）、转成站内墨绿
        （--accent-bright）。原件是蓝紫色的，加工脚本见 _probe/hand-sign-prep.mjs
        （该目录已 gitignore；成品 src/assets/about/sign.png 进仓参与构建期优化）。
      ★ 深底上的颜色只有两个选择（实测，见 scripts/assert-tokens.mjs）：
        编号 accent-bright 6.9:1 · 字是图 · 小字 dusk-5 4.26:1（**不到 4.5，所以只做
        10px 标签/刻度，不承载正文**）。**--accent-ink 在深底上只有 2.97，不许用。**
      ★ 落笔 = 横向揭幕（clip-path inset 从 100% 走到 0），不是逐笔 —— 位图没有路径。 */}
  {signature && (
    <figure class="sign-card" data-sign-card>
      <figcaption class="sign-head">
        <span class="sign-fig">FIG.01 — HAND</span>
        <span class="sign-kind">specimen / signature</span>
      </figcaption>
      <div class="sign-plate">
        <Image
          class="sign-img"
          data-sign-img
          src={signature}
          alt={`${d.avatarName ?? '站主'}的手写签名`}
          widths={[340, 680]}
          sizes="340px"
        />
      </div>
      <p class="sign-foot">
        <span>{d.signatureNote}</span>
        {/* ★ 这行小字是**站主自己的标注**，不是构建期读数 ——
            故意不写"509×264"这类尺寸：那是一次性处理时的中间值，与页面上的
            产物（构建期转WebP 18 KB、多档 srcset）无关。写它就是假读数，
            与首页那条「语言占比必须是实测值」同一个原则：读数要么真，要么别写。 */}
        <span class="sign-meta">HANDWRITTEN / ALPHA</span>
      </p>
    </figure>
  )}

  <div class="prose">{Content && <Content />}</div>

  {social.length > 0 && (
    <section class="social-block fig-block" aria-labelledby="social-title">
      <p class="fig-no" aria-hidden="true">FIG.02</p>
      <h2 id="social-title">我的一些社交账号</h2>
      <ul class="social">
        {social.map((s, i) => (
          <li>
            <a
              href={s.href}
              {...(isExternal(s.href) ? { rel: 'noopener' } : {})}
              {...(isExternal(s.href) ? { target: '_blank' } : {})}
            >
              <span class="fig-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <SocialIcon name={s.icon} />
              <span>{s.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {stack.length > 0 && (
    <section class="stack-block fig-block" aria-labelledby="stack-title">
      <p class="fig-no" aria-hidden="true">FIG.03</p>
      <h2 id="stack-title">技术栈</h2>
      <div class="stack-groups">
        {stack.map((g) => (
          <div class="stack-group">
            {g.group && <p class="stack-group-name">{g.group}</p>}
            <ul class="stack-items">
              {(g.items ?? []).map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )}

  {/* 技术栈占比条（站主 2026-09-30：「更新技术栈并加一个这个」）——紧跟在技术栈之后，同一个位置。
      数据口径：**本站源码实测**（站主拍板的那一档），不是抄原型那组——
      原型是 HTML 单文件，它的 JS 占 93.1%（含 three.js 整包），与本站毫无可比性。
      条宽直接用百分比当 CSS 宽度；每段配一个纯色圆点做图例
      （渐变在小圆点上会渲染成全透明，所以 dot 与 fill 是两个字段）。 */}
  {LANGS.length > 0 && (
    <section class="lang-block fig-block" aria-labelledby="lang-title">
      <p class="fig-no" aria-hidden="true">FIG.04</p>
      <h2 id="lang-title">源码语言占比</h2>
      <p class="lang-total">
        本站源码实测 · 合计 <b>{LANG_TOTAL}</b>（<code>src/</code> 与 <code>functions/</code>，不含依赖与构建产物）
      </p>
      <ul class="lang-list">
        {LANGS.map((l) => (
          <li class="lang-row">
            <span class="lang-head">
              <i class="lang-dot" style={`background:${l.dot}`} aria-hidden="true"></i>
              <span class="lang-name">{l.name}</span>
              <span class="lang-bytes">{l.bytes}</span>
              <span class="lang-pct">{l.pct}</span>
            </span>
            <span class="lang-bar" aria-hidden="true">
              <s class="lang-fill" style={`width:${l.w};background:${l.fill}`}></s>
            </span>
            <span class="lang-note">{l.note}</span>
          </li>
        ))}
      </ul>
      {/* 刻度尺：每 10% 一道，纯装饰（aria-hidden）。它是「读数」的延伸，不是新数据。 */}
      <div class="lang-rule" aria-hidden="true">
        {Array.from({ length: 10 }, (_, i) => <i style={`left:${i * 10}%`}></i>)}
      </div>
    </section>
  )}
</Base>

<script>
  // 签名落笔（横向揭幕）。与页面其余部分刻意无耦合：只读 [data-sign-img]，不碰别的节点。
  // 写法照 archive.astro 那台卷尺：独立入口的 <script>，不与内联逻辑混在一起。
  import '../scripts/hand-sign';
</script>

<style>
  /* 拍板 D：页头版心收成 --measure，与正文列左对齐（与文章页同一条）。 */

  /* ===================================================================
   * 标本馆（SPECIMEN CABINET）—— 站主 2026-10-03 定的版式语言
   *
   * 参照物是一组「拼贴 + 版画蚀刻 + 仪器图纸」的参考图，共同语法是：
   *   ① 大量留白（纸白底不改 —— 口径 #1「纸白阅读底一行不改」）；
   *   ② 标本切片：直��� + 细边框 + 左上角编号（FIG.01 / FIG.02…）；
   *   ③ 印刷体标签用等宽小字 + 字距，与「手写」形成层次对比。
   * 落在这三样上的改动只有版式（页头/ 列表项 / 卡片），**正文 .prose 一行没动**
   * —— 口径 #3 明确「正文排版不动」。
   * =================================================================== */

  /* ---- 切片编号（FIG.01 那类）----
     等宽字 + 大字距 + 小尺寸 = 「标本标签」的印刷感，也是仪器语汇的延续。 */
  .fig-no,
  .sign-fig,
  .sign-kind,
  .fig-idx {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    color: var(--accent-ink);
    font-variant-numeric: tabular-nums;
  }
  /* 切片编号挂在区块左上角外侧（视觉上像贴在切片上的标签，不占正文宽度） */
  .fig-block {
    position: relative;
  }
  /* ★ 编号与 h2 之间要留气：2026-10-03 目检发现两者挤在一起像一行。
     用 --sp-2（0.5rem）—— 编号是"标签"不是标题，不能抢 h2 的节奏。 */
  .fig-no {
    margin: 0 0 var(--sp-2);
    color: var(--muted);
  }

  /* ---- 签名切片：全页唯一一处深底（--dusk-2）----
     ★ 深底上的颜色只有两个选择（实测值见 scripts/assert-tokens.mjs）：
       --accent-bright on --dusk-1 = 6.90（编号用这个）
       --dusk-5      on --dusk-1 = 4.26（**不到 4.5 ⇒ 只做 10px 标签/刻度**）
       --accent-ink  on --dusk-1 = 2.97（**深底上不许用** —— 它是纸上的绿）
     ⇒ tests/tokens.test.ts 有断言守着这条线，改配色前先看那里。 */
  .sign-card {
    /* 下边距要给足：.prose 在 base.css 里没有上边距，不留白会紧贴第一行正文
       （2026-10-03 目检发现）。
     ★ 宽度不能写死：380px 在 390 视口下会连边框一起溢出（目检实测签名右边被切）⇒
       用 min() 收窄。站主 2026-10-03 拍板的是「340px 图 / 380px 切片」这个**桌面**比例。 */
    margin: var(--sp-6) 0 var(--sp-6);
    width: min(380px, 100%);
    background: var(--dusk-2);
    border: 1px solid var(--dusk-4);
  }
  .sign-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-3);
    padding: var(--sp-2) var(--sp-3);
    border-bottom: 1px solid var(--dusk-4);
  }
  .sign-head .sign-fig {
    color: var(--accent-bright);
  }
  .sign-head .sign-kind {
    color: var(--dusk-5);
    letter-spacing: 0.08em;
  }
  /* 签名图所在的「切片台」：留 20px 边距（站主 2026-10-03 拍板 340px 图 / 380px 切片） */
  .sign-plate {
    padding: 20px;
  }
  .sign-img {
    display: block;
    width: 100%;
    height: auto;
  }
  .sign-foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-3);
    margin: 0;
    padding: var(--sp-2) var(--sp-3);
    border-top: 1px solid var(--dusk-4);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    color: var(--dusk-5);
    font-variant-numeric: tabular-nums;
  }
  .sign-foot .sign-meta {
    color: var(--accent-bright);
  }

  /* ---- 社交卡 / 技术栈：从「圆角柔边」改成「标本标签」（直角 + 细框 + 序号）---- */
  .social a,
  .stack-group {
    border: 1px solid var(--hair);
    background: var(--panel);
  }
  /* 卡片是标本 ⇒ 不再圆角。原有的 hover 反馈保留（accent-wash 那一档）。 */
  .social a {
    position: relative;
  }
  .social a .fig-idx {
    position: absolute;
    top: 0;
    right: 0;
    padding: 0 0.3em;
    background: var(--paper);
    color: var(--muted);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
  }
  .stack-items li {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
  }

  /* ---- 语言占比条：条形保留（它是构建期实测的真读数），下面加一道刻度尺 ---- */
  .lang-rule {
    position: relative;
    height: 6px;
    margin-top: var(--sp-2);
    border-bottom: 1px solid var(--hair);
  }
  .lang-rule i {
    position: absolute;
    bottom: 0;
    width: 1px;
    height: 3px;
    background: var(--hair);
  }
  /* 0% 那一道加高一档，给个「起点」 */
  .lang-rule i:first-child {
    height: 6px;
    background: var(--accent-ink);
  }
  .pagehead {
    max-width: var(--measure);
  }
  /* ---- 头像 ---- */
  /* 手机端：头像与「北杉」必须**同一条中轴**（站主 2026-09-27："头像移到北杉正上方，歪了"）。
     用 flex 列 + align-items:center 而不是 text-align:center ——
     后者对 Astro `<Image>` 产出的图片无效（它是块级元素，text-align 管不到它，
     实测头像被左对齐、名字居中，于是看着是歪的）。 */
  .profile {
    margin: var(--sp-6) 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--hair);
    background: var(--panel);
  }
  .profile-name {
    margin: var(--sp-2) 0 0;
    font-size: var(--fs-sm);
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  /* 宽屏：页头变成**两栏** —— 标题在左、头像在右（都留在正文流里 ⇒ 位置固定不变、且跟着页面滚）。
     为什么不用 position:fixed：① 不跟滚动；② 过渡动画给 .shell 加的 transform 会把 fixed 的包含块
     从视口换成 .shell，动画一结束就位置突变（"加载后跳一下"）。布局定位两个问题都没有。 */
  @media (min-width: 1024px) {
    .pagehead {
      max-width: none;
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: start;
      column-gap: var(--sp-6);
    }
    .profile {
      /* 往下压一点，让头像对着标题的下半部分（站主给的参考图就是这个观感；
         代价是页头行高变大、正文整体下移 40px —— 这是刻意的，不是副作用）。 */
      margin: 2.5rem 0 0;
    }
    .avatar {
      width: 128px;
      height: 128px;
      box-shadow: 0 6px 24px rgb(26 26 26 / 10%);
    }
  }
  /* ---- 社交账号 ---- */
  .social-block {
    margin: var(--sp-8) 0 0;
    max-width: var(--measure);
  }
  .social-block h2 {
    margin: 0 0 var(--sp-4);
