:global(:where(.about-page button)){font:inherit;color:inherit;border:0;background:none}
.profile-header{margin:0;padding:0;border:0}

.personal-copy :global(.prose){max-width:none;font-size:14px;line-height:2;color:var(--muted)}
.personal-copy :global(.prose > p:first-child){display:none}
.personal-copy :global(.prose > p){margin:0 0 var(--sp-3)}
