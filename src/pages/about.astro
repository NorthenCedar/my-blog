---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import SocialIcon from '../components/SocialIcon.astro';

// 关于页正文来自 content/pages/about.md —— 主题不持有任何正文（content-model.md §7）
const entry = await getEntry('pages', 'about');
const Content = entry ? (await render(entry)).Content : null;

/** 头像与社交账号（站主 2026-09-26 要求）也走内容层：文件在 src/assets/about/，配置在 about.md 的 frontmatter。
 *  头像必须放 src/ 才能参与构建期优化（转 WebP + 出 srcset）—— 与「说说配图」同一条例外。 */
interface Social {
  icon: string;
  name: string;
  href: string;
}
/** 技术栈（站主 2026-09-28 要求：放在社交账号下方）。同样走内容层 about.md 的 `stack`，
 *  与社交账号同一条例外理由：这是站主自己的信息，不该硬编码在主题里。 */
interface StackGroup {
  group?: string;
  items?: string[];
}
interface AboutData {
  avatar?: string;
  avatarName?: string;
  social?: Social[];
  stack?: StackGroup[];
  /* ★ 2026-10-03 站主口径：「只保留排版，其他什么背景签名全部恢复原样」
     ⇒ signature / signatureNote 两个字段**已删**（连同 sign.png 素材、
       src/scripts/hand-sign.ts、FIG.01 那块纸、以及它专属的测试与门闩）。
     要恢复签名时按 git log 回看 9a4414b / 0572158 两版，别凭印象重写。 */
}

/* ===== 语言占比条（站主 2026-09-30 要求「更新技术栈并加一个这个」）=====
   **数据是实测值，不是抄来的。** 站主第一次给的 GitHub 风格截图是旧数据，
   他随即纠正「那个图片里的是旧的还没更新，你根据现在的数据做」——
   所以这里按**本站当前源码**重新量，一行命令可复算：

     for e in astro ts css md; do
       find src content functions -name "*.$e" -type f \
         | xargs wc -c | tail -1
     done

   口径（与 GitHub linguist 一致）：
     · 只统计**自己写的代码**：src/ + content/ + functions/
     · 不含 node_modules/、dist/、public/、图片、字体 —— 语言占比统计的是代码，不是整站体积
     · 同扩展名合并为同一语言（.astro / .ts / .css / .md）

   实测（2026-09-30）：
     .astro 170,036 B · .ts 136,909 B · .css 95,103 B · .md 45,784 B → 合计 447,832 B

   配色按站主 2026-09-30 指定：「用我博客风格的颜色，绿色全色系，黑，白，灰和少量橙色系」
   —— 全部取自 tokens.css 真值，**没有一个自创色**：
     Astro（最大段）走绿的三档渐变 accent-ink → accent → accent-bright
     TypeScript 走 accent-ink（深绿）
     CSS 走 --muted（灰）
     Markdown 走 --signal（橙，唯一一处 —— 沿用它在 tokens 里「少量信号色」的语义） */
interface LangRow {
  name: string;
  bytes: string;
  pct: string;
  /** 条的宽度（与 pct 同值，内联 style 用） */
  w: string;
  /** 段底色：CSS 值，全部由 token 拼出 */
  fill: string;
  /** 图例圆点：必须纯色（渐变在图例小圆点上会渲染成全透明） */
  dot: string;
  note: string;
}
const LANGS: LangRow[] = [
  { name: 'Astro', bytes: '170,036 B', pct: '38.0%', w: '38.0%',
    fill: 'linear-gradient(90deg, var(--accent-ink) 0%, var(--accent) 55%, var(--accent-bright) 100%)',
    dot: 'var(--accent)', note: '页面与组件（29 个 .astro）' },
  { name: 'TypeScript', bytes: '136,909 B', pct: '30.6%', w: '30.6%',
    fill: 'var(--accent-ink)', dot: 'var(--accent-ink)', note: '内容集合 / 脚本 / Cloudflare Functions（23 个 .ts）' },
  { name: 'CSS', bytes: '95,103 B', pct: '21.2%', w: '21.2%',
    fill: 'var(--muted)', dot: 'var(--muted)', note: '设计令牌 / 开场 / 过渡 / 版式（9 个 .css）' },
  { name: 'Markdown', bytes: '45,784 B', pct: '10.2%', w: '10.2%',
    fill: 'var(--signal)', dot: 'var(--signal)', note: '文章与页面正文（14 篇 .md）' },
];
const LANG_TOTAL = '447,832 B';
const d = (entry?.data ?? {}) as unknown as AboutData;
const assets = import.meta.glob<{ default: ImageMetadata }>('/src/assets/about/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const avatar = d.avatar ? assets[`/src/assets/about/${d.avatar}`]?.default : undefined;
/* ★ 2026-10-03 删：const signature = …（签名整体移除，见 AboutData 注记）*/

/* 参考图底纹（第2 步，2026-10-03）—— **构建期已裁成小图**，不是 CSS 取景。
   ★ 为什么必须裁文件：CSS 的 overflow:hidden + 偏移能在浏览器里「取景」，
     但**浏览器仍会下载整张原图**。原图 1080×1791~2355、3–4 MB 三张 ⇒ 关于页 10 MB+。
   ★ 裁切用的是 sharp —— **astro 自带的依赖**（astro 的 package.json 有 "sharp": "^0.35.4"），
     不是新增运行时依赖，不违反「只允许 astro / @astrojs/rss / @astrojs/sitemap」。
   ★ 元素全部取自站主给的参考图，**不自己画**（手绘 SVG 雕像实测砸过三次：蘑菇→emoji→火柴人）。
     月相序列 + 维纳斯雕像取自同一段（风格一致，且都是白底）；
     d 图虽有罗马雕像但**底是蓝色**，蓝底转绿会与「白底 + 墨绿」的整体调子打架 ⇒ 没用它。
   裁切参数（段内百分比、白点分位数等）见 `_probe/_ref-plate.mjs`，可复算、可改。 */
const PLATE_SRCS = import.meta.glob<{ default: ImageMetadata }>('/src/assets/about/plates/*.webp', { eager: true });
const plate = (name: string) => PLATE_SRCS[`/src/assets/about/plates/${name}.webp`]?.default;
const social = d.social ?? [];
// 空组不渲染（内容层写错分组时不至于留一个空卡片）
const stack = (d.stack ?? []).filter((g) => (g?.items ?? []).length > 0);
const isExternal = (h: string) => /^https?:/i.test(h);
---
{
  /* 关于页迁移（2026-09-26）：chrome='band' → 'page'（内页外壳：浅色顶栏 + 切片档案背景）。
     **'page' 不渲染 <slot name="band" />** —— 所以标题必须从那个槽搬进正文流（外壳提供的 .pagehead），
     漏搬会静默消失且构建照常成功（文章页同一个坑）。
     PageTitle 本身不写任何颜色（只有 margin/font-weight + 字号类 token），**靠继承取色** ——
      搬进浅底后自动继承外壳的 --ink，所以**无需主题化**（已读源码确认，见 docs/about-migration-notes.md）。
      版式依据不是原型：prototype/terminal/ 里没有关于页，依据是既有内页外壳的实测实现（/gallery 与文章页）。 */
}
<Base title="关于" current="about" chrome="page" bodyClass="about-plate">
  {/* 头像（站主 2026-09-26 要、2026-09-27 改）：
      **必须和标题放在同一个页头里**，桌面靠 grid 排到右边、手机在标题下方居中。
      为什么不用 `position: fixed`（第一版就是这么写的，被站主抓了）：
        ① 它会**不跟页面滚**（站主："要求跟随鼠标滚轮上下而上下"）；
        ② 更要命的：过渡动画给 `.shell` 加了 `transform: scale(0.98→1)`，而被 transform 的祖先会成为
           `position: fixed` 的**包含块** ⇒ 头像按"相对 .shell"定位；动画结束、类被摘掉后 transform 变 none，
           包含块又换回视口 ⇒ **位置突变，视觉上就是"加载后跳一下"**（实测从 y=246 跳到 y=198，48px）。
      改成布局定位后这两个问题一起消失：位置由排版决定（不会变），元素在正文流里（自然跟着滚）。 */}
  {/* ===================================================================
   * 底纹层（PAGE PLATE）—— 2026-10-03 站主第三轮口径
   *
   * 站主原话：「只保留排版，其他什么背景签名全部恢复原样，
   *   背景恢复后把月相和蓝条替代背景上本来的百褶无限符号」
   *
   * 拆成两句话来执行，缺一不可：
   *   ① 「其他什么背景签名全部恢复原样」
   *      ⇒ **只保留排版**（页头 / 两栏 / 细线列表 / 刻度尺这些版式语言），
   *        签名（FIG.01 HAND）整块删除、揭幕动画与素材一起删；
   *        背景**不是**回到站主指定的那张「铺满视口大图」——
   *        而是回到**百褶 ∞ 那一层的位置与角色**（下一条）。
   *   ② 「把月相和蓝条替代百褶无限符号」
   *      ⇒ 仍然用站主指定的那张图（`moon-main.webp`，月相 + 纯蓝横带 +
   *        蓝色轨道线都是原图自带的），但**挂法对齐百褶 ∞**：
   *        fixed 挂视口居中、`min(128vw, 1600px)`、`contain`、`opacity .2`、
   *        `z-index` 退到正文之下。
   *      ⇒ 效果：关于页的纸白区纹理从「深绿大图」换回「淡墨纹」，
   *        母题从 ∞ 换成月相，**纸白阅读底一字不改**（口径 #1）。
   *
   * ★ 为什么必须**覆盖**而不是「叠在百褶 ∞ 上面」：
   *   百褶 ∞ 那层是 `body.chrome-page .page-inf`（`z-index:-1`），
   *   由 Topbar 渲染、全站内页共用。若只加一层不覆盖它，两层纹理会叠在一起 ——
   *   两套母题叠一次脏（Topbar 注释里已记过这个教训：「切片档案」四层
   *   换 ∞ 底纹时就是因为叠着才整体删掉）。
   *   ⇒ 本页把 `.page-inf` 显式关掉（见样式段 `body.about-plate .page-inf`），
   *     自己也用 `z-index:-1` 站在同一个层级上。
   *
   * ★ 图**不重新处理**：构建期已把纯黑底染成深绿（`_probe/_deep-plate.mjs`，
   *   灰阶按「越暗染得越多」混向 --dusk-2 的 #131b17，白月亮与星芒保持白，
   *   彩色像素一格不动）⇒ 站点内不存在第二份「纯黑版」。
   * =================================================================== */}
  <div class="ref-plate" aria-hidden="true">
    {plate('moon-main') && (
      <div class="ref-main">
        <Image
          class="ref-img"
          src={plate('moon-main')!}
          alt=""
          widths={[960, 1920]}
          sizes="128vw"
          loading="eager"
          decoding="sync"
        />
      </div>
    )}
  </div>

  {/* ===================================================================
   * 两栏容器（站主 2026-10-03：「右半部分太空，重新排版」）
   *
   * 为什么这么分：内容天然分两类 ——
   *   · **叙述类**（页头 / 签名 / 正文）要窄、要安静⇒ 左边一栏，宽度就是 --measure
   *   · **读数类**（社交 / 技术栈 / 语言占比）天生是清单与仪表 ⇒ 右边一栏，占满余宽
   * 分栏后 1280 视口的右半不再是空的，而清单类内容**比正文更适合窄栏堆叠**
   * （行短、易扫读），布局与内容是匹配的，不是硬塞。
   *
   * ★ 关键：**不改变 DOM 里的阅读顺序**。签名仍在正文之前（移动端尤其重要）。
   *   办法是移动端把 aside 设成 `display:contents` —— 它不生成盒子，
   *   子元素直接参与父级流动，于是视觉顺序 = main 的三个 + aside 的三个，
   *   与改造前**逐项一致**。（若用 grid 显式指定行列，两栏的 DOM 顺序就会决定
   *   移动端顺序，签名会掉到正文后面。）
   * =================================================================== */}
  <div class="about-grid">
  <div class="about-main">
  <header class="pagehead">
    {/* ★ 站主 2026-10-03：「我的头像上面不要有线」⇒原来的圆形刻度环（量规语汇）
        与头像上的排线**全部去掉**，头像回归纯圆形照片。
        刻度与量规的语汇改由页头那根 `--hair` 细线与各区块的 `FIG.0x` 编号承担。

        ★★ 页头纸托底 `.page-paper` 已删（2026-10-03 第三轮口径）。
          它存在过的唯一理由是「深绿大图压住标题」（实测 pagehead 整段落在图上）；
          现在底纹回到百褶 ∞ 那一层（`z-index:-1` + `opacity:.2`，画在 body
          纸白底**之下**）⇒ 标题直接落在纸白底上，不需要任何纸。
          顺带 `.pagehead` 的 `overflow:hidden` 也去掉了（它只是给纸兜底）。*/}
    <p class="fig-no" aria-hidden="true">FIG.00 — PROFILE</p>
    <PageTitle>关于</PageTitle>
    {avatar && (
      <div class="profile">
        <Image class="avatar" src={avatar} alt={`${d.avatarName ?? '站主'}的头像`} widths={[96, 192]} sizes="128px" />
        <p class="profile-name">{d.avatarName} · SPECIMEN 00</p>
      </div>
    )}
  </header>

  {/* ★ 2026-10-03 站主口径：「签名全部恢复原样」⇒ FIG.01 HAND 整块**已删**
      （含 <figure class="sign-card"> 纸托底、编号小字、<img data-sign-img>，
        以及配套的 src/scripts/hand-sign.ts 揭幕动画与 sign.png 素材）。
      左栏现在是：页头 → 正文。原「FIG.01」这个编号位空缺，
      社交/技术栈/语言占比仍从 FIG.02 起（编号是连续的排版语汇，不重排）。*/}

  <div class="prose">{Content && <Content />}</div>
  </div><!-- /.about-main -->

  <aside class="about-side" aria-label="站点信息">
  {social.length > 0 && (
    <section class="social-block fig-block" aria-labelledby="social-title">
      <p class="fig-no" aria-hidden="true">FIG.02</p>
      <h2 class="fig-h" id="social-title">我的一些社交账号</h2>
      <ul class="social">
        {social.map((s, i) => (
          <li>
            <a
              href={s.href}
              {...(isExternal(s.href) ? { rel: 'noopener' } : {})}
              {...(isExternal(s.href) ? { target: '_blank' } : {})}
            >
              <span class="fig-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <SocialIcon name={s.icon} />
              <span>{s.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {stack.length > 0 && (
    <section class="stack-block fig-block" aria-labelledby="stack-title">
      <p class="fig-no" aria-hidden="true">FIG.03</p>
      <h2 class="fig-h" id="stack-title">技术栈</h2>
      <div class="stack-groups">
        {stack.map((g) => (
          <div class="stack-group">
            {g.group && <p class="stack-group-name">{g.group}</p>}
            <ul class="stack-items">
              {(g.items ?? []).map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )}

  {/* 技术栈占比条（站主 2026-09-30：「更新技术栈并加一个这个」）——紧跟在技术栈之后，同一个位置。
      数据口径：**本站源码实测**（站主拍板的那一档），不是抄原型那组——
      原型是 HTML 单文件，它的 JS 占 93.1%（含 three.js 整包），与本站毫无可比性。
      条宽直接用百分比当 CSS 宽度；每段配一个纯色圆点做图例
      （渐变在小圆点上会渲染成全透明，所以 dot 与 fill 是两个字段）。 */}
  {LANGS.length > 0 && (
    <section class="lang-block fig-block" aria-labelledby="lang-title">
      <p class="fig-no" aria-hidden="true">FIG.04</p>
      <h2 class="fig-h" id="lang-title">源码语言占比</h2>
      <p class="lang-total">
        本站源码实测 · 合计 <b>{LANG_TOTAL}</b>（<code>src/</code> 与 <code>functions/</code>，不含依赖与构建产物）
      </p>
      <ul class="lang-list">
        {LANGS.map((l) => (
          <li class="lang-row">
            <span class="lang-head">
              <i class="lang-dot" style={`background:${l.dot}`} aria-hidden="true"></i>
              <span class="lang-name">{l.name}</span>
              <span class="lang-bytes">{l.bytes}</span>
              <span class="lang-pct">{l.pct}</span>
            </span>
            <span class="lang-bar" aria-hidden="true">
              <s class="lang-fill" style={`width:${l.w};background:${l.fill}`}></s>
            </span>
            <span class="lang-note">{l.note}</span>
          </li>
        ))}
      </ul>
      {/* 刻度尺：每 10% 一道，纯装饰（aria-hidden）。它是「读数」的延伸，不是新数据。 */}
      <div class="lang-rule" aria-hidden="true">
        {Array.from({ length: 10 }, (_, i) => <i style={`left:${i * 10}%`}></i>)}
      </div>
    </section>
  )}
  </aside><!-- /.about-side -->
  </div><!-- /.about-grid -->
</Base>

<!-- ★ 2026-10-03 删：签名落笔的 <script>import '../scripts/hand-sign'</script>
     （连同 src/scripts/hand-sign.ts 与 src/assets/about/sign.png 一起删除）。
     关于页现在**零 JS**—— 版式与底纹都是纯 CSS，与「只保留排版」的口径一致。 -->

<style>
  /* 拍板 D：页头版心收成 --measure，与正文列左对齐（与文章页同一条）。 */

  /* ===================================================================
   * 标本馆（SPECIMEN CABINET）—— 站主 2026-10-03 定的版式语言
   *
   * 参照物是一组「拼贴 + 版画蚀刻 + 仪器图纸」的参考图，落到版式上是这四样：
   *   ① 纸白底（口径 #1「纸白阅读底一行不改」）；
   *   ② 标本编号（FIG.00 / 01 / 02…）用等宽小字 + 大字距，排在区块左上；
   *   ③ 细线分隔的列表（**不做卡片** —— 站主 2026-10-03「直接放背景里，不要单独做卡片」）；
   *   ④ 参考图底纹层（.ref-plate，见结构处注释），元素是原图里的月相 / 雕像 / 飞鸟 / 星芒。
   * 落在这四样上的改动只有版式（页头 / 列表项 / 刻度），**正文 .prose 一行没动**
   * —— 口径 #3 明确「正文排版不动」。
   * =================================================================== */

  /* ===================================================================
   * 两栏版式（站主 2026-10-03：「右半部分太空，重新排版」）
   *
   * 改版前：页头 / 签名 / 正文 / 社交 / 技术栈 / 语言占比 **全部**限在
   * --measure（34em ≈ 578px）里单列排下来⇒ 1280 视口下右半 600px 全空。
   *
   * 分栏依据（不是「为了填满」而是内容本来就分两类）：
   *   左栏 = **叙述类**（页头 / 签名 / 正文）—— 窄栏、安静、适合连续阅读
   *   右栏 = **读数类**（社交 / 技术栈 / 语言占比）—— 清单与仪表，
   *           行短可扫读，在窄栏里比在通栏里更好读（通栏时一行只剩三五个字，两端全是空白）
   * ★ 正文 .prose 的宽度**一个字没改**（仍是 prose.css 里的 max-width:var(--measure)），
   *   它在 grid 里被第一列约束，视觉效果与改版前一致 —— 口径 #3「正文排版不动」。
   *
   * ★ 移动端为什么用 `display: contents` 而不是 grid 显式定位：
   *   若在 grid 上写 `grid-row/grid-column`，**DOM 顺序就决定了窄屏顺序**，
   *   而 aside 在 main 之后 ⇒ 签名会掉到正文后面（改版前签名在正文之前）。
   *   `display:contents` 让 aside 不生成盒子、子元素直接参与父级流动，
   *   窄屏顺序 = main 的三个 + aside 的三个 = 与改版前**逐项一致**，零顺序变化。
   * =================================================================== */
  .about-grid {
    display: block;            /* 窄屏默认就是原来的单列流 */
  }
  .about-side {
    display: contents;
  }
  @media (min-width: 1024px) {
    .about-grid {
      display: grid;
      /* 左列固定 --measure（正文该多宽就多宽），右列吃掉余宽。
         1024px 起才分栏：低于它右列不足 300px，清单会被挤成两三个字一行。 */
      grid-template-columns: minmax(0, var(--measure)) minmax(0, 1fr);
      column-gap: var(--sp-8);
      align-items: start;      /* ★ 右栏不拉高，块按自身高度排（否则 social 会被prose 拉出大片空白）*/
    }
    .about-main {
      grid-column: 1;
      min-width: 0;
      /* ★ 2026-10-03 删：`padding-top: min(30vh, 380px)` 那段顶部空档。
         它存在过的唯一理由是「让铺满视口的深绿大图从页面上方整段露出来」
         （当时的算式：图高 697px、月亮直径约 250px ⇒ 空档要装得下月亮）。
         现在底纹回到百褶 ∞ 那一层（照抄它的挂法：fixed 居中、铺满视口、
         `opacity:.2`、画在 body 纸白底之下）⇒ **不需要任何空档**，
         而且右栏（.about-side）本来就没有这段 padding，
         留着会让左右两栏的**首行基线错开**（实测左栏 y=490、右栏 y=110）。
         ⇒ 删掉之后两栏齐平，这本该是版式的默认状态。 */
    }
    .about-side {
      /* ★ 不用 flex + gap，用「上边框 + padding-top」分隔。
         目检踩到：gap 与 border-top 同时存在时，两个半段间距（上一块下方 gap
         + 下一块上方 padding）夹着一条线，看起来像「双线夹一段空白」。
         现在间距**只由 padding-top 提供**，线上只有一条 —— 干净。 */
      display: block;
      grid-column: 2;
      min-width: 0;
    }
    /* 右栏标题比左栏小一档：它们是清单的标题，不是页的章节标题。
       （--fs-lg → --fs-body 上浮，视觉上落在一级与二级之间。） */
    .about-side .fig-h {
      font-size: var(--fs-body);
      font-weight: 700;
      margin-bottom: var(--sp-2);
    }
    /* 编号与标题同行：右栏窄，横排更紧凑（左栏是竖排的两行） */
    .about-side .fig-no {
      margin-bottom: 0;
    }
    .about-side .fig-block {
      /* 归零原有的 margin-top（.stack-block / .lang-block / .social-block 各带
         `margin: var(--sp-8) 0 0`）—— 在右栏里由 padding-top 统一控制间距，
         两处都留会叠成双倍空白。 */
      margin-top: 0;
      max-width: none;         /* 右栏宽度由 grid 列给，不该再限 --measure */
      padding-top: var(--sp-5);
      border-top: 1px solid var(--hair);
    }
    .about-side .fig-block:first-child {
      padding-top: 0;
      border-top: 0;
    }
    /* ★ 2026-10-03 删：.about-main .sign-card { width: min(380px,100%) }
       —— 签名整块已删，这条是它专属的宽屏宽度约束。 */
  }

  /* ===================================================================
   * 底纹层（PAGE PLATE）—— 月相 + 蓝条**替代**百褶 ∞（2026-10-03 第三轮口径）
   *
   * 站主原话：「只保留排版，其他什么背景签名全部恢复原样，
   *   背景恢复后把月相和蓝条替代背景上本来的百褶无限符号」
   *
   * ⇒ 这一段的参数**逐条照抄** Topbar 里 `body.chrome-page .page-inf`
   *   （百褶 ∞ 那一层），只有两处不同：素材换成月相图、本页关掉 .page-inf。
   *   照抄是有意的：全站纸白区只有**一套**纹理语言（Topbar 注释原话
   *   「保持全站只有一套纸白区语言」），本页换母题但不换**挂法**。
   *
   * ★ 三个关键参数各自的作用（都是从上一版踩出来的）：
   *   · `position: fixed` + `translate(-50%,-50%)`
   *     ⇒ 挂**视口**而不是文档 ⇒ 滚动时纹理始终居中，与百褶 ∞ 观感一致。
   *   · `width: min(128vw, 1600px)` + `aspect-ratio`
   *     ⇒ 纹理比版心宽、大尺度；`aspect-ratio` 锁住比例，
   *       `contain` 才不会把图拉变形（这张是 1920×1045 ⇒ 1.837:1）。
   *   · `opacity: .2` + `z-index: -1`
   *     ⇒ 退到正文**之下**、压成极淡的墨纹 —— 这正是「纸白阅读底一字不改」
   *       （口径 #1）的前提：纹理只做氛围，不承载任何信息。
   *
   * ⚠ `opacity: .2` 是**照抄百褶 ∞**，与上一版「不加 opacity」相反 ——
   *   那条是针对「铺满视口的深绿大图」说的（那时要的是冲击力）；
   *   现在回到「纸白区纹理」这个角色，淡墨纹才是对的。
   *   代价：月相与纯蓝强调色都会被压到 20% 不透明度
   *   ⇒ 这是站主要求的必然结果（他说的是「替代百褶∞ 那个位置」），
   *     不是实现偷工。若嫌太淡，唯一该动的是这个数值（0.2 → 0.3 之类），
   *     改这里一处即可，别去动图本身。
   * =================================================================== */
  /* ===================================================================
   * 底纹层挂法 —— 与百褶 ∞ 同位（2026-10-03 第三轮口径）
   *
   * 站主原话：「只保留排版，其他什么背景签名全部恢复原样，
   *   背景恢复后把月相和蓝条替代背景上本来的百褶无限符号」
   *
   * ★ **同位**：挂法逐条照抄 Topbar 的 `body.chrome-page .page-inf`
   *   （fixed 挂视口居中、`min(128vw,1600px)`、`aspect-ratio`、
   *     `object-fit:contain`、`opacity:.2`、`z-index:-1`、不拦指针）
   *   —— 全站纸白区只有一套纹理语言，本页换的是**母题**（∞ → 月相），不是角色。
   *
   * ★★ 唯一不能照抄的是素材本身，这一条是**目检逼出来的**（踩了两轮）：
   *   百褶 ∞ 那张 `inf-orig.webp` 是**白底**图 ⇒ 矩形底与纸白底同色 ⇒ 看不出边界。
   *   月相这张是**纯黑底**图 ⇒ 即使 `opacity:.2`，矩形内也是
   *   0.2×黑 + 0.8×纸白 = 一片灰，与矩形外的纸白**有色差**
   *   ⇒ 截图上一眼能看见一条矩形下边界（实测 x=60：y≤300 是 rgb(250,250,247)、
   *     y=700~1100 是 rgb(203,204,201)，差 47/255）。
   *   第一轮试 `mix-blend-mode: multiply` —— **压不住**：
   *   multiply 只改色、不裁形状，而图本身是个**不透明矩形**；
   *   把 z-index 提到 0 让它与 body 纸白底同层之后，矩形边依然在（实测截图复验）。
   *   ⇒ 正解在**素材侧**（`_probe/_deep-plate.mjs`）：把纯黑底转成 **alpha**，
   *     图只剩月亮 / 星芒 / 蓝带 / 山脊的形状 ⇒ 矩形在数学上不存在。
   *     素材处理完，这一层就与百褶 ∞ **完全同参数**，不需要任何额外花招。
   * ★ 所以这里刻意**不写** mix-blend-mode、也**不写** opacity 之外的 blend 相关属性：
   *   那些是为「不透明矩形底」打的补丁，素材修好后就该撤掉。
   * =================================================================== */
  .ref-plate {
    position: fixed;
    left: 50%;
    top: 50%;
    width: min(128vw, 1600px);
    aspect-ratio: 1920 / 1045;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: -1;
    opacity: 0.2;
  }
  .ref-main {
    width: 100%;
    height: 100%;
    line-height: 0;
  }
  .ref-main > picture,
  .ref-main > img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    max-width: none;
  }

  /* ★★ 必须**关掉**本页的百褶 ∞（`.page-inf`，由 Topbar 渲染，全站内页共用）。
     不关的话两套母题会叠在一起 —— Topbar 注释里已记过这个教训
     （「切片档案」四层换 ∞ 底纹时就是因为叠着才整体删掉）。
     ⚠ 用 `:global(body.about-plate .page-inf)`：
       `.page-inf` 是 Topbar 的元素、带的是**别的**作用域属性；
       且 `body.chrome-page .page-inf` (0,2,1) 权重高于裸 `.page-inf` (0,1,0)
       ⇒ 不对齐权重压不住它。
     关法用 `display: none` 而不是 `opacity: 0`：
       后者仍占层、仍可能被合成层吃掉 GPU（这层是 fixed 满屏，很贵）。 */
  :global(body.about-plate .page-inf) {
    display: none;
  }

  /* ★★ body 的不透明纸白底**必须留着**（与上一版相反）。
     上一版为了让「深绿大图」透出来，把 `body.about-plate` 改成 `background: transparent`
     并给每个内容块加纸托底（`.prose::before` / `.fig-block::before` / `.page-paper`）。
     现在底纹回到「z-index:-1 的淡墨纹」⇒ 它在 body 背景**之下**才正常
     （-1 的元素画在 body 背景之下，这是 z-index:-1 的定义），
     ⇒ body 保持 `var(--paper)` 不透明即可，**所有纸托底一并删除**。

     为什么必须是这样，而不是「body 透明 + 逐块垫纸」：
       · 逐块垫纸是 2026-10-03 踩了**四轮**才做对的东西（两次被月亮劈开、
         一次纸把月亮吃掉、一次纸与内容错位），根因是「深色大图必须被不透明纸压住」。
       · 而现在纹理是淡墨纹，**不需要**任何东西压它
         （实测百褶 ∞ 就是裸挂在 body 纸白底上的）。
       · 少一层纸 = 正文的对比度由 body 一次性保证，不必逐块维护。
     红线「正文排版不动」也因此更稳：删掉 `::before` 之后
     `.prose` 的内容盒回到最干净的状态（此前 `::before` 一直挂在它身上）。 */

  /* ===================================================================
   * 纸托底 —— **整段已删**（2026-10-03 站主第三轮口径）
   *
   * 下面是踩了三轮才做对的东西，删掉之前先把为什么删写清楚（别手滑加回来）：
   *   ① 两条竖条 + 中间留缝 ⇒ 月亮被劈成两半；
   *   ② 一整块纸盖满版心 ⇒ 正文可读了，但月亮被整块吃掉；
   *   ③ 分段但用写死的 % ⇒ 纸与内容错位，文字直接压在图上。
   * 这三轮的共同前提是：**背景是一张铺满视口的深绿大图**，
   * 文字压不住 ⇒ 必须有不透明纸垫在下面。
   *
   * ★ 现在底纹回到 `z-index: -1` + `opacity: .2` 的淡墨纹
   *   （＝百褶 ∞ 那一层的角色），它画在 body 纸白底**之下**
   *   ⇒ 不需要任何东西压它，跟百褶 ∞ 当年一样是裸挂的。
   * ⇒ 一并删除的东西：`.sign-card::before` / `.prose::before` / `.fig-block::before`
   *   / `.page-paper` 真元素 / `.ref-paper` 那两条写死 % 的分段纸 / body 的 transparent。
   * ⇒ 顺带收益：`.prose` 的内容盒回到最干净的状态（此前 `::before` 一直挂在它身上），
   *   红线「正文排版不动」少了一层需要维护的东西。
   *=================================================================== */

  /* 页头：宽屏两栏（标题左 / 头像右），窄屏单列纵向流。
     ★ `display: grid` **只在媒体查询里写一次**（见下方 `@media (min-width:1024px)`），
       这里**不重复声明** —— 同元素两处各写一次 display 时后写的赢（这个坑踩过：
       外层 grid 被媒体查询的 flex 覆盖）。 */
  .pagehead {
    position: relative;
  }
  /* ★★ 页头网格必须**逐项显式指定落位**（2026-10-03 实测出来的坑）。
     之前只写 `grid-template-columns: 1fr auto` 让浏览器自动放置，结果是：
       实测 h1 x=562（落在**右**列）、.profile x=101（落在**左**列）
     ⇒ 标题和头像左右**调换**了（与设计意图相反）。
     根因：网格项按源码顺序自动-flow，`.fig-no` 先占 (1,1)，
     于是 `h1` 被挤到 (1,2)、`.profile` 到 (2,1)。
     ⇒ 显式落位，顺序无关：编号通栏（1/-1）· 标题左列 · 头像右列。

     ★ 标题为什么用 `:global()` 而不是 `.pagehead > h1`（实测踩过）：
       Astro 的 scoped CSS 会给选择器尾部加本页 cid 属性，
       `.pagehead > h1` 编译成 `.pagehead[本页cid] > h1[本页cid]`；
       而这个 h1 是 **PageTitle 组件**渲染的，元素上带的是**组件自己的** cid
       ⇒ 属性选择器**不匹配** ⇒ 规则整条静默失效（不报错、不警告）。
       当时纸（`.page-paper`，本页元素 ⇒ 匹配成功）拿到 position:absolute + z-index:0，
       标题既static 又无 z-index ⇒ **纸把标题整个盖住**，页头一片空白。
       ★ 现在纸已删、底纹是 z-index:-1，这个失效**不再有可见症状**，
         但规则本身仍要写对（落位得真生效，否则左右又会调换）。
       代价与边界：`:global()` 让这条规则离开本页作用域，
       但它以 `.pagehead >` 为前缀（该类是本页独有）⇒ 影响面仅关于页。 */
  .pagehead > .fig-no { grid-column: 1 / -1; grid-row: 1; }
  :global(.pagehead > h1) { grid-column: 1; grid-row: 2; }
  .pagehead > .profile { grid-column: 2; grid-row: 2; }

  /* 块与块之间的间距。
     ★ 这里曾用 `margin-bottom` 在「纸与纸之间露出背景图」——
       纸已删（底纹回到淡墨纹，本来就铺满视口、不需要留缝），
       间距改由各块自己的 margin 承担。 */
  .prose,
  .fig-block {
    margin-bottom: var(--sp-7);
  }

  /* ---- 标本编号：等宽字 + 大字距 = 「标本标签」的印刷感，也是仪器语汇的延续 ---- */
  .fig-no,
  .fig-idx {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    color: var(--accent-ink);
    font-variant-numeric: tabular-nums;
  }
  /* 编号与 h2 各占一行、之间留气：编号是「标签」不是标题，不能抢 h2 的节奏。 */
  .fig-no {
    margin: 0 0 var(--sp-2);
    color: var(--muted);
  }
  .fig-h {
    margin: 0 0 var(--sp-3);
    font-size: var(--fs-lg);
    font-weight: 800;
  }
  .fig-block {
    position: relative;
  }

  /* ★ 签名的样式（.sign-card/.sign-head/.sign-img）**已删**（2026-10-03 第三轮口径）。
     宽度那套`min(380px, 100%)` 的收窄结论仍然有效，将来要恢复签名时直接用。 */

  /* ---- 社交卡 / 技术栈：站主 2026-10-03 第二轮「不做卡片」⇒
     改成**细线分隔的列表**（上边框分隔、无卡片框、无底色）----
     ★ 为什么彻底去框：参考图里那些元素是「浮在纸上」的不是「装在盒子里」；
       保留 --panel 底色会让每一行都变成一个独立的方块，与底纹层打架。 */
  .social {
    border-top: 1px solid var(--hair);
  }
  .social a {
    border: 0;
    border-bottom: 1px solid var(--hair);
    background: transparent;
    padding: var(--sp-3) 0;
  }
  .social a:hover,
  .social a:focus-visible {
    background: var(--accent-wash);
    /* 悬停时给一点左内边距，让它看起来「被抽出」而不是「被点亮」 */
    padding-left: var(--sp-2);
  }
  .stack-group {
    border: 0;
    border-top: 1px solid var(--hair);
    background: transparent;
    padding: var(--sp-4) 0;
  }
  /* 卡片是标本 ⇒ 不再圆角。原有的 hover 反馈保留（accent-wash 那一档）。 */
  .social a {
    position: relative;
  }
  .social a .fig-idx {
    position: absolute;
    top: 0;
    right: 0;
    padding: 0 0.3em;
    background: var(--paper);
    color: var(--muted);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
  }
  .stack-items li {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
  }

  /* ---- 语言占比条：条形保留（它是构建期实测的真读数），下面加一道刻度尺 ---- */
  .lang-rule {
    position: relative;
    height: 6px;
    margin-top: var(--sp-2);
    border-bottom: 1px solid var(--hair);
  }
  .lang-rule i {
    position: absolute;
    bottom: 0;
    width: 1px;
    height: 3px;
    background: var(--hair);
  }
  /* 0% 那一道加高一档，给个「起点」 */
  .lang-rule i:first-child {
    height: 6px;
    background: var(--accent-ink);
  }
  .pagehead {
    max-width: var(--measure);
  }
  /* ---- 头像 ---- */
  /* 手机端：头像与「北杉」必须**同一条中轴**（站主 2026-09-27："头像移到北杉正上方，歪了"）。
     用 flex 列 + align-items:center 而不是 text-align:center ——
     后者对 Astro `<Image>` 产出的图片无效（它是块级元素，text-align 管不到它，
     实测头像被左对齐、名字居中，于是看着是歪的）。 */
  .profile {
    margin: var(--sp-6) 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--hair);
    background: var(--panel);
  }
  .profile-name {
    margin: var(--sp-2) 0 0;
    font-size: var(--fs-sm);
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  /* 宽屏：页头变成**两栏** —— 标题在左、头像在右（都留在正文流里 ⇒ 位置固定不变、且跟着页面滚）。
     为什么不用 position:fixed：① 不跟滚动；② 过渡动画给 .shell 加的 transform 会把 fixed 的包含块
