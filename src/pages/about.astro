---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import FinInfinity from '../components/FinInfinity.astro';
import SocialIcon from '../components/SocialIcon.astro';
import gallery from '../../public/gallery/manifest.json';
import { coverPresentation, type GalleryAlbum } from '../lib/gallery-stage';
import { LANGUAGE_STATS_DIRS, readLanguageStats } from '../lib/lang-stats';

const entry = await getEntry('pages', 'about');
const Content = entry ? (await render(entry)).Content : null;
interface Social { icon: string; name: string; href: string; note?: string }
interface AboutData {
  avatar?: string; avatarName?: string; social?: Social[];
  stack?: {group: string; items: string[]}[];
  presentation?: {
    identity?: string; greeting?: string[]; technologyTitle?: string[]; languageTitle?: string[];
    socialCaption?: string[]; technologyCaption?: string[]; languageCaption?: string[];
    personalTitle?: string; interests?: {label: string; href?: string}[];
  };
}
const d = (entry?.data ?? {}) as AboutData;
const p = d.presentation ?? {};
const assets = import.meta.glob<{default: ImageMetadata}>('/src/assets/about/*.{jpg,jpeg,png,webp,avif}', {eager: true});
const avatar = d.avatar ? assets[`/src/assets/about/${d.avatar}`]?.default : undefined;
const social = d.social ?? [];
const stack = (d.stack ?? []).filter(g => g.items?.length);
const email = social.find(s => s.href.startsWith('mailto:'))?.href.slice(7);
const intro = entry?.body?.trim().split(/\r?\n\s*\r?\n/)[0] ?? '';
const languageStats = readLanguageStats();
const total = languageStats.reduce((n, row) => n + row.bytes, 0).toLocaleString('en-US') + ' B';
const colors = ['var(--accent)', 'var(--accent-ink)', 'var(--signal)', 'var(--muted)'];
const photoLinks = (gallery.albums as GalleryAlbum[]).flatMap((album, index) => {
  const cover = coverPresentation(album, index);
  return cover ? [{ title: album.title, ...cover }] : [];
}).slice(0, 3);
const groupNotes: Record<string,string> = {构建:'如何写成',服务:'如何运转',呈现:'如何呈现'};
---
<Base title="关于" current="about" chrome="page" bodyClass="about-plate" fullWidth>
  <Fragment slot="plate">
    <div class="about-dots" data-dot-grid data-dot-base="--about-dot-base" aria-hidden="true"></div>
    <FinInfinity />
  </Fragment>
  <div class="about-page about-grid" data-about-redesign="4">
    <section class="scene social-scene" id="social" data-motion-stop="0" aria-labelledby="profile-title">
      <div class="scene-copy">
        <header class="profile-header">
          <div class="profile-mark">
            {avatar && <Image class="avatar" src={avatar} alt={`${d.avatarName ?? '站主'}的头像`} widths={[96,192]} sizes="52px" />}
            <p class="profile-name">关于{d.avatarName}<span>{p.identity}</span></p>
          </div>
          <h1 id="profile-title">{(p.greeting ?? ['关于']).map((line,i)=><>{i>0 && <br />}{line}</>)}</h1>
        </header>
        <p class="intro">{intro}</p>
        <div class="social-heading"><h2>在这些地方找到我</h2>{email && <button class="copy-mail" data-copy-mail={email}>复制邮箱 ⧉</button>}</div>
        <div class="social-list" data-about-spotlight>{social.map(s => <a class="social-link" href={s.href} {...(/^https?:/i.test(s.href)?{target:'_blank',rel:'noopener noreferrer'}:{})}>
          <span class="social-icon"><SocialIcon name={s.icon} /></span><span>{s.name}<small>{s.note}</small></span><span class="visit" aria-hidden="true">↗</span>
        </a>)}</div>
        <p class="copy-status" role="status" aria-live="polite"></p>
      </div>
      <div class="scene-space profile-art" aria-hidden="true"><p class="scene-caption">{p.socialCaption?.map((line,i)=><>{i>0 && <br />}{line}</>)}</p></div>
      <a class="next-scene" href="#technology"><span>这个站是怎么搭起来的</span><span aria-hidden="true">↓</span></a>
    </section>
    <section class="scene technology-scene" id="technology" data-motion-stop="1" aria-labelledby="tech-title">
      <div class="scene-space" aria-hidden="true"><p class="scene-caption">{p.technologyCaption?.map((line,i)=><>{i>0 && <br />}{line}</>)}</p></div>
      <div class="scene-copy"><p class="kicker">技术栈</p><h2 class="section-title" id="tech-title">{p.technologyTitle?.map((line,i)=><>{i>0 && <br />}{line}</>)}</h2>
        <div class="stack-groups">{stack.map((g,i)=><section class={`stack-group group-${i}`}><h3><span>{g.group}</span><small>{groupNotes[g.group]}</small></h3><ul>{g.items.map(item=><li>{item}</li>)}</ul></section>)}</div>
      </div>
    </section>
    <section class="scene language-scene" id="languages" data-motion-stop="2" aria-labelledby="lang-title">
      <div class="scene-copy"><p class="kicker">源码语言占比</p><h2 class="section-title" id="lang-title">{p.languageTitle?.map((line,i)=><>{i>0 && <br />}{line}</>)}</h2>
        <p class="section-intro">页面、交互、内容，还有它们背后的代码。</p>
        <div class="language-overview" data-about-meter aria-hidden="true">{languageStats.map((row,i)=><span title={`${row.name} ${row.pct}%`} style={`flex-grow:${row.bytes};background:${colors[Math.min(i,3)]}`}></span>)}</div>
        <ul class="language-list">{languageStats.map((row,i)=><li class="lang-row">
          <div class="language-label"><span class="lang-name">{row.name}</span><span class="lang-pct">{row.pct}%</span></div>
          <div class="language-meter" aria-hidden="true"><i data-about-meter style={`width:${row.pct}%;background:${colors[Math.min(i,3)]}`}></i></div>
          <div class="lang-bytes">{row.bytes.toLocaleString('en-US')} B</div>
        </li>)}</ul>
        <details class="stats-scope"><summary>统计范围与口径</summary><p class="lang-total">构建时读取当前仓库，合计 <b>{total}</b>。范围为 {LANGUAGE_STATS_DIRS.join('、')}；排除第三方副本、图片、字体、缓存和临时文件，与 GitHub 的语言统计口径不同。</p></details>
      </div>
      <div class="scene-space" aria-hidden="true"><p class="scene-caption">{p.languageCaption?.map((line,i)=><>{i>0 && <br />}{line}</>)}</p></div>
    </section>
    <section class="personal" id="personal" aria-labelledby="personal-title">
      <div class="personal-heading">
        <p class="kicker">也关于我</p>
        <h2 id="personal-title">{p.personalTitle}</h2>
        <ul class="interests">{p.interests?.map(item => <li>{item.href ? <a href={item.href}>{item.label} <span aria-hidden="true">↗</span></a> : item.label}</li>)}</ul>
      </div>
      <div class="personal-copy">
        <div class="prose">{Content && <Content />}</div>
        {photoLinks.length > 0 && <ul class="photo-links" aria-label="相册入口">
          {photoLinks.map(photo => <li><a href={photo.href}>
            <img src={photo.thumbnail} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
            <span class="photo-label">{photo.title}<span aria-hidden="true">↗</span></span>
          </a></li>)}
        </ul>}
      </div>
    </section>
  </div>

  <nav class="chapter-nav" aria-label="关于页章节">
    <span class="chapter-indicator" data-chapter-indicator aria-hidden="true"></span>
    <a href="#social" data-chapter="social" aria-current="true">联系我</a>
    <a href="#technology" data-chapter="technology">技术栈</a>
    <a href="#languages" data-chapter="languages">源码语言</a>
    <a href="#personal" data-chapter="personal">个人介绍</a>
  </nav>
</Base>
<script>
  import '../scripts/about-page';
  import '../scripts/page-dots';
</script>
<!-- 正式站保留公共导航、搜索、账户与统计，关于页自己的样式只在本页生效。 -->
