---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import SocialIcon from '../components/SocialIcon.astro';

// 关于页正文来自 content/pages/about.md —— 主题不持有任何正文（content-model.md §7）
const entry = await getEntry('pages', 'about');
const Content = entry ? (await render(entry)).Content : null;

/** 头像与社交账号（站主 2026-09-26 要求）也走内容层：文件在 src/assets/about/，配置在 about.md 的 frontmatter。
 *  头像必须放 src/ 才能参与构建期优化（转 WebP + 出 srcset）—— 与「说说配图」同一条例外。 */
interface Social {
  icon: string;
  name: string;
  href: string;
}
/** 技术栈（站主 2026-09-28 要求：放在社交账号下方）。同样走内容层 about.md 的 `stack`，
 *  与社交账号同一条例外理由：这是站主自己的信息，不该硬编码在主题里。 */
interface StackGroup {
  group?: string;
  items?: string[];
}
interface AboutData {
  avatar?: string;
  avatarName?: string;
  social?: Social[];
  stack?: StackGroup[];
  /** 手写签名（站主 2026-10-03 提供原件）。走内容层，与 avatar 同一条理由：
   *  图片放 src/assets/about/ 才能参与构建期优化（转 WebP + 出 srcset）。 */
  signature?: string;
  /** 签名切片底部那行小字（等宽字、读数感）。也在内容层——它是站主自己的话。 */
  signatureNote?: string;
}

/* ===== 语言占比条（站主 2026-09-30 要求「更新技术栈并加一个这个」）=====
   **数据是实测值，不是抄来的。** 站主第一次给的 GitHub 风格截图是旧数据，
   他随即纠正「那个图片里的是旧的还没更新，你根据现在的数据做」——
   所以这里按**本站当前源码**重新量，一行命令可复算：

     for e in astro ts css md; do
       find src content functions -name "*.$e" -type f \
         | xargs wc -c | tail -1
     done

   口径（与 GitHub linguist 一致）：
     · 只统计**自己写的代码**：src/ + content/ + functions/
     · 不含 node_modules/、dist/、public/、图片、字体 —— 语言占比统计的是代码，不是整站体积
     · 同扩展名合并为同一语言（.astro / .ts / .css / .md）

   实测（2026-09-30）：
     .astro 170,036 B · .ts 136,909 B · .css 95,103 B · .md 45,784 B → 合计 447,832 B

   配色按站主 2026-09-30 指定：「用我博客风格的颜色，绿色全色系，黑，白，灰和少量橙色系」
   —— 全部取自 tokens.css 真值，**没有一个自创色**：
     Astro（最大段）走绿的三档渐变 accent-ink → accent → accent-bright
     TypeScript 走 accent-ink（深绿）
     CSS 走 --muted（灰）
     Markdown 走 --signal（橙，唯一一处 —— 沿用它在 tokens 里「少量信号色」的语义） */
interface LangRow {
  name: string;
  bytes: string;
  pct: string;
  /** 条的宽度（与 pct 同值，内联 style 用） */
  w: string;
  /** 段底色：CSS 值，全部由 token 拼出 */
  fill: string;
  /** 图例圆点：必须纯色（渐变在图例小圆点上会渲染成全透明） */
  dot: string;
  note: string;
}
const LANGS: LangRow[] = [
  { name: 'Astro', bytes: '170,036 B', pct: '38.0%', w: '38.0%',
    fill: 'linear-gradient(90deg, var(--accent-ink) 0%, var(--accent) 55%, var(--accent-bright) 100%)',
    dot: 'var(--accent)', note: '页面与组件（29 个 .astro）' },
  { name: 'TypeScript', bytes: '136,909 B', pct: '30.6%', w: '30.6%',
    fill: 'var(--accent-ink)', dot: 'var(--accent-ink)', note: '内容集合 / 脚本 / Cloudflare Functions（23 个 .ts）' },
  { name: 'CSS', bytes: '95,103 B', pct: '21.2%', w: '21.2%',
    fill: 'var(--muted)', dot: 'var(--muted)', note: '设计令牌 / 开场 / 过渡 / 版式（9 个 .css）' },
  { name: 'Markdown', bytes: '45,784 B', pct: '10.2%', w: '10.2%',
    fill: 'var(--signal)', dot: 'var(--signal)', note: '文章与页面正文（14 篇 .md）' },
];
const LANG_TOTAL = '447,832 B';
const d = (entry?.data ?? {}) as unknown as AboutData;
const assets = import.meta.glob<{ default: ImageMetadata }>('/src/assets/about/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const avatar = d.avatar ? assets[`/src/assets/about/${d.avatar}`]?.default : undefined;
const signature = d.signature ? assets[`/src/assets/about/${d.signature}`]?.default : undefined;

/* 参考图底纹（第2 步，2026-10-03）—— **构建期已裁成小图**，不是 CSS 取景。
   ★ 为什么必须裁文件：CSS 的 overflow:hidden + 偏移能在浏览器里「取景」，
     但**浏览器仍会下载整张原图**。原图 1080×1791~2355、3–4 MB 三张 ⇒ 关于页 10 MB+。
   ★ 裁切用的是 sharp —— **astro 自带的依赖**（astro 的 package.json 有 "sharp": "^0.35.4"），
     不是新增运行时依赖，不违反「只允许 astro / @astrojs/rss / @astrojs/sitemap」。
   ★ 元素全部取自站主给的参考图，**不自己画**（手绘 SVG 雕像实测砸过三次：蘑菇→emoji→火柴人）。
     月相序列 + 维纳斯雕像取自同一段（风格一致，且都是白底）；
     d 图虽有罗马雕像但**底是蓝色**，蓝底转绿会与「白底 + 墨绿」的整体调子打架 ⇒ 没用它。
   裁切参数（段内百分比、白点分位数等）见 `_probe/_ref-plate.mjs`，可复算、可改。 */
const PLATE_SRCS = import.meta.glob<{ default: ImageMetadata }>('/src/assets/about/plates/*.webp', { eager: true });
const plate = (name: string) => PLATE_SRCS[`/src/assets/about/plates/${name}.webp`]?.default;
const social = d.social ?? [];
// 空组不渲染（内容层写错分组时不至于留一个空卡片）
const stack = (d.stack ?? []).filter((g) => (g?.items ?? []).length > 0);
const isExternal = (h: string) => /^https?:/i.test(h);
---
{
  /* 关于页迁移（2026-09-26）：chrome='band' → 'page'（内页外壳：浅色顶栏 + 切片档案背景）。
     **'page' 不渲染 <slot name="band" />** —— 所以标题必须从那个槽搬进正文流（外壳提供的 .pagehead），
     漏搬会静默消失且构建照常成功（文章页同一个坑）。
     PageTitle 本身不写任何颜色（只有 margin/font-weight + 字号类 token），**靠继承取色** ——
      搬进浅底后自动继承外壳的 --ink，所以**无需主题化**（已读源码确认，见 docs/about-migration-notes.md）。
      版式依据不是原型：prototype/terminal/ 里没有关于页，依据是既有内页外壳的实测实现（/gallery 与文章页）。 */
}
<Base title="关于" current="about" chrome="page" bodyClass="about-plate">
  {/* 头像（站主 2026-09-26 要、2026-09-27 改）：
      **必须和标题放在同一个页头里**，桌面靠 grid 排到右边、手机在标题下方居中。
      为什么不用 `position: fixed`（第一版就是这么写的，被站主抓了）：
        ① 它会**不跟页面滚**（站主："要求跟随鼠标滚轮上下而上下"）；
        ② 更要命的：过渡动画给 `.shell` 加了 `transform: scale(0.98→1)`，而被 transform 的祖先会成为
           `position: fixed` 的**包含块** ⇒ 头像按"相对 .shell"定位；动画结束、类被摘掉后 transform 变 none，
           包含块又换回视口 ⇒ **位置突变，视觉上就是"加载后跳一下"**（实测从 y=246 跳到 y=198，48px）。
      改成布局定位后这两个问题一起消失：位置由排版决定（不会变），元素在正文流里（自然跟着滚）。 */}
  {/* ===================================================================
   * 标本馆底纹层（REFERENCE PLATE）—— 站主 2026-10-03 第二轮口径
   *
   * 站主四条要求，逐条对应：
   *   ① 头像上面不要有线   ⇒ 见下面 .profile 的样式（刻度环与排线已删）
   *   ② **直接用参考图里的素材**（月相 / 雕像 / 飞鸟 / 星芒），不自己画
   *   ③ **直接放背景里**，不做成独立卡片 ⇒ 就是这一层，铺满视口
   *   ④ **背景用白色** ⇒ 底色 --paper，参考图按亮度差透明化后染成墨绿
   *
   * ★★ 第 2 步（2026-10-03）：参考图底纹素材走**构建期图片管线**。
   *   本机 Chrome canvas 那条路今天卡了三次（症状都是「不报错、只是收不到结果」，
   *   真因是 execFileSync 阻塞事件循环 ⇒ 同进程的服务无法响应），
   *   而 astro:assets 已在站内跑着（头像与签名都走它）⇒ 复用它最省、最可复算。
   *
   * ★ 取哪几段（互不重复、不冲突）：
   *   月相盘 + 直尺 · 雕像群像 · 飞鸟 + 星芒 · 树 + 新月
   *   灰度 + 墨绿全部用 CSS filter 现场做（grayscale + sepia + hue-rotate）——
   *   **不做像素处理**：逐像素改色会把原图的浓淡与拼贴层次一起抹平。
   * =================================================================== */}
  <div class="ref-plate" aria-hidden="true">
    {/* ★ 站主 2026-10-03 16:37 指定：**直接拿这一张当背景**，
       纯黑底改成偏黑的深绿（`#131b17`，站内 `--dusk-2`）。
       「纯黑 → 深绿」是**构建期**做的（`_probe/_deep-plate.mjs`，用 sharp）：
       灰阶像素按「越暗染得越多」混向深绿，白月亮与星芒保持白；
       **彩色像素（那条纯蓝横带、轨道线）一格不动** —— 它就是强调色。
       实测：白月亮 on #131b17 = 17.55:1；纯蓝带 = 2.04:1（纯装饰图形，
       且是站主指定作品的一部分 ⇒ 记录实测值，不做数值上的假通过，详见脚本头）。*/}
    {plate('moon-main') && (
      <div class="ref-main">
        <Image
          class="ref-img"
          src={plate('moon-main')!}
          alt=""
          widths={[960, 1920]}
          sizes="100vw"
          loading="eager"
          decoding="sync"
        />
      </div>
    )}
    {/* 纸托底：文字区铺一层**不透明**的纸，让正文压得住这张深色大图。
        （半透明白纱不行—— 那等于把图洗淡，站主要的原色与繁复线条会再被抽掉一次。）*/}
    <div class="ref-paper" aria-hidden="true"></div>
  </div>

  {/* ===================================================================
   * 两栏容器（站主 2026-10-03：「右半部分太空，重新排版」）
   *
   * 为什么这么分：内容天然分两类 ——
   *   · **叙述类**（页头 / 签名 / 正文）要窄、要安静⇒ 左边一栏，宽度就是 --measure
   *   · **读数类**（社交 / 技术栈 / 语言占比）天生是清单与仪表 ⇒ 右边一栏，占满余宽
   * 分栏后 1280 视口的右半不再是空的，而清单类内容**比正文更适合窄栏堆叠**
   * （行短、易扫读），布局与内容是匹配的，不是硬塞。
   *
   * ★ 关键：**不改变 DOM 里的阅读顺序**。签名仍在正文之前（移动端尤其重要）。
   *   办法是移动端把 aside 设成 `display:contents` —— 它不生成盒子，
   *   子元素直接参与父级流动，于是视觉顺序 = main 的三个 + aside 的三个，
   *   与改造前**逐项一致**。（若用 grid 显式指定行列，两栏的 DOM 顺序就会决定
   *   移动端顺序，签名会掉到正文后面。）
   * =================================================================== */}
  <div class="about-grid">
  <div class="about-main">
  <header class="pagehead">
    {/* ★ 站主 2026-10-03：「我的头像上面不要有线」⇒原来的圆形刻度环（量规语汇）
        与头像上的排线**全部去掉**，头像回归纯圆形照片。
        刻度与量规的语汇改由页头那根 `--hair` 细线与各区块的 `FIG.0x` 编号承担。

        ★★ 页头纸托底（2026-10-03 目检后补，实测依据）：
          页头整段落在背景大图上（实测 pagehead y=490..918，图高 772）⇒ 标题与
          「关于」两字直接压深色底，完全读不出来（`.page-paper` 查无此元素 ⇒ 纸丢了）。
          ⇒ 纸必须是**真元素**而不是 `::before`：`.pagehead` 是 grid 容器，
            伪元素会按 grid item 参与轨道计算，`inset` 被算坏（见下方 CSS 注记）。
            纸铺 `grid-area: 1/1/-1/-1` 跨全部网格区，负 margin 向外撑出纸边。*/}
    <div class="page-paper" aria-hidden="true"></div>
    <p class="fig-no" aria-hidden="true">FIG.00 — PROFILE</p>
    <PageTitle>关于</PageTitle>
    {avatar && (
      <div class="profile">
        <Image class="avatar" src={avatar} alt={`${d.avatarName ?? '站主'}的头像`} widths={[96, 192]} sizes="128px" />
        <p class="profile-name">{d.avatarName} · SPECIMEN 00</p>
      </div>
    )}
  </header>

  {/* ===== HAND 亲笔 · 签名（站主 2026-10-03）=====
      ★ 站主 2026-10-03 第二轮口径：「**这个是直接放到背景里，不要单独做一个卡片**」
        ⇒ 深底板取消、编号小字与图同宽排在图上方，签名直接落在纸白底上。
        （上一版那套--dusk-2 深底切片是从「深底才有冲击力」的思路来的，
          但既然底纹走白底，深底板就成了页面里唯一的孤岛 —— 去掉更干净。）
      ★ 签名是站主手迹原件：已抠掉白底（转成带 alpha 的图）、转成站内墨绿。
        加工脚本见 _probe/hand-sign-prep.mjs（该目录已 gitignore；
        成品 src/assets/about/sign.png 进仓，参与构建期优化：56 KB → WebP 18 KB）。
      ★ 落笔 = 横向揭幕（clip-path inset 从 100% 走到 0），不是逐笔 —— 位图没有路径。 */}
  {signature && (
    <figure class="sign-card" data-sign-card>
      <figcaption class="sign-head">
        <b>FIG.01 — HAND</b>
        <span>{d.signatureNote}</span>
      </figcaption>
      <Image
        class="sign-img"
        data-sign-img
        src={signature}
        alt={`${d.avatarName ?? '站主'}的手写签名`}
        widths={[340, 680]}
        sizes="340px"
      />
    </figure>
  )}

  <div class="prose">{Content && <Content />}</div>
  </div><!-- /.about-main -->

  <aside class="about-side" aria-label="站点信息">
  {social.length > 0 && (
    <section class="social-block fig-block" aria-labelledby="social-title">
      <p class="fig-no" aria-hidden="true">FIG.02</p>
      <h2 class="fig-h" id="social-title">我的一些社交账号</h2>
      <ul class="social">
        {social.map((s, i) => (
          <li>
            <a
              href={s.href}
              {...(isExternal(s.href) ? { rel: 'noopener' } : {})}
              {...(isExternal(s.href) ? { target: '_blank' } : {})}
            >
              <span class="fig-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <SocialIcon name={s.icon} />
              <span>{s.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {stack.length > 0 && (
    <section class="stack-block fig-block" aria-labelledby="stack-title">
      <p class="fig-no" aria-hidden="true">FIG.03</p>
      <h2 class="fig-h" id="stack-title">技术栈</h2>
      <div class="stack-groups">
        {stack.map((g) => (
          <div class="stack-group">
            {g.group && <p class="stack-group-name">{g.group}</p>}
            <ul class="stack-items">
              {(g.items ?? []).map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )}

  {/* 技术栈占比条（站主 2026-09-30：「更新技术栈并加一个这个」）——紧跟在技术栈之后，同一个位置。
      数据口径：**本站源码实测**（站主拍板的那一档），不是抄原型那组——
      原型是 HTML 单文件，它的 JS 占 93.1%（含 three.js 整包），与本站毫无可比性。
      条宽直接用百分比当 CSS 宽度；每段配一个纯色圆点做图例
      （渐变在小圆点上会渲染成全透明，所以 dot 与 fill 是两个字段）。 */}
  {LANGS.length > 0 && (
    <section class="lang-block fig-block" aria-labelledby="lang-title">
      <p class="fig-no" aria-hidden="true">FIG.04</p>
      <h2 class="fig-h" id="lang-title">源码语言占比</h2>
      <p class="lang-total">
        本站源码实测 · 合计 <b>{LANG_TOTAL}</b>（<code>src/</code> 与 <code>functions/</code>，不含依赖与构建产物）
      </p>
      <ul class="lang-list">
        {LANGS.map((l) => (
          <li class="lang-row">
            <span class="lang-head">
              <i class="lang-dot" style={`background:${l.dot}`} aria-hidden="true"></i>
              <span class="lang-name">{l.name}</span>
              <span class="lang-bytes">{l.bytes}</span>
              <span class="lang-pct">{l.pct}</span>
            </span>
            <span class="lang-bar" aria-hidden="true">
              <s class="lang-fill" style={`width:${l.w};background:${l.fill}`}></s>
            </span>
            <span class="lang-note">{l.note}</span>
          </li>
        ))}
      </ul>
      {/* 刻度尺：每 10% 一道，纯装饰（aria-hidden）。它是「读数」的延伸，不是新数据。 */}
      <div class="lang-rule" aria-hidden="true">
        {Array.from({ length: 10 }, (_, i) => <i style={`left:${i * 10}%`}></i>)}
      </div>
    </section>
  )}
  </aside><!-- /.about-side -->
  </div><!-- /.about-grid -->
</Base>

<script>
  // 签名落笔（横向揭幕）。与页面其余部分刻意无耦合：只读 [data-sign-img]，不碰别的节点。
  // 写法照 archive.astro 那台卷尺：独立入口的 <script>，不与内联逻辑混在一起。
  import '../scripts/hand-sign';
</script>

<style>
  /* 拍板 D：页头版心收成 --measure，与正文列左对齐（与文章页同一条）。 */

  /* ===================================================================
   * 标本馆（SPECIMEN CABINET）—— 站主 2026-10-03 定的版式语言
   *
   * 参照物是一组「拼贴 + 版画蚀刻 + 仪器图纸」的参考图，落到版式上是这四样：
   *   ① 纸白底（口径 #1「纸白阅读底一行不改」）；
   *   ② 标本编号（FIG.00 / 01 / 02…）用等宽小字 + 大字距，排在区块左上；
   *   ③ 细线分隔的列表（**不做卡片** —— 站主 2026-10-03「直接放背景里，不要单独做卡片」）；
   *   ④ 参考图底纹层（.ref-plate，见结构处注释），元素是原图里的月相 / 雕像 / 飞鸟 / 星芒。
   * 落在这四样上的改动只有版式（页头 / 列表项 / 刻度），**正文 .prose 一行没动**
   * —— 口径 #3 明确「正文排版不动」。
   * =================================================================== */

  /* ===================================================================
   * 两栏版式（站主 2026-10-03：「右半部分太空，重新排版」）
   *
   * 改版前：页头 / 签名 / 正文 / 社交 / 技术栈 / 语言占比 **全部**限在
   * --measure（34em ≈ 578px）里单列排下来⇒ 1280 视口下右半 600px 全空。
   *
   * 分栏依据（不是「为了填满」而是内容本来就分两类）：
   *   左栏 = **叙述类**（页头 / 签名 / 正文）—— 窄栏、安静、适合连续阅读
   *   右栏 = **读数类**（社交 / 技术栈 / 语言占比）—— 清单与仪表，
   *           行短可扫读，在窄栏里比在通栏里更好读（通栏时一行只剩三五个字，两端全是空白）
   * ★ 正文 .prose 的宽度**一个字没改**（仍是 prose.css 里的 max-width:var(--measure)），
   *   它在 grid 里被第一列约束，视觉效果与改版前一致 —— 口径 #3「正文排版不动」。
   *
   * ★ 移动端为什么用 `display: contents` 而不是 grid 显式定位：
   *   若在 grid 上写 `grid-row/grid-column`，**DOM 顺序就决定了窄屏顺序**，
   *   而 aside 在 main 之后 ⇒ 签名会掉到正文后面（改版前签名在正文之前）。
   *   `display:contents` 让 aside 不生成盒子、子元素直接参与父级流动，
   *   窄屏顺序 = main 的三个 + aside 的三个 = 与改版前**逐项一致**，零顺序变化。
   * =================================================================== */
  .about-grid {
    display: block;            /* 窄屏默认就是原来的单列流 */
  }
  .about-side {
    display: contents;
  }
  @media (min-width: 1024px) {
    .about-grid {
      display: grid;
      /* 左列固定 --measure（正文该多宽就多宽），右列吃掉余宽。
         1024px 起才分栏：低于它右列不足 300px，清单会被挤成两三个字一行。 */
      grid-template-columns: minmax(0, var(--measure)) minmax(0, 1fr);
      column-gap: var(--sp-8);
      align-items: start;      /* ★ 右栏不拉高，块按自身高度排（否则 social 会被prose 拉出大片空白）*/
    }
    .about-main {
    grid-column: 1;
    min-width: 0;
    /* ★ 顶部留一整段空档：页面上方约380px 不排内容 ⇒ 背景图从那里**整段**露出来。
       为什么要这么大：版心左右两侧加起来只有约 96px，图从那里露出来只是一条窄边，
       认不出是月亮还是星芒（试过，像「贴了张白纸」）。
       而这张图铺到 1280视口后高约 697px、**月亮直径约 250px** ⇒ 空档要装得下它。
       ★ 数字是按「图的实际宽高比 + 月亮实际直径」算的，不是拍脑袋。 */
    padding-top: min(30vh, 380px);
  }
    .about-side {
      /* ★ 不用 flex + gap，用「上边框 + padding-top」分隔。
         目检踩到：gap 与 border-top 同时存在时，两个半段间距（上一块下方 gap
         + 下一块上方 padding）夹着一条线，看起来像「双线夹一段空白」。
         现在间距**只由 padding-top 提供**，线上只有一条 —— 干净。 */
      display: block;
      grid-column: 2;
      min-width: 0;
    }
    /* 右栏标题比左栏小一档：它们是清单的标题，不是页的章节标题。
       （--fs-lg → --fs-body 上浮，视觉上落在一级与二级之间。） */
    .about-side .fig-h {
      font-size: var(--fs-body);
      font-weight: 700;
      margin-bottom: var(--sp-2);
    }
    /* 编号与标题同行：右栏窄，横排更紧凑（左栏是竖排的两行） */
    .about-side .fig-no {
      margin-bottom: 0;
    }
    .about-side .fig-block {
      /* 归零原有的 margin-top（.stack-block / .lang-block / .social-block 各带
         `margin: var(--sp-8) 0 0`）—— 在右栏里由 padding-top 统一控制间距，
         两处都留会叠成双倍空白。 */
      margin-top: 0;
      max-width: none;         /* 右栏宽度由 grid 列给，不该再限 --measure */
      padding-top: var(--sp-5);
      border-top: 1px solid var(--hair);
    }
    .about-side .fig-block:first-child {
      padding-top: 0;
      border-top: 0;
    }
    /* 签名留在左栏（它在 main 里）：它宽380px，与页头上下成组更紧。
       ★ 但让它占满左列宽度上限，别让 380px 的图孤零零挂在 578px 栏里右侧。 */
    .about-main .sign-card {
      width: min(380px, 100%);
    }
  }

  /* ---- 参考图底纹层（站主 2026-10-03 第二轮；第2 步换成真图）----
     ★ 站主四条：① 头像上不要线 ② 直接用参考图素材 ③ 直接放背景不做卡片 ④ 白底。
     ★★ 第2 步把「CSS 取景 + 原图」换成**构建期裁好的小图**：
        CSS 的 overflow:hidden + 偏移能在浏览器里取景，但**浏览器仍会下载整张原图**
        （3–4 MB × 3 ⇒ 关于页 10 MB+）。现在图是 900px 宽的 WebP、四块共 482 KB。
     ★★ **不改成单色、不压淡**（2026-10-03 站主驳回过一次）：
        上一版把元素统一染成墨绿 + 整体压成极淡 alpha，站主要的是
        「**强调色、雕像月相的原色、繁复的线条**」。
        ⇒ 图是**原色**的（`_probe/_ref-plate.mjs` 只做裁切+缩放，一格颜色不动），
        运行时也**没有 filter**、没有低 opacity ——
        文字压不住的部分由下面的纸托底（`.ref-paper`）解决。
     ★ 四块的取景内容：月相序列环 / 维纳斯雕像 / 飞鸟+同心圆 /撞色蓝块+罗马侧脸。 */
  .ref-plate {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    /* ★ 2026-10-03 补：这一层自己要**有底色**。
       实测（1440×1500）：图按视口宽铺、高 772px，而视口高 1500px
       ⇒ 图只占 y=0..772，**下面 728px 全是 body 的透明**（实测 bg=rgba(0,0,0,0)）
       ⇒ 页面下半截是白底，与站主要求的「深绿」相悖。
       垫 --dusk-2（与构建期处理后的图底同色 `#131b17`）⇒ 上下都深绿，看不出接缝。 */
    background: var(--dusk-2);
  }
  /* ===================================================================
   * 内容层提层（★ 2026-10-03 补；之前**漏了**，症状是正文「透明」）
   *
   * 症状：正文发灰、对比度掉下来 —— 文字后面直接是底纹与白纱。
   * 根因：`.ref-plate` 是 `position:fixed; z-index:0`（它自己那个 0 必须在：
   *   用 -1 会被 body 的 `background: var(--paper)` 挡住 ⇒ 底纹全白，
   *   见规范 §6.26 记的两条层叠坑），而**内容侧一条提层规则都没有**
   *   （`.prose` 实测 `position: static`）⇒ 两者同处一个层叠上下文，
   *   DOM 靠后的底纹压过了正文。
   *
   * ★ 这条规则我**写错过两次位置**：① 最初只在样稿 `_refbg.html` 里写了，
   *   落到 `.astro` 时漏掉；② 第二次插在 `.ref-veil` 注释之前，
   *   而那段注释后来被替换掉 ⇒ 规则跟着一起没了（编译产物里查不到）。
   *   ⇒ 教训：**层叠规则要放在不会被后续替换波及的位置**，
   *     且改完必须到**产物 CSS** 里查有没有这条规则（源码有 ≠ 产物有）。
   *
   * ★ 顶栏/页脚用 `:global(body.chrome-page …)`：它们由 Base/Topbar 渲染，
   *   带的是**别的**作用域属性；且 `body.chrome-page .topbar` (0,1,1)
   *   的权重高于裸 `.topbar` (0,1,0) ⇒ 不对齐权重压不住它。
   * =================================================================== */
  :global(body.chrome-page .topbar),
  :global(body.chrome-page .foot) {
    position: relative;
    z-index: 1;
  }
  .pagehead,
  .sign-card,
  .prose,
  .fig-block {
    position: relative;
    z-index: 1;
  }
  /* 背景大图：铺满视口，**原色、原比例**（站主 16:37 指定）。
     ★ object-fit: cover + 居中：这张是 1.84:1 的宽幅，铺到竖向视口会上下留白，
       靠 cover 裁掉；居中是为了让月亮（视觉中心）落在视口中央。
     ★ 不加任何 filter、不加 opacity —— 上一版被驳回的就是这两样。 */
  .ref-main {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  /* ★ 图只从**页面顶部与底部**露出来，两侧不露。
     ★★ 踩了四轮才明白这件事（2026-10-03 目检）：
       纸要压住文字 ⇒ 必须不透明、必须完整；而版心左右两侧加起来只有约 96px，
       图从那里露出来只是**一条窄边**，看不出是月亮还是星芒（试过：像"贴了张白纸"）。
       ⇒ 让纸的上下**留出空档**：纸按内容块分段（已做），段间就是图的可见区。
     ★ object-position 的第二个值：月亮在这张图的中偏上 ⇒ 42% 让它落在上半屏的
       空档里（0–8% 那段）。 */
  /* ★★★ 定位必须用「按宽铺 + 顶部对齐」，**不能用 cover**（2026-10-03 实测算出来的）：
     图 1920×1045（1.84:1），cover 到 1280×1500 ⇒按**高**铺，
     纵向溢出 0、横向溢出 1476px ⇒ `object-position` 的**纵向值完全无效**
     （实测 0%–100% 算出来月亮都在视口 y=690px，而顶部空档只有 0–380px）。
     ⇒ 改用显式的 `width:100%; height:auto`：图按视口宽铺、高约 697px，
        顶部对齐 ⇒ 月亮（图内 y≈46%）落在视口 y≈320px，**正好在空档里**。
     ★ 图比容器窄时会露底 ⇒ 底下垫 --dusk-2（与图底同色，看不出接缝）。 */
  /* ★★ body 的不透明纸白底必须让位 —— 它是遮挡整张背景图的真正原因。
     `src/styles/base.css` 里 `body { background: var(--paper) }`铺满全页，
     而 `.ref-plate` 是 `z-index:0` 的 fixed 层 ⇒ **在 body 背景之上**
     （元素永远在body 背景之上），实测射线里顶部空档只有 body 的纸白底、没有图。
     ⇒ 关于页把 body 背景改成透明，纸白由**各内容块自己的纸**承担
      （.page-paper 与各块的 ::before 已经是--paper）。
     ⚠ 用 `:global()` + `body.about` 类名限定，**只影响关于页**，
        别的页面仍靠 body 的纸白底（红线：别顺手改全站）。 */
  :global(body.about-plate) {
    background: transparent;
  }

  /* `.ref-main` 装图：用 **relative**（不是 absolute）——
     绝对定位会让子元素脱离文档流、容器高度塌成 0 ⇒ 图整块消失（实测踩到）。
     图在正常流里，容器高度由图撑开。 */
  .ref-main {
    position: relative;
    width: 100%;
    line-height: 0;
  }
  .ref-main > picture,
  .ref-main > img {
    display: block;
    width: 100%;
    height: auto;
    max-width: none;
  }

  /* ===================================================================
   * 纸托底 —— **由内容自己撑开**，不写死任何百分比
   *
   * ★★ 踩了三轮才对（2026-10-03 目检），每轮的错都记在这里：
   *   ① 两条竖条 + 中间留缝 ⇒ **月亮被劈成两半**（它是这张图唯一的视觉中心）；
   *   ② 一整块纸盖满版心 ⇒ 正文可读了，但**月亮被整块吃掉**，只剩边角；
   *   ③ 分段但用**写死的 %** ⇒ 纸与内容错位，文字直接压在图上（最难看的一版）。
   * ⇒ 正解：**每一块有字的元素自己带纸**，纸由**伪元素**画在内容盒之外。
   *
   * ★★ 关键约束：纸**不能靠给内容加 padding 实现** ——
   *   那会改变 `.prose` 的内容盒（红线#3「正文排版不动」）。
   *   正确做法：伪元素 `::before` 用 `inset: -Npx` 向外撑，
   *   **盒子本身一格不动**，纸在它周围张出来。
   *
   * ★ 为什么不给 `.about-main` / `.about-side` 整栏加纸：
   *   整栏加纸 = 情况②（月亮被吃掉）。**逐块加**才有缝。
   *=================================================================== */
  .pagehead,
  .sign-card,
  .prose,
  .fig-block {
    position: relative;
  }
  .sign-card::before,
  .prose::before,
  .fig-block::before {
    content: '';
    position: absolute;
    /* 向外撑出纸边（负 inset）—— 内容盒本身不动，正文排版零影响。 */
    inset: calc(var(--sp-4) * -1);
    background: var(--paper);
    box-shadow: 0 0 0 1px var(--hair);
    z-index: -1;             /* 纸在内容之下、文字之上 */
  }
  /* 签名那块窄（380px），纸也窄 ⇒ 视觉上像「贴上去的标本片」 */
  .sign-card::before {
    inset: calc(var(--sp-3) * -1);
  }
  /* ★★ 页头的纸**不能用伪元素** ——
     `.pagehead` 是两栏 grid（标题左 / 头像右，且 `FIG.00` 通栏），
     伪元素会按 grid 容器参与轨道计算，实测 inset 被算成
     `72px -16px -32px -3px`（上面莫名撑开 72px、左侧只剩 -3px）
     ⇒ 纸既盖不住标题那一格、又往版心外溢。
     ⇒ 改用**真元素**：在模板里给页头加一个 `.page-paper` 子节点，
       由下面的 `position:absolute + inset` 铺满页头（见「页头纸托底」段）。 */
  /* 页头：宽屏两栏（标题左 / 头像右），窄屏单列纵向流。
     ★ `display: grid` **只在媒体查询里写一次**（见下方 `@media (min-width:1024px)`），
       这里**不重复声明** —— 同元素两处各写一次 display 时后写的赢（这个坑踩过：
       外层 grid 被媒体查询的 flex 覆盖）。 */
  .pagehead {
    position: relative;
    /* 纸用负 inset 向外撑，理论上会超出页头盒 —— 这里裁掉，
       保证任何视口下页头都不产生横向溢出（红线：页面不可横向滚动）。
       代价：页头右侧/底部若有元素想「探出」页头会被裁（当前没有这类元素）。 */
    overflow: hidden;
  }
  /* ★★ 页头网格必须**逐项显式指定落位**（2026-10-03 实测出来的坑）。
     之前只写 `grid-template-columns: 1fr auto` 让浏览器自动放置，结果是：
       实测 h1 x=562（落在**右**列）、.profile x=101（落在**左**列）
     ⇒ 标题和头像左右**调换**了（与设计意图相反）。
     根因：网格项按源码顺序自动-flow，`.fig-no` 先占 (1,1)，于是
     `h1` 被挤到 (1,2)、`.profile` 到 (2,1)。
     ⇒ 显式落位，顺序无关：
       编号通栏（1/-1）· 标题左列 · 头像右列。 */
  .pagehead > .fig-no { grid-column: 1 / -1; grid-row: 1; }
  /* ★ 标题必须用 `:global()` 包住类名，**不能**写 `.pagehead > h1` 或 `.pagehead > .h`
     （2026-10-03 实测踩到，症状是「纸把标题整个盖住、页头一片空白」）。

     —— 为什么。这两个写法都被 Astro 的 scoped CSS 编译成**带本页 cid 的属性选择器**：
        `.pagehead[本页cid] > h1[本页cid]` / `> .h[本页cid]`。
        而这个 h1 是 **PageTitle 组件**渲染的，元素上带的是**组件自己的 cid**（ta2fbyqs≠本页）
        ⇒ 属性选择器**不匹配** ⇒ 规则整条静默失效（实测 h1pos=static h1z=auto）。
        ⇒ 纸（`.page-paper`，本页元素 ⇒ 匹配成功）拿到 position:absolute + z-index:0，
          标题既 static 又无z-index ⇒ **纸盖住标题**，纸上只剩空白。

     ★ 代价与边界：`:global()` 意味着这条规则**离开本页作用域**。
       它以 `.pagehead >` 为前缀（`.pagehead` 是本页唯一的类）⇒ 实际影响面仅关于页。
       规则：凡是**跨组件边界**要选择元素，一律 `:global(类名)`，不用标签/局部类选择器。 */
  :global(.pagehead > h1) { grid-column: 1; grid-row: 2; }
  .pagehead > .profile { grid-column: 2; grid-row: 2; }

  /* ---- 页头纸托底（真元素，不是伪元素）----
     ★ 为什么不用 `::before`：`.pagehead` 是 grid 容器，伪元素会作为 grid item
       参与轨道计算，`inset: -16px` 被算成 `72px -16px -32px -3px`
       （实测上面莫名撑 72px、左侧只剩 -3px）⇒ 纸既盖不住标题、又往版心外溢。
     ★ 为什么**不能**用 `grid-area: 1/1/-1/-1`（实测踩到，2026-10-03）：
       `grid-template-rows: auto auto` 只有 2 行，`-1` 解析成第 3 行（不存在）
       ⇒ 纸被放进一条**隐式行**并按内容高度撑开，而那条行没有内容
       ⇒ **实测高度 = 0**（探针：page-paper=[85,546,610,0]）⇒ 纸等于不存在。
       ⇒ 改成显式 `grid-row: 1 / 3`（第 1 行到第 2 行末）才跨满，
         但那样纸会**参与行分配**、可能把标题/头像挤变形（纸成了有内容的项）。
     ⇒ 最终方案：`position: absolute` + 显式四边 inset，**包含块锚在页头自己**
       （`.pagehead` 已有 position:relative，上面那条规则给了）。
       绝对定位的 grid 子元素**不参与轨道计算**（这正是我们要的：纸不影响排版），
       而包含块是页头的 padding盒 ⇒ inset 相对页头算，精确可控。
       ⚠ 之前「absolute ⇒ 高度塌 0」那次是因为 `.pagehead` 当时**没有**
         position:relative，包含块跑到 main 去了；现在有了，两个条件都满足。
     ⚠⚠ **另一个更隐蔽的坑（2026-10-03 实测）**：下面那条
        `.pagehead > * { position: relative; z-index: 1 }` 排在**本规则之后**，
        同特异性（都是 0,1,0）**后写的赢** ⇒ 把纸的 `position:absolute`
        覆盖回 `relative` ⇒ 纸重新变成 grid item ⇒ 实测高度又塌成 0。
        ⇒ 靠**提高特异性**（`.pagehead > .page-paper`，0,2,0）压过通配那条，
          而不是靠调整源码顺序 —— 顺序太脆，下一次插注释就会再被翻回去。
     ⚠⚠⚠ 窄屏下纸**不得**超出视口（2026-10-03 实测）：
       390 视口时 grid 的 `1fr auto` 算出 503px 的纸宽（文档 scrollWidth=512）
       ⇒ 横向溢出 122px、头像被切出屏幕。
       根因不在纸上，而在 **grid 只该在宽屏生效**（见下方媒体查询）。
       这里再加一道保险：`overflow: hidden` 让纸的溢出被裁在页头盒内。 */
  .pagehead > .page-paper {
    position: absolute;
    /* 负 inset = 纸边向外撑；页头内容盒本身一格不动（红线：正文排版不动）。 */
    inset: calc(var(--sp-4) * -1);
    background: var(--paper);
    box-shadow: 0 0 0 1px var(--hair);
    /* 纸在内容之下：`.pagehead > *` 那条会给所有子元素 z-index:1，
