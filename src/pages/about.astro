---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import SocialIcon from '../components/SocialIcon.astro';

// 关于页正文来自 content/pages/about.md —— 主题不持有任何正文（content-model.md §7）
const entry = await getEntry('pages', 'about');
const Content = entry ? (await render(entry)).Content : null;

/** 头像与社交账号（站主 2026-09-26 要求）也走内容层：文件在 src/assets/about/，配置在 about.md 的 frontmatter。
 *  头像必须放 src/ 才能参与构建期优化（转 WebP + 出 srcset）—— 与「说说配图」同一条例外。 */
interface Social {
  icon: string;
  name: string;
  href: string;
}
/** 技术栈（站主 2026-09-28 要求：放在社交账号下方）。同样走内容层 about.md 的 `stack`，
 *  与社交账号同一条例外理由：这是站主自己的信息，不该硬编码在主题里。 */
interface StackGroup {
  group?: string;
  items?: string[];
}
interface AboutData {
  avatar?: string;
  avatarName?: string;
  social?: Social[];
  stack?: StackGroup[];
}

/* ===== 语言占比条（站主 2026-09-30 要求「更新技术栈并加一个这个」）=====
   **数据是实测值，不是抄来的。** 站主第一次给的 GitHub 风格截图是旧数据，
   他随即纠正「那个图片里的是旧的还没更新，你根据现在的数据做」——
   所以这里按**本站当前源码**重新量，一行命令可复算：

     for e in astro ts css md; do
       find src content functions -name "*.$e" -type f \
         | xargs wc -c | tail -1
     done

   口径（与 GitHub linguist 一致）：
     · 只统计**自己写的代码**：src/ + content/ + functions/
     · 不含 node_modules/、dist/、public/、图片、字体 —— 语言占比统计的是代码，不是整站体积
     · 同扩展名合并为同一语言（.astro / .ts / .css / .md）

   实测（2026-09-30）：
     .astro 170,036 B · .ts 136,909 B · .css 95,103 B · .md 45,784 B → 合计 447,832 B

   配色按站主 2026-09-30 指定：「用我博客风格的颜色，绿色全色系，黑，白，灰和少量橙色系」
   —— 全部取自 tokens.css 真值，**没有一个自创色**：
     Astro（最大段）走绿的三档渐变 accent-ink → accent → accent-bright
     TypeScript 走 accent-ink（深绿）
     CSS 走 --muted（灰）
     Markdown 走 --signal（橙，唯一一处 —— 沿用它在 tokens 里「少量信号色」的语义） */
interface LangRow {
  name: string;
  bytes: string;
  pct: string;
  /** 条的宽度（与 pct 同值，内联 style 用） */
  w: string;
  /** 段底色：CSS 值，全部由 token 拼出 */
  fill: string;
  /** 图例圆点：必须纯色（渐变在图例小圆点上会渲染成全透明） */
  dot: string;
  note: string;
}
const LANGS: LangRow[] = [
  { name: 'Astro', bytes: '170,036 B', pct: '38.0%', w: '38.0%',
    fill: 'linear-gradient(90deg, var(--accent-ink) 0%, var(--accent) 55%, var(--accent-bright) 100%)',
    dot: 'var(--accent)', note: '页面与组件（29 个 .astro）' },
  { name: 'TypeScript', bytes: '136,909 B', pct: '30.6%', w: '30.6%',
    fill: 'var(--accent-ink)', dot: 'var(--accent-ink)', note: '内容集合 / 脚本 / Cloudflare Functions（23 个 .ts）' },
  { name: 'CSS', bytes: '95,103 B', pct: '21.2%', w: '21.2%',
    fill: 'var(--muted)', dot: 'var(--muted)', note: '设计令牌 / 开场 / 过渡 / 版式（9 个 .css）' },
  { name: 'Markdown', bytes: '45,784 B', pct: '10.2%', w: '10.2%',
    fill: 'var(--signal)', dot: 'var(--signal)', note: '文章与页面正文（14 篇 .md）' },
];
const LANG_TOTAL = '447,832 B';
const d = (entry?.data ?? {}) as unknown as AboutData;
const assets = import.meta.glob<{ default: ImageMetadata }>('/src/assets/about/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const avatar = d.avatar ? assets[`/src/assets/about/${d.avatar}`]?.default : undefined;
const social = d.social ?? [];
// 空组不渲染（内容层写错分组时不至于留一个空卡片）
const stack = (d.stack ?? []).filter((g) => (g?.items ?? []).length > 0);
const isExternal = (h: string) => /^https?:/i.test(h);
---
{
  /* 关于页迁移（2026-09-26）：chrome='band' → 'page'（内页外壳：浅色顶栏 + 切片档案背景）。
     **'page' 不渲染 <slot name="band" />** —— 所以标题必须从那个槽搬进正文流（外壳提供的 .pagehead），
     漏搬会静默消失且构建照常成功（文章页同一个坑）。
     PageTitle 本身不写任何颜色（只有 margin/font-weight + 字号类 token），**靠继承取色** ——
      搬进浅底后自动继承外壳的 --ink，所以**无需主题化**（已读源码确认，见 docs/about-migration-notes.md）。
      版式依据不是原型：prototype/terminal/ 里没有关于页，依据是既有内页外壳的实测实现（/gallery 与文章页）。 */
}
<Base title="关于" current="about" chrome="page">
  {/* 头像（站主 2026-09-26 要、2026-09-27 改）：
      **必须和标题放在同一个页头里**，桌面靠 grid 排到右边、手机在标题下方居中。
      为什么不用 `position: fixed`（第一版就是这么写的，被站主抓了）：
        ① 它会**不跟页面滚**（站主："要求跟随鼠标滚轮上下而上下"）；
        ② 更要命的：过渡动画给 `.shell` 加了 `transform: scale(0.98→1)`，而被 transform 的祖先会成为
           `position: fixed` 的**包含块** ⇒ 头像按"相对 .shell"定位；动画结束、类被摘掉后 transform 变 none，
           包含块又换回视口 ⇒ **位置突变，视觉上就是"加载后跳一下"**（实测从 y=246 跳到 y=198，48px）。
      改成布局定位后这两个问题一起消失：位置由排版决定（不会变），元素在正文流里（自然跟着滚）。 */}
  <header class="pagehead">
    <PageTitle>关于</PageTitle>
    {avatar && (
      <div class="profile">
        <Image class="avatar" src={avatar} alt={`${d.avatarName ?? '站主'}的头像`} widths={[96, 192]} sizes="128px" />
        <p class="profile-name">{d.avatarName}</p>
      </div>
    )}
  </header>

  <div class="prose">{Content && <Content />}</div>

  {social.length > 0 && (
    <section class="social-block" aria-labelledby="social-title">
      <h2 id="social-title">我的一些社交账号</h2>
      <ul class="social">
        {social.map((s) => (
          <li>
            <a
              href={s.href}
              {...(isExternal(s.href) ? { rel: 'noopener' } : {})}
              {...(isExternal(s.href) ? { target: '_blank' } : {})}
            >
              <SocialIcon name={s.icon} />
              <span>{s.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {stack.length > 0 && (
    <section class="stack-block" aria-labelledby="stack-title">
      <h2 id="stack-title">技术栈</h2>
      <div class="stack-groups">
        {stack.map((g) => (
          <div class="stack-group">
            {g.group && <p class="stack-group-name">{g.group}</p>}
            <ul class="stack-items">
              {(g.items ?? []).map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )}

  {/* 技术栈占比条（站主 2026-09-30：「更新技术栈并加一个这个」）——紧跟在技术栈之后，同一个位置。
      数据口径：**本站源码实测**（站主拍板的那一档），不是抄原型那组 ——
      原型是 HTML 单文件，它的 JS 占 93.1%（含 three.js 整包），与本站毫无可比性。
      条宽直接用百分比当 CSS 宽度；每段配一个纯色圆点做图例
      （渐变在小圆点上会渲染成全透明，所以 dot 与 fill 是两个字段）。 */}
  {LANGS.length > 0 && (
    <section class="lang-block" aria-labelledby="lang-title">
      <h2 id="lang-title">源码语言占比</h2>
      <p class="lang-total">
        本站源码实测 · 合计 <b>{LANG_TOTAL}</b>（<code>src/</code> 与 <code>functions/</code>，不含依赖与构建产物）
      </p>
      <ul class="lang-list">
        {LANGS.map((l) => (
          <li class="lang-row">
            <span class="lang-head">
              <i class="lang-dot" style={`background:${l.dot}`} aria-hidden="true"></i>
              <span class="lang-name">{l.name}</span>
              <span class="lang-bytes">{l.bytes}</span>
              <span class="lang-pct">{l.pct}</span>
            </span>
            <span class="lang-bar" aria-hidden="true">
              <s class="lang-fill" style={`width:${l.w};background:${l.fill}`}></s>
            </span>
            <span class="lang-note">{l.note}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  /* 拍板 D：页头版心收成 --measure，与正文列左对齐（与文章页同一条）。 */
  .pagehead {
    max-width: var(--measure);
  }
  /* ---- 头像 ---- */
  /* 手机端：头像与「北杉」必须**同一条中轴**（站主 2026-09-27："头像移到北杉正上方，歪了"）。
     用 flex 列 + align-items:center 而不是 text-align:center ——
     后者对 Astro `<Image>` 产出的图片无效（它是块级元素，text-align 管不到它，
     实测头像被左对齐、名字居中，于是看着是歪的）。 */
  .profile {
    margin: var(--sp-6) 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--hair);
    background: var(--panel);
  }
  .profile-name {
    margin: var(--sp-2) 0 0;
    font-size: var(--fs-sm);
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  /* 宽屏：页头变成**两栏** —— 标题在左、头像在右（都留在正文流里 ⇒ 位置固定不变、且跟着页面滚）。
     为什么不用 position:fixed：① 不跟滚动；② 过渡动画给 .shell 加的 transform 会把 fixed 的包含块
     从视口换成 .shell，动画一结束就位置突变（"加载后跳一下"）。布局定位两个问题都没有。 */
  @media (min-width: 1024px) {
    .pagehead {
      max-width: none;
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: start;
      column-gap: var(--sp-6);
    }
    .profile {
      /* 往下压一点，让头像对着标题的下半部分（站主给的参考图就是这个观感；
         代价是页头行高变大、正文整体下移 40px —— 这是刻意的，不是副作用）。 */
      margin: 2.5rem 0 0;
    }
    .avatar {
      width: 128px;
      height: 128px;
      box-shadow: 0 6px 24px rgb(26 26 26 / 10%);
    }
  }
  /* ---- 社交账号 ---- */
  .social-block {
    margin: var(--sp-8) 0 0;
    max-width: var(--measure);
  }
  .social-block h2 {
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-lg);
    font-weight: 800;
  }
  .social {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: var(--sp-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .social a {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--hair);
    background: var(--panel);
    color: var(--ink);
    text-decoration: none;
    font-size: var(--fs-sm);
  }
  .social a:hover,
  .social a:focus-visible {
    border-color: var(--accent);
    background: var(--accent-wash);
  }
  @media (max-width: 767px) {
    .social {
      grid-template-columns: 1fr 1fr;
    }
  }
  /* ---- 技术栈（站主 2026-09-28 要求：社交账号下方）----
     视觉取既有元件，不新造：卡片沿用社交卡的「--panel 底 + --hair 边框」，
     组名沿用 .profile-name / 日志版本号的「--accent-ink 小字 + 字距」，
     条目沿用标签页 chips 的方框写法。颜色只用 token，无 rgba()。 */
  .stack-block {
    margin: var(--sp-8) 0 0;
    max-width: var(--measure);
  }
  .stack-block h2 {
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-lg);
    font-weight: 800;
  }
  .stack-groups {
    /* 单列：正文列只有 34em（≈544px），两列放不下三张卡会留一张孤卡（1440 实测）；
       全宽单列让每组的 chips 有整行可用，长条目（Cloudflare D1…）也不用挤。 */
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-3);
  }
  .stack-group {
    border: 1px solid var(--hair);
    background: var(--panel);
    padding: var(--sp-4);
  }
  .stack-group-name {
    margin: 0 0 var(--sp-3);
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    color: var(--accent-ink);
  }
  .stack-items {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  /* 条目是**不是链接**，所以刻意不给 hover —— 免得看着能点 */
  .stack-items li {
    font-size: var(--fs-sm);
    color: var(--ink);
    border: 1px solid var(--hair);
    padding: 0.15em 0.5em;
  }

  /* ---------- 源码语言占比条（站主 2026-09-30）----------
     视觉取原型 v10.6 的**玻璃卡语言**（--glass-bg 底 + --glass-line 边 + backdrop-filter），
     与技术栈那组实心 --panel 卡刻意拉开一档：栈是"清单"，占比是"仪表读数"。
     颜色只用 token，一个自创色都没有。 */
  .lang-block {
    margin: var(--sp-8) 0 0;
    max-width: var(--measure);
  }
  .lang-block h2 {
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-lg);
    font-weight: 800;
  }
  .lang-total {
    margin: 0 0 var(--sp-5);
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .lang-total b {
    color: var(--accent-ink);
    font-variant-numeric: tabular-nums;
  }
  .lang-total code {
    font-family: inherit;
    color: var(--ink);
  }
  .lang-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--sp-4);
  }
  .lang-row {
    display: grid;
    gap: 0.4rem;
  }
  /* 表头行：圆点 + 语言名 + 字节数（右对齐）+ 百分比（等宽数字，右对齐） */
  .lang-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: var(--fs-sm);
  }
  .lang-dot {
    width: 0.55rem;
    height: 0.55rem;
    flex: 0 0 auto;
    /* 圆点与首行文字视觉居中（baseline 对齐会让它偏下） */
    align-self: center;
  }
  .lang-name {
    color: var(--ink);
    font-weight: 600;
  }
  .lang-bytes {
    margin-left: auto;
    font-size: var(--fs-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .lang-pct {
    min-width: 4.5ch;
    text-align: right;
    color: var(--accent-ink);
    font-variant-numeric: tabular-nums;
  }
  /* 条本体：半透明玻璃槽 + 内部填充段。
     ★ 高度 6px 是"非文字图形"⇒ 按 WCAG 1.4.11 要 ≥3:1。
       四个 fill 色对 --paper 的对比度：accent 4.86 / accent-ink 6.18 / muted 6.62 / signal 2.83。
       ⚠️ --signal（橙）只有 2.83 —— **不达标**。它在这里的唯一用途是"第 4 段已经很短（10.2%）"，
       且同一条的上方有文字标签 + 字节数 + 百分比三重冗余 ⇒ 颜色不是唯一的信息载体，
       符合 1.4.11 的"信息不依赖颜色"豁免条件。这是**有意的取舍**，写在这免得以后被当成漏检。 */
  .lang-bar {
    display: block;
    height: 6px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-line);
    -webkit-backdrop-filter: blur(var(--glass-blur));
    backdrop-filter: blur(var(--glass-blur));
    overflow: hidden;
  }
  .lang-fill {
    display: block;
    height: 100%;
    text-decoration: none;
  }
  .lang-note {
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  @media (max-width: 767px) {
    /* 窄屏：百分比与字节数换行排，别把语言名挤没 */
    .lang-head {
      flex-wrap: wrap;
      row-gap: 0.15rem;
    }
    .lang-pct {
      min-width: 0;
    }
  }
</style>
