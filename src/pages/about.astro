      padding-top: 0;
      border-top: 0;
    }
    /* 签名留在左栏（它在 main 里）：它宽380px，与页头上下成组更紧。
       ★ 但让它占满左列宽度上限，别让 380px 的图孤零零挂在 578px 栏里右侧。 */
    .about-main .sign-card {
      width: min(380px, 100%);
    }
  }

  /* ---- 参考图底纹层（站主 2026-10-03 第二轮）----
     ★ 站主四条：① 头像上不要线 ② 直接用参考图素材 ③ 直接放背景不做卡片 ④ 白底。
     ★ 结构是「取景框 + 绝对定位的图」⇒ 裁切用 CSS 完成（overflow:hidden +偏移），
       **不做像素处理**：灰度与墨绿全靠 filter 现场做（grayscale + sepia + hue-rotate）——
       逐像素改色会把原图的浓淡与拼贴层次一起抹平，而那正是参考图的值钱处。
     ★ 素材走 astro:assets 出来的小图（构建期已转WebP），所以下载量是几十 KB 级，
       不是原图那 3–4 MB（CSS 裁切不能裁文件，浏览器仍会下载整张 —— 这点务必记住）。
     ★ 四块互不重叠：左上飞鸟 / 右上月相 / 左下群像 / 右下树。 */
  .ref-plate {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .ref-plate .ref {
    position: absolute;
    overflow: hidden;
  }
  .ref-plate .ref > picture,
  .ref-plate .ref > img {
    position: absolute;
    max-width: none;
    height: auto;
  }
  /* 月相盘 + 直尺（站主点名要的那两块之一）*/
  .ref-moon {
    right: -6%;
    top: 4%;
    width: 62%;
    height: 30%;
  }
  .ref-moon > picture,
  .ref-moon > img {
    right: 0;
    top: -84%;
    width: 128%;
  }
  /* 雕像群像（站主点名的另一块）*/
  .ref-statue {
    left: -8%;
    top: 40%;
    width: 58%;
    height: 34%;
  }
  .ref-statue > picture,
  .ref-statue > img {
    left: 0;
    top: -36%;
    width: 132%;
  }
  /* 飞鸟 + 星芒 */
  .ref-birds {
    left: -10%;
    top: 12%;
    width: 56%;
    height: 26%;
  }
  .ref-birds > picture,
  .ref-birds > img {
    left: 0;
    top: -3%;
    width: 138%;
  }
  /* 树 + 新月 */
  .ref-tree {
    right: -4%;
    top: 72%;
    width: 52%;
    height: 28%;
  }
  .ref-tree > picture,
  .ref-tree > img {
    right: 0;
    top: -2%;
    width: 152%;
  }
  /* 统一转色：灰度 → 墨绿。三个 token 值对应站内既有色，不自创。 */
  .ref-plate .ref {
    filter: grayscale(1) sepia(0.9) hue-rotate(88deg) saturate(0.7) contrast(1.1);
    opacity: 0.24;
  }
  .ref-moon {
    opacity: 0.3;
  }
  .ref-statue {
    opacity: 0.26;
  }
  .ref-birds {
    opacity: 0.2;
  }
  .ref-tree {
    opacity: 0.18;
  }
  /* 白纱：把版心那一带压干净（★ 头像区不要有线），两端留出底纹的可见区。 */
  /* ★ 内容层必须**显式提到 1** —— 2026-10-03 目检连踩两条：
       ① 底纹用 z-index:-1 ⇒ 被 body 的 `background: var(--paper)` 挡住，底纹全白；
       ② 底纹用 z-index:0 而不给内容提层 ⇒ .shell 没有 positioned 祖先，两者同处一个
          层叠上下文，DOM 靠后的底纹**盖在内容上** ⇒ 整页发白、标题正文全看不见。
       ⇒ 正确做法：底纹 0 / 内容 1。
     ★ 顶栏与页脚在 .shell **之外**（Base.astro 渲染的），同样要提层，
       否则导航与站名会发白（第二次目检才抓到）。 */
  /* ★ 顶栏/页脚必须用 :global() + **body.chrome-page 前缀**：
       ① 它们由 Base/Topbar 渲染，带的是**别的**作用域属性（AGENTS 事故表记过同类坑：
          时间切片的交接层就因此静默失效过一次）；
       ② 更关键：**权重**—— `body.chrome-page .topbar`（0,1,1）已经设了
          `background: linear-gradient(--glass-bg…)` + `backdrop-filter`，
          而 `.topbar`（0,1,0）盖不住它 ⇒ 顶栏被底纹压住、发白看不见。
          ⇒ 锚到同一个 `body.chrome-page` 上，权重齐平而后定义，才压得住。 */
  :global(body.chrome-page .topbar),
  :global(body.chrome-page .foot) {
    position: relative;
    z-index: 1;
  }
  .pagehead,
  .sign-card,
  .prose,
  .fig-block {
    position: relative;
    z-index: 1;
  }

  .ref-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      #fafaf7e8 0%,
      #fafaf7a8 40%,
      #fafaf7b0 60%,
      #fafaf7e8 82%,
      #fafaf7e8 100%
    );
  }

  /* ---- 标本编号：等宽字 + 大字距 = 「标本标签」的印刷感，也是仪器语汇的延续 ---- */
  .fig-no,
