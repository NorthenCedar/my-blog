---
import Base from '../layouts/Base.astro';
---
<Base title="页面不存在 — 北杉札记">
  <Fragment slot="band">
    <h1 class="h">404</h1>
  </Fragment>

  <p class="prose">
    这个地址没有内容。可能是链接写错了，或者这篇文章还没写完。
  </p>
  <p><a href="/">回到首页</a></p>
</Base>

<style>
  .h {
    font-size: var(--fs-display);
    margin: 0;
    font-weight: 800;
    letter-spacing: var(--ls-display);
  }
</style>
