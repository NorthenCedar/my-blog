---
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
---
<Base title="页面不存在" noCanonical>
  <Fragment slot="band">
    <PageTitle size="display">404</PageTitle>
  </Fragment>

  <p class="prose">
    这个地址没有内容。可能是链接写错了，或者这篇文章还没写完。
  </p>
  <p><a href="/">回到首页</a></p>
</Base>
