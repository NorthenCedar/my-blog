---
import '../styles/beacon.css';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="only dark" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="beacon@northcedar" />
    <link rel="canonical" href="https://northcedar.top/beacon/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>beacon@northcedar</title>
  </head>
  <body>
    <div class="crt-scan" aria-hidden="true"></div>
    <main class="term" data-beacon-root data-unlocked="false">
      <div class="term-output" data-term-output role="log" aria-live="polite">
        <h1 class="term-line term-hi">&gt; welcome to beacon@northcedar.</h1>
        <p class="term-line term-dim">私有归档已封存（仅限本人设备或明确授权的隔离实验环境学习）。</p>
        <p class="term-line">输入 "help" 按回车查看命令，或直接输入 "unlock &lt;口令&gt;" 校验解锁。</p>
      </div>

      <form class="term-prompt-line" data-term-form autocomplete="off">
        <label class="term-ps1" for="term-input" data-term-ps1>beacon@northcedar:~$</label>
        <span class="term-input-wrap">
          <span class="term-idle-block" data-term-block aria-hidden="true"></span>
          <input
            id="term-input"
            type="text"
            class="term-input"
            data-term-input
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            autofocus
            aria-label="终端命令输入"
          />
        </span>
      </form>
      <noscript>
        <p class="term-line term-dim">此终端需要启用 JavaScript。</p>
      </noscript>
    </main>

    <script>
      import '../scripts/beacon-terminal';
    </script>
  </body>
</html>
