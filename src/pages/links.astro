---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getSite } from '../lib/site';
import { requireContentLink } from '../lib/content-urls.mjs';
import PageTitle from '../components/PageTitle.astro';
import infInk from '../assets/links/inf-ink.png';

/** 友链页（2026-09-26 站主按参考站要求新增）。
 *  内容全在 content/pages/links.md（主题不持有正文）；这里只负责把它画出来。
 *  体例取自参考站：先一句引子，再按「分组」摆卡片；本页多两件事 —— 我自己的入口、以及**申请步骤**
 *  （参考站有申请说明，但没写清流程；站上既然有留言板，就让申请走留言，闭环）。
 *★ 2026-10-05 站主拍板：把本页的百褶 ∞ 底纹换成他手绘的墨笔 ∞（`../assets/links/inf-ink.png`），
 *  同时给本页装第七台装置「星座CONSTELLATION」（`src/scripts/constellation.ts`）。 */
interface Item {
  name: string;
  href: string;
  avatar?: string;
  desc?: string;
}
interface Group {
  title: string;
  note?: string;
  items: Item[];
}
interface LinksData {
  title?: string;
  intro?: string;
  waveText?: string;
  mine?: Item;
  groups?: Group[];
}
const DEFAULT_AVATAR = '/avatars/helix.svg';
const entry = await getEntry('pages', 'links');
const d = (entry?.data ?? {}) as unknown as LinksData;
const groups = d.groups ?? [];
for (const [groupIndex, group] of groups.entries()) {
  for (const [itemIndex, item] of group.items.entries()) {
    requireContentLink(item.href, `content/pages/links.md 的 groups[${groupIndex}].items[${itemIndex}].href`);
    if (item.avatar) {
      requireContentLink(item.avatar, `content/pages/links.md 的 groups[${groupIndex}].items[${itemIndex}].avatar`);
    }
  }
}
if (d.mine) {
  requireContentLink(d.mine.href, 'content/pages/links.md 的 mine.href');
  if (d.mine.avatar) requireContentLink(d.mine.avatar, 'content/pages/links.md 的 mine.avatar');
}
const avatarSrc = (raw?: string) => {
  const s = typeof raw === 'string' ? raw.trim() : '';
  if (!s) return DEFAULT_AVATAR;
  return s === 'https://northcedar.top/my-avatar' ? '/my-avatar.jpg' : s;
};
const { wordmark } = await getSite();
const waveText = d.waveText?.trim() || wordmark;
const isExternal = (h: string) => /^https?:/i.test(h);
const isPortalGroup = (g: Group) => g.title === '本站入口';
const linkAttrs = (h: string) => (isExternal(h) ? { target: '_blank', rel: 'noopener noreferrer' } : {});
---

<Base title="友链" current="links" chrome="page" bodyClass="links-plate">
  {/*==================================================================
   * ① `.inf-ink-plate`：本站墨笔 ∞ 底纹，**替代**百褶 ∞（站主 2026-10-05 拍板）
   *
   * 素材：站主手绘的墨笔 ∞（原图 1920×1090，比例 1.7615），构建期由
   * `src/assets/links/inf-ink.png` 出发。**它已经带 alpha 通道** —— 抠图那一步
   * 把纸白反相成了不透明度，所以这里不需要、也不允许再做 CSS 底色叠加。
   * ★ **为什么是墨绿而不是原墨黑**（与 about 页「装饰图保留原始色彩」相反，
   *   是站主本轮明确拍板的例外，理由见 docs/rhinelab-spec.md §6.34）：
   *   全站纸白区是一族绿（说说页墨点螺旋、归档卷尺、日志页 ∞ 都是绿），
   *   一张纯黑的照片放进来会读成"贴了张别人的图"，不是"本站的一种纹理"。
   *   ⇒ 抠图只留**不透明度**（墨笔的浓淡层次全在这一层），**RGB 统一染成
   *     `--accent-ink`(#266b3b)**，由 token 决定颜色、素材本身不带死色。
   *
   * 挂法照抄 Topbar 的 `body.chrome-page .page-inf`（百褶 ∞ 那一层）：
   *   fixed 挂视口居中 / `contain` / `z-index:-1` / 不拦指针。
   * ★ **取宽刻意不照抄** ∞ 的 `min(128vw,1600px)`（那是**故意出血**）——
   *   本图墨迹**铺满整个画布**（抠图时按 200px 半径收边，飞溅刚好触到四边），
   *   出血会把最外圈的飞溅切掉半截，读起来像"图被裁坏了"。
   *   ⇒ `min(92vw, 1400px, 190vh)`，三个上限各管一件事：
   *      · 92vw —— 任何视口宽下都留 ≥4% 余量
   *      · 1400px —— 超宽屏不让它无限长
   *      · 190vh —— 兜住"又宽又扁"的窗（横屏平板），图高 ≤ 85%vh
   * =================================================================*/}
  <Fragment slot="plate">
    <div class="inf-ink-plate" aria-hidden="true">
      <Image
        class="inf-ink-img"
        src={infInk}
        alt=""
        widths={[700, 1400]}
        sizes="92vw"
        loading="eager"
        decoding="sync"
      />
    </div>
    {/* ② `.const-bg`：本页装置「星座」的画布，逻辑在 src/scripts/constellation.ts。
        与底纹同层（z-index:-1）、DOM 在后 ⇒ 连线画在墨笔 ∞ 之上、正文之下。
        ★ **不用 `hidden` 属性** —— 它会把元素钉成 `display:none`，
          而 `.const-bg` 是 `position:fixed`，脚本 `fit()` 量的是 `clientWidth/clientHeight`
          （`display:none` 下恒为 0）⇒ 装置永远量不到尺寸、画不出第一帧。
          改用首页 DNA 那套**opacity 门控**（`opacity:0` → 脚本加 `.is-ready` → 1）：
          元素始终占位、可量尺寸，只是没就绪时不可见。 */}
    <canvas class="const-bg" data-const-bg aria-hidden="true"></canvas>
  </Fragment>

  <header class="pagehead links-heading">
    <PageTitle>友链</PageTitle>
    {d.intro && <p class="lede">{d.intro}</p>}
  </header>

  <div class="links-directory">
    {groups.map((g, gi) => (
      <section class="group">
        <h2 class="sec">{g.title}</h2>
        {g.note && <p class="note">{g.note}</p>}
        {g.items.length > 0 ? (
          <ul class="cards">
            {g.items.map((it) => {
              const portal = isPortalGroup(g);
              return (
                <li>
                  <a class={portal ? 'card' : 'card card-friend'} href={it.href} {...linkAttrs(it.href)}>
                    {!portal && <span class="card-glass music-glass" aria-hidden="true"></span>}
                    {!portal && (
                      <span class="avatar-ring" aria-hidden="true">
                        <img
                          class="card-avatar"
                          src={avatarSrc(it.avatar)}
                          alt=""
                          width="56"
                          height="56"
                          decoding="async"
                          data-avatar-fallback={DEFAULT_AVATAR}
                        />
                      </span>
                    )}
                    {portal ? (
                      <>
                        <span class="name">{it.name}</span>
                        {it.desc && <span class="desc">{it.desc}</span>}
                        <span class="url">{it.href.replace(/^https?:\/\//, '')}</span>
                      </>
                    ) : (
                      <span class="card-body">
                        <span class="name">{it.name}</span>
                        {it.desc && <span class="desc">{it.desc}</span>}
                        <span class="url">{it.href.replace(/^https?:\/\//, '')}</span>
                      </span>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="empty" data-group={gi}>这一组还空着 —— 想换友链的在下方提交申请。</p>
        )}
      </section>
    ))}
    <div class="links-waves" data-links-waves={waveText} aria-hidden="true"></div>
  </div>

  {d.mine && (
    <div class="links-info">
      <section class="mine">
        <h2 class="sec">本站</h2>
        <div class="mine-row">
          <a class="card card-friend card-mine" href={d.mine.href} {...linkAttrs(d.mine.href)}>
            <span class="card-glass music-glass" aria-hidden="true"></span>
            <span class="avatar-ring" aria-hidden="true">
              <img
                class="card-avatar"
                src={avatarSrc(d.mine.avatar || '/my-avatar.jpg')}
                alt=""
                width="56"
                height="56"
                decoding="async"
                data-avatar-fallback="/my-avatar.jpg"
              />
            </span>
            <span class="card-body">
              <span class="name">{d.mine.name}</span>
              {d.mine.desc && <span class="desc">{d.mine.desc}</span>}
              <span class="url">{d.mine.href.replace(/^https?:\/\//, '')} · 头像 /my-avatar</span>
            </span>
          </a>
          <div class="mine-actions">
            <a class="mine-btn" href="/my-avatar.jpg" download="northcedar-avatar.jpg">下载头像</a>
            <button type="button" class="mine-btn mine-btn-ghost" data-copy-avatar="https://northcedar.top/my-avatar.jpg">复制头像链接</button>
          </div>
        </div>
      </section>
    </div>
  )}

  <section class="apply-section" id="link-apply">
    <h2 class="sec">友链申请</h2>
    <div class="apply-inbox" data-link-inbox hidden></div>
    <form class="apply-form" data-link-apply-form novalidate>
      <label class="apply-field">
        <span class="apply-label">站点名称 <span class="apply-req" aria-hidden="true">*</span></span>
        <input name="name" type="text" maxlength="60" placeholder="你的站点叫什么？" required />
      </label>

      <label class="apply-field">
        <span class="apply-label">网站链接 <span class="apply-req" aria-hidden="true">*</span></span>
        <input name="href" type="url" maxlength="300" placeholder="https://northcedar.top" required />
      </label>

      <label class="apply-field">
        <span class="apply-label">一句话描述 <span class="apply-req" aria-hidden="true">*</span></span>
        <input name="desc" type="text" maxlength="15" placeholder="用 15 个字介绍一下" required />
        <span class="apply-hint">最多 15 个字</span>
      </label>

      <label class="apply-field">
        <span class="apply-label">头像链接</span>
        <input name="avatar" type="url" maxlength="400" placeholder="https://northcedar.top/my-avatar.jpg（选填）" />
        <span class="apply-hint">填写图片直链，留空则使用默认头像</span>
      </label>

      {/* 蜜罐：真人不可见 */}
      <div class="apply-hp" aria-hidden="true">
        <label for="link-apply-website">网站（请留空）</label>
        <input id="link-apply-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="apply-foot">
        <button class="apply-submit" type="submit" data-link-apply-submit>提交申请</button>
        <p class="apply-status" data-link-apply-status role="status" hidden></p>
      </div>
    </form>
  </section>

</Base>

<style>
  .pagehead.links-heading { padding-block: var(--sp-6); }
  .pagehead.links-heading::before, .pagehead.links-heading::after { top: var(--sp-6); }

  .links-directory {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .links-directory .group .sec { margin-block-start: var(--sp-5); }
  .links-waves {
    --links-waves-size: clamp(5rem, 15vw, 14rem);
    display: flex;
    align-items: flex-end;
    min-block-size: var(--links-waves-size);
    /* 点阵在第一组后，友站卡片紧接页头。 */
    grid-row: 2;
    margin-block: var(--sp-5) 0;
    overflow: hidden;
    border-radius: var(--sp-3);
    background: var(--links-mosaic-bg);
  }
  .links-waves:empty {
    background-image: radial-gradient(circle, var(--links-mosaic-base) 1px, transparent 1.5px);
    background-size: var(--sp-2) var(--sp-2);
  }
  .links-waves :global(.ln-footer-art) {
    height: var(--links-waves-size);
    margin: 0;
    color: var(--links-mosaic-base);
  }
  .links-waves :global(.ln-footer-art-fallback) { max-width: none; }

  .links-info {
    display: grid;
    gap: var(--sp-4);
    margin-block: var(--sp-6) var(--sp-5);
  }
  .links-info .sec { margin-top: 0; }
  .mine-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
  }
  .card-mine {
    flex: 0 1 22.5rem;
    width: min(100%, 22.5rem);
  }
  .mine-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
  }
  .mine-btn,
  :global(.mine-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-2) var(--sp-4);
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    font: inherit;
    font-size: var(--fs-sm);
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }
  .mine-btn:hover,
  .mine-btn:focus-visible,
  :global(.mine-btn:hover),
  :global(.mine-btn:focus-visible) {
    background: var(--accent-ink);
    border-color: var(--accent-ink);
  }
  .mine-btn-ghost,
  :global(.mine-btn-ghost) {
    background: var(--panel);
    color: var(--ink);
    border-color: var(--hair);
  }
  .mine-btn-ghost:hover,
  .mine-btn-ghost:focus-visible,
  :global(.mine-btn-ghost:hover),
  :global(.mine-btn-ghost:focus-visible) {
    background: var(--accent-wash);
    border-color: var(--accent);
    color: var(--ink);
  }

  /* ===================================================================
   * 底纹层（PAGE PLATE）—— 墨笔 ∞ **替代**百褶 ∞（站主 2026-10-05 拍板）
   *
   * 挂法照抄 Topbar 的 `body.chrome-page .page-inf`（百褶 ∞ 那一层）：
   *   fixed 挂视口居中 / `contain` / `z-index:-1` / 不拦指针
   *   —— 全站纸白区只有一套纹理语言，本页换**母题**不换**角色**。
   * ★ 三项**刻意不照抄**，理由写在 markup 的plate 槽注记里（素材差异逼出来的，
   *   与说说页/关于页同一课：「唯一不能照抄的是素材本身」）：
   *   ① 取宽不照抄 `min(128vw,1600px)`（那是**故意出血**，本图铺满画布 ⇒ 收到画内）
   *   ② 透明度不照抄 `.2` —— 本图墨色重、覆盖 10.3%（实测alpha>0 占比），
   *      .2 相当于比站内装饰底纹定稿档（8%）重 2.5 倍
   *   ③ 不需要 background-color：素材自带 alpha，叠底色 = 双重压暗
   * ★ `--plate-w` / `--plate-op` 留给"再调分量"用（可在 HTML 上内联覆盖，不改样式表）
   * =================================================================== */
  .inf-ink-plate {
    position: fixed;
    left: 50%;
    top: 50%;
    width: var(--plate-w, min(92vw, 1400px, 190vh));
    aspect-ratio: 1920 / 1090;
    transform: translate(-50%, -50%);
    /* ★ 透明度 .09：站内装饰底纹定稿档是 8%（`--deco-plate-coarse` = #2d7d4614
       = 20/255 ≈ 7.8%，文章页方格那轮站主亲选）。本图墨笔的浓淡层次比方格丰富，
       略抬一档到 9% 让笔锋看得出来，但**不回到百褶 ∞ 的 .2** —— 那一档配的是
       "近白米色呢喃"的素材，本图是不透明墨，.2 会把「纸白阅读底」压过去。
       ★★ 2026-11-13：暗档不再靠 `html.dark` 整条替换 —— 那时拖动软条全程是 9% 的原图，
       松手那一瞬才跳到 17% 的铜色。现在滤镜按 --theme-w 连续化（`--plate-filter-ink`），
       浓度写成两个端点的 calc：亮 9% → 暗 17%。`--plate-op` 仍是人工旋钮，
       只要它被内联设了值，两项取同一个数、结果就等于它（乘 (1-w) + w = 1）。 */
    filter: var(--plate-filter-ink);
    opacity: calc(
      var(--plate-op, 0.09) * (1 - var(--theme-w)) +
        var(--plate-op, var(--links-plate-dark-opacity)) * var(--theme-w)
    );
    pointer-events: none;
    z-index: -1;
  }
  /* ★ `max-width: none` 必需：base.css 给 `img` 定了 `max-width:100%`，
     而这一层刻意比版心宽 —— 不解除限制它会缩到父盒宽度，底纹跟着版心走。 */
  .inf-ink-plate img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
  }

  /* 装置画布：与底纹同层（同 z-index:-1），DOM 在后 ⇒ 连线画在墨笔 ∞ **之上**、正文之下。
     `inset:0` 满屏 ⇒ 一次对尺寸，滚动时不需要任何重算（fixed 不随文档走）。 */
  .const-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
    /* ★ 显隐门控照抄首页 DNA（`.dna-stack :global(canvas)` + `.is-ready`）：
       元素始终占位（`fit()` 要量 clientWidth），没就绪时只是不可见。
       **不用 `hidden` 属性** —— 那会让 clientWidth 恒为 0，装置量不到尺寸。 */
    opacity: 0;
    transition: opacity 640ms var(--ease-glass);
  }
  .const-bg.is-ready {
    opacity: 1;
  }

  /* ★★ 必须关掉本页的百褶 ∞（`.page-inf`，Topbar 渲染、全站内页共用）。
     不关就是两套母题叠在一起（Topbar 注释里已记过这个教训：「切片档案」四层
     换 ∞ 底纹时就是因为叠着才整体删掉）。
     ⚠ 用 `:global(...)`：`.page-inf` 是 Topbar 的元素、带的是**别的**作用域属性；
       且那边写的是 `body.chrome-page .page-inf`（0,2,1）⇒ 权重必须对齐才压得住。
     关法用 `display:none` 而非 `opacity:0`：后者仍占一层满屏合成层，很贵。 */
  :global(body.links-plate .page-inf) {
    display: none;
  }

  .lede {
    margin: var(--sp-4) 0 0;
    max-width: var(--measure);
    color: var(--muted);
  }
  .sec {
    margin: var(--sp-8) 0 var(--sp-3);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--muted);
    border-left: 3px solid var(--accent);
    padding-left: 0.6em;
  }
  .note {
    margin: 0 0 var(--sp-3);
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--sp-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.25em;
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--hair);
    background: var(--panel);
    text-decoration: none;
    color: var(--ink);
    /* ★ 装置「星座」的**卡片节点**：星点画在卡片右上角外侧（`::before`）。
     *
     *   为什么节点星不能只画在 canvas 上（本轮踩到）：
     *     canvas 在 `z-index:-1` 层，而 `.card` 有**不透明底色** `--panel` 且在
     *     `z-index:1` 的层叠上下文里 ⇒ 画在卡片中心的节点会被卡片整个盖住，
     *     截图中表现为"卡片区一颗星都没有"。连线同理，中心段被遮。
     *   ⇒ 分工：canvas 只画**连线**（它在卡片之下，正好读作"线从卡片背后连出去"），
     *     节点星本体交给 `::before` —— 它在卡片之上，永远可见。
     *
     *   亮度由脚本写入的 `--node-lit`（0..1）驱动，缺省 0 ⇒ **无 JS 时不画星点**
     *   （降级态②：无 JS 不该凭空多出一个装饰点）。 */
    position: relative;
  }
  .card::before {
    content: '';
    position: absolute;
    top: -5px;
    right: -5px;
    z-index: 2;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    /* ★ 8 位 hex，不写 rgba()；`calc()` 里用 0/1 相乘得到 0 或 1 的透明度 */
    opacity: calc(var(--node-lit, 0) * 0.9);
    box-shadow: 0 0 0 calc(var(--node-lit, 0) * 4px) var(--accent-wash);
  }
  .card:hover {
    border-color: var(--accent);
    background: var(--accent-wash);
  }
