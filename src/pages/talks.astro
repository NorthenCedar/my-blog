---
import '../styles/visitor.css';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import TalkImageViewer from '../components/TalkImageViewer.astro';
import TalkVideoViewer from '../components/TalkVideoViewer.astro';
import { renderTalkText } from '../lib/talk-text';
import { requireContentLink } from '../lib/content-urls.mjs';
import { validateTalkVideos } from '../lib/video-assets.mjs';
import { validateTalkAudio } from '../lib/audio-assets.mjs';
// 回复区样式（2026-09-28）：全局引入。本页 <style> 是 scoped，
// 而回复元素是 JS 运行时创建的（没有 data-astro-cid）⇒ 写在本页 style 里不会生效。
import '../styles/replies.css';
import '../vendor/react-bits/ThoughtLineDisclosure.css';

/** 说说页（2026-09-26 站主按参考站要求新增）：短的、没成为文章的东西。
 *  体例取自参考站「说说」：时间线，每条 = 时间 + 正文（那边还带序号，本站不加序号 ——
 *  时间已经很清楚地表达顺序，序号会跟站上别处的"编号"语义打架）。
 *  内容在 content/pages/talks.md。
 *
 *  图片（站主 2026-09-26："可以加图片"）：图片文件放 src/assets/talks/，说说里写文件名。
 *  为什么图片不在 content/ 下 —— 站上所有图片都要参与**构建期优化**（转 WebP + 出 srcset），
 *  只有 src/ 里的资源能被 Astro 处理；这是内容层唯一的例外，写作手册里写明了。 */
interface TalkImage {
  src: string;
  alt: string;
}
interface TalkVideo {
  src: string;
  alt: string;
}
/** 说说里的语音（2026-11-10）：文件放 content/audio/，这里只写 /audio/<hash>.mp3|wav */
interface TalkAudio {
  src: string;
  label?: string;
}
interface Talk {
  id?: string;
  date: string | Date;
  text: string;
  href?: string;
  images?: TalkImage[];
  videos?: TalkVideo[];
  audio?: TalkAudio[];
}
interface TalksData {
  intro?: string;
  items?: Talk[];
}
const entry = await getEntry('pages', 'talks');
const d = (entry?.data ?? {}) as unknown as TalksData;
/** YAML 会把未加引号的 `date: 2026-09-26` 隐式解析成 Date 对象 —— 归一成 YYYY-MM-DD。
 *  站上同一条约定见 src/lib/schema.ts 的 dateField（这里没走 schema，因为 pages 集合不校验）。 */
const iso = (v: string | Date) => (v instanceof Date ? v.toISOString().slice(0, 10) : String(v));
/** 倒序 = 新的在最上面（站主 2026-09-28 定）。
 *  ⚠️ **必须先归一成 ISO 再比** —— 直接 `String(a.date)` 比的是 Date 的默认字符串
 *  （"Sat Sep 26 2026 08:00:00 GMT+0800…"），开头是**星期名**：09-26 是 Sat、09-28 是 Mon，
 *  "Sat" > "Mon" ⇒ 旧的反而被排到最上面（2026-09-28 实测到的就是这个现象）。
 *  同日多条靠 Array.sort 的稳定性保留文件里的先后（写作手册要求"新的写最上面"）。 */
const items = [...(d.items ?? [])].sort((a, b) => {
  const x = iso(a.date);
  const y = iso(b.date);
  return x < y ? 1 : x > y ? -1 : 0;
});
const fmt = (v: string | Date) => {
  const [y, m, day] = iso(v).split('-');
  return `${y} 年 ${Number(m)} 月 ${Number(day)} 日`;
};
/**
 * 每条说说的**稳定标识**（点赞与评论都挂在它上面）。
 *   · 默认 = 日期（去掉连字符）+ 同一天的第几条（a/b/c…）⇒ `talk-20260926`、`talk-20260926b`
 *   · **刻意不用正文做哈希**：改了文字不该丢掉已经攒下的赞和评论；
 *     用"日期 + 当日序号"则只有"在同一天中间插一条"才会挪位（罕见，且可显式写 id 固定）。
 *   · 想钉死某一条：在 talks.md 里给它加 `id: talk-xxx`（必须符合 ^[a-z0-9-]+$ 且以 talk- 开头）。
 */
const slugOf = (t: Talk): string => {
  if (t.id) return t.id;
  const day = iso(t.date).replace(/-/g, '');
  const sameDay = items.filter((x) => iso(x.date) === iso(t.date));
  const nth = sameDay.indexOf(t);
  return `talk-${day}${nth === 0 ? '' : String.fromCharCode(97 + nth)}`;
};
// 说说配图：构建期收进来，才能走 Astro 的优化管线（WebP + srcset）
// ⚠️ 位置有讲究：`rows` 里要用 `assetOf`（把配图拼进统一媒体网格），
//    而 `const` 是 TDZ ⇒ 这两行必须留在 `rows` **之前**（2026-11-12 构建实测：
//    放后面报 `Cannot access 'assetOf' before initialization`）。
const talkAssets = import.meta.glob<{ default: ImageMetadata }>('/src/assets/talks/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const assetOf = (name: string) => talkAssets[`/src/assets/talks/${name}`]?.default;
const rows = items.map((t) => {
  const slug = slugOf(t);
  if (t.href != null && t.href !== '') requireContentLink(t.href, `content/pages/talks.md 的 ${slug}.href`);
  const videos = validateTalkVideos(t.videos, `content/pages/talks.md 的 ${slug}`);
  const images = (t.images ?? []).map((img, index) => ({ ...img, index, asset: assetOf(img.src) }));
  /* ★ 2026-11-12（第二轮）站主：「图片和视频的排版太乱了，做整齐一点」。
     原来图片走 `.shots`（3 栏方图）、视频单独一条 `.clips`（288 宽、比图片宽一大截），
     同一条说说里两套尺寸、两个左缘 —— 看起来像两拨东西掉在同一页上。
     ⇒ 图片与视频**并进同一张网格**：一种方块、一种间距、一个左缘。
     栏数只看总数（1 / 2 / 4 → 1 / 2 / 2 栏，其余 3 栏），4 个媒体正好排成 2×2。 */
  const media = [
    ...images.map((img) => ({ kind: 'image' as const, ...img })),
    ...videos.map((video, index) => ({ kind: 'video' as const, ...video, index })),
  ];
  const columns = media.length <= 2 ? Math.max(media.length, 1) : media.length === 4 ? 2 : 3;
  return { t, slug, videos, audio: validateTalkAudio(t.audio, `content/pages/talks.md 的 ${slug}`), media, columns };
});

/**
 * 视频封面（站主 2026-11-12：「不点开是黑色的，给他一张封面」）。
 *   · 约定：`public/videos/<sha>.poster.jpg` —— 与原件同名的首帧截图，
 *     由 `scripts/gen-video-poster.mjs` 抽出（本机没有 ffmpeg，用浏览器解码）。
 *   · 文件不在就返回 undefined：`poster` 属性干脆不写，
 *     让浏览器退回首帧，不会留下一个指向 404 的空封面。 */
const posterOf = (src: string): string | undefined => {
  const poster = src.replace(/\.(?:mp4|webm)$/, '.poster.jpg');
  return existsSync(join(process.cwd(), 'public', poster)) ? poster : undefined;
};
// 说说配图：构建期收进来，才能走 Astro 的优化管线（WebP + srcset）
// （`talkAssets` / `assetOf` 已提到 `rows` 之前，原因见那里。）
// 大档按实际配图生成；链接提供无脚本后备，缩略图在列表中居中裁成正方形。
const fullImages = new Map(await Promise.all(rows.flatMap(({ t }) => t.images ?? []).map(async (img) => {
  const asset = assetOf(img.src);
  return [img.src, asset ? (await getImage({ src: asset, width: Math.min(asset.width, 1920), format: 'webp' })).src : ''] as const;
})));

/* 底纹母题（站主 2026-10-04 指定）：墨点螺旋图，**替代本页的百褶 ∞**。
   ⚠️ 目录必须放在 `talks/` 的子目录里 —— 上面那条 `*.{jpg,…}` 是**非递归** glob，
      真把文件放进 `talks/` 根下会被它当成"说说的配图"一起收进去（多一份产物）。
   素材处理（不裁、不染，只转 WebP）见 `_probe/_talk-plate.mjs`。 */
const PLATES = import.meta.glob<{ default: ImageMetadata }>('/src/assets/talks/plates/*.webp', { eager: true });
const plate = PLATES['/src/assets/talks/plates/drift-main.webp']?.default;
---

<Base title="说说" current="talks" chrome="page" bodyClass="talks-plate">
  {/* ===================================================================
   * 视口装饰层（plate 槽）—— 两层：**静态底纹** + **动态装置**
   *
   * ① `.float-plate`：站主 2026-10-04 指定「把这个放在原来百褶无限符号的地方」。
   *    挂法照抄百褶 ∞（`body.chrome-page .page-inf`）—— fixed 挂视口居中、`contain`、
   *    `z-index:-1`、不拦指针；全站纸白区只有**一套纹理语言**，
   *    本页换的是母题（∞ → 墨点螺旋），不是角色。
   *    ★ 三项刻意不照抄，都是素材差异（关于页那条教训：「唯一不能照抄的是素材本身」）：
   *      ① 比例：本图 1317/563，∞ 是 1572/878。
   *      ② 透明度：∞ 的 `.2` 配本图重约 4 倍 ⇒ 取站上**自己**的装饰底纹定稿档 8%。
   *      ③ 取宽：∞ 是**故意出血**的 `min(128vw,1600px)`，本图墨迹铺满画布
   *         ⇒ 出血会切掉最外圈月牙，站主目检定「小一点，不要出去了」⇒ 收回画内。
   *      三条的推导与实测都写在下面样式段的 `.float-plate` 注释里。
   *    ★ 素材**不裁不染**（`_probe/_talk-plate.mjs`）：四边的月牙本来就触到画布边缘，
   *      按任何阈值裁都会切掉最外圈的月牙尖 —— 而那正是整张图的读法。
   *
   * ② `.float-bg`：本页的装置（FLOAT）画布，逻辑在 `src/scripts/float.ts`。
   *    与底纹同层（都在 z-index:-1）、DOM 在后 ⇒ 雨画在墨点**之上**、正文之下。
   *
   * ★★ 两层都必须走 `plate` 具名槽，不能塞进普通 slot：
   *    `.shell` 在页面过渡里会被 `transform`，而被 transform 的祖先会成为
   *    `position:fixed` 的包含块 ⇒ 装饰层会从下往上跳（关于页实测 91px）。
   *    百褶 ∞ 那层一直没事，正因为它在 `.shell` 外面。
   * =================================================================== */}
  <Fragment slot="plate">
    {plate && (
      <div class="float-plate" aria-hidden="true">
        <Image
          class="float-img"
          src={plate}
          alt=""
          widths={[590, 1180]}
          sizes="86vw"
          loading="eager"
          decoding="sync"
        />
      </div>
    )}
    <canvas class="float-bg" data-float-bg aria-hidden="true"></canvas>
  </Fragment>
  <header class="pagehead" data-build="text">
    <PageTitle>说说</PageTitle>
    {d.intro && <p class="lede">{d.intro}</p>}
  </header>

  {/* 多光标搭建（2026-11-12 站主口径）：不是在页面里放演示，而是**这一页本身**
      由几枚光标搭出来 —— 往下滚是搭，往回滚是撤。装饰画在 body 上那张 fixed canvas
      （`src/scripts/talks-build.ts`），这里只留一句说明。 */}
  <p class="build-note" data-build="text">
    这一页是七枚光标搭出来的：往下滚，它们会把下一条拉框、落字；往回滚就原路撤回。
  </p>

  <ol class="talks" data-talks-build>
    {rows.map(({ t, slug, audio, media, columns }) => (
      <li class="talk">
        <time datetime={iso(t.date)} data-build="carry">{fmt(t.date)}</time>
        <div class="talk-content">
          <p class="body" data-build="text">
            <Fragment set:html={renderTalkText(t.text)} />
            {t.href && <> <a href={t.href}>链接</a></>}
          </p>
          {/* 语音（2026-11-10）：贴在正文后面、配图前面 —— 它是"说出来的那句正文"，
              不是配图也不是配视频，顺序上该紧跟着文字。 */}
          {audio.length > 0 && (
            <div class="talk-audio" data-build="carry">
              {audio.map((a) => (
                <div class="ap" data-audio data-src={a.src} data-label={a.label}>
                  <audio controls preload="metadata" src={a.src} aria-label={a.label || '语音'}></audio>
                </div>
              ))}
            </div>
          )}

          {media.length > 0 && (
            <div class="shots" data-columns={columns}>
              {media.map((m) =>
                m.kind === 'image' ? (
                  m.asset ? (
                    <a
                      class="shot"
                      data-build="rect"
                      href={fullImages.get(m.src)}
                      data-talk-image={`talk-image-${slug}-${m.index}`}
                      data-no-transition
                      aria-label={`放大查看：${m.alt}`}
                    >
                      <Image
                        src={m.asset}
                        alt={m.alt}
                        widths={[480, 760]}
                        sizes={
                          columns === 1
                            ? '(max-width: 767px) 65vw, 288px'
                            : columns === 2
                              ? '(max-width: 767px) 44vw, 280px'
                              : '(max-width: 767px) 28vw, 184px'
                        }
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  ) : (
                    <p class="missing">找不到图片 {m.src}（应放在 src/assets/talks/ 下）</p>
                  )
                ) : (
                  /* 视频与图片同一个方块：列表里只放封面，不预载、不带控件，
                     点开才在弹窗里播放（站主 2026-11-12：「点开才能看大图」）。
                     说明文字压在封面左下角的小胶囊里 —— 放在方块**外面**
                     会把这一格的高度撑出网格的节奏（就是原来那种参差感）。 */
                  <a
                    class="shot shot-video"
                    data-build="rect"
                    href={m.src}
                    data-talk-video={`talk-video-${slug}-${m.index}`}
                    data-astro-prefetch="false"
                    data-astro-reload
                    data-no-transition
                    aria-label={`播放视频：${m.alt}`}
                  >
                    <video preload="none" muted playsinline tabindex="-1" aria-hidden="true" src={m.src} poster={posterOf(m.src)}></video>
                    <span class="clip-play" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="18" height="18" focusable="false"><path d="M8 5.3v13.4L19 12Z" /></svg>
                    </span>
                    <span class="shot-cap">{m.alt}</span>
                  </a>
                ),
              )}
            </div>
          )}

          {/* 点赞和评论以说说的稳定 slug 对应服务端记录。 */}
          <div class="acts" data-build="carry">
            <button type="button" class="act like" data-like={slug} aria-label="点赞" aria-pressed="false">
              <svg class="heart" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
                <path d="M12 20.3 4.6 13a4.8 4.8 0 0 1 6.8-6.8l.6.6.6-.6A4.8 4.8 0 0 1 19.4 13Z" />
              </svg>
              <span data-like-count>·</span>
            </button>
            <button type="button" class="act" data-toggle={slug} aria-expanded="false" aria-controls={`c-${slug}`}>
              <span>评论<span data-count-for={slug}></span></span>
              <svg class="comment-chevron" viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true">
                <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
          <section class="cbox thought-line__trace" id={`c-${slug}`} data-comments-for={slug} aria-hidden="true" inert>
            <div class="thought-line__fold">
              <div class="cbox-content">
                <div class="thought-line__trace" data-comment-results>
                  <div class="thought-line__fold">
                    <ol class="clist" data-list></ol>
                    <p class="cempty" data-empty hidden>还没有评论，你可以是第一个。</p>
                  </div>
                </div>
                <form class="cform" data-form novalidate>
                  <label for={`n-${slug}`}>名字</label>
                  <input id={`n-${slug}`} name="name" type="text" maxlength="40" autocomplete="nickname" required />
                  <label for={`b-${slug}`}>评论</label>
                  <textarea id={`b-${slug}`} name="body" rows="3" maxlength="1000" required></textarea>
                  <div class="hp" aria-hidden="true">
                    <label for={`w-${slug}`}>网站（请留空）</label>
                    <input id={`w-${slug}`} name="website" type="text" tabindex="-1" autocomplete="off" />
                  </div>
                  <button type="submit" data-submit>发表</button>
                </form>
                <p class="cerror" role="alert" data-error hidden></p>
              </div>
            </div>
          </section>
        </div>
      </li>
    ))}
  </ol>
  {rows.length === 0 && <p class="empty">还没有说说。</p>}
  {rows.flatMap(({ t, slug }) => (t.images ?? []).map((img, i) => {
    const asset = assetOf(img.src);
    return asset && <TalkImageViewer id={`talk-image-${slug}-${i}`} src={fullImages.get(img.src)!} alt={img.alt} width={asset.width} height={asset.height} />;
  }))}
  {rows.flatMap(({ videos, slug }) => videos.map((video, i) => (
    <TalkVideoViewer id={`talk-video-${slug}-${i}`} src={video.src} alt={video.alt} poster={posterOf(video.src)} />
  )))}
</Base>

<style>
  .lede {
    margin: var(--sp-4) 0 0;
    max-width: var(--measure);
    color: var(--muted);
  }
  /* 多光标搭建（2026-11-12 第二轮，站主纠正口径）：
     「我是让你用多光标页面搭建这个效果把说说页搭建起来，不是让你直接把这个放到说说页」
     ⇒ 页面里不再嵌任何演示框 —— **这一页本身**是搭出来的：
       几枚光标飞过来、在每条说说外面拉一个框、内容随后落位；上滚原路撤回。
     装饰层是 JS 往 body 上挂的一张 fixed canvas（`.tb-layer`，不拦指针），
     真正的显隐由 `data-built` 驱动。 */
  /* ⚠ 这张画布是 **JS 创建的**（`document.createElement`），身上没有 Astro 的
     `data-astro-cid-*` ⇒ 本页 scoped 选择器**碰不到它**。第一版就栽在这：
     `.tb-layer` 规则没生效，画布退回内联元素、被追加到 body 末尾随文档滚动，
     于是"明明在画（getImageData 数得到墨）却一个人也看不见"。
     ⇒ 必须写 `:global(...)`。同理，任何由脚本生成的节点都要走 :global。 */
  :global(.tb-layer) {
    position: fixed;
    inset: 0;
    z-index: 8;
    pointer-events: none;
  }
  /* ⚠ 藏内容这件事**必须**由 `html.build-ok` 把关（脚本加了类才会藏）：
     没有 JS、脚本失败、减少动效 —— 内容一律原样可见，绝不能出现"整页空白"。
     ★ 这里**不写 transition**：2026-11-12 第三轮起，每一块都由脚本按自己的时间轴
       逐帧写 opacity / transform / clip-path（文字逐字、图片 drag-and-drop、其余整块拖）。
       留一条 CSS 过渡只会和脚本抢同一批属性，表现得像"慢半拍"。
     ★ 也不写 `translateY`：carry 的位移是脚本算出来的，初始偏移会让基准矩形算错。 */
  html.build-ok [data-build] {
    opacity: 0;
  }
  /* 文字块的框要**贴住文字**，不是贴住盒。`.pagehead` / `.body` 是块级元素，
     宽度撑满容器 ⇒ 光标拉出来的框会比文字宽一大截（实测 1184 × 273 包着一个
     三百来字宽的标题）。`fit-content` 让宽度收到「最宽那一行」，
     而 `max-width: 100%` 保证长段落仍在原来的换行点折行。
     ⚠ 逐字 span 即使 `opacity: 0` 也占位，所以搭建过程中宽度不塌、不会抖。 */
  html.build-ok [data-build='text'] {
    width: fit-content;
    max-width: 100%;
  }
  @media (prefers-reduced-motion: reduce) {
    html.build-ok [data-build] { opacity: 1; transform: none; clip-path: none; }
  }
  /* ★★ 2026-11-13 站主：「改成搭建中不能点击评论吧，要不然一下搭完太突兀了」。
     搭建期间这颗开关**点不动**（类由 `talks-build.ts` 的 `syncBuilding()` 挂/摘）。
     为什么只锁它：点赞不改布局；而展开评论会把这一条以下整体下推，正在飞的框与
     缩略图按缓存的旧基准走 ⇒ 正好压到刚展开的表单上（站主截图里那一片）。
     `cursor: default` 是给的一点暗示 —— 不降透明度：搭建只有一两秒，
     按钮忽然变灰比"暂时按不动"更像出了故障。
     ⚠ 必须 `:global` —— `html` 是页面根，Astro 的作用域属性挂不到它上面。 */
  :global(html.is-building) .acts [data-toggle] {
    pointer-events: none;
    cursor: default;
  }
  .build-note {
    margin: var(--sp-4) 0 0;
    max-width: var(--measure);
    color: var(--muted);
    font-size: var(--fs-xs);
    letter-spacing: 0.01em;
  }
  /* 透明时间线：日期与正文分栏，留白让雨滴与墨点自然穿过。
     正文保持稳定，背景 FLOAT 继续独立绘制；只裁缩略图，不改原件与灯箱。 */
  .talks {
    --date-column: calc(var(--sp-7) * 3);
    --timeline-x: calc(var(--date-column) + var(--sp-5));
    position: relative;
    margin: var(--sp-8) 0 var(--sp-7);
    padding: 0;
    list-style: none;
    max-width: calc(var(--measure) + var(--date-column) + var(--sp-7));
    display: flex;
    flex-direction: column;
  }
  .talk {
    position: relative;
    display: grid;
    grid-template-columns: var(--date-column) minmax(0, 1fr);
    column-gap: var(--sp-7);
    padding: 0 0 var(--sp-8);
    background: transparent;
  }
  .talk:last-child { padding-bottom: 0; }
  .talk::before {
    content: '';
    position: absolute;
    left: calc(var(--timeline-x) - 2px);
    top: 0.75em;
    width: 5px;
    height: 5px;
    background: var(--accent);
  }
  .talk:not(:last-child)::after {
    content: '';
    position: absolute;
    left: var(--timeline-x);
    top: calc(0.75em + 5px);
    bottom: -0.75em;
    width: 1px;
    background: var(--hair);
  }
  time {
    display: block;
    padding-top: var(--sp-1);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .talk-content { min-width: 0; }
  .body {
    margin: 0;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  /* 媒体网格（2026-11-12 第二轮）：图片与视频共用一套方块。
     只有一条规矩 —— 所有格子都是 1:1、同一个间距、同一个左缘；
     栏数由媒体总数决定（见前面 rows 里的 columns）。 */
  .shots {
    display: grid;
    gap: var(--sp-3);
    margin-top: var(--sp-5);
  }
  .shots[data-columns='1'] {
    grid-template-columns: minmax(0, 1fr);
    width: min(100%, calc(var(--sp-8) * 4));
  }
  .shots[data-columns='2'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .shots[data-columns='3'] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  /* 缩略方块（站主 2026-11-12：「把图片和视频的正方形都改成圆角的」）：
     圆角、细边、裁切都挂在承载链接上，img/video 自己不带边框 —— 否则直角的边框
     会从圆角外面露出来，圆角就白做了。 */
  .shots .shot {
    position: relative;
    display: block;
    min-width: 0;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--hair);
    border-radius: var(--sp-2);
    background: var(--panel);
  }
  .shots .shot:focus-visible { outline: 2px solid var(--accent-ink); outline-offset: var(--sp-1); }
  .shots :global(img),
  .shots :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    background: var(--panel);
  }
  /* 视频说明：压在封面左下的小胶囊（吃纸色底，亮暗两套都自带对比）。
     放方块外面会把那一格撑高，网格立刻参差 —— 这正是原来"乱"的来源之一。 */
  .shot-cap {
    position: absolute;
    left: var(--sp-2);
    bottom: var(--sp-2);
    max-width: calc(100% - var(--sp-4));
    padding: 0.15em 0.55em;
    border: 1px solid var(--hair);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    font-size: var(--fs-xs);
    line-height: 1.6;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    pointer-events: none;
  }
  /* 播放键压在封面上：吃 --paper 底、--ink 三角，亮暗两套都自带对比。 */
  .clip-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .clip-play svg {
    box-sizing: content-box;
    width: 1.15rem;
    height: 1.15rem;
    padding: 0.55rem;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    fill: currentColor;
    opacity: 0.92;
  }
  .shot-video:hover .clip-play svg { opacity: 1; }
  .missing {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--muted);
    border: 1px dashed var(--hair);
    padding: var(--sp-2) var(--sp-3);
  }
  .empty {
    margin: var(--sp-8) 0 0;
    color: var(--muted);
  }
  /* ---- 点赞 / 评论 ---- */
  .acts {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-top: var(--sp-3);
  }
  .act {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-block-size: 2.5rem;
    padding: var(--sp-1) var(--sp-3);
    font: inherit;
    font-size: var(--fs-xs);
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--hair);
    border-radius: 999px;
    cursor: pointer;
    font-variant-numeric: tabular-nums;
  }
  .act[hidden] { display: none; }
  .act:is(:hover, :focus-visible, [aria-expanded='true']) {
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  /* 已赞：填色 + 高亮（按下态靠 aria-pressed，屏幕阅读器也读得到） */
  .like[aria-pressed='true'] {
    color: var(--accent-ink);
    border-color: var(--accent);
    background: var(--accent-wash);
  }
  .like[aria-pressed='true'] .heart path {
    fill: currentColor;
  }
  .heart path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .acts :global(.pulse-heart__count) { font-size: var(--fs-xs); }
  .comment-chevron { flex: none; }
  .act[aria-expanded='true'] .comment-chevron { transform: rotate(180deg); }
  .cbox {
    --tl-ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --tl-settle: 350ms;
  }
  .cbox[data-comment-jump] { --tl-settle: 0ms; }
  .cbox-content {
    margin-top: var(--sp-3);
    padding: var(--sp-4);
    border: 1px solid var(--glass-line);
    border-radius: var(--sp-3);
    background: var(--glass-bg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .act, .comment-chevron, .cbox-content :global(.reply-btn) {
      transition: transform var(--dur-fast) var(--ease-interact), color var(--dur-hover) var(--ease-interact);
    }
    .act:active, .cbox-content :global(.reply-btn:active) { transform: translateY(1px) scale(0.98); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cbox { --tl-settle: 0ms; }
  }
  @media (pointer: coarse) {
    .act { min-block-size: 44px; }
  }
  .clist:empty { margin: 0; }
  .clist {
    list-style: none;
    margin: 0 0 var(--sp-3);
    padding: 0;
  }
  /* ★ li 是 talks.ts 运行时 createElement 注入的，拿不到编译期加的 data-astro-cid，
     scoped 产物会写成 `.clist[cid] li[cid]` ⇒ 整条规则静默失效（列表裸奔：无分隔线、无留白）。
     后代选择器里那一段一旦是动态元素，就必须 :global()，让它产出 `.clist[cid] li`。 */
  .clist :global(li) {
    padding: 0.5em 0;
    border-bottom: 1px solid var(--hair);
  }
  /* ★ 同样理由：这两个类是 talks.ts 动态加的，必须 :global()，
     否则产物是 `.cmeta[cid]` 匹配不上，条目元信息掉回浏览器默认样式。 */
  :global(.cmeta) {
    font-size: var(--fs-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  :global(.cbody) {
    margin: 0.2em 0 0;
    color: var(--ink);
    font-size: var(--fs-sm);
    white-space: pre-wrap;
    word-break: break-word;
  }
  .cempty,
  .cerror {
    margin: 0 0 var(--sp-3);
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .cerror {
    color: #a33;
  }
  .cform {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.4em var(--sp-3);
  }
  .cform label {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .cform input,
  .cform textarea {
    font: inherit;
    font-size: var(--fs-sm);
    color: var(--ink);
    background: var(--panel);
    border: 1px solid var(--hair);
    padding: 0.35em 0.5em;
  }
  .cform textarea { inline-size: 100%; resize: vertical; }
  .cform textarea,
  .cform .hp,
  .cform button {
    grid-column: 1 / -1;
  }
  .cform button {
    justify-self: start;
    margin-top: 0.3em;
    padding: 0.35em 0.9em;
    font: inherit;
    font-size: var(--fs-xs);
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--hair);
  }
  .cform button:hover {
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  /* 蜜罐：真人看不见，也不会进 Tab 序 */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  @media (max-width: 767px) {
    .talks {
      --timeline-x: 0px;
      margin-top: var(--sp-7);
    }
    .talk {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--sp-3);
      padding-left: var(--sp-5);
      padding-bottom: var(--sp-7);
    }
    time { padding-top: 0; }
    .talk::before { top: 0.5em; }
    .talk:not(:last-child)::after { top: calc(0.5em + 5px); bottom: -0.5em; }
    .shots { gap: var(--sp-2); }
    .shots[data-columns='1'] { width: min(100%, 65vw, calc(var(--sp-8) * 4)); }
  }

  /* ===================================================================
   * 底纹层（PAGE PLATE）—— 墨点螺旋**替代**百褶 ∞（站主 2026-10-04）
   *
   * 挂法照抄 Topbar 的 `body.chrome-page .page-inf`（百褶 ∞ 那一层）：
   *   fixed 挂视口居中 / `min(128vw,1600px)` / `contain` / `z-index:-1` / 不拦指针
   *   —— 全站纸白区只有一套纹理语言，本页换**母题**不换**角色**。
   * ★ 两项**刻意不照抄**，都是素材差异逼出来的（关于页同一课：「唯一不能照抄的是素材本身」）：
   *   ① 比例：∞ 是 1572/878，本图 1317/563
   *   ② 透明度：∞ 的 .2 配本图重约 4 倍 ⇒ 取站上自己的装饰底纹 8% 档（见下）
   * ★ `--plate-w` / `--plate-op` 两个变量留给"再调分量"用（可以只在 HTML 上内联覆盖，
   *   不必改样式表）；默认值就是校准后的定稿。四档对照样机见 `_probe/_float-verify.mjs`。
   * =================================================================== */
  .float-plate {
    position: fixed;
    left: 50%;
    top: 50%;
    /* ★★ 取宽**不照抄**百褶 ∞ —— 站主 2026-10-04 目检后定了「小一点，不要出去了」。
       ∞ 用的是 `min(128vw,1600px)`，那是**故意出血**（∞ 的两头被视口切掉是它的读法，
       它的墨迹只占取景框 45.8%，切掉的本来就是空白）。本图墨迹**铺满整个画布**，
       出血 = 最外圈那排月牙被切掉半截，读起来像"图被裁坏了" ⇒ 必须收到画内。
       ⇒ `min(86vw, 1180px, 200vh)`：三个上限各管一件事
          · 86vw —— 任何视口宽下都留 ≥7% 余量（1440 实测取 1180，左右各 130px）
          · 1180px —— 超宽屏不让它无限长（同时仍是版心 544px 的两倍多，"大尺度氛围"没丢）
          · 200vh —— 兜住"又宽又扁"的窗（横屏平板）：图高 ≤ 85.5vh，上下永远留得下。 */
    width: var(--plate-w, min(86vw, 1180px, 200vh));
    aspect-ratio: 1317 / 563;
    transform: translate(-50%, -50%);
    /* ★★ 透明度**不是**照抄 ∞ 的 .2 —— 这是本页唯一一处必须偏离 ∞ 定稿值的地方，
       理由是**等视觉分量**：.2 这个数字只对 ∞ 那张素材有意义（近白的米色呢喃，
       实测整块底纹"纸白上一道极淡的暖痕"），换成本图（不透明区 rgb(30,30,29)、
       覆盖 12.2%）后同样 .2 的分量重了约 4 倍，会把"纸白阅读底一字不改"压过去。
       ⇒ 取 **.08**：站上**自己**的装饰底纹定稿档就是 8%
         （`--deco-plate-coarse` = `#2d7d4614` = 20/255 ≈ 7.8%，文章页方格那轮站主亲选）。
         同一把尺子量两张图，比"照抄一个只对旧素材成立的数字"更忠实于原意。
       ★★ 2026-11-13：暗档滤镜与浓度改成连续（--theme-w）——
          原来 `html.dark` 那条只在松手后成立，拖动全程停在 8% 的原图。 */
    filter: var(--plate-filter-ink);
    opacity: calc(
      var(--plate-op, 0.08) * (1 - var(--theme-w)) +
        var(--plate-op, var(--talks-plate-dark-opacity)) * var(--theme-w)
    );
    pointer-events: none;
    z-index: -1;
  }
  /* ★ `max-width: none` 仍是必需的：base.css 给 `img` 定了 `max-width:100%`，
     而这一层刻意比版心宽（`min(86vw,1180px,200vh)` 仍 ≥ 1180px，版心只有 544px）
     —— 不解除限制它就缩到父盒宽度，底纹会跟着版心走。 */
  .float-plate img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
  }
  /* 暗底上的月相使用哑光铜橙，仍能分辨圆缺与半透明边缘。
     ★ 2026-11-13：这条规则已并入上面的 `.float-plate`（滤镜与浓度都按权重连续走）。 */

  /* 装置画布：与底纹同层（同 z-index:-1），DOM 在后 ⇒ 雨画在墨点**之上**、正文之下。
     `inset:0` 满屏 ⇒ 一次对尺寸，滚动时不需要任何重算（fixed 不随文档走）。 */
  .float-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
  }

  /* ★★ 必须关掉本页的百褶 ∞（`.page-inf`，Topbar 渲染、全站内页共用）。
     不关的话两套母题会叠在一起 —— Topbar 注释里已记过这个教训
     （「切片档案」四层换 ∞ 底纹时就是因为叠着才整体删掉）。
     ⚠ 用 `:global(...)`：`.page-inf` 是 Topbar 的元素、带的是**别的**作用域属性；
       且那边写的是 `body.chrome-page .page-inf`（0,2,1）⇒ 权重必须对齐才压得住。
     关法用 `display:none` 而不是 `opacity:0`：后者仍占一层满屏合成层，很贵。 */
  :global(body.talks-plate .page-inf) {
    display: none;
  }
</style>

<script>
  // 点赞和评论分别挂载，Pulse Heart 按可见范围加载。
  // 与文章/留言页的评论脚本分开：那边是"一个页面一个评论区"，这里是"一条说说一个"。
  import '../scripts/talks';
  import '../scripts/talks-likes';
  import '../scripts/talk-image-viewer';
  import { onPage } from '../scripts/page-lifecycle';
  // 本页的装置「浮游 FLOAT」（2026-10-04）：斜飘雨线 + 下半屏椭圆涟漪。
  // 在同一个 <script> 里 import ⇒ Astro 会把两个模块并进同一个产物脚本，不新增标签。
  import '../scripts/float';
  /* 多光标搭建（2026-11-12 站主：「用多光标页面搭建这个效果把说说页搭建起来」）。
     光标与选择框都画在 body 上那张 fixed canvas 里（`src/scripts/talks-build.ts`），
     这里只负责在页面切换后重新点火。 */
  onPage(({ document }) => {
    const root = document.querySelector('[data-talks-build]');
    if (!root || root.hasAttribute('data-build-ready')) return;
    root.setAttribute('data-build-ready', '');
    void import('../scripts/talks-build').then((m) => m.initTalksBuild());
  }, '[data-talks-build]');
</script>
