---
import '../styles/visitor.css';
import { getEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import TalkImageViewer from '../components/TalkImageViewer.astro';
import { renderTalkText } from '../lib/talk-text';
import { validateTalkVideos } from '../lib/video-assets.mjs';
// 回复区样式（2026-09-28）：全局引入。本页 <style> 是 scoped，
// 而回复元素是 JS 运行时创建的（没有 data-astro-cid）⇒ 写在本页 style 里不会生效。
import '../styles/replies.css';

/** 说说页（2026-09-26 站主按参考站要求新增）：短的、没成为文章的东西。
 *  体例取自参考站「说说」：时间线，每条 = 时间 + 正文（那边还带序号，本站不加序号 ——
 *  时间已经很清楚地表达顺序，序号会跟站上别处的"编号"语义打架）。
 *  内容在 content/pages/talks.md。
 *
 *  图片（站主 2026-09-26："可以加图片"）：图片文件放 src/assets/talks/，说说里写文件名。
 *  为什么图片不在 content/ 下 —— 站上所有图片都要参与**构建期优化**（转 WebP + 出 srcset），
 *  只有 src/ 里的资源能被 Astro 处理；这是内容层唯一的例外，写作手册里写明了。 */
interface TalkImage {
  src: string;
  alt: string;
}
interface TalkVideo {
  src: string;
  alt: string;
}
interface Talk {
  id?: string;
  date: string | Date;
  text: string;
  href?: string;
  images?: TalkImage[];
  videos?: TalkVideo[];
}
interface TalksData {
  intro?: string;
  items?: Talk[];
}
const entry = await getEntry('pages', 'talks');
const d = (entry?.data ?? {}) as unknown as TalksData;
/** YAML 会把未加引号的 `date: 2026-09-26` 隐式解析成 Date 对象 —— 归一成 YYYY-MM-DD。
 *  站上同一条约定见 src/lib/schema.ts 的 dateField（这里没走 schema，因为 pages 集合不校验）。 */
const iso = (v: string | Date) => (v instanceof Date ? v.toISOString().slice(0, 10) : String(v));
/** 倒序 = 新的在最上面（站主 2026-09-28 定）。
 *  ⚠️ **必须先归一成 ISO 再比** —— 直接 `String(a.date)` 比的是 Date 的默认字符串
 *  （"Sat Sep 26 2026 08:00:00 GMT+0800…"），开头是**星期名**：09-26 是 Sat、09-28 是 Mon，
 *  "Sat" > "Mon" ⇒ 旧的反而被排到最上面（2026-09-28 实测到的就是这个现象）。
 *  同日多条靠 Array.sort 的稳定性保留文件里的先后（写作手册要求"新的写最上面"）。 */
const items = [...(d.items ?? [])].sort((a, b) => {
  const x = iso(a.date);
  const y = iso(b.date);
  return x < y ? 1 : x > y ? -1 : 0;
});
const fmt = (v: string | Date) => {
  const [y, m, day] = iso(v).split('-');
  return `${y} 年 ${Number(m)} 月 ${Number(day)} 日`;
};
/**
 * 每条说说的**稳定标识**（点赞与评论都挂在它上面）。
 *   · 默认 = 日期（去掉连字符）+ 同一天的第几条（a/b/c…）⇒ `talk-20260926`、`talk-20260926b`
 *   · **刻意不用正文做哈希**：改了文字不该丢掉已经攒下的赞和评论；
 *     用"日期 + 当日序号"则只有"在同一天中间插一条"才会挪位（罕见，且可显式写 id 固定）。
 *   · 想钉死某一条：在 talks.md 里给它加 `id: talk-xxx`（必须符合 ^[a-z0-9-]+$ 且以 talk- 开头）。
 */
const slugOf = (t: Talk): string => {
  if (t.id) return t.id;
  const day = iso(t.date).replace(/-/g, '');
  const sameDay = items.filter((x) => iso(x.date) === iso(t.date));
  const nth = sameDay.indexOf(t);
  return `talk-${day}${nth === 0 ? '' : String.fromCharCode(97 + nth)}`;
};
const rows = items.map((t) => {
  const slug = slugOf(t);
  return { t, slug, videos: validateTalkVideos(t.videos, `content/pages/talks.md 的 ${slug}`) };
});
// 说说配图：构建期收进来，才能走 Astro 的优化管线（WebP + srcset）
const talkAssets = import.meta.glob<{ default: ImageMetadata }>('/src/assets/talks/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const assetOf = (name: string) => talkAssets[`/src/assets/talks/${name}`]?.default;
// 大档按实际配图生成；链接提供无脚本后备，缩略图在列表中居中裁成正方形。
const fullImages = new Map(await Promise.all(rows.flatMap(({ t }) => t.images ?? []).map(async (img) => {
  const asset = assetOf(img.src);
  return [img.src, asset ? (await getImage({ src: asset, width: Math.min(asset.width, 1920), format: 'webp' })).src : ''] as const;
})));

/* 底纹母题（站主 2026-10-04 指定）：墨点螺旋图，**替代本页的百褶 ∞**。
   ⚠️ 目录必须放在 `talks/` 的子目录里 —— 上面那条 `*.{jpg,…}` 是**非递归** glob，
      真把文件放进 `talks/` 根下会被它当成"说说的配图"一起收进去（多一份产物）。
   素材处理（不裁、不染，只转 WebP）见 `_probe/_talk-plate.mjs`。 */
const PLATES = import.meta.glob<{ default: ImageMetadata }>('/src/assets/talks/plates/*.webp', { eager: true });
const plate = PLATES['/src/assets/talks/plates/drift-main.webp']?.default;
---

<Base title="说说" current="talks" chrome="page" bodyClass="talks-plate">
  {/* ===================================================================
   * 视口装饰层（plate 槽）—— 两层：**静态底纹** + **动态装置**
   *
   * ① `.float-plate`：站主 2026-10-04 指定「把这个放在原来百褶无限符号的地方」。
   *    挂法照抄百褶 ∞（`body.chrome-page .page-inf`）—— fixed 挂视口居中、`contain`、
   *    `z-index:-1`、不拦指针；全站纸白区只有**一套纹理语言**，
   *    本页换的是母题（∞ → 墨点螺旋），不是角色。
   *    ★ 三项刻意不照抄，都是素材差异（关于页那条教训：「唯一不能照抄的是素材本身」）：
   *      ① 比例：本图 1317/563，∞ 是 1572/878。
   *      ② 透明度：∞ 的 `.2` 配本图重约 4 倍 ⇒ 取站上**自己**的装饰底纹定稿档 8%。
   *      ③ 取宽：∞ 是**故意出血**的 `min(128vw,1600px)`，本图墨迹铺满画布
   *         ⇒ 出血会切掉最外圈月牙，站主目检定「小一点，不要出去了」⇒ 收回画内。
   *      三条的推导与实测都写在下面样式段的 `.float-plate` 注释里。
   *    ★ 素材**不裁不染**（`_probe/_talk-plate.mjs`）：四边的月牙本来就触到画布边缘，
   *      按任何阈值裁都会切掉最外圈的月牙尖 —— 而那正是整张图的读法。
   *
   * ② `.float-bg`：本页的装置（FLOAT）画布，逻辑在 `src/scripts/float.ts`。
   *    与底纹同层（都在 z-index:-1）、DOM 在后 ⇒ 雨画在墨点**之上**、正文之下。
   *
   * ★★ 两层都必须走 `plate` 具名槽，不能塞进普通 slot：
   *    `.shell` 在页面过渡里会被 `transform`，而被 transform 的祖先会成为
   *    `position:fixed` 的包含块 ⇒ 装饰层会从下往上跳（关于页实测 91px）。
   *    百褶 ∞ 那层一直没事，正因为它在 `.shell` 外面。
   * =================================================================== */}
  <Fragment slot="plate">
    {plate && (
      <div class="float-plate" aria-hidden="true">
        <Image
          class="float-img"
          src={plate}
          alt=""
          widths={[590, 1180]}
          sizes="86vw"
          loading="eager"
          decoding="sync"
        />
      </div>
    )}
    <canvas class="float-bg" data-float-bg aria-hidden="true"></canvas>
  </Fragment>
  <header class="pagehead">
    <PageTitle>说说</PageTitle>
    {d.intro && <p class="lede">{d.intro}</p>}
  </header>

  <ol class="talks">
    {rows.map(({ t, slug, videos }) => (
      <li class="talk">
        <time datetime={iso(t.date)}>{fmt(t.date)}</time>
        <div class="talk-content">
          <p class="body">
            <Fragment set:html={renderTalkText(t.text)} />
            {t.href && <> <a href={t.href}>链接</a></>}
          </p>
          {t.images && t.images.length > 0 && (
            <div class="shots" data-columns={t.images.length <= 2 ? t.images.length : t.images.length === 4 ? 2 : 3}>
              {t.images.map((img, i) =>
                assetOf(img.src) ? (
                  <a href={fullImages.get(img.src)} data-talk-image={`talk-image-${slug}-${i}`} data-no-transition aria-label={`放大查看：${img.alt}`}>
                    <Image
                      src={assetOf(img.src)!}
                      alt={img.alt}
                      widths={[480, 760]}
                      sizes={t.images.length === 1 ? '(max-width: 767px) 65vw, 288px' : t.images.length === 2 || t.images.length === 4 ? '(max-width: 767px) 44vw, 280px' : '(max-width: 767px) 28vw, 184px'}
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                ) : (
                  <p class="missing">找不到图片 {img.src}（应放在 src/assets/talks/ 下）</p>
                ),
              )}
            </div>
          )}

          {videos.length > 0 && (
            <div class="clips">
              {videos.map((video) => (
                <figure class="clip">
                  <video controls preload="none" playsinline src={video.src} aria-label={video.alt}>
                    <a href={video.src}>下载视频：{video.alt}</a>
                  </video>
                  <figcaption>{video.alt}</figcaption>
                </figure>
              ))}
            </div>
          )}

          {/* 点赞（不记名，只记个数）+ 评论（要写名字）。数据挂在 data-slug 上，见 src/scripts/talks.ts */}
          <div class="acts">
            <button type="button" class="act like" data-like={slug} aria-pressed="false">
              <svg class="heart" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
                <path d="M12 20.3 4.6 13a4.8 4.8 0 0 1 6.8-6.8l.6.6.6-.6A4.8 4.8 0 0 1 19.4 13Z" />
              </svg>
              <span data-like-count>·</span>
            </button>
            <button type="button" class="act" data-toggle={slug} aria-expanded="false" aria-controls={`c-${slug}`}>
              评论<span data-count-for={slug}></span>
            </button>
          </div>
          <section class="cbox" id={`c-${slug}`} data-comments-for={slug} hidden>
            <ol class="clist" data-list></ol>
            <p class="cempty" data-empty hidden>还没有评论，你可以是第一个。</p>
            <form class="cform" data-form novalidate>
              <label for={`n-${slug}`}>名字</label>
              <input id={`n-${slug}`} name="name" type="text" maxlength="40" autocomplete="nickname" required />
              <label for={`b-${slug}`}>评论</label>
              <textarea id={`b-${slug}`} name="body" rows="3" maxlength="1000" required></textarea>
              <div class="hp" aria-hidden="true">
                <label for={`w-${slug}`}>网站（请留空）</label>
                <input id={`w-${slug}`} name="website" type="text" tabindex="-1" autocomplete="off" />
              </div>
              <button type="submit" data-submit>发表</button>
            </form>
            <p class="cerror" role="alert" data-error hidden></p>
          </section>
        </div>
      </li>
    ))}
  </ol>
  {rows.length === 0 && <p class="empty">还没有说说。</p>}
  {rows.flatMap(({ t, slug }) => (t.images ?? []).map((img, i) => {
    const asset = assetOf(img.src);
    return asset && <TalkImageViewer id={`talk-image-${slug}-${i}`} src={fullImages.get(img.src)!} alt={img.alt} width={asset.width} height={asset.height} />;
  }))}
</Base>

<style>
  .lede {
    margin: var(--sp-4) 0 0;
    max-width: var(--measure);
    color: var(--muted);
  }
  /* 透明时间线：日期与正文分栏，留白让雨滴与墨点自然穿过。
     正文保持稳定，背景 FLOAT 继续独立绘制；只裁缩略图，不改原件与灯箱。 */
  .talks {
    --date-column: calc(var(--sp-7) * 3);
    --timeline-x: calc(var(--date-column) + var(--sp-5));
    position: relative;
    margin: var(--sp-8) 0 var(--sp-7);
    padding: 0;
    list-style: none;
    max-width: calc(var(--measure) + var(--date-column) + var(--sp-7));
    display: flex;
    flex-direction: column;
  }
  .talk {
    position: relative;
    display: grid;
    grid-template-columns: var(--date-column) minmax(0, 1fr);
    column-gap: var(--sp-7);
    padding: 0 0 var(--sp-8);
    background: transparent;
  }
  .talk:last-child { padding-bottom: 0; }
  .talk::before {
    content: '';
    position: absolute;
    left: calc(var(--timeline-x) - 2px);
    top: 0.75em;
    width: 5px;
    height: 5px;
    background: var(--accent);
  }
  .talk:not(:last-child)::after {
    content: '';
    position: absolute;
    left: var(--timeline-x);
    top: calc(0.75em + 5px);
    bottom: -0.75em;
    width: 1px;
    background: var(--hair);
  }
  time {
    display: block;
    padding-top: var(--sp-1);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .talk-content { min-width: 0; }
  .body {
    margin: 0;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .shots {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-3);
    margin-top: var(--sp-5);
  }
  .shots[data-columns='1'] {
    grid-template-columns: minmax(0, 1fr);
    width: min(100%, calc(var(--sp-8) * 4));
  }
  .shots[data-columns='2'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .shots a {
    display: block;
    min-width: 0;
    aspect-ratio: 1;
    overflow: hidden;
  }
  .shots a:focus-visible { outline: 2px solid var(--accent-ink); outline-offset: var(--sp-1); }
  .shots :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border: 1px solid var(--hair);
    background: var(--panel);
  }
  .clips {
    display: grid;
    gap: var(--sp-3);
    margin-top: var(--sp-3);
    min-width: 0;
  }
  .clip {
    margin: 0;
    min-width: 0;
  }
  .clip video {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--hair);
    background: var(--panel);
  }
  .clip figcaption {
    margin-top: var(--sp-2);
    color: var(--muted);
    font-size: var(--fs-sm);
    overflow-wrap: anywhere;
  }
  .missing {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--muted);
    border: 1px dashed var(--hair);
    padding: var(--sp-2) var(--sp-3);
  }
  .empty {
    margin: var(--sp-8) 0 0;
    color: var(--muted);
  }
  /* ---- 点赞 / 评论 ---- */
  .acts {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-3);
  }
  .act {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.25em 0.7em;
    font: inherit;
    font-size: var(--fs-xs);
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--hair);
    font-variant-numeric: tabular-nums;
  }
  .act:hover {
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  /* 已赞：填色 + 高亮（按下态靠 aria-pressed，屏幕阅读器也读得到） */
  .like[aria-pressed='true'] {
    color: var(--accent-ink);
    border-color: var(--accent);
    background: var(--accent-wash);
  }
  .like[aria-pressed='true'] .heart path {
    fill: currentColor;
  }
  .heart path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .cbox {
    margin-top: var(--sp-3);
    padding: var(--sp-3) 0 0;
    border-top: 1px dashed var(--hair);
  }
  .clist {
    list-style: none;
    margin: 0 0 var(--sp-3);
    padding: 0;
  }
  /* ★ li 是 talks.ts 运行时 createElement 注入的，拿不到编译期加的 data-astro-cid，
     scoped 产物会写成 `.clist[cid] li[cid]` ⇒ 整条规则静默失效（列表裸奔：无分隔线、无留白）。
     后代选择器里那一段一旦是动态元素，就必须 :global()，让它产出 `.clist[cid] li`。 */
  .clist :global(li) {
    padding: 0.5em 0;
    border-bottom: 1px solid var(--hair);
  }
  /* ★ 同样理由：这两个类是 talks.ts 动态加的，必须 :global()，
     否则产物是 `.cmeta[cid]` 匹配不上，条目元信息掉回浏览器默认样式。 */
  :global(.cmeta) {
    font-size: var(--fs-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  :global(.cbody) {
    margin: 0.2em 0 0;
    color: var(--ink);
    font-size: var(--fs-sm);
    white-space: pre-wrap;
    word-break: break-word;
  }
  .cempty,
  .cerror {
    margin: 0 0 var(--sp-3);
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .cerror {
    color: #a33;
  }
  .cform {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.4em var(--sp-3);
  }
  .cform label {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .cform input,
  .cform textarea {
    font: inherit;
    font-size: var(--fs-sm);
    color: var(--ink);
    background: var(--panel);
    border: 1px solid var(--hair);
    padding: 0.35em 0.5em;
  }
  .cform textarea,
  .cform .hp,
  .cform button {
    grid-column: 1 / -1;
  }
  .cform button {
    justify-self: start;
    margin-top: 0.3em;
    padding: 0.35em 0.9em;
    font: inherit;
    font-size: var(--fs-xs);
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--hair);
  }
  .cform button:hover {
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  /* 蜜罐：真人看不见，也不会进 Tab 序 */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  @media (max-width: 767px) {
    .talks {
      --timeline-x: 0px;
      margin-top: var(--sp-7);
    }
    .talk {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--sp-3);
      padding-left: var(--sp-5);
      padding-bottom: var(--sp-7);
    }
    time { padding-top: 0; }
    .talk::before { top: 0.5em; }
    .talk:not(:last-child)::after { top: calc(0.5em + 5px); bottom: -0.5em; }
    .shots { gap: var(--sp-2); }
    .shots[data-columns='1'] { width: min(100%, 65vw, calc(var(--sp-8) * 4)); }
  }

  /* ===================================================================
   * 底纹层（PAGE PLATE）—— 墨点螺旋**替代**百褶 ∞（站主 2026-10-04）
   *
   * 挂法照抄 Topbar 的 `body.chrome-page .page-inf`（百褶 ∞ 那一层）：
   *   fixed 挂视口居中 / `min(128vw,1600px)` / `contain` / `z-index:-1` / 不拦指针
   *   —— 全站纸白区只有一套纹理语言，本页换**母题**不换**角色**。
   * ★ 两项**刻意不照抄**，都是素材差异逼出来的（关于页同一课：「唯一不能照抄的是素材本身」）：
   *   ① 比例：∞ 是 1572/878，本图 1317/563
   *   ② 透明度：∞ 的 .2 配本图重约 4 倍 ⇒ 取站上自己的装饰底纹 8% 档（见下）
   * ★ `--plate-w` / `--plate-op` 两个变量留给"再调分量"用（可以只在 HTML 上内联覆盖，
   *   不必改样式表）；默认值就是校准后的定稿。四档对照样机见 `_probe/_float-verify.mjs`。
   * =================================================================== */
  .float-plate {
    position: fixed;
    left: 50%;
    top: 50%;
    /* ★★ 取宽**不照抄**百褶 ∞ —— 站主 2026-10-04 目检后定了「小一点，不要出去了」。
       ∞ 用的是 `min(128vw,1600px)`，那是**故意出血**（∞ 的两头被视口切掉是它的读法，
       它的墨迹只占取景框 45.8%，切掉的本来就是空白）。本图墨迹**铺满整个画布**，
       出血 = 最外圈那排月牙被切掉半截，读起来像"图被裁坏了" ⇒ 必须收到画内。
       ⇒ `min(86vw, 1180px, 200vh)`：三个上限各管一件事
          · 86vw —— 任何视口宽下都留 ≥7% 余量（1440 实测取 1180，左右各 130px）
          · 1180px —— 超宽屏不让它无限长（同时仍是版心 544px 的两倍多，"大尺度氛围"没丢）
          · 200vh —— 兜住"又宽又扁"的窗（横屏平板）：图高 ≤ 85.5vh，上下永远留得下。 */
    width: var(--plate-w, min(86vw, 1180px, 200vh));
    aspect-ratio: 1317 / 563;
    transform: translate(-50%, -50%);
    /* ★★ 透明度**不是**照抄 ∞ 的 .2 —— 这是本页唯一一处必须偏离 ∞ 定稿值的地方，
       理由是**等视觉分量**：.2 这个数字只对 ∞ 那张素材有意义（近白的米色呢喃，
       实测整块底纹"纸白上一道极淡的暖痕"），换成本图（不透明区 rgb(30,30,29)、
       覆盖 12.2%）后同样 .2 的分量重了约 4 倍，会把"纸白阅读底一字不改"压过去。
       ⇒ 取 **.08**：站上**自己**的装饰底纹定稿档就是 8%
         （`--deco-plate-coarse` = `#2d7d4614` = 20/255 ≈ 7.8%，文章页方格那轮站主亲选）。
         同一把尺子量两张图，比"照抄一个只对旧素材成立的数字"更忠实于原意。 */
    opacity: var(--plate-op, 0.08);
    pointer-events: none;
    z-index: -1;
  }
  /* ★ `max-width: none` 仍是必需的：base.css 给 `img` 定了 `max-width:100%`，
     而这一层刻意比版心宽（`min(86vw,1180px,200vh)` 仍 ≥ 1180px，版心只有 544px）
     —— 不解除限制它就缩到父盒宽度，底纹会跟着版心走。 */
  .float-plate img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
  }
  /* 暗底上的月相使用哑光铜橙，仍能分辨圆缺与半透明边缘。 */
  :global(html.dark) .float-plate {
    filter: var(--ink-plate-dark-filter);
    opacity: var(--plate-op, var(--talks-plate-dark-opacity));
  }

  /* 装置画布：与底纹同层（同 z-index:-1），DOM 在后 ⇒ 雨画在墨点**之上**、正文之下。
     `inset:0` 满屏 ⇒ 一次对尺寸，滚动时不需要任何重算（fixed 不随文档走）。 */
  .float-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
  }

  /* ★★ 必须关掉本页的百褶 ∞（`.page-inf`，Topbar 渲染、全站内页共用）。
     不关的话两套母题会叠在一起 —— Topbar 注释里已记过这个教训
     （「切片档案」四层换 ∞ 底纹时就是因为叠着才整体删掉）。
     ⚠ 用 `:global(...)`：`.page-inf` 是 Topbar 的元素、带的是**别的**作用域属性；
       且那边写的是 `body.chrome-page .page-inf`（0,2,1）⇒ 权重必须对齐才压得住。
     关法用 `display:none` 而不是 `opacity:0`：后者仍占一层满屏合成层，很贵。 */
  :global(body.talks-plate .page-inf) {
    display: none;
  }
</style>

