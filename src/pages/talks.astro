---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';

/** 说说页（2026-09-26 站主按参考站要求新增）：短的、没成为文章的东西。
 *  体例取自参考站「说说」：时间线，每条 = 时间 + 正文（那边还带序号，本站不加序号 ——
 *  时间已经很清楚地表达顺序，序号会跟站上别处的"编号"语义打架）。
 *  内容在 content/pages/talks.md。
 *
 *  图片（站主 2026-09-26："可以加图片"）：图片文件放 src/assets/talks/，说说里写文件名。
 *  为什么图片不在 content/ 下 —— 站上所有图片都要参与**构建期优化**（转 WebP + 出 srcset），
 *  只有 src/ 里的资源能被 Astro 处理；这是内容层唯一的例外，写作手册里写明了。 */
interface TalkImage {
  src: string;
  alt: string;
}
interface Talk {
  date: string | Date;
  text: string;
  href?: string;
  images?: TalkImage[];
}
interface TalksData {
  intro?: string;
  items?: Talk[];
}
const entry = await getEntry('pages', 'talks');
const d = (entry?.data ?? {}) as unknown as TalksData;
const items = [...(d.items ?? [])].sort((a, b) => (String(a.date) < String(b.date) ? 1 : -1));
/** YAML 会把未加引号的 `date: 2026-09-26` 隐式解析成 Date 对象 —— 归一成 YYYY-MM-DD。
 *  站上同一条约定见 src/lib/schema.ts 的 dateField（这里没走 schema，因为 pages 集合不校验）。 */
const iso = (v: string | Date) => (v instanceof Date ? v.toISOString().slice(0, 10) : String(v));
const fmt = (v: string | Date) => {
  const [y, m, day] = iso(v).split('-');
  return `${y} 年 ${Number(m)} 月 ${Number(day)} 日`;
};
// 说说配图：构建期收进来，才能走 Astro 的优化管线（WebP + srcset）
const talkAssets = import.meta.glob<{ default: ImageMetadata }>('/src/assets/talks/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const assetOf = (name: string) => talkAssets[`/src/assets/talks/${name}`]?.default;
---

<Base title="说说" current="talks" chrome="page">
  <header class="pagehead">
    <PageTitle>说说</PageTitle>
    {d.intro && <p class="lede">{d.intro}</p>}
  </header>

  <ol class="talks">
    {items.map((t) => (
      <li class="talk">
        <time datetime={iso(t.date)}>{fmt(t.date)}</time>
        <p class="body">
          {t.text}
          {t.href && <> <a href={t.href}>链接</a></>}
        </p>
        {t.images && t.images.length > 0 && (
          <div class="shots">
            {t.images.map((img) =>
              assetOf(img.src) ? (
                <Image
                  src={assetOf(img.src)!}
                  alt={img.alt}
                  widths={[480, 760]}
                  sizes="(max-width: 767px) 90vw, 640px"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <p class="missing">找不到图片 {img.src}（应放在 src/assets/talks/ 下）</p>
              ),
            )}
          </div>
        )}
      </li>
    ))}
  </ol>
  {items.length === 0 && <p class="empty">还没有说说。</p>}
</Base>

<style>
  .lede {
    margin: var(--sp-4) 0 0;
    max-width: var(--measure);
    color: var(--muted);
  }
  .talks {
    margin: var(--sp-8) 0 0;
    padding: 0;
    list-style: none;
    max-width: var(--measure);
  }
  .talk {
    position: relative;
    padding: 0 0 var(--sp-6) var(--sp-5);
    border-left: 1px solid var(--hair);
  }
  /* 时间轴上的点：与相册/扫描带同一套"仪器感" */
  .talk::before {
    content: '';
    position: absolute;
    left: -3px;
    top: 0.45em;
    width: 5px;
    height: 5px;
    background: var(--accent);
  }
  .talk:last-child {
    padding-bottom: 0;
    border-left-color: transparent;
  }
  time {
    display: block;
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .body {
    margin: 0.35em 0 0;
    color: var(--ink);
  }
  /* 配图：最多两列并排（手机一列），圆角不用（站上是直角语言），细边框 */
  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--sp-3);
    margin-top: var(--sp-3);
  }
  .shots :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--hair);
    background: var(--panel);
  }
  .missing {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--muted);
    border: 1px dashed var(--hair);
    padding: var(--sp-2) var(--sp-3);
  }
  .empty {
    margin: var(--sp-8) 0 0;
    color: var(--muted);
  }
  @media (max-width: 767px) {
    .talk {
      padding-left: var(--sp-4);
    }
  }
</style>
