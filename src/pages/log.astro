---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import { sortLogItems, isoDate } from '../lib/log-order';
import plate from '../assets/log/plates/main.webp';

/** 日志页（2026-09-26 站主："你顺便把日志自己写了"）。
 *  体例取自参考站：日期 + 版本号 + 该版本改了什么（一条一行）。
 *  内容在 content/pages/log.md，按真实开发史写；新的插在最上面。
 *  排序（站主 2026-09-27："不光按日期，同一天版本号也排好"）见 src/lib/log-order.ts ——
 *  那里是独立模块，因为版本号必须**数值**比较（v1.10 vs v1.9），字符串比较会蒙对一两次然后出错。 */
const entry = await getEntry('pages', 'log');
const d = (entry?.data ?? {}) as unknown as { intro?: string; items?: Parameters<typeof sortLogItems>[0] };
const items = sortLogItems(d.items ?? []);
const iso = isoDate;

/** 跳转锚点：**同一天只在第一条上挂 id**。
 *  09-30 那天有 9 条，逐条挂就会产出 9 个同名 id（非法 HTML，`getElementById` 只认第一个）。 */
const seenDay = new Set<string>();
const rows = items.map((it) => {
  const day = iso(it.date);
  const anchor = seenDay.has(day) ? undefined : `day-${day}`;
  seenDay.add(day);
  return { date: it.date, version: it.version, changes: it.changes, day, anchor };
});

/* ============================================================================
 * 走时仪 CHRONO STRIP（站主 2026-10-04：「走时仪 —— 时间刻线随更新频率变化」）
 *
 * 「走时仪」不是新发明的名字 —— 它**本来就在最初的十台装置命名表里**
 * （`src/scripts/rl-core.ts` 头部：归档卷尺 / 关于亲笔 / 阅读尺 / 浮游 / 走时仪 /
 *   准星 / 墨滴 / 星座 / 裂痕），和上一轮的 FLOAT 是同一种状态：有名字、没规格、没实现。
 * 本轮兑现它，也把那一行的名单划掉。
 *
 * ── 它和站上另外两把「尺」是**镜像**，不是第三把（这是它的身份证明）──────
 *    索引卷尺（归档）· 阅读尺（文章）都是**跟随器**：齿长恒定，动的是「当前位置」。
 *    走时仪是**读出器**：**齿长随数据变**，而它自己一动不动 —— 没有「当前进度」这个概念。
 *    ⇒ 契约里那条硬断言（齿高取值数 ≥ 8 且 max/min ≥ 4）就是它的身份证：
 *      哪天有人把它「优化」成等长齿，它立刻退化成卷尺，断言当场红。
 *
 * ── 三条通道，各自独立（数据实测，不是设计出来的）──────────────────
 *    齿数 = 当日版本数（1→9，09-30 那天 9 根并排挤在一起）
 *    齿高 = 该版改动项数（1→12）
 *    齿位 = 真实日期（13 格，其中 09-29 那格是空的 ⇒ 画一根虚线短柱）
 *    ⚠ 括号里的数是**内容快照**，不是这台装置的常量 —— 尺子从 `items` 推。
 *      （2026-10-07 站主要求日志改「一天一条」之后更新过一次：26 版 9 格 → 28 版 13 格。）
 *
 * ── ★ 被数据否掉的那条路（已排除，不留开关）───────────────────────
 *    「刻线间距 = 版本之间的真实间隔」听起来最自然，但本站数据撑不住：
 *    28 条里 **71% 的版本是同一天发的** ⇒ 间隔 0 ⇒ 那些刻线会叠成一个点，
 *    而不是「密」；非零间隔只有 0/1/2 三档 ⇒ 密度只有三档，拉不开。
 *    （与阅读尺那轮同一条纪律：对照过的映射连同开关一起删，留着两套只会各自腐化。）
 *
 * ── 零 JS ────────────────────────────────────────────────────────
 *    整台是**构建期算好的一支 SVG** + 几十行 CSS。没有 rAF、没有脚本、没有 canvas。
 *    ⇒ 降级链是**空集**：reduced-motion 只需把 hover 过渡压到 0ms（信息量不变）、
 *      无 JS 时每个日格仍是 `<a href="#day-…">`（退化成一张可点的日期目录）。
 *      这是全站第一台「没有可降级之物」的装置 —— 它不是"实现得更稳"，是**没有可坏的部件**。
 * ========================================================================== */
const CHRONO = (() => {
  if (!items.length) return null;

  const DAY_MS = 86_400_000;
  /* 几何全部给**自然像素**，viewBox 与之一致 ⇒ 视口缩放时整台等比缩，
     不会出现「只有齿变粗、间距没跟着变」的错位。 */
  const CELL = 46;      // 日格宽（n=9 时齿组 33.8px，仍留 12px 余量）
  const PITCH = 4;      // 同日相邻两齿的中心距
  const TOOTH_W = 1.8;  // 齿宽（= CSS 里的 stroke-width，两处必须同值）
  const MIN_H = 14;     // 最矮的齿（1 项）
  const MAX_H = 104;    // 最高的齿（= 全集里最高的项数）
  const READOUT = 22;   // 齿顶以上的读数带（hover 时才显字）
  const LABEL = 20;     // 基线以下的日期带
  const BASE_Y = READOUT + MAX_H;

  const asc = [...rows].reverse(); // 时间正序：左 = 最早（文档里是倒序）
  const t0 = Date.parse(`${asc[0].day}T00:00:00Z`);
  const t1 = Date.parse(`${asc[asc.length - 1].day}T00:00:00Z`);

  const days: { date: string; label: string; count: number; total: number; teeth: number[]; anchor: string }[] = [];
  for (let t = t0; t <= t1; t += DAY_MS) {
    const date = new Date(t).toISOString().slice(0, 10);
    const inDay = asc.filter((r) => r.day === date);
    days.push({
      date,
      label: String(Number(date.slice(8, 10))),
      count: inDay.length,
      total: inDay.reduce((a, b) => a + (b.changes?.length ?? 0), 0),
      teeth: inDay.map((r) => r.changes?.length ?? 0),
      anchor: `day-${date}`,
    });
  }

  /* 齿高上限**从数据推**，不写死 12 —— 照抄卷尺那条口径
     「刻度从内容推导」：明年某项数破纪录时，尺自己长高，不用改代码。 */
  const maxChanges = Math.max(1, ...days.flatMap((x) => x.teeth));
  const hOf = (n: number) => MIN_H + (MAX_H - MIN_H) * (n / maxChanges);

  return {
    days, CELL, PITCH, TOOTH_W, MIN_H, BASE_Y, READOUT, LABEL, maxChanges, hOf,
    W: days.length * CELL,
    H: BASE_Y + LABEL,
    from: asc[0].day,
    to: asc[asc.length - 1].day,
    versions: items.length,
    // 契约用的可见量（探针与测试读它，避免"看着像"）
    distinctHeights: new Set(days.flatMap((x) => x.teeth.map(hOf))).size,
    tallest: Math.max(...days.flatMap((x) => x.teeth.map(hOf)), 0),
    shortest: Math.min(...days.flatMap((x) => x.teeth.map(hOf)), Number.POSITIVE_INFINITY),
    emptyDays: days.filter((x) => x.count === 0).length,
  };
})();
---

<Base title="日志" current="log" chrome="page" bodyClass="log-plate">
  {/* ==========================================================================
   * 视口层（plate 槽）—— 两层：**静态底纹** + **读数装置**
   *
   * ① `.log-inf`：站主 2026-10-04 给的蓝色 ∞ 带，转**墨绿**后替代本页的百褶 ∞。
   *    挂法照抄百褶 ∞（`body.chrome-page .page-inf`）：fixed 挂视口居中 / `contain` /
   *    `z-index:-1` / 不拦指针 —— 全站纸白区只有**一套纹理语言**，本页换的是母题
   *    （米色百褶 → 墨绿 ∞），不是角色。
   * ② `.chrono`：走时仪。它是**读数器兼日期目录**，所以 fixed 常驻、不随文档走。
   * 两者都必须在 `.shell` **之外**：页面过渡会给 `.shell` 加 transform，
   * 被 transform 的祖先会成为 `position:fixed` 的包含块 ⇒ 装饰层会从下往上跳
   * （关于页实测 91px）。plate 槽就是为此存在的，见 Base.astro 的注记。
   * ======================================================================== */}
  <Fragment slot="plate">
    <div class="log-inf" aria-hidden="true">
      <Image
        src={plate}
        alt=""
        widths={[610, 1222]}
        sizes="62vw"
        loading="eager"
        decoding="sync"
      />
    </div>

    {CHRONO && (
      <nav class="chrono" aria-label="日志时间刻线尺">
        <p class="chrono-legend">
          <span>刻线高度 = 该版改动项数</span>
          <span>刻线根数 = 当日版本数</span>
        </p>
        {/* 「生长」的缩放轴钉在基线上 ⇒ 把 CHRONO.BASE_Y 传给 CSS。
            不在这里写死、也不在 CSS 里写死：MAX_H 哪天从数据推出来变高，
            两边只要有一处忘了跟就会错位 —— 现在只有一处事实来源。 */}
        <svg
          class="chrono-svg"
          style={`--chrono-base:${CHRONO.BASE_Y}px`}
          viewBox={`0 0 ${CHRONO.W} ${CHRONO.H}`}
          role="img"
          aria-label={`日志时间刻线尺：${CHRONO.from} 至 ${CHRONO.to}，共 ${CHRONO.versions} 个版本`}
        >
          <line class="chrono-base" x1="0" y1={CHRONO.BASE_Y} x2={CHRONO.W} y2={CHRONO.BASE_Y} />
          {CHRONO.days.map((day, di) => {
            const left = di * CHRONO.CELL;
            const cx = left + CHRONO.CELL / 2;
            const n = day.teeth.length;
            const groupW = n ? (n - 1) * CHRONO.PITCH + CHRONO.TOOTH_W : 0;
            const x0 = cx - groupW / 2 + CHRONO.TOOTH_W / 2;
            return (
              /* ★ 空格（09-29）**不挂 href**：那天没有任何条目 ⇒ 跳过去是一个死锚。
                 不写 href 的 `<a>` 在 HTML 里不是链接（不可点、不进 Tab 序），
                 刚好是这里要的语义 —— 它仍然可以被 hover 读出「0 版 · 0 项」。 */
              <a class="chrono-day" href={day.count ? `#${day.anchor}` : undefined}>
                <title>{`${day.date} · ${day.count} 版 · ${day.total} 项`}</title>
                <rect class="chrono-hit" x={left} y="0" width={CHRONO.CELL} height={CHRONO.BASE_Y} />
                {n === 0 ? (
                  /* 空格留一根**虚线短柱** ——
                     "有这一格、但那天没动手"本身是信息，不能让它直接消失。 */
                  <line
                    class="chrono-empty"
                    x1={cx}
                    y1={CHRONO.BASE_Y}
                    x2={cx}
                    y2={CHRONO.BASE_Y - CHRONO.MIN_H}
                  />
                ) : (
                  /* ⑤「生长」（GROW）的入场相位：**按日格错开**，不是逐齿均分。
                     ⇒ 同一格的几根齿是一簇、格与格之间推进 ⇒ 读起来是「一天一天地长出来」，
                       而不是「一根一根地长」（后者会把"一天 = 一格"的结构打散）。
                     方向也刚好对：di 是时间正序（左 = 最早）⇒ 从最早那天往右长。
                     ★ 两个系数的**相对大小是硬约束**：格内错开必须 < 格间距，
                       否则相邻格会交错（09-30 那格有 9 根齿，跨度 8×ti），
                       一眼看过去就不是"从左往右"而是"逐格来回跳"。
                       这里是 8ms × 8 = 64ms < 90ms ⇒ 严格单增。断言守着这一条。 */
                  day.teeth.map((c, ti) => (
                    <line
                      class="chrono-tooth"
                      style={`--tooth-delay:${di * 90 + ti * 8}ms`}
                      x1={x0 + ti * CHRONO.PITCH}
                      y1={CHRONO.BASE_Y}
                      x2={x0 + ti * CHRONO.PITCH}
                      y2={CHRONO.BASE_Y - CHRONO.hOf(c)}
                    />
                  ))
                )}
                <text class="chrono-readout" x={cx} y={CHRONO.READOUT - 10}>
                  {`${day.count} 版 · ${day.total} 项`}
                </text>
                <text class="chrono-lbl" x={cx} y={CHRONO.BASE_Y + 14}>
                  {day.label}
                </text>
              </a>
            );
          })}
        </svg>
        <p class="chrono-range">
          <span>{CHRONO.from}</span>
          <span>{CHRONO.to}</span>
        </p>
      </nav>
    )}
  </Fragment>

  <header class="pagehead">
    <PageTitle>日志</PageTitle>
    {d.intro && <p class="lede">{d.intro}</p>}
  </header>

  <ol class="log">
    {rows.map((it) => (
      <li class="entry" id={it.anchor}>
        <p class="head">
          <time datetime={iso(it.date)}>{iso(it.date)}</time>
          {it.version && <span class="ver">{it.version}</span>}
        </p>
        {it.changes && (
          <ul class="changes">
            {it.changes.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ol>
  {items.length === 0 && <p class="empty">还没有日志。</p>}
</Base>

<style>
  .lede {
    margin: var(--sp-4) 0 0;
    max-width: var(--measure);
    color: var(--muted);
  }
  .log {
    margin: var(--sp-8) 0 0;
    padding: 0;
    list-style: none;
    max-width: var(--measure);
  }
  .entry {
    padding: var(--sp-4) 0;
    border-top: 1px solid var(--hair);
    /* 从走时仪跳过来时，条目不要贴死在视口顶边（顶栏是普通流、会滚走，
       所以这里给的只是"呼吸"，不是"避让"）。 */
    scroll-margin-top: var(--sp-5);
  }
  .entry:last-child {
    border-bottom: 1px solid var(--hair);
  }
  /* 锚点命中时的落点提示：一条短暂的左边线，告诉眼睛"跳到的是这一条" */
  .entry:target {
    box-shadow: inset 2px 0 0 var(--accent);
    animation: log-hit 900ms var(--ease-interact) both;
  }
  @keyframes log-hit {
    from {
      background: var(--accent-wash);
    }
    to {
      background: transparent;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .entry:target {
      animation: none;
    }
  }
  .head {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    margin: 0;
  }
  time {
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  /* 版本号用站上的"切片标签"气质：绿框 + 等宽数字 */
  .ver {
    font-size: var(--fs-xs);
    color: var(--accent-ink);
    border: 1px solid var(--accent);
    padding: 0.05em 0.45em;
    font-variant-numeric: tabular-nums;
  }
  .changes {
    margin: var(--sp-3) 0 0;
    padding-left: 1.1em;
    color: var(--ink);
  }
  .changes li {
    margin-bottom: 0.35em;
  }
  .changes li::marker {
    color: var(--accent);
  }
  .empty {
    margin: var(--sp-8) 0 0;
    color: var(--muted);
  }

  /* ===================================================================
   * 底纹层（PAGE PLATE）—— 墨绿 ∞ **替代**百褶 ∞（站主 2026-10-04）
   *
   * 站主原话：「把这个无限符号替代日志背景的百褶无限符号，
   *   注意把颜色改为墨绿色」。
   *
   * ★ 素材侧：`_probe/_log-plate.mjs` 做的只有一件事 —— **亮度→墨绿色阶**。
   *   没有用 HSL 色相旋转，原因是旋转对**纯黑**像素无效（黑在 HSL 里 S=0，
   *   转完还是黑），而这张图 38% 的不透明像素落在亮度 0–25 档 ⇒ 会留下一大片
   *   "没转到的黑"。按亮度查色阶则保证每个像素都落在墨绿族里、明暗结构原样保留。
   *   色阶锚点取自站上 token：`--accent` #2d7d46 / `--accent-bright` #4caf50。
   *   ★ 站主这条指令与关于页那句「你不要变他们的颜色」**不矛盾**：
   *     那条是对**引用素材**（别人的作品）说的，这条是站主对自己给的母题下的指令。
   * =================================================================== */
  /* ★★ 必须先关掉本页的百褶 ∞（`.page-inf`，Topbar 渲染、全站内页共用）。
     不关就是两套母题叠在一起。⚠ 用 `:global(...)`：`.page-inf` 是 Topbar 的元素、
     带的是**别的**作用域属性；那边写的是 `body.chrome-page .page-inf`（0,2,1）
     ⇒ 权重必须对齐才压得住。关法用 `display:none` 而不是 `opacity:0`：
     后者仍占一层满屏合成层，很贵。 */
  :global(body.log-plate .page-inf) {
    display: none;
  }

  .log-inf {
    position: fixed;
    left: 50%;
    top: 50%;
    /* ★★ 取宽**不照抄**百褶 ∞ 的 `min(128vw, 1600px)` —— 那条在两张素材上不是一件事。
       ① ∞ 的墨迹只占它取景框的 **45.8%**（两边本来就空），出血是它的读法、切掉的只是空白；
          本图墨迹横跨 x **11.1%–93.0%**（几乎顶满画布）⇒ 同一句 128vw 会**切掉内容**：
          实测 1366 视口下右缘出头 4px、1280 下出头 47px。
       ② 就算不切，"等取景框宽"也不等于"等分量"：本图墨迹是 ∞ 的 3.6 倍重（实测差分）。
       ⇒ 按**墨迹同宽**反推：∞ 的墨迹在 1440 视口下是 733px，除以本图墨迹占比 0.819
         ⇒ 层宽 895px ⇒ `min(62vw, 895px, 170vh)`。三个上限各管一件事：
           · 62vw   —— 1440 实测取 879，墨迹与百褶 ∞ **同宽**
           · 895px  —— 超宽屏不让它无限长
           · 170vh  —— 兜住"又宽又扁"的窗（图高 = 宽 × 0.5254；没有它，1200×400 会从上下出头）
       ★ 判据（`_probe/_log-verify.mjs` + `_probe/_log-mass.mjs`，**差分口径**：
         同一页渲染两遍、一遍 display:none，逐像素相减 —— 只有差值才是底纹自己贡献的墨）：
           百褶 ∞（/links/ 参照）  mean 0.76  峰值 20.7  覆盖 8.86%
           本档                    mean 1.15  峰值 19.7  覆盖 7.08%   ← 峰值同档、覆盖几乎相同
           若照抄 96vw             mean 2.77  覆盖 16.98%          ← 总墨量 3.6 倍，明显偏重
       （说说页同一条教训：**出血档不能跨素材继承**；这里多补一句 ——
         **"照抄取景框"也不等于"照抄分量"，得按墨迹算。**） */
    width: var(--plate-w, min(62vw, 895px, 170vh));
    aspect-ratio: 1222 / 642;
    /* ★★ 居中用的变换**必须拎成变量** —— 呼吸的 keyframes 也要写 `transform`，
       而 @keyframes 里的 transform 会**整体覆盖**基础声明：直接写死的话，
       底纹会在动画第一帧就丢掉居中、跳到右下角去。
       拎出来之后「居中」只有一处事实来源，将来换居中方式 keyframes 会自动跟上。 */
    --log-inf-center: translate(-50%, -50%);
    transform: var(--log-inf-center);
    /* ①「呼吸」（BREATHE，站主 2026-10-04 拍板，同日**改过一次参数**）——
       声明式整幅相位：`alternate` 往返，只动 transform ⇒ 走合成器，
       不触发布局/重绘，主线程成本 0。
       ★ 与说说页 FLOAT 的**机制分野**（口径 #5「每页一台机制不同」）：
         FLOAT 是 canvas **每帧解析函数** + **事件式**（雨线、涟漪是个体事件，各有出生/消散）；
         本台是 CSS **声明式**动画 + **整幅相位** —— 无个体、无事件、无出生时刻，
         只有一层纸在极慢地换气。两者同在「只吃时间」这一格，但**介质与驱动不同**
         （合成器插值 vs JS 每帧求值）⇒ 不是同一台装置换了皮。
       ★★ 参数改过一次，原因是**原来那组根本看不见**（站主原话「呼吸我看不出来啊」）。
         实测依据（`_probe/_log-motion.mjs` + `_probe/_log-breathe.mjs` v2）：
           旧组 96 s / 平移极差 9.43 px / scale 极差 0.008
             ⇒ 关键帧预算 13.47 px，但**轮廓实际只增长 6 px**（软 alpha 边吃掉大半），
             单程均速 **0.14 px/s**。人眼对慢运动的分辨阈约 1 px/s ⇒ 差一个数量级，
             不是"弱"，是物理上看不见。
           现组 24 s / 平移极差 23.32 px / scale 极差 0.070
             ⇒ 预算上界 ≈58.7 px，实测轮廓增长 **+52 px**，单程均速 **2.45 px/s**。
         ⇒ **原先的「≤15 px」配额作废**（那条只防"太大"，没有任何东西防"消失"，
           于是它一路漂到 0.14 px/s 而断言全绿 —— 教训见 `tests/log-chrono.test.ts`：
           装饰性动效的契约必须**上下界都写**）。新配额见测试里的 70px 上界 + 40px 下界。
       ★ 24 s 是"一次慢深呼吸"（12 s 吸 / 12 s 呼）。曾同时评估 32 s（+65px，更奔放）
         与 16 s（+37px，最快但容易显躁），站主选 A。
       ★ 缩放刻意**不对称**（0.965 ↔ 1.035，中心偏上）—— 缩小时 ∞ 离版心更远、
         胀大时才靠近，与"吸气/呼气"同向，不是机械地来回。
       ★ 用 px 不用比例单位：判据是**绝对像素**，而层宽随视口变（层宽三档），
         百分比会让「同一个设定」在不同窗口下位移不同。 */
    animation: log-inf-breathe 24s ease-in-out infinite alternate;
    /* ★ 透明度**不是**照抄 ∞ 的 .2 —— 理由与说说页同一条：**等视觉分量**。
       .2 那个数字只对 ∞ 那张素材成立（近白的米色呢喃，覆盖画布 1.1%）；
       本图是实心墨绿（覆盖 24.2%，且明暗跨满 0–255）⇒ 同样 .2 会重得多。
       ⇒ 取站上**自己**的装饰底纹定稿档 8%（文章页方格那轮站主亲选，
         `--deco-plate-coarse` = #2d7d4614 ≈ 7.8%）。实测最深墨点与 ∞ 同档，见探针。
       `--plate-op` / `--plate-w` 两个旋钮留在层上：想再淡/再小，改一行内联即可。 */
    opacity: var(--plate-op, 0.08);
    pointer-events: none;
    z-index: -1;
  }
  .log-inf img {
    display: block;
    width: 100%;
    height: 100%;
    /* base.css 给 `img` 定了 `max-width:100%`；这里不解除的话 contain 永远铺不满层 */
    max-width: none;
    object-fit: contain;
  }
  /* ①「呼吸」的关键帧。★ 每个 from/to 都要**带上居中** ——
     这是"拎成变量"的落点，也是唯一能让动画与居中同时成立的地方。
     ★ 只动 transform：不碰 opacity ⇒ 墨量判据（§6.30 那张差分表）不受影响，
       动画只改变墨迹的**位置**、不改变它的**多少**。 */
  @keyframes log-inf-breathe {
    from {
      transform: var(--log-inf-center) translate3d(-10px, -6px, 0) scale(0.965);
    }
    to {
      transform: var(--log-inf-center) translate3d(10px, 6px, 0) scale(1.035);
    }
  }

  /* ===================================================================
   * 走时仪（CHRONO STRIP）—— 读数器，不是跟随器
   *
   * 落位：`fixed` 常驻右侧（它是"读数器兼日期目录"，滚到哪儿都该看得见），
   *   贴的是**版心的右缘**而不是视口右缘 —— 宽屏下版心有 82rem 上限，
   *   贴视口边会飘到很远的地方、读不出"这是这一页的仪器"。
   *   `right` 取 max(gutter, 50% − wrap/2 + gutter)：窄于版心时退回 gutter。
   * 只在 ≥1024px 渲染 —— 该断点以下右半屏已经没有空位，硬塞会压正文。
   * =================================================================== */
  .chrono {
    position: fixed;
    top: 50%;
    right: max(var(--gutter), calc(50% - var(--wrap) / 2 + var(--gutter)));
    width: min(34vw, 520px);
    transform: translateY(-50%);
    z-index: 1;
    /* 整台不拦指针，只有日格接 —— 否则它会在右侧抢走一大片选择/滚动区域 */
    pointer-events: none;
    font-family: "IBM Plex Mono", Consolas, "Courier New", monospace;
  }
  .chrono-legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.9em;
    margin: 0 0 var(--sp-3);
    font-size: var(--fs-xs);
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  .chrono-svg {
    display: block;
    width: 100%;
    height: auto;
    /* 首/末格的 hover 读数会越出 viewBox 一点点（字比格宽）—— 放它出来画 */
    overflow: visible;
  }
  .chrono-base {
    stroke: var(--hair);
    stroke-width: 1;
  }
  .chrono-day {
    pointer-events: auto;
  }
  .chrono-hit {
    fill: transparent;
    pointer-events: all;
  }
  .chrono-tooth {
    stroke: var(--accent);
    stroke-width: 1.8;
    transition: stroke var(--dur-hover) var(--ease-interact);
    /* ⑤「生长」（GROW，站主 2026-10-04 拍板）—— 一次性入场编排。
       ★ 这是全站**唯一一台播一次**的动效：另外六台都是持续动态（常驻 / 永续 / 跟随），
         所以机制上不与任何一台重合。
       ★ `both` 让 delay 期间停在 from（= 还没长出来），到点后长到 to 并保持。
       ★ **它不违反「走时仪自己一动不动」**：那条约束管的是"受输入驱动的持续运动"
         （有累计进度那种）。这是一次性入场，播完永久静止，装置依然没有"当前位置"这个概念。
       ★ reduced-motion 下动画整体撤掉 ⇒ scaleY 落回默认 1 ⇒ **齿一根不少、直接给完整高度**
         —— 这正是"只撤动效、不撤信息"。 */
    animation: chrono-tooth-grow 480ms var(--ease-interact) both;
    /* ★★ `--tooth-lead`：**排在页面过渡之后**（站主 2026-10-04「把根齿依次长出放在过渡动画后」）。
       为什么要提前量（实测，`_probe/_log-motion.mjs`）：页面过渡 `--pt-sweep: 900ms`，
       而齿的相位 + 480 ms 时长**已经越过过渡**（当时 9 格：0→736 ms + 480 ms = 1.216 s）
       ⇒ 与过渡**重叠**：页面还在暗着扫，齿就开始冒头，两台动效挤在同一段里，读起来像"卡了一下"。
       提前量取 **1000 ms**（= 过渡 900 ms + 100 ms 余量），改这一个数就能整体挪。
       ⚠ 相位跨度**随日志内容变**（2026-10-07 日志改成一天一条后是 13 格：0→1080 ms + 480 ms = 1.56 s）
         ⇒ 这里只记"为什么要这一档提前量"，别把某一天的总时长当成常量引用。
       ⚠ **不做 `html.pt-play` 条件化**：那个类在 1000 ms 就被摘掉，而末齿还要晚得多
         才开始 —— 靠"改 animation-delay 不影响运行中动画"这条实现细节吃饭，太脆。
         代价是**直接打开 `/log/` 时齿会晚 1 秒出现**；站内导航过来时正是想要的效果。
       用 `calc()` 叠加而不是改内联 `--tooth-delay` 的算法 ⇒ 全体的齿的「依次」相位
       仍由数据算出，这里只做**整体平移**，两者职责不混。 */
    animation-delay: calc(var(--tooth-delay, 0ms) + var(--tooth-lead, 1000ms));
    /* ★ 缩放轴必须钉在**基线**上，否则齿会从自己的中点往两头长（上下一齐冒头）。
       这里不用 `transform-box: fill-box` —— 齿是 <line>，它的 object bbox **宽为 0**，
       把 origin 交给"零宽包围盒"的百分比行为不划算；改用 view-box 参照系 +
       绝对用户坐标，值由 CHRONO.BASE_Y 内联在 <svg> 上，这里不写死数字。 */
    transform-box: view-box;
    transform-origin: 0 var(--chrono-base, 126px);
  }
  @keyframes chrono-tooth-grow {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  .chrono-empty {
    stroke: var(--hair);
    stroke-width: 1.8;
    stroke-dasharray: 2 3;
  }
  .chrono-lbl {
    fill: var(--muted);
    font-size: 11px;
    text-anchor: middle;
    font-variant-numeric: tabular-nums;
  }
  .chrono-readout {
    fill: var(--accent-ink);
    font-size: 11px;
    text-anchor: middle;
    white-space: pre;
    opacity: 0;
    transition: opacity var(--dur-hover) var(--ease-interact);
  }
  /* 一格一读数（不逐齿读数：齿细到 1.8px，逐齿 hover 会抖） */
  .chrono-day:hover .chrono-tooth,
  .chrono-day:focus-visible .chrono-tooth {
    stroke: var(--accent-ink);
  }
  .chrono-day:hover .chrono-lbl,
  .chrono-day:focus-visible .chrono-lbl {
    fill: var(--ink);
  }
  .chrono-day:hover .chrono-readout,
  .chrono-day:focus-visible .chrono-readout {
    opacity: 1;
  }
  .chrono-range {
    display: flex;
    justify-content: space-between;
    margin: var(--sp-2) 0 0;
    font-size: var(--fs-xs);
    color: var(--muted);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }
  /* reduced-motion：**只撤动效、不撤信息**。hover 的反馈是可用性的一部分
