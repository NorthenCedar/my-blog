---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import { sortLogItems, isoDate } from '../lib/log-order';
import plate from '../assets/log/plates/main.webp';

/** 日志页（2026-09-26 站主："你顺便把日志自己写了"）。
 *  体例取自参考站：日期 + 版本号 + 该版本改了什么（一条一行）。
 *  内容在 content/pages/log.md，按真实开发史写；新的插在最上面。
 *  排序（站主 2026-09-27："不光按日期，同一天版本号也排好"）见 src/lib/log-order.ts ——
 *  那里是独立模块，因为版本号必须**数值**比较（v1.10 vs v1.9），字符串比较会蒙对一两次然后出错。 */
const entry = await getEntry('pages', 'log');
const d = (entry?.data ?? {}) as unknown as { intro?: string; items?: Parameters<typeof sortLogItems>[0] };
const items = sortLogItems(d.items ?? []);
const iso = isoDate;

/** 跳转锚点：**同一天只在第一条上挂 id**。
 *  09-30 那天有 9 条，逐条挂就会产出 9 个同名 id（非法 HTML，`getElementById` 只认第一个）。 */
const seenDay = new Set<string>();
const rows = items.map((it) => {
  const day = iso(it.date);
  const anchor = seenDay.has(day) ? undefined : `day-${day}`;
  seenDay.add(day);
  return { date: it.date, version: it.version, changes: it.changes, day, anchor };
});

/* ============================================================================
 * 走时仪 CHRONO STRIP（站主 2026-10-04：「走时仪 —— 时间刻线随更新频率变化」）
 *
 * 「走时仪」不是新发明的名字 —— 它**本来就在最初的十台装置命名表里**
 * （`src/scripts/rl-core.ts` 头部：归档卷尺 / 关于亲笔 / 阅读尺 / 浮游 / 走时仪 /
 *   准星 / 墨滴 / 星座 / 裂痕），和上一轮的 FLOAT 是同一种状态：有名字、没规格、没实现。
 * 本轮兑现它，也把那一行的名单划掉。
 *
 * ★ 上面那份是**最初的十台**（历史记录，不改写）。之后兑现/新增的都续在
 *   `src/scripts/rl-core.ts` 头部那份注记里 —— 截至 2026-10-07 已到
 *   **第十一台：螺旋盘 HELIX**（`src/pages/gallery/spiral.astro`）。
 *   ⇒ 数装置一律 grep 命名表 + `git log`，**别从文档正文推**（spec §6.39.1 那一课）。
 *
 * ── 它和站上另外两把「尺」是**镜像**，不是第三把（这是它的身份证明）──────
 *    索引卷尺（归档）· 阅读尺（文章）都是**跟随器**：齿长恒定，动的是「当前位置」。
 *    走时仪是**读出器**：**齿长随数据变**，而它自己一动不动 —— 没有「当前进度」这个概念。
 *    ⇒ 契约里那条硬断言（齿高取值数 ≥ 8 且 max/min ≥ 4）就是它的身份证：
 *      哪天有人把它「优化」成等长齿，它立刻退化成卷尺，断言当场红。
 *
 * ── 三条通道，各自独立（数据实测，不是设计出来的）──────────────────
 *    齿数 = 当日版本数（1→9，09-30 那天 9 根并排挤在一起）
 *    齿高 = 该版改动项数（1→17）
 *    齿位 = 真实日期（13 格，其中 09-29 那格是空的 ⇒ 画一根虚线短柱）
 *    ⚠ 括号里的数是**内容快照**，不是这台装置的常量 —— 尺子从 `items` 推。
 *      （2026-10-07 站主要求日志改「一天一条」之后更新过一次：26 版 9 格 → 28 版 13 格；
 *        同日补v2.0 那条相册重排之后：29 版 13 格、齿高上限 12 → 17、同日多版 71% → 61%。）
 *
 * ── ★ 被数据否掉的那条路（已排除，不留开关）───────────────────────
 *    「刻线间距 = 版本之间的真实间隔」听起来最自然，但本站数据撑不住：
 *    29 条里 **61% 的版本是同一天发的** ⇒ 间隔 0 ⇒ 那些刻线会叠成一个点，
 *    而不是「密」；非零间隔只有 0/1/2 三档 ⇒ 密度只有三档，拉不开。
 *    （与阅读尺那轮同一条纪律：对照过的映射连同开关一起删，留着两套只会各自腐化。）
 *
 * ── 零 JS ────────────────────────────────────────────────────────
 *    整台是**构建期算好的一支 SVG** + 几十行 CSS。没有 rAF、没有脚本、没有 canvas。
 *    ⇒ 降级链是**空集**：reduced-motion 只需把 hover 过渡压到 0ms（信息量不变）、
 *      无 JS 时每个日格仍是 `<a href="#day-…">`（退化成一张可点的日期目录）。
 *      这是全站第一台「没有可降级之物」的装置 —— 它不是"实现得更稳"，是**没有可坏的部件**。
 * ========================================================================== */
const CHRONO = (() => {
  if (!items.length) return null;

  const DAY_MS = 86_400_000;
  /* 几何全部给**自然像素**，viewBox 与之一致 ⇒ 视口缩放时整台等比缩，
     不会出现「只有齿变粗、间距没跟着变」的错位。 */
  const TOOTH_W = 1.8;  // 齿宽（= CSS 里的 stroke-width，两处必须同值）
  const PITCH = 4;      // 日格档：同日相邻两齿的中心距
  const SLOT_PITCH = 2.7;  // 月格档：格内相邻两**列**的中心距（1.8 齿 + 0.9 空气）
  const MIN_H = 14;     // 最矮的齿（1 项）
  const MAX_H = 104;    // 最高的齿（= 全集里最高的项数）
  const READOUT = 22;   // 齿顶以上的读数带（hover 时才显字）
  /* ★ 2026-10-15 从 20 抬到 38：标签带现在有**两行**（日号 + 月份），
     20 只够一行 ⇒ 第二行会被 viewBox 裁掉。
     ★ 这是"改了内容必须改容器"的同族 —— 而且第一版只抬到 34 也不够：
       两行基线相距 13（字号 11）时它们是**贴着的**（实测图里"9月"压在"25"上）。
       现在 14 / 29，相距 15 > 字号 ⇒ 两行之间有一整行的空气。 */
  const LABEL = 38;
  const BASE_Y = READOUT + MAX_H;

  /* ★ 档位（2026-10-15 站主：「让"一格一天"变成"一格一月"，分档走」）。
     为什么必须分档 —— 量过，不是推的（`.chrono` 是 `width:100%` + viewBox
     **等比缩到 min(34vw, 520px)** 里）：
         天数   日格总宽    缩放比    齿宽落到
          21     966px     53.8%     0.97px   ← 现在
          90    4140px     12.6%     0.23px
         365   16790px      3.1%     0.056px
     ⇒ 一格一天、格宽写死 ⇒ 结局不是"变挤"，是**整台缩小到看不见**。
     换成月格后总宽不再是问题（一年 12 格），真正的约束变成"一格里放几列"。
     阈值 45 天：**跨过它的那天装置自己换档**，不靠人记得改。 */
  const DAY_TIER_MAX = 45;

  const asc = [...rows].reverse(); // 时间正序：左 = 最早（文档里是倒序）
  const t0 = Date.parse(`${asc[0].day}T00:00:00Z`);
  const t1 = Date.parse(`${asc[asc.length - 1].day}T00:00:00Z`);

  /* 逐日桶（两档都要：月格里的列就是按它切的） */
  const dayBuckets: { date: string; label: string; count: number; total: number; teeth: number[]; anchor: string }[] = [];
  for (let t = t0; t <= t1; t += DAY_MS) {
    const date = new Date(t).toISOString().slice(0, 10);
    const inDay = asc.filter((r) => r.day === date);
    dayBuckets.push({
      date,
      label: String(Number(date.slice(8, 10))),
      count: inDay.length,
      total: inDay.reduce((a, b) => a + (b.changes?.length ?? 0), 0),
      teeth: inDay.map((r) => r.changes?.length ?? 0),
      anchor: `day-${date}`,
    });
  }
  const spanDays = dayBuckets.length;

  /* 齿高上限**从数据推**，不写死 —— 照抄卷尺那条口径「刻度从内容推导」：
     哪天某项数破纪录时，尺自己长高，不用改代码。 */
  const maxChanges = Math.max(1, ...dayBuckets.flatMap((x) => x.teeth));
  const hOf = (n: number) => MIN_H + (MAX_H - MIN_H) * (n / maxChanges);

  /* ── 档一：日格（一格一天，格内该天的几版**并排**）────────────────────
     ★ 这条路的输出与 2026-10-14 之前**逐字一致**，不是为了省事，是为了让
       守它的那 6 条断言在改档位的那天仍然有效（"改一处必须改另一处"的反面：
       换档不该顺手把旧档的契约一起废掉）。 */
  /* ── 档二：月格（一格一月，格内按**天**分列）──────────────────────────
     同一天的多版**共列**（叠成一根，取最高的一版）—— 这是几何逼出来的：
     格宽有限，一格里排 31 天已是极限，再按版排就顶破了。 */
  const tier = spanDays <= DAY_TIER_MAX ? 'day' : 'month';
  const daysInMonth = (y: number, m: number) => new Date(Date.UTC(y, m, 0)).getUTCDate();

  type Cell = {
    kind: 'day' | 'month';
    key: string;
    label: string;
    count: number;
    total: number;
    slots: { x: number; h: number; day: string; n: number }[];  // x = 格内相对偏移（px）
    anchor: string | null;
    title: string;
    monthMark: boolean;   // 这一格是该月的第一格 ⇒ 标签带要在这里写月份
  };

  let cells: Cell[] = [];
  let CELL = 46;

  if (tier === 'day') {
    CELL = 46;   // 日格档的格宽是**内容快照**：9 根齿时齿组 32px、格内余量 14px
    let lastMonth = '';
    cells = dayBuckets.map((d) => {
      const monthMark = d.date.slice(0, 7) !== lastMonth;
      lastMonth = d.date.slice(0, 7);
      const n = d.teeth.length;
      /* 同日几版并排、整簇在格内居中（与旧版逐字一致） */
      const groupW = n ? (n - 1) * PITCH + TOOTH_W : 0;
      const start = -groupW / 2 + TOOTH_W / 2;
      return {
        kind: 'day' as const,
        key: d.date,
        label: d.label,
        count: d.count,
        total: d.total,
        slots: d.teeth.map((c, ti) => ({ x: start + ti * PITCH, h: hOf(c), day: d.date, n: c })),
        anchor: d.count ? d.anchor : null,
        title: `${d.date} · ${d.count} 版 · ${d.total} 项`,
        monthMark,
      };
    });
  } else {
    /* 月格：格内槽位 = 那天有更新的日子，位置按**几号**（真日期，不按序） */
    const byMonth = new Map<string, typeof dayBuckets>();
    for (const d of dayBuckets) {
      const mk = d.date.slice(0, 7);
      if (!byMonth.has(mk)) byMonth.set(mk, []);
      byMonth.get(mk)!.push(d);
    }
    const groups = [...byMonth.entries()].sort((a, b) => (a[0] < b[0] ? -1 : 1));
    /* 格宽**从数据反推**：一格要装得下当月最多的"有更新日"那几天。
       ★ 不写死 46 —— 写死就是"哪天数据一变就顶破"的老毛病（AGENTS §5
         「拿同一套办法给流场加东西」那一族的反面：常量迟早被数据顶穿）。 */
    const maxActive = Math.max(
      1,
      ...groups.map(([, ds]) => ds.filter((d) => d.count > 0).length),
    );
    CELL = Math.max(46, Math.min(72, maxActive * SLOT_PITCH));

    let lastYear = '';
    cells = groups.map(([mk, ds]) => {
      const [y, m] = mk.split('-').map(Number);
      const dm = daysInMonth(y, m!);
      const inner = CELL - 6;                 // 格内左右各留 3px
      const step = inner / dm;
      const yearMark = String(y) !== lastYear;
      lastYear = String(y);
      const slots = ds
        .filter((d) => d.count > 0)
        .map((d) => {
          const dom = Number(d.date.slice(8, 10));
          /* 一天多版时取**最高的一版**当这列的齿高（同一天只占一列） */
          const top = Math.max(...d.teeth);
          return { x: -inner / 2 + (dom - 0.5) * step, h: hOf(top), day: d.date, n: top };
        });
      const count = ds.reduce((a, b) => a + b.count, 0);
      const total = ds.reduce((a, b) => a + b.total, 0);
      const first = ds.find((d) => d.count > 0);
      return {
        kind: 'month' as const,
        key: mk,
        label: `${m}月`,
        count,
        total,
        slots,
        /* 锚点指向该月**第一个有更新的日子**（`day-…` 每天一个，天然存在 ⇒ 不产生死锚） */
        anchor: first ? first.anchor : null,
        title: `${mk} · ${count} 版 · ${total} 项`,
        monthMark: yearMark,
      };
    });
  }

  return {
    tier, cells, CELL, PITCH, TOOTH_W, MIN_H, BASE_Y, READOUT, LABEL, maxChanges, hOf,
    spanDays,
    W: cells.length * CELL,
    H: BASE_Y + LABEL,
    from: asc[0].day,
    to: asc[asc.length - 1].day,
    versions: items.length,
    // 契约用的可见量（探针与测试读它，避免"看着像"）
    distinctHeights: new Set(cells.flatMap((c) => c.slots.map((s) => s.h))).size,
    tallest: Math.max(...cells.flatMap((c) => c.slots.map((s) => s.h)), 0),
    shortest: Math.min(...cells.flatMap((c) => c.slots.map((s) => s.h)), Number.POSITIVE_INFINITY),
    emptyCells: cells.filter((c) => c.count === 0).length,
    /* ★ 装置自己的**可读性预算**：相邻两列渲染后的中心距。
       它才是"会不会糊成一条"的那个量 —— 低于 ~1px 时相邻的齿连成一片，
       齿高这条通道就没了。上面几行算的"总宽"只是它的成因。
       （量法：格内列距 × 缩放比。缩放比 = 盒宽 / viewBox 宽，
         盒宽取 `.chrono` 的上界 min(34vw, 520px) 的 520 那一档。） */
    slotPitchRendered:
      (tier === 'day' ? PITCH : SLOT_PITCH) * (520 / (cells.length * CELL)),
    boxWidth: 520,
  };
})();
---

<Base title="日志" current="log" chrome="page" bodyClass="log-plate">
  {/* ==========================================================================
   * 视口层（plate 槽）—— 两层：**静态底纹** + **读数装置**
   *
   * ① `.log-inf`：站主 2026-10-04 给的蓝色 ∞ 带，转**墨绿**后替代本页的百褶 ∞。
   *    挂法照抄百褶 ∞（`body.chrome-page .page-inf`）：fixed 挂视口居中 / `contain` /
   *    `z-index:-1` / 不拦指针 —— 全站纸白区只有**一套纹理语言**，本页换的是母题
   *    （米色百褶 → 墨绿 ∞），不是角色。
   * ② `.chrono`：走时仪。它是**读数器兼日期目录**，所以 fixed 常驻、不随文档走。
   * 两者都必须在 `.shell` **之外**：页面过渡会给 `.shell` 加 transform，
   * 被 transform 的祖先会成为 `position:fixed` 的包含块 ⇒ 装饰层会从下往上跳
   * （关于页实测 91px）。plate 槽就是为此存在的，见 Base.astro 的注记。
   * ======================================================================== */}
  <Fragment slot="plate">
    <div class="log-inf" aria-hidden="true">
      <Image
        src={plate}
        alt=""
        widths={[610, 1222]}
        sizes="62vw"
        loading="eager"
        decoding="sync"
      />
    </div>

    {CHRONO && (
      <nav class="chrono" aria-label="日志时间刻线尺">
        <p class="chrono-legend">
          <span>刻线高度 = 该版改动项数</span>
          <span>{CHRONO.tier === 'day' ? '刻线根数 = 当日版本数' : '刻线根数 = 当月有更新的天数'}</span>
        </p>
        {/* 「生长」的缩放轴钉在基线上 ⇒ 把 CHRONO.BASE_Y 传给 CSS。
            不在这里写死、也不在 CSS 里写死：MAX_H 哪天从数据推出来变高，
            两边只要有一处忘了跟就会错位 —— 现在只有一处事实来源。 */}
        <svg
          class="chrono-svg"
          style={`--chrono-base:${CHRONO.BASE_Y}px`}
          viewBox={`0 0 ${CHRONO.W} ${CHRONO.H}`}
          role="img"
          aria-label={`日志时间刻线尺：${CHRONO.from} 至 ${CHRONO.to}，共 ${CHRONO.versions} 个版本`}
        >
          <line class="chrono-base" x1="0" y1={CHRONO.BASE_Y} x2={CHRONO.W} y2={CHRONO.BASE_Y} />
          {CHRONO.cells.map((cell, di) => {
            const left = di * CHRONO.CELL;
            const cx = left + CHRONO.CELL / 2;
            const n = cell.slots.length;
            return (
              /* ★ 空格（当天 0 版）**不挂 href**：那天没有任何条目 ⇒ 跳过去是一个死锚。
                 不写 href 的 `<a>` 在 HTML 里不是链接（不可点、不进 Tab 序），
                 刚好是这里要的语义 —— 它仍然可以被 hover 读出「0 版 · 0 项」。
                 ★ 月格档的 href 指向该月**第一个有更新的日子**的 `day-…`
                   （`day-…` 是每天一个、真实存在的 id ⇒ 换档不会造出死锚）。 */
              <a
                class="chrono-day"
                data-period={cell.kind}
                href={cell.anchor ? `#${cell.anchor}` : undefined}
              >
                <title>{cell.title}</title>
                <rect class="chrono-hit" x={left} y="0" width={CHRONO.CELL} height={CHRONO.BASE_Y} />
                {n === 0 ? (
                  /* 空格留一根**虚线短柱** ——
                     "有这一格、但那天没动手"本身是信息，不能让它直接消失。 */
                  <line
                    class="chrono-empty"
                    x1={cx}
                    y1={CHRONO.BASE_Y}
                    x2={cx}
                    y2={CHRONO.BASE_Y - CHRONO.MIN_H}
                  />
                ) : (
                  /* ⑤「生长」（GROW）的入场相位：**按日格错开**，不是逐齿均分。
                     ⇒ 同一格的几根齿是一簇、格与格之间推进 ⇒ 读起来是「一天一天地长出来」，
                       而不是「一根一根地长」（后者会把"一天 = 一格"的结构打散）。
                     方向也刚好对：di 是时间正序（左 = 最早）⇒ 从最早那天往右长。
                     ★ 两个系数的**相对大小是硬约束**：格内错开必须 < 格间距，
                       否则相邻格会交错（09-30 那格有 9 根齿，跨度 8×ti），
                       一眼看过去就不是"从左往右"而是"逐格来回跳"。
                       这里是 8ms × 8 = 64ms < 90ms ⇒ 严格单增。断言守着这一条。 */
                  cell.slots.map((s, ti) => (
                    <line
                      class="chrono-tooth"
                      style={`--tooth-delay:${di * 90 + ti * 8}ms`}
                      x1={cx + s.x}
                      y1={CHRONO.BASE_Y}
                      x2={cx + s.x}
                      y2={CHRONO.BASE_Y - s.h}
                    />
                  ))
                )}
                <text class="chrono-readout" x={cx} y={CHRONO.READOUT - 10}>
                  {`${cell.count} 版 · ${cell.total} 项`}
                </text>
                {/* ★ 标签带（2026-10-15 站主：「日号会重复，得加月份」）。
                   日号档写**日号**，月份标在**每月的第一格**上；月格档直接写月份，
                   年份变化时多写一行年份。
                   ⚠ 这不是"补丁式地加个月份"—— 一旦跨过 31 天，日号本身就失去了
                     唯一性（"3" 分不清是几月 3 号），月份才是那一档唯一的自然标签。
                   ★★★ **月份排在日号下面，不是把日号顶下去**（本轮第一版踩了）：
                     顶下去的话，同月里只有那一格下沉，看起来是"排版歪了一格"，
                     而月与月之间还会因为"有没有月标"而高低不一。
                     独占一行 ⇒ 日号那一行**一个像素都不动**，与改版前逐字一致。 */}
                <text class="chrono-lbl" x={cx} y={CHRONO.BASE_Y + 14}>
                  {cell.label}
                </text>
                {cell.monthMark && (
                  <text class="chrono-mon" x={cx} y={CHRONO.BASE_Y + 29}>
                    {cell.kind === 'month'
                      ? cell.key.slice(0, 4) + '年'
                      : Number(cell.key.slice(5, 7)) + '月'}
                  </text>
                )}
              </a>
            );
          })}
        </svg>
        <p class="chrono-range">
          <span>{CHRONO.from}</span>
          <span>{CHRONO.to}</span>
        </p>
      </nav>
    )}

    {/* 滚动轨（站主 2026-10-08：「再加一个拖动的条要不然太长了」）。
        ★ 与走时仪同一层放在 plate 槽里：`.shell` 之外 ⇒ 免疫页面过渡那层 transform
          建立的 fixed 包含块（本文件上面那段注释写过这个坑）。
        ★ 默认挂着 `hidden`，脚本到位才摘 ⇒ 无 JS 时整根不存在。
          ⇒ CSS 里**不要**给 `.rail` 写 display，写了会盖过 UA 的 [hidden]。 */}
    <div class="rail" data-rail hidden aria-hidden="true" tabindex="-1">
      <span class="rail-thumb" data-rail-thumb></span>
    </div>
  </Fragment>

  <header class="pagehead">
    <PageTitle>日志</PageTitle>
    {d.intro && <p class="lede">{d.intro}</p>}
  </header>

  <ol class="log">
    {rows.map((it) => (
      <li class="entry" id={it.anchor}>
        <p class="head">
          <time datetime={iso(it.date)}>{iso(it.date)}</time>
          {it.version && <span class="ver">{it.version}</span>}
        </p>
        {it.changes && (
          <ul class="changes">
            {it.changes.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ol>
  {items.length === 0 && <p class="empty">还没有日志。</p>}
</Base>

<style>
  /* ---- 滚动轨 SCROLL RAIL（站主 2026-10-08）-----------------------------------
     全站原生滚动条 2026-10-02 按站主要求删掉了（base.css 那两行），超长页从此
     没有「能拖的东西」。这根是补回来的替代控件 —— 不是把原生皮肤还回去，
     仍走站上的纸白 / 墨绿。
     ★ 位置避开走时仪：走时仪的右缘落在 `max(--gutter, …)` 外侧，本轨贴视口右边缘
       0.75rem ⇒ 两者不会叠。
     ★ 视觉只有 3px，命中区给了 22px：细得好看，又抓得住。
     ★ 无过渡：滑块位置是滚动量的即时映射，reduced-motion 下天然一致。
     ★ 窄屏不渲染（手机上触屏滚动更自然，条只会挡内容）。 */
  .rail {
    position: fixed;
    top: 50%;
    right: 0.75rem;
    /* 正文与走时仪是 1、抽屉 40、整页过渡蒙版 45 ⇒ 夹在内容之上、蒙版之下 */
    z-index: 2;
    width: 22px;
    height: min(44vh, 360px);
    transform: translateY(-50%);
    cursor: pointer;
    /* 拖动滑块时不要连带触发页面自身的滚动 */
    touch-action: none;
  }
  .rail::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 3px;
    transform: translateX(-50%);
    border-radius: 2px;
    background: var(--hair);
  }
  .rail-thumb {
    position: absolute;
    left: 50%;
    top: 0;
    width: 3px;
    transform: translateX(-50%);
    border-radius: 2px;
    background: var(--accent);
    /* top 与 height 都由 src/scripts/scroll-rail.ts 按滚动量设 */
  }
  @media (max-width: 767px) {
    .rail {
      display: none;
    }
  }

  .lede {
    margin: var(--sp-4) 0 0;
    max-width: var(--measure);
    color: var(--muted);
  }
  .log {
    margin: var(--sp-8) 0 0;
    padding: 0;
    list-style: none;
    max-width: var(--measure);
  }
  .entry {
