---
/**
 * 首页 · console 外壳（B1）
 * 零动效：本文件里没有任何 transition / animation / 监听器。
 * `.field-item` 与 `data-label` 是留给 B2 动效层的挂点，B1 不消费它们。
 */
import Base from '../layouts/Base.astro';
import BootIntro from '../components/BootIntro.astro';
import NavDrawer from '../components/NavDrawer.astro';
import SiteStats from '../components/SiteStats.astro';
import { NAV_LINKS } from '../lib/nav';
import { getVisiblePosts } from '../lib/posts';
import { getSite } from '../lib/site';
// 由 scripts/gen-gallery-webp.mjs 在构建前生成（原图不部署，只部署两档 webp）。
// manifest v2（2026-09-26）：顶层是全量 `albums[]`，首页只依赖 `home` 这一段 ——
// 首页不需要理解全量结构，将来相册页也不用迁就首页。
import galleryManifest from '../../public/gallery/manifest.json';

const site = await getSite();
const posts = await getVisiblePosts();

if (!galleryManifest.home) throw new Error('manifest.json 缺 home 段 —— 跑一下 node scripts/gen-gallery-webp.mjs');
const album = galleryManifest.home;
const shots = album.shots;

// 主图 srcset 从 manifest 反推（唯一真源 = gen-gallery-webp.mjs 的 WIDTHS），
// 不写死 800w/1280w —— 否则改档位时这里会静默指向不存在的文件。
const mainSrcset = (files) =>
  [...files]
    .sort((a, b) => a.w - b.w)
    .map((f) => `${f.url} ${f.w}w`)
    .join(', ');

// 坐标行三个字段都可选：缺任何一个就整行不渲染，不渲染空值
const hasCoord = Boolean(site.lat && site.lon && site.status);

const sectors = [
  { id: 's1', n: '01', name: '身份', top: '0%' },
  { id: 's2', n: '02', name: '文章', top: '28%' },
  { id: 's3', n: '03', name: '相册', top: '71%' },
  { id: 's4', n: '04', name: '项目', top: '90%' },
  { id: 's5', n: '05', name: '联系', top: '97%' },
];
---

<Base description={site.metaDescription} current="index" chrome="console">
  {/* ===== 两态门控（B2）=====
      默认（无 JS）= 页面完整可读：正文不弱化、仪表不显示死指针；
      JS 到位后给 <html> 挂 .js，才有聚焦弱化与扫描仪表。
      放在槽内最前面：脚本同步执行，等 .field-item 被解析时类已就位，不会闪。
      只落在首页 —— 不动 Base，其余 13 页产物逐字节不变。 */}
  {/* ===== 开场门控（B3）：必须在覆盖层之前**同步**执行，否则会先闪一下再隐藏 =====
      不播的四种情形（#6 + 站主 Q3）：reduced-motion / 无 JS / 本会话已播 / ≤767px。
      方向是 fail-safe：默认不显示，只有判定"该播"才挂 .boot-on（锁滚动也挂在这个类上）。
      `.js` 这个字面量有断言守着（tests/b2-motion.test.ts「门控脚本只落首页」），别改。 */}
  <script is:inline>
    document.documentElement.classList.add('js');
    try {
      var play =
        !matchMedia('(prefers-reduced-motion: reduce)').matches &&
        innerWidth >= 768 &&
        !sessionStorage.getItem('boot-intro');
      if (play) document.documentElement.classList.add('boot-on');
      sessionStorage.setItem('boot-intro', '1'); /* 进入播放即记：刷新不重播（#6）；skip 也不重播（#16） */
    } catch (e) {
      /* 无痕 / 禁用 storage：退化成"可能重播一次"，不影响可用性 */
    }
  </script>

  {/* 开场覆盖层（装饰 + skip 按钮）。只落首页；JS 与门控见 BootIntro.astro */}
  <BootIntro />

  {/* ===== 背景装饰层（B2）：四样全是装饰，不承载任何信息 =====
      堆叠计划：0 装饰 < 1 正文 .tier < 2 扫描带 < 3 刻度尺 < 4 HUD < 5 OS 状态条
      （装饰层是 position:fixed，若正文不给 z-index，定位元素会画在静态正文之上 —— 水印会盖到字上。） */}
  <svg class="bg-mark" aria-hidden="true" focusable="false"><use href="#rhine-logo" /></svg>
  <div class="bg-ring" aria-hidden="true"></div>
  <div class="bg-orbit" aria-hidden="true"></div>
  <div class="bg-green" aria-hidden="true"></div>
  {/* 磁带（站主 2026-09-26 提供的那张「RHINE LAB, LLC. NO.001」渲染图，抠底后压成 WebP）：
      用 CSS 背景而不是 <img> —— 它是**纯装饰**，站上那条"所有图片 alt 非空"的硬约束不该为它开口子；
      仍是装饰层（z-index 0，见下面的堆叠说明），只放右下角、不让它压到正文与页脚的字上。 */}
  <div class="bg-cassette" aria-hidden="true"></div>

  {/* 莱茵标志（＋∞−）：一处定义。注意外层**不要**再写 viewBox —— 符号自带，
      外层再写会双重映射并把上下裁掉（原型里踩过）。 */}
  <svg class="svg-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <symbol id="rhine-logo" viewBox="0 6 24 12">
      <g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4c2 2.67 4 4 6 4a4 4 0 0 0 2.83-6.83M19.04 8.14a4 4 0 0 0-1.04-.14c-2 0-4 1.33-6 4" />
        <path d="M4.7 12h2.6M6 10.7v2.6" stroke-width="1.8" />
        <path d="M16.7 12h2.6" stroke-width="1.8" />
      </g>
    </symbol>
  </svg>

  <!-- OS 状态条：只写能确证的东西（站点名 / 区段数）。不写 SAVED/INDEX 那类语义不明的数字。 -->
  {/* 底 OS 状态条。**注意：这里不能写 slot="band"** —— console 外壳下 Base 不渲染
      <slot name="band" />，Astro 会把指派给未渲染具名槽的子元素整个丢掉，
      结果这条从 B1 起一直没进过产物（B2 增量 2 的探针把它逮出来的）。
      它是 position:fixed，放在默认槽里同样贴在视口底部。 */}
  <div class="os-rail" aria-hidden="true">
    <span>OS-01-H · {site.name}</span>
    <span>SECTORS {String(sectors.length).padStart(2, '0')} · POSTS {String(posts.length).padStart(2, '0')}</span>
  </div>

  <nav class="rail" aria-label="页面区段">
    {/* .rail-track 用 100% 高而不是原型的 56vh 居中 —— 否则 5 个刻度的 top% 换基准、
        整体位置会漂移。这里只是给 .rail-fill 一个定位父级，几何与 B1 完全一致。 */}
    <div class="rail-track">
      <div class="rail-fill" id="railFill"></div>
      {sectors.map((s) => (
        <a class="rail-tick" href={`#${s.id}`} style={`top:${s.top}`} data-sec={s.id}>
          <i></i><b>{s.n}</b><span class="rail-name">{s.name}</span>
        </a>
      ))}
    </div>
  </nav>

  <div class="hud">
    <span class="site">{site.wordmark}</span>
    {/* 导航（2026-09-26 站主追加）：**首页也要有** —— 站主说"PC 端右上角加这几项"，
        而首页是最自然的入口页；我第一版按"console 外壳没有导航"的旧定案没加，站主打开首页就以为没生效。
        位置贴着 HUD 读数（右上角），≤1023px 换成与内页同一个抽屉组件。 */}
    <span class="hud-right">
      <nav class="hud-nav" aria-label="主导航">
        {NAV_LINKS.map((l) => (
          <a href={l.href} aria-current={l.key === 'index' ? 'page' : undefined}>{l.label}</a>
        ))}
        <a href="/rss.xml">RSS</a>
      </nav>
      <span class="readout">
        <i class="rec" aria-hidden="true"></i>
        <span id="hudSec">01</span> / {String(sectors.length).padStart(2, '0')} · <span class="hud-progress" id="hudPct">000%</span>
      </span>
    </span>
    <NavDrawer current="index" />
  </div>

  <div class="band" id="band" aria-hidden="true">
    <div class="band-line"></div>
    <span class="band-sweep"></span>
    <span class="band-cap l"></span><span class="band-cap r"></span>
    <div class="band-readout">
      <svg class="rhine-mark sm" aria-hidden="true"><use href="#rhine-logo" /></svg>
      扫描：<b id="bandTitle">—</b>
    </div>
  </div>

  <section class="tier" id="s1">
    {/* 扫描带读数用**作者名**（站主 2026-09-26 定）。这里刻意写死字面量：
        content/site.md 没有 author 字段，而这一行是界面标签、不是正文 —— 优先照站主要求直改，
        不顺手扩内容契约（若将来要可配置，给 site.md 加可选的 author 字段即可）。 */}
    <div class="field-item hud" data-label="身份 · 郑云嘉">
      <div class="pod pod-s1">
        {/* 中文站名沉为**背景水印**（站主 2026-09-26：做成英文旁的小字太扎眼）：
            半透明、比小字大得多、允许越过身份舱边框但**越界部分被裁掉**（.pod-s1 overflow:hidden）。
            它是纯装饰 —— 同样的站名在 OS 状态条与坐标行都已有 —— 所以 aria-hidden。
            大字是英文站名；两个值都来自 content/site.md。 */}
        <span class="pod-zh" aria-hidden="true">{site.name}</span>
        <span class="pod-tag">POD 01 · 身份</span>
        {/* tabindex="-1"：开场结束/跳过时把焦点交回这里（决策 #16）。它只在**页内程序化聚焦**时生效，
            不进 Tab 序列、不改变键盘浏览顺序。 */}
        <h1 class="display" tabindex="-1">{site.wordmark}</h1>
        <p class="lede">{site.intro}</p>
        {hasCoord && (
          <p class="coord">
            <span>SITE {site.name}</span>
            <span>LAT {site.lat}</span>
            <span>LON {site.lon}</span>
            <span>STATUS {site.status}</span>
          </p>
        )}
      </div>
    </div>
  </section>

  <section class="tier" id="s2">
    <div class="tier-head hud"><span class="sec">SECTOR 02</span><h2>最近写的</h2></div>
    <ul class="index">
      {posts.map((p) => (
        <li class="field-item hud hud-card" data-label={`文章 · ${p.title}`}>
          {/* .bracket：L 形角标（左下 + 右上对角）。它是聚焦的主要载体 —— 透明度只是辅助。 */}
          <div class="bracket">
            <a href={p.url}>
              <span class="date"><time datetime={p.date}><span class="brk">[</span> {p.date.replace(/-/g, '.')} <span class="brk">]</span></time></span>
              <span class="title">{p.title}</span>
              <span class="tags">{p.tags.join(' / ')}</span>
            </a>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="tier" id="s3">
    <div class="tier-head hud"><span class="sec">SECTOR 03</span><h2>相册</h2></div>
    {shots.length > 0 ? (
      <div class="field-item hud" data-label={`相册 · ${album.title} · ${album.total} 帧`}>
        <div class="pod">
          <p class="pod-tag">CULTURE POD · {album.title} · {album.total} 帧</p>
          <div class="frames">
            <div class="f-main">
              {/* S3 的图是 /gallery 的入口（站主 2026-09-26）：原型 home.html 也是这么连的。
                  三张都指向相册页 —— 筛选是客户端行为，没有按相册分的 URL 可深链。 */}
              <a class="frame hud" href="/gallery">
                <img
                  src={shots[0].files[0].url}
                  srcset={mainSrcset(shots[0].files)}
                  sizes="(min-width: 900px) 44vw, 100vw"
                  width={shots[0].files[0].w}
                  height={shots[0].files[0].h}
                  alt={shots[0].alt}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            </div>
            {shots.length > 1 && (
              <div class="f-thumbs">
                {shots.slice(1, 3).map((s) => (
                  <a class="frame hud" href="/gallery">
                    <img src={s.files[1].url} width={s.files[1].w} height={s.files[1].h} alt={s.alt} loading="lazy" decoding="async" />
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    ) : (
      <p class="empty">相册还没建。</p>
    )}
  </section>

  <section class="tier" id="s4">
    <div class="tier-head hud"><span class="sec">SECTOR 04</span><h2>项目</h2></div>
    <div class="field-item hud" data-label="项目 · 空态">
      <p class="empty">哎呀，目前还没有项目呢 &lt;3 —— 写了几个，但都还躺在本地，等它们能跑起来再挂到这儿。</p>
    </div>
  </section>

  <section class="tier" id="s5">
    <div class="tier-head hud"><span class="sec">SECTOR 05</span><h2>找到我</h2></div>
    <div class="field-item hud" data-label="联系 · 找到我">
      <ul class="links">
        <li><a href={site.github}>GitHub</a></li>
        <li><a href="/rss.xml">RSS</a></li>
        <li><a href={`mailto:${site.email}`}>邮箱</a></li>
      </ul>
    </div>
  </section>

  {/* 页脚统计（站主 2026-09-26："在每页最底部加上图一上的功能"）。
      首页是 console 外壳、**不渲染 SiteFooter** ⇒ 这里单独放一份，用浅色 tone。
      放在正文流最末（下面那条固定 OS 状态条会盖住 fixed 层，所以这里给它留了底部间距）。 */}
  <div class="home-stats">
    <SiteStats since={site.since} tone="paper" />
  </div>

  {/* ===== 动效层（B2）：6 段行为，零依赖 =====
       规矩：只读 DOM + 写 class/style，不动布局；reduced-motion 下不补间、不位移。
       元素缺失时全部短路（B1 的标记里没有这些仪器时页面照样能用）。 */}
  <script>
    (() => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = Array.from(document.querySelectorAll('.field-item'));
      const band = document.getElementById('band');
      const bandTitle = document.getElementById('bandTitle');
      const railFill = document.getElementById('railFill');
      const hudPct = document.getElementById('hudPct');
      const hudSec = document.getElementById('hudSec');
      const ticks = Array.from(document.querySelectorAll('.rail-tick'));

      /* 1) 入场揭示：每个条目第一次进入视口时显形，只播一次。
            揭示的载体是 transform（不是 opacity）—— 基准 opacity 恒为 --focus-min，
            所以最坏情况只是「没动画」，绝不会「内容永久不可见」。 */
      if ('IntersectionObserver' in window) {
        const reveal = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('is-revealed');
            reveal.unobserve(e.target);
          }
        }, { rootMargin: '0px 0px -12% 0px', threshold: 0.01 });
        items.forEach((el, i) => {
          // 同屏一起揭示的条目做 90ms 错位（spec §1.1：层间错位 80–120ms）
          if (!reduce) el.style.transitionDelay = (i % 3) * 90 + 'ms';
          reveal.observe(el);
        });
      } else {
        items.forEach((el) => el.classList.add('is-revealed'));
      }

      /* 2) 聚焦：屏幕中部 25vh 就是「扫描带」，焦点由滚动位置驱动。带外不禁用，只弱化。 */
      let current = null;
      const setFocus = (el) => {
        if (el === current) return;
        items.forEach((i) => i.classList.toggle('is-focused', i === el));
        current = el;
        if (bandTitle) bandTitle.textContent = el ? (el.dataset.label || '—') : '—';
        if (!reduce && band) {
          // 端点闪一下 120ms：用户在动，给「带子响应了」的反馈
          band.classList.add('is-tick');
          setTimeout(() => band.classList.remove('is-tick'), 120);
        }
      };
      if ('IntersectionObserver' in window) {
        const focus = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) setFocus(e.target);
            else if (e.target === current) {
              // 还在带内的其它条目会立刻把它顶掉；没有就清空
              const still = items.filter((i) => {
                const r = i.getBoundingClientRect();
                return r.top < innerHeight * 0.625 && r.bottom > innerHeight * 0.375;
              });
              setFocus(still[0] || null);
            }
          }
        }, { rootMargin: '-37.5% 0px -37.5% 0px', threshold: 0 });
        items.forEach((el) => focus.observe(el));
      }

      /* 3) 刻度填充 + HUD 读数（passive，不阻塞滚动；仪器读数不加缓动） */
      let secTops = [];
      const measure = () => {
        secTops = ticks.map((t) => {
          const el = document.getElementById(t.dataset.sec);
          return { t, top: el ? el.getBoundingClientRect().top + scrollY : 0 };
        });
      };
      const onScroll = () => {
        const max = document.documentElement.scrollHeight - innerHeight;
        const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
        if (railFill) railFill.style.height = p * 100 + '%';
        setPct(p * 100);
        const mid = scrollY + innerHeight / 2;
        let active = secTops[0];
        for (const s of secTops) if (s.top <= mid) active = s;
        if (active) {
          ticks.forEach((t) => t.setAttribute('aria-current', t === active.t ? 'true' : 'false'));
          const b = active.t.querySelector('b');
          const txt = b ? b.textContent : '';
          if (hudSec && txt && hudSec.textContent !== txt) {
            hudSec.textContent = txt;
            if (!reduce) {
              // 橙色唯一的用武之地：刚扫到新区段（160ms）
              hudSec.classList.add('is-scan');
              setTimeout(() => hudSec.classList.remove('is-scan'), 160);
            }
          }
        }
        queueYield();
      };

      /* 4) 穿字让位：带中心 ±12px 内的文字朝纸退一档，带子离开后回位。
            选择器按 index.astro 的真实类名重列 —— 原型的 .post/.frame 在这边不存在。 */
      const yieldEls = Array.from(document.querySelectorAll(
        '.display,.lede,.coord span,.index .date,.index .title,.index .tags,.pod-tag,.tier-head h2,.tier-head .sec,.empty,.links a'
      ));
      let yieldQueued = false;
      const updateYield = () => {
        yieldQueued = false;
        const cy = innerHeight / 2, half = 12;
        for (const el of yieldEls) {
          const r = el.getBoundingClientRect();
          if (!r.height) continue;
          const hit = r.bottom >= cy - half && r.top <= cy + half;
          if (hit !== el.classList.contains('is-yielding')) el.classList.toggle('is-yielding', hit);
        }
      };
      const queueYield = () => {
        if (yieldQueued) return;
        yieldQueued = true;
        requestAnimationFrame(updateYield);
      };

      /* 5) 数字跳动：HUD 百分比在 ~180ms 内插值到目标（每帧补 28% 差额，约 10 帧收敛）。
            首次与 reduced-motion 直接落值；tabular-nums 已保证字宽不抖。 */
      let pctTarget = 0, pctShown = 0, pctRaf = 0, pctInit = false;
      const paintPct = (v) => { if (hudPct) hudPct.textContent = String(Math.round(v)).padStart(3, '0') + '%'; };
      const tweenPct = () => {
        pctRaf = 0;
        const diff = pctTarget - pctShown;
        pctShown = Math.abs(diff) < 0.5 ? pctTarget : pctShown + diff * 0.28;
        paintPct(pctShown);
        if (pctShown !== pctTarget) pctRaf = requestAnimationFrame(tweenPct);
      };
      const setPct = (v) => {
        if (!hudPct) return;
        if (!pctInit || reduce) { pctInit = true; pctShown = pctTarget = v; paintPct(v); return; }
        pctTarget = v;
        if (!pctRaf) pctRaf = requestAnimationFrame(tweenPct);
      };

      /* 6) 点击绿色闪烁：pointerdown（捕获阶段）命中 a/button → .is-flash 180ms */
      document.addEventListener('pointerdown', (e) => {
        const t = e.target && e.target.closest ? e.target.closest('a,button') : null;
        if (!t) return;
        t.classList.add('is-flash');
        setTimeout(() => t.classList.remove('is-flash'), 180);
      }, true);

      measure();
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', () => { measure(); onScroll(); });
      onScroll();
      updateYield();
    })();
  </script>
</Base>

<style>
  /* ===== 背景装饰层（B2）：四样全是装饰，不承载信息 =====
     **堆叠计划（插入本层后重排，务必保持这个次序）**：
       0 装饰 < 1 正文 .tier < 2 扫描带 < 3 刻度尺 < 4 HUD < 5 OS 状态条
     装饰层是 position:fixed，若正文不显式给 z-index，定位元素会画在静态正文之上
     —— 水印会盖到字上（原型靠给正文容器 z-index 解掉，这里同理）。 */
  .bg-mark {
    position: fixed;
    top: 12vh;
    right: 3vw;
    width: min(46vw, 540px);
    height: min(23vw, 270px);
    color: var(--ink);
    opacity: 0.055;
    z-index: 0;
    pointer-events: none;
  }
  /* 磁带：右下角，压到视口外一点（像"摆在桌面边上"而不是贴一张图）。
     尺寸/位置/透明度都在这里调；窄屏直接不显示（手机上是纵向长页，右下角会被正文反复压过）。 */
  .bg-cassette {
    position: fixed;
    right: -4vw;
    bottom: -6vh;
    width: min(38vw, 460px);
    aspect-ratio: 560 / 452;
    z-index: 0;
    pointer-events: none;
    opacity: 0.92;
    background: url('/art/cassette.webp') center / contain no-repeat;
  }
  @media (max-width: 767px) {
    .bg-cassette {
      display: none;
    }
  }
  .bg-ring {
    position: fixed;
    left: -8vw;
    bottom: -10vh;
    width: min(52vw, 620px);
    aspect-ratio: 1;
    z-index: 0;
    pointer-events: none;
    background: repeating-radial-gradient(
      circle at 50% 50%,
      transparent 0 118px,
      var(--deco-ring-line) 118px 119px
    );
  }
  .bg-orbit {
    position: fixed;
    left: -8vw;
    bottom: -10vh;
    width: min(52vw, 620px);
    aspect-ratio: 1;
    z-index: 0;
    pointer-events: none;
    border-radius: 50%;
    border: 1px solid transparent;
    border-top-color: var(--deco-orbit-strong);
    border-right-color: var(--deco-orbit-soft);
  }
  .bg-orbit::after {
    content: "";
    position: absolute;
    inset: 14%;
    border-radius: 50%;
    border: 1px solid transparent;
    border-bottom-color: var(--deco-orbit-inner);
  }
  .bg-green {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: 26vh;
    z-index: 0;
    pointer-events: none;
    background: var(--deco-wash-green);
  }
  /* 符号定义块：不占位、不显示，只提供 #rhine-logo 给 <use> */
  .svg-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* ===== 外壳：左刻度尺 / 顶 HUD / 中扫描带 / 底 OS 条 =====
     数值取自已冻结的视觉规范；B1 只做静态，没有任何 transition / animation。 */
  .rail {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3rem;
    border-right: 1px solid var(--hair);
    z-index: 3;
  }
  .rail-tick {
    position: absolute;
    left: 0;
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    padding-left: var(--sp-2);
    text-decoration: none;
    color: var(--muted);
    font-size: var(--fs-xs);
  }
  .rail-tick i {
    display: block;
    width: 0.75rem;
    height: 1px;
    background: var(--hair);
  }
  .rail-tick b {
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }
  .rail-name {
    position: absolute;
    left: 100%;
    white-space: nowrap;
  }
  .hud {
    position: fixed;
    top: 0;
    left: 3rem;
    right: 0;
    display: flex;
    justify-content: space-between;
    padding: var(--sp-2) var(--sp-4);
    border-bottom: 1px solid var(--hair);
    font-size: var(--fs-xs);
    color: var(--muted);
    z-index: 4;
  }
  .hud .site {
    letter-spacing: 0.06em;
  }
  /* 导航贴着读数放在右上角；≤1023px 收起（换成抽屉，与内页同一个组件） */
  .hud-right {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }
  .hud-nav {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .hud-nav a {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
  }
  .hud-nav a:hover,
  .hud-nav a[aria-current='page'] {
    color: var(--ink);
    border-color: var(--accent);
  }
  @media (max-width: 1023px) {
    .hud-nav {
      display: none;
    }
  }
  .band {
    position: fixed;
    top: 50vh;
    left: 3rem;
    right: 0;
    height: 1px;
    z-index: 2;
    pointer-events: none;
  }
  .band-line {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
  }
  /* 页脚统计（首页那份）：正文流最末，给固定的 OS 状态条留出高度 */
  .home-stats {
    margin: var(--sp-8) 0 0;
    padding: var(--sp-3) 0 calc(1.9rem + var(--sp-6));
    border-top: 1px solid var(--hair);
    max-width: 60rem;
  }
  .os-rail {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1.9rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--sp-4);
    border-top: 1px solid var(--hair);
    background: var(--paper);
    font-size: var(--fs-xs);
    color: var(--muted);
    z-index: 5;
  }

  /* 版心：Base 的 .shell 已经把 main 排好，这里只补左右让位与上下留白 */
  main {
    padding-left: 3rem;
    padding-bottom: 1.9rem;
  }

  /* 正文层：必须显式抬到装饰层之上（理由见上面「堆叠计划」） */
  .tier {
    position: relative;
    z-index: 1;
    padding: var(--sp-8) 0;
  }
  .tier-head {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    margin-bottom: var(--sp-5);
    border-bottom: 1px solid var(--ink);
    padding-bottom: var(--sp-2);
  }
  .tier-head .sec {
    font-size: var(--fs-xs);
    color: var(--muted);
    letter-spacing: 0.08em;
  }
  .tier-head h2 {
    margin: 0;
    font-size: var(--fs-h2);
  }

  .pod {
    border: 1px solid var(--hair);
    background: var(--panel);
    padding: var(--sp-5);
  }
  /* 身份舱的中文站名水印（站主 2026-09-26）：半透明沉到背景、字号大得多，
     允许越过 pod 边框但被 overflow:hidden 裁掉 —— 裁切点就是"身份边框"，越界部分不显示。 */
  .pod-s1 {
    position: relative;
    overflow: hidden; /* ← 越界部分不显示的那一刀 */
  }
  /* 水印是定位元素，会盖在静态兄弟之上 ⇒ 显式把其余内容抬到它上面（不用逐条改既有规则） */
  .pod-s1 > *:not(.pod-zh) {
    position: relative;
    z-index: 1;
  }
  .pod-zh {
    position: absolute;
    right: -0.04em;
    bottom: -0.22em;
    z-index: 0;
    font-size: clamp(5rem, 16vw, 15rem);
    font-weight: 800;
    line-height: 0.78;
    letter-spacing: -0.04em;
    /* alpha 写在颜色 token 里（--deco-identity-ink = --ink @ 6%）——
       这里**不能**用 `opacity: var(...)`：变量没解析成功时它会回落到初值 1（全不透明），
       实测就那样出过一张实心黑水印压在正文上的图。 */
    color: var(--deco-identity-ink);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  .pod-tag {
    display: inline-block;
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-xs);
    color: var(--accent-ink);
    letter-spacing: 0.06em;
  }
  .display {
    margin: 0;
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    font-weight: 800;
  }
  .lede {
    max-width: 33em;
    margin: var(--sp-5) 0 0;
    font-size: var(--fs-lede);
  }
  .coord {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin: var(--sp-5) 0 0;
    font-size: var(--fs-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .index li {
    border-bottom: 1px solid var(--hair);
  }
  .index a {
    display: block;
    padding: var(--sp-5) 0;
    text-decoration: none;
    color: inherit;
  }
  .index .date {
    font-size: var(--fs-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .index .title {
    display: block;
    margin: var(--sp-2) 0 var(--sp-2);
    font-size: var(--fs-item);
    line-height: var(--lh-item);
    letter-spacing: var(--ls-item);
    font-weight: 800;
  }
  .index .tags {
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  .frames {
    display: flex;
    gap: var(--sp-4);
    align-items: flex-start;
  }
  .f-main {
    flex: 1 1 auto;
  }
  .f-main :global(img) {
    width: 100%;
    height: auto;
  }
  .f-thumbs {
    flex: 0 0 31%;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }
  .f-thumbs :global(img) {
    width: 100%;
    /* 手机上 .f-thumbs 变行排（两缩略图并排）。flex 项的 min-width:auto 会取 width:100% 的
       内容最小尺寸（= 整个容器宽），两张就顶成 200% 宽 → 整页横向溢出（390px 视口实测
       scrollWidth 673）。显式 min-width:0 才让它们能平分这一行。 */
    min-width: 0;
    height: auto;
  }
  /* S3 的图现在是 /gallery 的链接（2026-09-26）→ 锚点成了新的 flex 项，
     上面那条 min-width:0 防的是 flex 项，所以必须跟着搬到锚点上；
     line-height:0 消掉 inline 锚点里 img 下方那条基线空隙，版面尺寸不变。 */
  .frames :global(a.frame) {
    display: block;
    min-width: 0;
    line-height: 0;
  }
  .frames :global(a.frame:focus-visible) {
    outline: 2px solid var(--accent-ink);
    outline-offset: 2px;
  }

  .empty {
    margin: 0;
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    color: var(--accent-ink);
  }

  @media (max-width: 767px) {
    .rail {
      display: none;
    }
    /* 小屏：水印缩小、同心环收掉（细环在小屏显脏 —— 原型实测结论），绿底也压矮 */
    .bg-mark {
      width: min(70vw, 300px);
      height: min(35vw, 150px);
      opacity: 0.045;
      top: 9vh;
      right: 0;
    }
    .bg-ring {
      display: none;
    }
    .bg-green {
      height: 18vh;
    }
    .hud,
    .band {
      left: 0;
    }
    main {
      padding-left: 0;
    }
    .frames {
      flex-direction: column;
      gap: var(--sp-3);
    }
    .f-thumbs {
      flex-direction: row;
      width: 100%;
    }
  }

  /* ============================================================
     B2 动效层（2026-09-26 站主批准移植；清单与原型行号见 docs/b2-port-notes.md）
     四层：交互 120ms · 叙事 640ms · 循环 8/16s linear · 硬切 800ms steps(1)
     时长与曲线一律走 tokens.css，这里不写字面量。
     硬约束：只动 transform / opacity / color / background-color，**不动 layout**。
     ============================================================ */

  /* ---- 仪表（B1 省略、B2 补回）：刻度填充 / HUD 读数 / 扫描带两端与读数 ---- */
  .rail-track {
    position: relative;
    height: 100%;
  }
  .rail-fill {
    position: absolute;
    top: 0;
    left: 0.5rem;
    width: 2px;
    height: 0; /* JS 更新 */
    /* 滚过的部分 = 仪器已量到处。用 --accent(4.86:1) 而不是 --accent-bright(2.66:1)：
       2px 线属于「必须被看见的非文字图形」，按 WCAG 1.4.11 要 ≥3:1 ——
       这正是 tests/tokens.test.ts 白名单守的那条线，所以这里**不能**用 --accent-bright。 */
    background: var(--accent);
  }
  .rail-tick[aria-current='true'] {
    color: var(--ink);
  }
  .rail-tick[aria-current='true'] i {
    width: 26px;
    background: var(--accent-ink);
  }
  /* 清单第 1 条：角标变长要有过渡，否则 aria-current 切换时是硬跳。
     原型用的是 --ease（叙事曲线），但这属于交互层（120ms 的即时反馈）
     → 按 spec §1.1 的分层改用 --ease-interact。 */
  .rail-tick i {
    transition: width var(--dur-fast) var(--ease-interact);
  }
  .rail-tick:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: 2px;
  }

  .hud .readout {
    display: inline-flex;
    align-items: center;
  }
  .hud .rec {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.5rem;
    background: var(--accent);
    /* 硬切，不是呼吸灯 —— 仪器是硬切的 */
    animation: blink var(--dur-blink) steps(1) infinite;
  }
  #hudSec {
    transition: color var(--dur-fast) linear;
  }
  /* 橙色唯一的用武之地：刚扫到新区段时闪一下（JS 160ms 后摘掉类） */
  #hudSec.is-scan {
    color: var(--signal-text);
  }
  .hud-progress {
    font-variant-numeric: tabular-nums;
  }
  /* 仪表读数是 JS 驱动的：没有 JS 就不该显示死指针 / 假读数。
     原型用的是 html.no-js 规则，本站走「默认=无 JS 安全、html.js=增强」的路线，
     所以等价规则写成 html:not(.js)。（三态截图时发现漏了这条：无 JS 下 HUD 挂着 000%、
     扫描带读数挂着「—」，都是没人在更新的死指针。） */
  html:not(.js) .hud-progress,
  html:not(.js) .band-readout {
    display: none;
  }

  .band-sweep {
    position: absolute;
    top: -1px;
    left: 0;
    width: 16rem;
    height: 2px;
    /* 端点高光同样只能用 --accent：这是压在纸上的图形，
       白名单测试不许裸 var(--accent-bright) 出现在这个选择器里。 */
    background: linear-gradient(
      90deg,
      transparent,
      var(--accent) 42%,
      var(--accent-wash) 50%,
      var(--accent) 58%,
      transparent
    );
    animation: sweep-x 4s linear infinite;
  }
  .band-cap {
    position: absolute;
    top: -3px;
    width: 14px;
    height: 7px;
    /* 端帽跟着读数一起玻璃化（同一套质感）：透白 + 模糊 + 极淡描边 */
    background: rgb(250 250 247 / 60%);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    border: 1px solid var(--hair);
    opacity: 0;
    transition: opacity var(--dur-fast) linear;
  }
  .band-cap.l {
    left: 0;
  }
  .band-cap.r {
    right: 0;
  }
  .band.is-tick .band-cap {
    opacity: 1;
    background: var(--accent);
  }
  .band-readout {
    position: absolute;
    left: 0;
    top: -1.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding-right: 0.75rem;
    /* 真·透明玻璃（站主 2026-09-26："直接改透明玻璃的样式"）：
       上一版是 55% 纸色 —— 在纸白页面上仍像一块"板子"；这一版几乎不上色（22%），
       靠**更强的模糊**分层，再用一圈极淡描边 + 上缘一道高光把"玻璃片"的质感做出来。
       扫描带固定在视口中央，滚动时必然压到正文 ⇒ 底色必须一直保持透明。 */
    background: rgb(250 250 247 / 22%);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    backdrop-filter: blur(12px) saturate(1.2);
    border: 1px solid rgb(250 250 247 / 45%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 40%);
    /* 读数内容是**整条标题**，手机上会折成两行、把标题盖掉大半 ⇒ 一律单行截断 */
    max-width: min(72vw, 52ch);
    white-space: nowrap;
    font-size: var(--fs-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  /* 让 <b>（标题那一段）可以被压缩并省略，而不是把整块撑宽 */
  .band-readout b {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--accent-ink);
    font-weight: 400;
  }
  .rhine-mark {
    width: 44px;
    height: 22px;
    color: var(--accent-ink);
    display: inline-block;
    vertical-align: middle;
  }
  .rhine-mark.sm {
    width: 32px;
    height: 16px;
  }

  /* ---- 聚焦：JS 打开时才生效。带外条目不禁用，只是弱化；聚焦回到 1 ---- */
  html.js .field-item {
    opacity: var(--focus-min);
    transform: translateY(12px);
    transition: opacity var(--dur-enter) var(--ease), transform var(--dur-enter) var(--ease);
  }
  /* 揭示的真正载体是 transform —— 基准 opacity 恒为 --focus-min，
     所以最坏情况只是「没动画」，绝不会出现「内容永久不可见」 */
  html.js .field-item.is-revealed {
    transform: none;
  }
  html.js .field-item.is-focused {
    opacity: 1;
  }
  /* 聚焦时角标升级（原型：这才是聚焦的主要载体，透明度只是辅助） */
  html.js .field-item .bracket::before,
  html.js .field-item .bracket::after {
    border-color: var(--hair);
  }
  html.js .field-item.is-focused .bracket::before,
  html.js .field-item.is-focused .bracket::after {
    border-color: var(--ink);
  }

  /* L 形角标：左下 + 右上对角 */
  .bracket {
    position: relative;
    padding: 1rem;
  }
  .bracket::before,
  .bracket::after {
    content: '';
    position: absolute;
    width: 1.4rem;
    height: 1rem;
    border: 0 solid var(--hair);
    transition: border-color var(--dur-fast) var(--ease-interact);
  }
  .bracket::before {
    left: 0;
    bottom: 0;
    border-left-width: 1px;
    border-bottom-width: 1px;
  }
  .bracket::after {
    right: 0;
    top: 0;
    border-right-width: 1px;
    border-top-width: 1px;
  }

  /* ---- 交互层：悬停微亮 + 位移，按压缩一下（走 token，不写字面量） ---- */
  .index a,
  .links a,
  .rail-tick {
    transition:
      background var(--dur-fast) var(--ease-interact),
      transform var(--dur-fast) var(--ease-interact),
      border-color var(--dur-fast) var(--ease-interact),
      color var(--dur-fast) var(--ease-interact);
  }
  .index a:hover,
  .index a:focus-visible {
    transform: translateY(-2px);
    background: var(--accent-wash);
  }
  .index a:active,
  .links a:active,
  .rail-tick:active {
    transform: scale(0.995);
  }
  /* 点击绿色闪烁（JS 加 180ms）—— 只改背景与描边，不动布局 */
  a.is-flash,
  button.is-flash {
    background: var(--accent-wash);
    outline: 1px solid var(--accent);
  }

  /* ---- 穿字让位：扫描带中心 ±12px 内的文字朝纸退一档 ----
     原型用 color-mix 调色，这里改用 opacity（同样只动 paint，
     且不引入 color-mix 的兼容面；"退 18%" 的观感一致）。 */
  .display.is-yielding,
  .tier-head h2.is-yielding,
  .links a.is-yielding,
  .index .title.is-yielding {
