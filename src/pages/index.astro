    transform-box: view-box;
    transform-origin: 50% 50%;
    /* 缓动是 ease-in-out（不是 --ease 那条"起步极快"的）：
       起步慢，那条线才会在观众眼前**停留一下**再炸开；用 --ease 的话 25% 处已经长完 85%，
       生长全程都躲在幕布后面（实测踩到过）。 */
    animation: rh-bloom var(--bi-bloom) cubic-bezier(0.65, 0, 0.35, 1)
      calc(var(--bi-bloom-at) + var(--st, 0ms) * var(--bi-k)) both;
  }
  /* ★ 顺序是**横向**在前、**竖向**在后，而且必须分开：
       0 → 45%    还在 ∞ 那撮采样点上（扁的）→ 横向散开到自己该在的列位
                   ⇒ 幕布收成那条线之后，它先"横向拉长"成整屏一条线
       45% → 100% 竖向长成满高（按 --st 从两端向中间错峰）
     为什么顺序是这个、为什么不能合并成一次变形 —— 两个都是实测出来的：
       · 扁的时候横向散开：整屏一条**干净的线**（这是最要紧的那一帧）。
       · 长高的时候横向散开：104 条**波浪线**在同一小段高度里互相交叠 ⇒ 一坨摩尔纹
         （实测 3300ms 是一整条模糊的梭形，不像线）。
       · 两者同时跑：上面两条都占 ⇒ 中段直接糊掉。
     ⇒ 竖向那一段要短（--bi-bloom 的 55%），"糊"的窗口只有 ~180ms，一闪就过去了。 */
  @keyframes rh-bloom {
    from {
      opacity: 0.9;
      transform: translateX(calc(50vw + var(--k, 0) * min(23vw, 260px) - var(--x, 0px))) scaleY(0.003);
    }
    45% {
      opacity: 0.88;
      transform: translateX(0) scaleY(0.004);
    }
    to { opacity: 0.62; transform: none; }
  }
  .rh-grid__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: block;
    pointer-events: none;
    /* 暗角：让流场在首屏中间最实、四角淡出（原型值） */
    mask-image: radial-gradient(ellipse 74% 64% at 56% 46%, #000 14%, transparent 84%);
    -webkit-mask-image: radial-gradient(ellipse 74% 64% at 56% 46%, #000 14%, transparent 84%);
  }
  /* ★★ :global() 必须：这些 <path> 是运行时 createElementNS 造的，没有 cid。
     不带 :global() 时 computed 是 stroke:none / fill:rgb(0,0,0) ⇒
     一根线都没有，反而是黑色实心多边形糊在首屏上。 */
  .rh-grid :global(path) {
    fill: none;
    stroke: var(--on-band-sub);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
    opacity: 0.62;
  }

  /* ====================== 首屏 · 深墨绿场 ====================== */
  .band {
    position: relative;
    /* ★ 逃出 .shell 的宽度回到整屏（原型 .band 本来就是顶层元素） */
    margin-inline: calc(50% - 50vw);
    min-height: 100vh;
    min-height: 100svh; /* 手机地址栏收放时不跳 */
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: var(--on-band);
    perspective: 1400px;
    /* ★ 底色必须是**半透明**的（原型 v5.4 最终值）：实心色会把压在后面的
       .bg 循环动效完全闷死，整张深场变成一块没有呼吸的死色。 */
    background:
      radial-gradient(110% 70% at 12% 0%, #2d7d462e 0%, transparent 58%),
      radial-gradient(90% 60% at 88% 88%, #e877220f 0%, transparent 62%),
      linear-gradient(
        178deg,
        #090c0cee 0%,
        #101814e0 34%,
        #1a251fcc 62%,
        #34413ab3 100%
      );
    isolation: isolate;
  }
  /* ★★ 明度爬升层：**照搬原型** —— `flex:1` + `position:relative`（在文档流里）。
     上一轮我加了 `position:absolute; inset:0; z-index:0`，让它「盖满整个首屏」，
     于是那条 78%/100% 处的深墨绿洗色**真的生效了** —— 而原型里它是个**可伸缩的顶部留白块**：
     `.band-inner` 的 `min-height:auto` 先吃掉内容高度（802 视口下是 761），
     flex 把剩下的 41px 分给 `.band-core` ⇒ 原型的渐变只铺在顶部 41px ⇒ 几乎不可见。
     实测证据（1258×802，英雄区最末 40px 平均亮度）：原型 112 / 本站 85
     —— 站主截的「身份下面的过渡」就是这条。
     ⇒ 恢复原型形态：① 首屏下半段不再多一层压暗；② topbar 会被这块留白往下推一点
       （原型 41px，本站因真实简介更长、内容更高，实测约 34px）。 */
  .band-core {
    flex: 1;
    position: relative;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      transparent 0%,
      transparent 24%,
      #1b26208c 78%,
      #26332c66 100%
    );
  }
  .band-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.5;
    background-image:
      linear-gradient(90deg, #ffffff0a 1px, transparent 1px),
      linear-gradient(0deg, #ffffff0a 1px, transparent 1px);
    background-size: 64px 64px;
    transform: translate3d(
      calc(var(--mx) * var(--shift-c) * 2),
      calc(var(--my) * var(--shift-c) * 2),
      0
    );
    transition: transform 160ms linear;
  }
  /* 三块玻璃「舱窗」：错落制造前后关系，位移量逐块递增（22 / 34 / 44px） */
  .band-glass {
    position: absolute;
    z-index: 1;
    pointer-events: none;
    border-radius: 14px;
    border: 1px solid var(--dglass-line);
    background: linear-gradient(160deg, #ffffff14, #ffffff05);
    /* ★ 前缀必须写在标准属性**之前**，否则 esbuild 会删掉标准那条 */
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.1);
    backdrop-filter: blur(var(--glass-blur)) saturate(1.1);
    transition: transform 140ms linear;
    will-change: transform;
  }
  .band-glass.g1 {
    top: 11%; right: 6%; width: min(22vw, 240px); height: min(30vh, 220px);
    transform: translate3d(calc(var(--mx) * 22px), calc(var(--my) * 22px), 0)
      rotateY(calc(var(--mx) * var(--tilt))) rotateX(calc(var(--my) * var(--tilt) * -1));
  }
  .band-glass.g2 {
    top: 47%; right: 26%; width: min(15vw, 164px); height: min(20vh, 140px); opacity: 0.72;
    transform: translate3d(calc(var(--mx) * 34px), calc(var(--my) * 34px), 0)
      rotateY(calc(var(--mx) * var(--tilt)));
  }
  .band-glass.g3 {
    top: 15%; right: 30%; width: min(10vw, 110px); height: min(13vh, 92px); opacity: 0.5;
    transform: translate3d(calc(var(--mx) * 44px), calc(var(--my) * 44px), 0)
      rotateY(calc(var(--mx) * var(--tilt)));
  }
  /* 卡面游走高光：光源随指针在卡里移动 —— 玻璃"活着"的关键 */
  .band-glass::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      60% 55% at calc(50% + var(--mx) * 40%) calc(50% + var(--my) * 40%),
      #ffffff26,
      transparent 70%
    );
  }
  .band-inner {
    position: relative;
    z-index: 2;
    max-width: var(--wrap);
    margin: 0 auto;
    padding: var(--gutter);
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
  }
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    flex-wrap: wrap;
  }
  .wordmark {
    font-family: Archivo, sans-serif;
    font-weight: 700;
    letter-spacing: 0.14em;
    font-size: 0.9rem;
  }
  .wordmark small {
    display: block;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--on-band-meta);
    font-size: 0.7rem;
  }
  /* 导航 = 原型胶囊按钮（不是下划线文字链）：悬停位移 + 亮边 + 掠光 */
  nav {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  nav a {
    position: relative;
    padding: 0.42rem 0.82rem;
    border-radius: 999px;
    font-size: var(--fs-sm);
    color: var(--on-band-sub);
    border: 1px solid transparent;
    overflow: hidden;
    /* ★ 2026-09-30 第五轮补：原型第 78 行有一条全局 `a{color:inherit;text-decoration:none}`，
       上一轮我按「不搬全局 reset」的原则整体没带 ⇒ 首页导航成了全站唯一带下划线的链接
       （其余组件 Topbar / NavDrawer / PostIndex / Toc / 首页 .entry a 都各自补过这一条）。
       这里按同样的局部写法补上，不改全局 base.css。 */
    text-decoration: none;
    transition:
      transform var(--dur-tap) var(--ease-interact),
      color var(--dur-tap) var(--ease-interact),
      background-color var(--dur-tap) var(--ease-interact),
      border-color var(--dur-tap) var(--ease-interact);
  }
  /* 掠光：悬停时一道斜光从左扫到右 */
  nav a::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(115deg, transparent 30%, #ffffff26 50%, transparent 70%);
    transform: translateX(-120%);
    transition: transform var(--dur-hover) var(--ease-glass);
  }
  nav a:hover,
  nav a:focus-visible {
    color: var(--on-band);
    background: #ffffff14;
    border-color: var(--dglass-line);
    transform: translateY(-2px);
  }
  nav a:hover::before,
  nav a:focus-visible::before {
    transform: translateX(120%);
  }
  /* 当前页：淡绿底 + 绿描边（不是下划线）。
     ★ 三段值**照搬原型**（原型 nav a[aria-current] 那一行）。
       上一轮我把它们换成了 --on-band / #2d7d4624 / #4caf5059，结果「主页」那两个字不会变绿 ——
       站主 2026-09-30 报的就是这条。别再"统一到 token"：原型就是直接写 #4caf50 系字面量。
       深色 band 上用亮绿合法（对 --ink 6.26:1），tests/tokens.test.ts 的白名单里已登记。 */
  nav a[aria-current] {
    color: var(--accent-bright);
    background: #4caf5014;
    border-color: #4caf5038;
  }
  .band-copy {
    margin-top: auto;
    padding-bottom: 2.6rem;
  }

  /* ====================== 首屏入场（开场揭幕的交接）======================
     ★★ 全部只在 `html.boot-on`（且非手机极简版）下挂 —— 这是 fail-safe 的方向：
        无 JS / reduced-motion / 本会话已播 / skip 之后 ⇒ 这组规则**根本不存在**，
        首屏内容默认就是终态、完整可读。绝不写成"默认藏起来、靠 JS 放出来"
        （上游 wodniack.dev 就是整站 SSR `opacity:0` 靠 JS 点亮，动画一丢内容永久不可见 ——
          那正是本仓 2026-09-30 第六轮修掉的 bug 类型）。
     ★ 四个时刻全部走 tokens.css 的 --bi-*（第八版：时间轴只有一处定义，覆盖层与首屏共用）。
     ★ 几段故意重叠：幕布 3400 收完，而线长到 4600、页头 3450–4070、揭帘 4150–5100、
       逐字 4400–5550 ⇒ 观感是"幕布收拢的同时线在长、内容在成形"，不是"揭幕完再放一段"。 */
  /* 页头（字标 + 导航）：幕布从上边缘先揭开它 ⇒ 不给门控就会**闪一下**。
     只动 opacity、不动 transform —— .topbar 里有抽屉（NavDrawer），给它 transform 会
     让它变成 fixed 后代的包含块，那是另一个坑。 */
  :global(html.boot-on:not(.boot-mini)) .topbar {
    animation: topbar-in 620ms var(--ease) calc(var(--bi-copy-at) - 700ms) backwards;
  }
  @keyframes topbar-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  :global(html.boot-on:not(.boot-mini)) .band-copy {
    animation: copy-veil var(--bi-copy) cubic-bezier(0.65, 0, 0.35, 1) var(--bi-copy-at) both;
  }
  @keyframes copy-veil {
    from { clip-path: inset(0 0 100% 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  :global(html.boot-on:not(.boot-mini)) .display .dch {
    animation: ch-rise var(--bi-ch) var(--ease) both;
    animation-delay: calc(var(--bi-ch-at) + var(--i, 0) * var(--bi-ch-step));
  }
  @keyframes ch-rise {
    from { opacity: 0; transform: translateY(0.6em); }
    to { opacity: 1; transform: none; }
  }

  /* 拆字壳：**只有 display:inline-block**，不动字号/行高/字距 ——
     inline-block 装单字时，基线与行盒高度都与原文本相同 ⇒ 拆字前后排版逐字节一致。
     letter-spacing 是"每字之后各加一份"，拆开后总宽也不变。 */
  .display .dline { display: block; }
  .display .dch { display: inline-block; }
  /* 给屏幕阅读器的那份完整原文（视觉上不存在，但留在无障碍树里） */
  .display-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: var(--fs-mono);
    letter-spacing: 0.22em;
    color: var(--on-band-meta);
    /* ★ 原型靠全局 `*{margin:0;padding:0}` 抹掉 <p> 的 UA 外边距，本站 base.css 没有这条
       ⇒ 首屏三个 <p> 各自多出上/下外边距（实测 .eyebrow mt 多 13.6px、.lede 多 17+17px、
       .coord mb 多 13.6px，合计约 61px）。这里按元素逐个补 0，不去动全局 reset。 */
    margin: 0 0 1rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .eyebrow i {
    width: 6px;
    height: 6px;
    background: var(--signal);
    border-radius: 50%;
    display: block;
    box-shadow: 0 0 8px 2px #e8772266;
  }
  .display {
    font-family: Archivo, sans-serif;
    font-weight: 700;
    font-size: clamp(2.4rem, 9.2vw, 6.4rem); /* 原型 --fs-display 原值 */
    line-height: 0.88;
    letter-spacing: -0.045em;
    margin: 0 0 1.1rem;
  }
  .lede {
    /* ★ 照搬原型 `max-width:34em`（em 按自身 font-size 1.0625rem 算 = 578px）。
       上一轮写的是 40.5rem = 648px，注释却写着「原型量度 578px」—— 注释对、值错了。 */
    max-width: 34em;
    margin: 0;
    color: var(--on-band-sub);
    font-size: 1.0625rem;
    line-height: 1.7; /* 原型值（上一轮误写成 1.62） */
  }
  .coord {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    margin: 1.5rem 0 0; /* 原型只有 margin-top:1.5rem，下外边距靠全局 reset 抹掉 ⇒ 这里显式归零 */
    font-family: 'IBM Plex Mono', monospace;
    font-size: var(--fs-mono);
    color: var(--on-band-meta);
    letter-spacing: 0.06em;
  }
  /* SCROLL 提示：左下角横排（一条 28px 短横线 + 2.2s 绿色跑光） */
  .scroll-hint {
    position: absolute;
    left: var(--gutter);
    bottom: 1rem;
    z-index: 2;
    font-family: 'IBM Plex Mono', monospace;
    font-size: var(--fs-mono);
    color: var(--on-band-meta);
    letter-spacing: 0.2em;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .scroll-hint s {
    display: block;
    width: 28px;
    height: 1px;
    background: #ffffff33;
    position: relative;
    overflow: hidden;
    text-decoration: none;
  }
  .scroll-hint s::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent-bright);
    animation: hint 2.2s var(--ease) infinite;
  }
  @keyframes hint {
    0% { transform: translateX(-100%); }
    60%, 100% { transform: translateX(100%); }
  }

  /* ====================== 晨昏带 ====================== */
  .dusk {
    position: relative;
    /* ★★ 2026-09-30 第六轮（站主报「身份下面衔接」那条）——
       必须和 .band / .paper-wrap 一样**逃出 Base 的 .shell**（max-width: --wrap = 82rem = 1312px）。
       原型的 .dusk 是顶层元素、天生满宽；本站它被包在 .shell 里，而 .shell 的内边距在首页
       被清零了 ⇒ **窄视口下看不出来**，一旦视口宽于 1312px，.dusk 就被框成「中间 1312px 一段」：
       它上面满宽的深墨绿场、下面满宽的纸白区都在，只有晨昏带两侧露出纸白
       ⇒ 上下各出现一条竖向硬边，看起来就是「没接上」（站主截图那条白边）。
       实测（1680×900 窗口，CDP elementFromPoint 逐点）：
         修前 本站 .dusk x=173 w=1312，x<173 命中 main（纸白）
         同条件 原型 .dusk x=0   w=1658（满宽）
       ★ 不写 width:100vw —— vw 含滚动条宽度 ⇒ 横向溢出（与 .band 同理）。 */
    margin-inline: calc(50% - 50vw);
    height: min(46vh, 400px);
    background: linear-gradient(
      180deg,
      var(--dusk-4) 0%,
      var(--dusk-5) 30%,
      var(--dusk-6) 58%,
      #ecebe4b8 78%,
      #fafaf747 92%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 74%, #0000008c 90%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0%, #000 74%, #0000008c 90%, transparent 100%);
  }
  .dusk::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.5;
    background-image:
      linear-gradient(90deg, #ffffff14 1px, transparent 1px),
      linear-gradient(0deg, #ffffff14 1px, transparent 1px);
    background-size: 72px 72px;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 72%);
    mask-image: linear-gradient(180deg, #000 0%, transparent 72%);
  }

  /* ====================== 字母滚动带 ======================
     两份内容并排 + 跑 -50% ⇒ 无缝。两行反向，速度不同（46s / 52s）。 */
  .marquee {
    position: relative;
    overflow: hidden;
    padding: 1.5rem 0 2.1rem;
    /* ★★ 下面三条**照搬原型**，而且要在原型里也是「死」的 —— 别去补 --line-1 / --paper-0！
       原型这两个变量从未定义 ⇒ `var()` 无 fallback ⇒ 计算值阶段整条作废 ⇒
       原型本来就没有上下横线、也没有实色底（∞ 底纹从跑马灯后面透出来）。
       上一轮我在 :global(:root) 里定义了这两个变量，把它们救活了 ⇒ 横线冒出来 ——
       站主 2026-09-30 报的就是这条。要复现「有横线」才需要去 tokens.css 里给这两个变量赋值。 */
    border-top: 1px solid var(--line-1);
    border-bottom: 1px solid var(--line-1);
    background: var(--paper-0);
    /* 原型有这一条，上一轮漏了 ⇒ S2→S3 的间距比原型紧。照搬补回。 */
    margin-bottom: clamp(2.4rem, 5vw, 4.2rem);
    user-select: none;
    z-index: 1;
  }
  .marquee-row {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .marquee-row.up { animation: marquee-left 46s linear infinite; }
  .marquee-row.down { animation: marquee-right 52s linear infinite; margin-top: 0.34rem; }
  @keyframes marquee-left {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }
  @keyframes marquee-right {
    from { transform: translate3d(-50%, 0, 0); }
    to { transform: translate3d(0, 0, 0); }
  }
  .marquee-item {
    display: inline-flex;
    align-items: baseline;
    gap: 1.4rem;
    padding-right: 2.6rem;
    /* ★ 照抄原型 830 行的**原文**（含 fallback）：原型没定义 --font-display ⇒ 取 inherit
