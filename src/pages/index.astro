    font-family: var(--mono, 'IBM Plex Mono', ui-monospace, monospace);
  }
  .langbar-hd {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.55rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .langbar-hd b {
    color: var(--ink);
    font-weight: 600;
    letter-spacing: 0.1em;
  }
  .langbar-hd .of {
    color: var(--hair);
  }
  /* 条本体：高 12px 胶囊，段间 2px 缝（缝用背景色，不用 border —— 缩放时线宽不跳） */
  .langbar-track {
    display: flex;
    gap: 2px;
    height: 12px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--hair);
  }
  .langbar-track > i {
    display: block;
    height: 100%;
    /* 生长用 scaleX 而不是 width —— 只走合成层，不触发 layout */
    transform-origin: left center;
    transform: scaleX(0);
    animation: lang-grow 0.9s var(--ease) forwards;
    animation-delay: calc(var(--i, 0) * 90ms + 180ms);
  }
  @keyframes lang-grow {
    to { transform: scaleX(1); }
  }
  .langbar-legend {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(148px, 1fr));
    gap: 0.4rem 1.4rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
