---
/**
 * 首页 · console 外壳（B1）
 * 零动效：本文件里没有任何 transition / animation / 监听器。
 * `.field-item` 与 `data-label` 是留给 B2 动效层的挂点，B1 不消费它们。
 */
import Base from '../layouts/Base.astro';
import { getVisiblePosts } from '../lib/posts';
import { getSite } from '../lib/site';
// 由 scripts/gen-gallery-webp.mjs 在构建前生成（原图不部署，只部署两档 webp）
import galleryManifest from '../../public/gallery/manifest.json';

const site = await getSite();
const posts = await getVisiblePosts();

const album = galleryManifest;
const shots = album.shots;

// 主图 srcset 从 manifest 反推（唯一真源 = gen-gallery-webp.mjs 的 WIDTHS），
// 不写死 800w/1280w —— 否则改档位时这里会静默指向不存在的文件。
const mainSrcset = (files) =>
  [...files]
    .sort((a, b) => a.w - b.w)
    .map((f) => `${f.url} ${f.w}w`)
    .join(', ');

// 坐标行三个字段都可选：缺任何一个就整行不渲染，不渲染空值
const hasCoord = Boolean(site.lat && site.lon && site.status);

const sectors = [
  { id: 's1', n: '01', name: '身份', top: '0%' },
  { id: 's2', n: '02', name: '文章', top: '28%' },
  { id: 's3', n: '03', name: '相册', top: '71%' },
  { id: 's4', n: '04', name: '项目', top: '90%' },
  { id: 's5', n: '05', name: '联系', top: '97%' },
];
---

<Base description={site.metaDescription} current="index" chrome="console">
  <!-- OS 状态条：只写能确证的东西（站点名 / 区段数）。不写 SAVED/INDEX 那类语义不明的数字。 -->
  <div class="os-rail" slot="band" aria-hidden="true">
    <span>OS-01-H · {site.name}</span>
    <span>SECTORS {String(sectors.length).padStart(2, '0')} · POSTS {String(posts.length).padStart(2, '0')}</span>
  </div>

  <nav class="rail" aria-label="页面区段">
    {sectors.map((s) => (
      <a class="rail-tick" href={`#${s.id}`} style={`top:${s.top}`}>
        <i></i><b>{s.n}</b><span class="rail-name">{s.name}</span>
      </a>
    ))}
  </nav>

  <div class="hud">
    <span class="site">{site.wordmark}</span>
    <span>01 / {String(sectors.length).padStart(2, '0')}</span>
  </div>

  <div class="band" aria-hidden="true"><div class="band-line"></div></div>

  <section class="tier" id="s1">
    <div class="field-item" data-label={`身份 · ${site.name}`}>
      <div class="pod pod-s1">
        <span class="pod-tag">POD 01 · 身份</span>
        <h1 class="display">{site.name}</h1>
        <p class="lede">{site.intro}</p>
        {hasCoord && (
          <p class="coord">
            <span>SITE {site.name}</span>
            <span>LAT {site.lat}</span>
            <span>LON {site.lon}</span>
            <span>STATUS {site.status}</span>
          </p>
        )}
      </div>
    </div>
  </section>

  <section class="tier" id="s2">
    <div class="tier-head"><span class="sec">SECTOR 02</span><h2>最近写的</h2></div>
    <ul class="index">
      {posts.map((p) => (
        <li class="field-item" data-label={`文章 · ${p.title}`}>
          <a href={p.url}>
            <span class="date"><time datetime={p.date}>{p.date}</time></span>
            <span class="title">{p.title}</span>
            <span class="tags">{p.tags.join(' / ')}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="tier" id="s3">
    <div class="tier-head"><span class="sec">SECTOR 03</span><h2>相册</h2></div>
    {shots.length > 0 ? (
      <div class="field-item" data-label={`相册 · ${album.title} · ${album.total} 帧`}>
        <div class="pod">
          <p class="pod-tag">CULTURE POD · {album.title} · {album.total} 帧</p>
          <div class="frames">
            <div class="f-main">
              <img
                src={shots[0].files[0].url}
                srcset={mainSrcset(shots[0].files)}
                sizes="(min-width: 900px) 44vw, 100vw"
                width={shots[0].files[0].w}
                height={shots[0].files[0].h}
                alt={shots[0].alt}
                loading="lazy"
                decoding="async"
              />
            </div>
            {shots.length > 1 && (
              <div class="f-thumbs">
                {shots.slice(1, 3).map((s) => (
                  <img src={s.files[1].url} width={s.files[1].w} height={s.files[1].h} alt={s.alt} loading="lazy" decoding="async" />
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    ) : (
      <p class="empty">相册还没建。</p>
    )}
  </section>

  <section class="tier" id="s4">
    <div class="tier-head"><span class="sec">SECTOR 04</span><h2>项目</h2></div>
    <div class="field-item" data-label="项目 · 空态">
      <p class="empty">哎呀，目前还没有项目呢 &lt;3 —— 写了几个，但都还躺在本地，等它们能跑起来再挂到这儿。</p>
    </div>
  </section>

  <section class="tier" id="s5">
    <div class="tier-head"><span class="sec">SECTOR 05</span><h2>找到我</h2></div>
    <div class="field-item" data-label="联系 · 找到我">
      <ul class="links">
        <li><a href={site.github}>GitHub</a></li>
        <li><a href="/rss.xml">RSS</a></li>
        <li><a href={`mailto:${site.email}`}>邮箱</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ===== 外壳：左刻度尺 / 顶 HUD / 中扫描带 / 底 OS 条 =====
     数值取自已冻结的视觉规范；B1 只做静态，没有任何 transition / animation。 */
  .rail {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3rem;
    border-right: 1px solid var(--hair);
    z-index: 2;
  }
  .rail-tick {
    position: absolute;
    left: 0;
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    padding-left: var(--sp-2);
    text-decoration: none;
    color: var(--muted);
    font-size: var(--fs-xs);
  }
  .rail-tick i {
    display: block;
    width: 0.75rem;
    height: 1px;
    background: var(--hair);
  }
  .rail-tick b {
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }
  .rail-name {
    position: absolute;
    left: 100%;
    white-space: nowrap;
  }
  .hud {
    position: fixed;
    top: 0;
    left: 3rem;
    right: 0;
    display: flex;
    justify-content: space-between;
    padding: var(--sp-2) var(--sp-4);
    border-bottom: 1px solid var(--hair);
    font-size: var(--fs-xs);
    color: var(--muted);
    z-index: 2;
  }
  .hud .site {
    letter-spacing: 0.06em;
  }
  .band {
    position: fixed;
    top: 50vh;
    left: 3rem;
    right: 0;
    height: 1px;
    z-index: 1;
    pointer-events: none;
  }
  .band-line {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
  }
  .os-rail {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1.9rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--sp-4);
    border-top: 1px solid var(--hair);
    background: var(--paper);
    font-size: var(--fs-xs);
    color: var(--muted);
    z-index: 3;
  }

  /* 版心：Base 的 .shell 已经把 main 排好，这里只补左右让位与上下留白 */
  main {
    padding-left: 3rem;
    padding-bottom: 1.9rem;
  }

  .tier {
    padding: var(--sp-8) 0;
  }
  .tier-head {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    margin-bottom: var(--sp-5);
    border-bottom: 1px solid var(--ink);
    padding-bottom: var(--sp-2);
  }
  .tier-head .sec {
    font-size: var(--fs-xs);
    color: var(--muted);
    letter-spacing: 0.08em;
  }
  .tier-head h2 {
    margin: 0;
    font-size: var(--fs-h2);
  }

  .pod {
    border: 1px solid var(--hair);
    background: var(--panel);
    padding: var(--sp-5);
  }
  .pod-tag {
    display: inline-block;
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-xs);
    color: var(--accent-ink);
    letter-spacing: 0.06em;
  }
  .display {
    margin: 0;
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    font-weight: 800;
  }
  .lede {
    max-width: 33em;
    margin: var(--sp-5) 0 0;
    font-size: var(--fs-lede);
  }
  .coord {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin: var(--sp-5) 0 0;
    font-size: var(--fs-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .index li {
    border-bottom: 1px solid var(--hair);
  }
  .index a {
    display: block;
    padding: var(--sp-5) 0;
    text-decoration: none;
    color: inherit;
  }
  .index .date {
    font-size: var(--fs-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .index .title {
    display: block;
    margin: var(--sp-2) 0 var(--sp-2);
    font-size: var(--fs-item);
    line-height: var(--lh-item);
    letter-spacing: var(--ls-item);
    font-weight: 800;
  }
  .index .tags {
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  .frames {
    display: flex;
    gap: var(--sp-4);
    align-items: flex-start;
  }
  .f-main {
    flex: 1 1 auto;
  }
  .f-main :global(img) {
    width: 100%;
    height: auto;
  }
  .f-thumbs {
    flex: 0 0 31%;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }
  .f-thumbs :global(img) {
    width: 100%;
    /* 手机上 .f-thumbs 变行排（两缩略图并排）。flex 项的 min-width:auto 会取 width:100% 的
       内容最小尺寸（= 整个容器宽），两张就顶成 200% 宽 → 整页横向溢出（390px 视口实测
       scrollWidth 673）。显式 min-width:0 才让它们能平分这一行。 */
    min-width: 0;
    height: auto;
  }

  .empty {
    margin: 0;
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    color: var(--accent-ink);
  }

  @media (max-width: 767px) {
    .rail {
      display: none;
    }
    .hud,
    .band {
      left: 0;
    }
    main {
      padding-left: 0;
    }
    .frames {
      flex-direction: column;
      gap: var(--sp-3);
    }
    .f-thumbs {
      flex-direction: row;
      width: 100%;
    }
  }
</style>
