---
/**
 * 首页 · console 外壳（B1）
 * 零动效：本文件里没有任何 transition / animation / 监听器。
 * `.field-item` 与 `data-label` 是留给 B2 动效层的挂点，B1 不消费它们。
 */
import Base from '../layouts/Base.astro';
import BootIntro from '../components/BootIntro.astro';
import NavDrawer from '../components/NavDrawer.astro';
import SiteStats from '../components/SiteStats.astro';
import { NAV_LINKS } from '../lib/nav';
import { getVisiblePosts } from '../lib/posts';
import { getSite } from '../lib/site';

const site = await getSite();
const posts = await getVisiblePosts();

// 首页 S2「最近写的」只露最新的三篇（站主 2026-09-28）。
// 这里**不覆盖 posts**：posts 已是按日期倒序的全量列表，OS 状态条的 POSTS 读数
// 与导航都还依赖它 —— 截断只发生在 S2 这一处渲染上，站点总量不该跟着首页走。
const HOME_POST_LIMIT = 3;
const recentPosts = posts.slice(0, HOME_POST_LIMIT);

// 2026-09-30 站主要求「相册不放主页了」⇒ 首页不再需要相册 manifest。
// 原来这里 import 了 public/gallery/manifest.json 并取 home.shots / mainSrcset，
// 现在整块移掉了 —— 相册页 /gallery 仍在自己消费那个 manifest，接口没变。
// 同时删掉的还有 <Base> 的 intro 门控对相册图的依赖（见下方注释）。
// ★ 注意：gen-gallery-webp.mjs 仍要在 build 里跑（相册页还要它产 WebP）。

// 坐标行三个字段都可选：缺任何一个就整行不渲染，不渲染空值
const hasCoord = Boolean(site.lat && site.lon && site.status);

// 首页区段（2026-09-30 站主要求：**相册从首页拿掉**）。
// 「相册」不再占首页一个区段 —— 首页回到四段：身份 → 文章 → 项目 → 找到我。
// 相册页 /gallery 本身保留，从导航进（站主原话「相册不放主页了」）。
// 区段编号表原本是给左刻度尺做定位与读数的（top = 各段在整页里的相对位置）。
// 2026-09-30：刻度尺随 console 外壳一并删除 ⇒ 这张表已无人引用，删掉，不留在源码里养灰。
---

<Base description={site.metaDescription} current="index" chrome="console">
  {/* ===== 两态门控（B2）=====
      默认（无 JS）= 页面完整可读：正文不弱化、仪表不显示死指针；
      JS 到位后给 <html> 挂 .js，才有聚焦弱化与扫描仪表。
      放在槽内最前面：脚本同步执行，等 .field-item 被解析时类已就位，不会闪。
      只落在首页 —— 不动 Base，其余 13 页产物逐字节不变。 */}
  {/* ===== 开场门控（B3）：必须在覆盖层之前**同步**执行，否则会先闪一下再隐藏 =====
      不播的四种情形（#6 + 站主 Q3）：reduced-motion / 无 JS / 本会话已播 / ≤767px。
      方向是 fail-safe：默认不显示，只有判定"该播"才挂 .boot-on（锁滚动也挂在这个类上）。
      `.js` 这个字面量有断言守着（tests/b2-motion.test.ts「门控脚本只落首页」），别改。 */}
  <script is:inline>
    document.documentElement.classList.add('js');
    try {
      var play =
        !matchMedia('(prefers-reduced-motion: reduce)').matches &&
        innerWidth >= 768 &&
        !sessionStorage.getItem('boot-intro');
      if (play) document.documentElement.classList.add('boot-on');
      sessionStorage.setItem('boot-intro', '1'); /* 进入播放即记：刷新不重播（#6）；skip 也不重播（#16） */
    } catch (e) {
      /* 无痕 / 禁用 storage：退化成"可能重播一次"，不影响可用性 */
    }
  </script>

  {/* 开场覆盖层（装饰 + skip 按钮）。只落首页；JS 与门控见 BootIntro.astro */}
  <BootIntro />

  {/* ===== 背景装饰层（B2）：四样全是装饰，不承载任何信息 =====
      堆叠计划：0 装饰 < 1 正文 .tier < 2 扫描带 < 3 刻度尺 < 4 HUD < 5 OS 状态条
      （装饰层是 position:fixed，若正文不给 z-index，定位元素会画在静态正文之上 —— 水印会盖到字上。） */}
  {/* 莱茵标志（＋∞−）：一处定义。注意外层**不要**再写 viewBox —— 符号自带，
      外层再写会双重映射并把上下裁掉（原型里踩过）。 */}
  <svg class="svg-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <symbol id="rhine-logo" viewBox="0 6 24 12">
      <g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4c2 2.67 4 4 6 4a4 4 0 0 0 2.83-6.83M19.04 8.14a4 4 0 0 0-1.04-.14c-2 0-4 1.33-6 4" />
        <path d="M4.7 12h2.6M6 10.7v2.6" stroke-width="1.8" />
        <path d="M16.7 12h2.6" stroke-width="1.8" />
      </g>
    </symbol>
  </svg>

  {/* ===== 首屏 · 深墨绿场（原型 v10.6 最终版）=====
      站主 2026-09-30 拍板「统一换成视觉原型」，并明确「去掉外壳，换成原型 topbar」。
      所以下面这一整块取代了原先的 console 外壳（左刻度尺 / 顶 HUD / 中扫描带 / 底 OS 状态条）——
      那四样**全部移除**，不保留、不叠在首屏上。

      ⚠️ 命名：原型里这个容器叫 `.band`，但本站 `.band` 已经是「中扫描带」那条 1px 线的名字。
      同名会撞车，所以这里叫 **.hero**，扫描带那套连人带 CSS 一起删掉，不留歧义。

      层次（从后往前）：深墨绿渐变场 → 流场线 → DNA canvas → 三块玻璃卡 → topbar/文案。
      DNA 必须在**底色之上、文案之下**（原型 v6 踩过：放到底色下面会被闷成灰线）。 */}
  <header class="hero" id="s1">
    {/* 流场线：原型移植自 wodniack.dev，几十条平行竖线被 Perlin 噪声持续推动 + 鼠标扰动。
        SVG 由 JS 建（见下面的脚本），这里是空容器。纯装饰 ⇒ aria-hidden，且 pointer-events:none。 */}
    <div class="rh-grid" id="rhGrid" aria-hidden="true">
      <svg class="rh-grid__svg" id="rhGridSvg" xmlns="http://www.w3.org/2000/svg"></svg>
    </div>

    {/* 真 3D DNA：three.js 把 canvas 注入这里。模型 dna-slim.glb 走 public/。
        空容器 ⇒ 没 WebGL / 加载失败时首屏只是没有模型，其余照常。 */}
    <div class="dna-stack" id="dnaStack" aria-hidden="true"></div>

    {/* 三块玻璃卡：原型是纯装饰的「舱窗」，错落在首屏里制造前后关系。 */}
    <div class="hero-glass g1" aria-hidden="true"></div>
    <div class="hero-glass g2" aria-hidden="true"></div>
    <div class="hero-glass g3" aria-hidden="true"></div>

    <div class="hero-inner">
      <div class="topbar">
        <div class="wordmark">
          {site.wordmark}
          <small>RHINE GLASS · v10.6</small>
        </div>
        <nav aria-label="主导航">
          {NAV_LINKS.map((l) => (
            <a href={l.href} aria-current={l.key === 'index' ? 'page' : undefined}>{l.label}</a>
          ))}
          <a href="/rss.xml">RSS</a>
        </nav>
        {/* 移动端抽屉：原型 topbar 在窄屏收起导航，这里复用站点原有的抽屉组件，
            保证 ≤1023px 仍有完整导航入口。 */}
        <NavDrawer current="index" />
      </div>

      {/* 首屏 ∞ 落款：官方描边 logo（左环＋、右环−、左环外侧白点）。
          原型 v10.1 定案：**不靠写死的 top/vw 定位**（vw/vh 会随视口缩放把 logo 推出画面），
          改成走正常文档流 —— 放在 topbar 之后、文案之前，天然落在 wordmark 下方。
          常驻动效是「小幅摆动」，不转整圈（站主 v10 轮选的）。 */}
      <div class="hero-logo" aria-hidden="true">
        <div class="lg-box">
          <div class="lg-glow"></div>
          <div class="lg-base"></div>
        </div>
      </div>

      {/* 身份：POD 01。内容与旧首页 s1 完全一致（wordmark / intro / 坐标行），
          一个字没动 —— 站主要的是换视觉，不是换内容。 */}
      <div class="hero-copy">
        <p class="eyebrow"><i></i>POD 01 · 身份 · {site.status}</p>
        <h1 class="display" tabindex="-1">{site.wordmark}</h1>
        <p class="lede">{site.intro}</p>
        {hasCoord && (
          <p class="coord">
            <span>SITE {site.name}</span>
            <span>LAT {site.lat}</span>
            <span>LON {site.lon}</span>
            <span>STATUS {site.status}</span>
          </p>
        )}
      </div>
    </div>

    <div class="scroll-hint" aria-hidden="true"><s></s>SCROLL</div>
  </header>

  {/* ===== 晨昏带（原型 v4）：深墨绿 → 暖灰绿 → 灰白 → 纸白，40vh =====
      它解决的是「深场与纸白之间那道硬缝」。站主 v5 轮要求末段渐隐到 transparent，
      这样背景能从缝里透上来，不会出现一条生硬的边界线。 */}
  <div class="dusk" aria-hidden="true"></div>

  {/* ===== 纸白正文区（原型 .paper-wrap）=====
      百褶 ∞ 底纹挂在这里（position:fixed 挂视口 ⇒ 滚动时始终居中，站主 v9.1 定的）。
      站主 v10.6 指定用**原始素材** inf-orig.webp（墨迹自带右偏 189.5px），不做任何居中补偿。 */}
  <div class="paper-wrap">
    <div class="paper-inf" aria-hidden="true"></div>

  {/* 身份区段已上移进首屏 .hero（POD 01），这里不再重复渲染 s1。 */}

  <section class="tier" id="s2">
    {/* 标题改成原型的 .section-head 语序（h2 在前、编号在后），
        站点旧版是「编号在前」—— 站主要统一换成原型视觉，这里跟着换。 */}
    <div class="section-head"><h2>最近写的</h2><span>SECTOR 02</span></div>
    <ul class="index">
      {recentPosts.map((p) => (
        <li class="field-item" data-label={`文章 · ${p.title}`}>
          {/* .bracket：L 形角标（左下 + 右上对角）。它是聚焦的主要载体 —— 透明度只是辅助。 */}
          <div class="bracket">
            <a href={p.url}>
              <span class="date"><time datetime={p.date}>{p.date}</time></span>
              <span class="title">{p.title}</span>
              <span class="tags">{p.tags.join(' / ')}</span>
            </a>
          </div>
        </li>
      ))}
    </ul>
  </section>

  {/* 2026-09-30 站主要求：「相册不放主页了」—— 这一段整块移除。
       相册页 /gallery 本身没动（导航里还能进），只是不再占首页一个区段。
       随之重编号：原 s4 项目 → s3，原 s5 找到我 → s4。 */}
  <section class="tier" id="s3">
    <div class="section-head"><h2>项目</h2><span>SECTOR 03</span></div>
    <div class="field-item" data-label="项目 · 空态">
      <p class="empty">哎呀，目前还没有项目呢 &lt;3 —— 写了几个，但都还躺在本地，等它们能跑起来再挂到这儿。</p>
    </div>
  </section>

  <section class="tier" id="s4">
    <div class="section-head"><h2>找到我</h2><span>SECTOR 04</span></div>
    <div class="field-item" data-label="联系 · 找到我">
      <ul class="links">
        <li><a href={site.github}>GitHub</a></li>
        <li><a href="/rss.xml">RSS</a></li>
        <li><a href={`mailto:${site.email}`}>邮箱</a></li>
      </ul>
    </div>
  </section>

    {/* 页脚统计（站主 2026-09-26："在每页最底部加上图一上的功能"）。
        首页是 console 外壳、**不渲染 SiteFooter** ⇒ 这里单独放一份，用浅色 tone。
        旧版要给它留底部间距避开固定 OS 状态条 —— 那条已经随外壳一起删了，所以间距也去掉。 */}
    <div class="home-stats">
      <SiteStats since={site.since} tone="paper" />
    </div>
  </div>
  {/* ← 闭合 .paper-wrap（纸白正文区到此结束） */}

  {/* ===== 动效层（B2）：揭示 + 聚焦 =====
       站主 2026-09-30 拍板去掉 console 外壳 ⇒ 刻度尺填充、HUD 读数、扫描带 tick
       这三段**连同 DOM 一起删除**（不是留着不显示）—— 否则就是死代码。
       保留的两段：① 入场揭示（.field-item 首次进视口）② 聚焦弱化（滚过中线的条目）。
       规矩不变：只读 DOM + 写 class/style，不动布局；reduced-motion 下不补间、不位移。 */}
  <script>
    (() => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = Array.from(document.querySelectorAll('.field-item'));
      // 刻度尺 / HUD / 扫描带的引用已随外壳一起删除（2026-09-30），
      // 不留 `document.getElementById(...)` 的空引用 —— 元素是 null，读属性就是死代码。

      /* 1) 入场揭示：每个条目第一次进入视口时显形，只播一次。
            揭示的载体是 transform（不是 opacity）—— 基准 opacity 恒为 --focus-min，
            所以最坏情况只是「没动画」，绝不会「内容永久不可见」。 */
      if ('IntersectionObserver' in window) {
        const reveal = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('is-revealed');
            reveal.unobserve(e.target);
          }
        }, { rootMargin: '0px 0px -12% 0px', threshold: 0.01 });
        items.forEach((el, i) => {
          // 同屏一起揭示的条目做 90ms 错位（spec §1.1：层间错位 80–120ms）
          if (!reduce) el.style.transitionDelay = (i % 3) * 90 + 'ms';
          reveal.observe(el);
        });
      } else {
        items.forEach((el) => el.classList.add('is-revealed'));
      }

      /* 2) 聚焦：扫描带是**一条线**（视口中线），焦点 = 中线真正压住的那一个条目。
            旧实现把「中部 25vh」当成带，条目够矮时一屏能塞进两三个 ⇒ 谁赢由
            IntersectionObserver 的回调顺序决定 ⇒ 绿线压着上一篇、读数却显示下一篇
            （站主 2026-09-28 报的就是这个，实测 73 个滚动位置里 26 个不一致）。
            现在只看中线：压住谁就报谁；区段之间的留白谁也没压住 ⇒ 报「—」（站主 2026-09-28 定）。
            条目互不重叠，中线最多压住一个，所以找到即收工，不需要再排序。
            选人挂在下面 4) 的 rAF 里 —— 每帧至多算一次，不额外加滚动监听器。 */
      let current = null;
      const setFocus = (el) => {
        if (el === current) return;
        items.forEach((i) => i.classList.toggle('is-focused', i === el));
        current = el;
      };
      const pickFocus = () => {
        const cy = innerHeight / 2;
        for (const el of items) {
          const r = el.getBoundingClientRect();
          if (r.top <= cy && r.bottom >= cy) return setFocus(el);
        }
        setFocus(null);
      };

      /* 3) 穿字让位：中线 ±12px 内的文字朝纸退一档，中线离开后回位。
            原第 3 段「刻度填充 + HUD 读数」已随外壳删除（2026-09-30）——
            它读写的 #railFill / #hudPct / #hudSec 三个节点都不存在了。
            选择器按本页真实类名重列：旧 .tier-head 已改名为原型 .section-head，
            旧 .pod-tag（s1 身份舱）随身份上移进首屏而不复存在，一并摘掉。 */
      const yieldEls = Array.from(document.querySelectorAll(
        '.display,.lede,.coord span,.index .date,.index .title,.index .tags,.section-head h2,.section-head span,.empty,.links a'
      ));
      let yieldQueued = false;
      const updateYield = () => {
        yieldQueued = false;
        pickFocus(); // 焦点与让位同帧结算：读数、透明度、字色三者永远对着同一条中线
        const cy = innerHeight / 2, half = 12;
        for (const el of yieldEls) {
          const r = el.getBoundingClientRect();
          if (!r.height) continue;
          const hit = r.bottom >= cy - half && r.top <= cy + half;
          if (hit !== el.classList.contains('is-yielding')) el.classList.toggle('is-yielding', hit);
        }
      };
      const queueYield = () => {
        if (yieldQueued) return;
        yieldQueued = true;
        requestAnimationFrame(updateYield);
      };

      /* 4) 点击绿色闪烁：pointerdown（捕获阶段）命中 a/button → .is-flash 180ms */
      document.addEventListener('pointerdown', (e) => {
        const t = e.target && e.target.closest ? e.target.closest('a,button') : null;
        if (!t) return;
        t.classList.add('is-flash');
        setTimeout(() => t.classList.remove('is-flash'), 180);
      }, true);

      /* 滚动只驱动「穿字让位」一件事了（刻度与读数的监听随外壳一起删掉）。
         首帧也跑一次：直接刷新在中段时，让位状态立刻是对的。 */
      addEventListener('scroll', queueYield, { passive: true });
      addEventListener('resize', queueYield);
      updateYield();
    })();
  </script>

  {/* ===== 真 3D DNA（站主 2026-09-30 拍板：「用 three.js，接受破例」）=====
       这是全站唯一一处打破「无第三方库」原则的地方，理由与代价都写死在
       src/scripts/dna3d.ts 的头部注释里（含 v10.3 那个「先缩放再平移」的根本坑）。

       为什么走外部 module chunk 而不是内联：
         首页内联 JS 有 7168 B 的预算守护（tests/build-output.test.ts），three 装不进去；
         而那条测试只数**内联**字节，Astro 把这个 <script> 打成 /_astro/*.js 就不计入。
       three 本体再往下拆一层动态 import —— 只有真要画的时候才下载那 690 KB。 */}
  <script>
    import '../scripts/dna3d';
    import '../scripts/rhgrid';
  </script>
</Base>

<style>
  /* ============================================================
     首页视觉 = 原型 v10.6 最终版（站主 2026-09-30 拍板「统一换成视觉原型」）
     ------------------------------------------------------------
     已删除的旧件（连同 DOM 一起删，不是留着隐藏）：
       .bg-mark / .bg-cassette / .bg-ring / .bg-orbit / .bg-green  旧纸白装饰层
       .rail 左刻度尺 · .hud 顶 HUD · .band 中扫描带 · .os-rail 底 OS 条
     新增：
       .hero 首屏深墨绿场（含 .rh-grid 流场 / .dna-stack / .hero-glass×3 / .topbar / .hero-logo）
       .dusk 晨昏带 · .paper-wrap + .paper-inf 纸白正文区与百褶∞底纹
     ============================================================ */

  /* 符号定义块：不占位、不显示，只提供 #rhine-logo 给 <use> */
  .svg-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* ===== 首屏 · 深墨绿场（原型 v10.6 .band，本站改名 .hero 避开「中扫描带」同名）=====
     站主 2026-09-30 拍板去掉 console 外壳 ⇒ 左刻度尺 / 顶 HUD / 中扫描带 / 底 OS 条
     这四套的 CSS 与 DOM **一并删除**，不留空壳。

     ⚠️ 与原型唯一的结构差异：原型用 vw/vh 定位 logo，本站走**正常文档流**
     （原型 v10.1 就是被 vw/vh 坑过：窗口一宽 logo 就被推出画面）。 */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh; /* 手机浏览器地址栏收放时不跳 */
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* 深墨绿场：从最深的 dusk-1 到抬升的 dusk-3，左下再压一层暗角 */
    background:
      radial-gradient(120% 90% at 18% 8%, var(--dusk-3) 0%, transparent 62%),
      linear-gradient(168deg, var(--dusk-1) 0%, var(--dusk-2) 58%, var(--dusk-3) 100%);
    color: var(--on-band);
    isolation: isolate; /* 给子层的 z-index 一个确定的基准，避免叠到正文上 */
  }
  /* 场内细网格：让深场不是一块死色，滚动/鼠标也不会动它（原型是视差驱动，本站先静态） */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.5;
    background-image:
      linear-gradient(90deg, #ffffff0a 1px, transparent 1px),
      linear-gradient(0deg, #ffffff0a 1px, transparent 1px);
    background-size: 64px 64px;
  }
  /* 流场线（原型移植自 wodniack.dev）：几十条平行竖线被噪声持续推动。
     SVG 由 JS 建，这里只给容器 —— pointer-events:none 让鼠标事件走 window。 */
  .rh-grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none; /* 事件走 window，铺满首屏时「离开组件」无意义 */
    opacity: 0.22;
    /* 径向蒙版：中心实、四周淡 —— 不跟右下玻璃卡和标题抢注意力（原型原样） */
    mask-image: radial-gradient(ellipse 74% 64% at 56% 46%, #000 14%, transparent 84%);
    -webkit-mask-image: radial-gradient(ellipse 74% 64% at 56% 46%, #000 14%, transparent 84%);
  }
  .rh-grid__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    display: block;
    pointer-events: none;
  }
  /* ★ 同理必须 :global()：这些 <path> 是 rhgrid.ts 运行时 createElementNS 造的，没有 cid 属性。
     实测：不带 :global() 时 computed 是 **stroke:none / fill:rgb(0,0,0)** ——
     线一根都没画出来，反而变成一堆黑色实心多边形糊在首屏上（站主「蛛网还在不在」看到的就是它）。
     SVG path 的 fill 默认值是 black，所以「忘了设 fill:none」在 SVG 里是致命的。 */
  .rh-grid :global(path) {
    fill: none; /* ★ SVG path 默认 fill:black —— 不写就是一坨黑 */
    stroke: var(--on-band-sub); /* 首屏是深墨绿场 → 流场线走浅色描边 */
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
    opacity: 0.62; /* 肌理要压得住：玻璃卡上不能浮出来 */
  }
  /* 真 3D DNA：three.js 注入 canvas 到这里。
     ⚠️ 必须 z-index 1（在深场底色之上、文案之下）—— 原型 v6 踩过：
     放到底色下面会被闷成灰线，对比度只剩 +33.8。 */
  /* ★ 2026-09-30 修正：这一块的数值必须照抄原型，**一个都不能自己另定**。
     站主反馈「DNA 怎么竖着了」—— 第一反应是 three.js 倾角错了，但实测否决了：
       原型 canvas 内倾角 25.55° / 本站 25.57° —— **3D 那层分毫不差**，容器 rotate(24deg) 也一致。
     真因在**容器形状**：原型是 354×1260 的**极窄竖条**，我写成了 520×702 的**矮胖块**。
     倾角相同，但细长体上的倾泻感 vs 矮胖体上的墩实感，观感天差地别；
     再加上 aspect 变小 → three 的 cam.aspect 由 0.281 涨到 0.741 → 模型屏幕体量只剩 44%
     （实测亮像素 65925 → 29124）。所以「竖着」其实是「变小变墩了」。
     另外还丢了三样：translate(0,-50%)、opacity:.80、径向融场蒙版。一并补齐。 */
  .dna-stack {
    position: absolute;
    /* 照 slide1：DNA 只从右侧斜插进来当配角，不占中景 */
    right: -6vw;
    top: 54%;
    /* ★ width 必须**显式算出来**，不能只靠 aspect-ratio 推 —— 这里是真踩过的坑：
       .dna-stack 是 absolute + width:auto ⇒ 走 shrink-to-fit，而子 canvas 又是 width:100%
       ⇒ 「容器宽 ← canvas 宽 ← 容器宽」的循环依赖，配上 aspect-ratio 会收敛到哪个不动点，
       取决于父容器有多宽：原型 .band 是 1440px 全宽 → 收敛到正确的 354px；
       本站 .hero 是 1216px → **发散到 3455px**（实测），模型被放大近 10 倍糊满屏。
       所以这里直接 calc 出确定宽度，把循环从根上掐断。aspect-ratio 只留作文档。 */
    width: calc(min(140vh, 1520px) * 900 / 3200); /* = 1260 × 0.28125 = 354.375px */
    height: min(140vh, 1520px); /* 原型原值：比视口还高，就是要"斜插出画" */
    aspect-ratio: 900 / 3200;   /* 文档用（真实推导见上面的 width）；别依赖它算尺寸 */
    transform: translate(0, -50%) rotate(24deg); /* -50% 让容器**中心**落在 54%，不是顶边 */
    z-index: 1;
    opacity: 0.8; /* 压一档，让它退到背景里当配角 */
    /* 两端融进深场；左缘额外淡出，避免与标题抢 */
    mask-image: radial-gradient(ellipse 62% 84% at 50% 50%, #000 52%, transparent 98%);
    -webkit-mask-image: radial-gradient(ellipse 62% 84% at 50% 50%, #000 52%, transparent 98%);
    pointer-events: none;
  }
  /* ★★ :global() 是必须的，不是可选写法 ★★
     three.js 的 canvas 是**运行时 JS 注入**的，Astro 编译期加的 data-astro-cid 属性它拿不到。
     scoped 样式产物会写成 `.dna-stack[...cid] canvas[...cid]` —— 后半的属性匹配不上 ⇒
     整条规则静默失效。实测后果：canvas 没拿到 width/height:100%，改用自己 3455px 的
     像素缓冲当 CSS 尺寸，反过来把 shrink-to-fit 的容器撑到 3455px（模型糊满屏）。
     写 `:global(canvas)` 产出 `.dna-stack[...cid] canvas`（后半不带属性）就对了。
     原型没这个坑，因为它是单文件 <style>，压根没有作用域属性。 */
  .dna-stack :global(canvas) {
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 900ms var(--ease-glass);
  }
  /* 模型就绪才淡入 —— 避免先闪一下白底再出模型 */
  .dna-stack :global(canvas.is-ready) {
    opacity: 1;
  }
  /* 三块玻璃卡：纯装饰的「舱窗」，错落制造前后关系（原型 .band-glass） */
  .hero-glass {
    position: absolute;
    z-index: 1;
    pointer-events: none;
    border-radius: 14px;
    border: 1px solid var(--dglass-line);
    background: linear-gradient(160deg, #ffffff14, #ffffff05);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.1);
    backdrop-filter: blur(var(--glass-blur)) saturate(1.1);
  }
  .hero-glass.g1 { top: 11%; right: 6%; width: min(22vw, 240px); height: min(30vh, 220px); }
  .hero-glass.g2 { top: 47%; right: 26%; width: min(15vw, 164px); height: min(20vh, 140px); opacity: 0.72; }
  .hero-glass.g3 { top: 15%; right: 30%; width: min(10vw, 110px); height: min(13vh, 92px); opacity: 0.5; }
  /* 首屏文案层：必须压在流场 / DNA / 玻璃卡之上 */
  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--wrap);
    margin: 0 auto;
    padding: var(--gutter);
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  /* 原型 topbar：wordmark + 导航（取代被删掉的顶 HUD） */
  .topbar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .topbar .wordmark {
    font-family: var(--font-display, inherit);
    font-size: var(--fs-sm);
    letter-spacing: 0.12em;
    color: var(--on-band);
  }
  .topbar .wordmark small {
    display: block;
    margin-top: 0.25em;
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    color: var(--on-band-meta);
  }
  .topbar nav {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    font-size: var(--fs-xs);
    /* ★ nav 自己也要允许换行：父层 .topbar 的 flex-wrap 只管 wordmark 与 nav 之间，
       nav 内部 9 个链接在 768/390 下会一起冲出右边界，而这层没有换行规则。 */
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .topbar nav a {
    color: var(--on-band-sub);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: color var(--dur-hover) var(--ease-glass),
                border-color var(--dur-hover) var(--ease-glass);
  }
  .topbar nav a:hover,
  .topbar nav a:focus-visible,
  .topbar nav a[aria-current='page'] {
    color: var(--on-band);
    border-bottom-color: var(--accent-bright);
  }
  @media (max-width: 767px) {
    .topbar nav {
      /* 手机上导航一行放不下，允许换行；wordmark 与导航各占一行 */
      width: 100%;
      gap: var(--sp-3);
      justify-content: flex-start;
    }
  }
  /* 首屏 ∞ 落款：官方描边 logo。position:static + 文档流，零魔法数字。 */
  .hero-logo {
    margin: 0.9rem 0 0;
    align-self: flex-start; /* 靠左，不拉伸 */
    position: relative;
    z-index: 0;
    pointer-events: none;
  }
  /* ★ 摆动挂在 **.lg-box** 上（不是外层 .hero-logo），且 transform-origin 居中。
     2026-09-30 修正：上一版我把它挂在外层、幅度也私自砍到 ±1.6deg/9s，
     站主原话是「还不是让你做了那个 logo 的晃动吗」—— 原型定值 **±4.2deg / translateY(-7px) / 7.5s**，
     照抄，不再自作主张缩放。 */
  .hero-logo .lg-box {
    position: relative;
    width: clamp(150px, 15vw, 208px);
    aspect-ratio: 722 / 570; /* ★= 素材本体尺寸（inf-mask.png 722×570），不能沿用旧 webp 的 1200/564 */
    transform-origin: 50% 50%;
    opacity: 0.92;
    animation: logo-sway 7.5s ease-in-out infinite;
  }
  /* 小幅摆动而非整圈自转：字必须永远可读（站主 v10 轮选的「不转整圈，只小幅摆动」） */
  @keyframes logo-sway {
    0%, 100% { transform: rotate(-4.2deg); }
    50%      { transform: rotate(4.2deg) translateY(-7px); }
  }
  /* ★ 2026-09-30 修正：换成原型最终定的** mask luminance 方案**。
     上一版我沿用的是 v9 那张早已废弃的 webp 抠图（inf-logo.webp，是还没有 mask 方案时的中间产物），
     aspect-ratio 也跟着用了它的 1200/564 —— 等于把中间过程品当成了定稿。
     素材必须是**黑底白图的不透明 PNG**：透明图 + 灰 alpha 会被按**亮度**解读 → 糊成灰白方块。
     所以必须显式写 mask-mode: luminance。 */
  .hero-logo .lg-base {
    position: absolute;
    inset: 0;
    /* ★ 用原型最终定色（站主 2026-09-30 要求沿用），不换成语义相邻的 --on-band-sub。
       这两个色值是品牌标识的一部分：差一点点灰/绿，跟原型摆在一起一眼就能看出来。 */
    background: var(--logo-ink); /* 原型原值 #e9efe9 */
    -webkit-mask: url('/art/inf-mask.png') center / contain no-repeat;
            mask: url('/art/inf-mask.png') center / contain no-repeat;
    -webkit-mask-mode: luminance;
            mask-mode: luminance;
  }
  /* 静态轮廓光：不旋转，只让描边带一层极淡的绿，避免纯白死板。
     ★ 原型 v10.1 已删掉原来会转的 .lg-run（conic-gradient 旋转盘）—— 站主要求去掉，这里没有。 */
  .hero-logo .lg-glow {
    position: absolute;
    inset: 0;
    /* 同上：原型最终定色 #8fe0b0（站主要求沿用），不换 --accent-bright。
       opacity .18 —— 只让描边透出一点薄荷绿，避免纯白死板；光层本身不旋转。 */
    background: var(--logo-glow);
    opacity: 0.18;
    -webkit-mask: url('/art/inf-mask-edge.png') center / contain no-repeat;
            mask: url('/art/inf-mask-edge.png') center / contain no-repeat;
    -webkit-mask-mode: luminance;
            mask-mode: luminance;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-logo .lg-box { animation: none; }
  }
  /* 身份文案（POD 01）：内容与旧首页 s1 完全一致，只是搬进深场 */
  .hero-copy {
    margin: auto 0 0;
    padding-bottom: var(--sp-7);
    max-width: 46rem;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6em;
    margin: 0 0 var(--sp-3);
    font-size: var(--fs-xs);
    letter-spacing: 0.18em;
    color: var(--on-band-meta);
  }
  .eyebrow i {
    width: 1.6rem;
    height: 1px;
    background: var(--accent-bright);
  }
  .hero-copy .display {
    margin: 0;
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    color: var(--on-band);
  }
  .hero-copy .lede {
    margin: var(--sp-4) 0 0;
    max-width: 40rem;
    font-size: var(--fs-lede, var(--fs-body));
    line-height: var(--lh-body);
    color: var(--on-band-sub);
  }
  .hero-copy .coord {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin: var(--sp-5) 0 0;
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    color: var(--on-band-meta);
  }
  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 1.2rem;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-xs);
    letter-spacing: 0.24em;
    color: var(--on-band-meta);
  }
  .scroll-hint s {
    display: block;
    width: 1px;
    height: 2.4rem;
    background: linear-gradient(180deg, transparent, var(--on-band-meta));
    text-decoration: none;
  }
  @media (max-width: 767px) {
    .dna-stack { display: none; }      /* 手机上 3D 太重且挤，直接不渲染 */
    .hero-glass.g2, .hero-glass.g3 { display: none; }
    .scroll-hint { display: none; }
  }

  /* ===== 晨昏带：深墨绿 → 暖灰绿 → 灰白 → 纸白 =====
     原型 v5 修订：末段必须落到 transparent（不是 --paper），
     否则正文区的背景层会被这条硬边一刀切断（站主当时指出过）。 */
  .dusk {
    position: relative;
    height: min(46vh, 400px);
    background: linear-gradient(
      180deg,
      var(--dusk-4) 0%,
      var(--dusk-5) 30%,
      var(--dusk-6) 58%,
      rgba(236, 235, 228, 0.72) 78%,
      rgba(250, 250, 247, 0.28) 92%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 74%, rgba(0, 0, 0, 0.55) 90%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0%, #000 74%, rgba(0, 0, 0, 0.55) 90%, transparent 100%);
  }
  /* 晨昏带里叠一层细网格，让过渡本身有信息量，不是纯色块 */
  .dusk::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.5;
    background-image:
      linear-gradient(90deg, #ffffff14 1px, transparent 1px),
      linear-gradient(0deg, #ffffff14 1px, transparent 1px);
    background-size: 72px 72px;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 72%);
    mask-image: linear-gradient(180deg, #000 0%, transparent 72%);
  }

  /* ===== 纸白正文区 ===== */
  .paper-wrap {
    position: relative;
    padding: var(--sp-8) 0 var(--sp-8);
  }
  /* 百褶 ∞ 底纹（站主原图）。position:fixed 挂视口 ⇒ 滚动时始终居中（原型 v9.1 定案）。
     ★ 站主 v10.6 指定：用**原始素材** inf-orig.webp（墨迹自带右偏 189.5px），
       不做任何居中补偿 —— 他要的就是原图本来的样子。 */
  .paper-inf {
    position: fixed;
    left: 50%;
    top: 50%;
    width: min(128vw, 1600px);
    aspect-ratio: 1572 / 878;
    transform: translate(-50%, -50%);
    background: url('/art/inf-orig.webp') center / contain no-repeat;
    opacity: 0.2;
    pointer-events: none;
    z-index: -1;
  }
  /* 页脚统计（首页那份）：正文流最末。外壳（底 OS 条）已移除 ⇒ 不再需要为它留底部高度。 */
  .home-stats {
    margin: var(--sp-8) 0 0;
    padding: var(--sp-3) 0 0;
    border-top: 1px solid var(--hair);
    max-width: 60rem;
    font-variant-numeric: tabular-nums;
  }

  /* 版心：Base 的 .shell 已经把 main 排好。
     旧版这里留的 padding-left:3rem（给左刻度尺让位）与 padding-bottom:1.9rem（给底 OS 条让位）
     随外壳一并删除 —— 站主 v10.6 选的是「去掉外壳，换成原型 topbar」。 */
  main {
    padding: 0;
  }

  /* 正文层：必须显式抬到装饰层之上（理由见上面「堆叠计划」） */
  .tier {
    position: relative;
    z-index: 1;
    padding: var(--sp-8) 0;
  }
  /* ---- 区段标题：v10.6 玻璃条（2026-09-30 站主要求视觉换成 rhine v10.6 最终版）----
     原来是一条 1px 实心黑底线（--ink，很硬）。v10.6 改成：
       · 底线换 --glass-line（等同 --ink @ 8%）+ 下方一道极淡的绿洗
       · 标题整条做成玻璃薄片（backdrop-filter），滚到上面时有"透过去"的层次感
     为什么保留 <h2> 的字号字重不变：**内容与信息层级一个字没动**，只换观感 ——
     站主这次的原话是「视觉包括风格全换成今天的最终版」，不是重做信息架构。 */
  .section-head {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    margin-bottom: var(--sp-5);
    padding: var(--sp-3) var(--sp-4);
    /* 负外距让玻璃条的左缘与正文列对齐（padding 不会把标题推进去） */
    margin-left: calc(var(--sp-4) * -1);
    margin-right: calc(var(--sp-4) * -1);
    border-bottom: 1px solid var(--glass-line);
    border-radius: 10px 10px 0 0;
    background: linear-gradient(180deg, var(--glass-bg), transparent);
    /* ★ 顺序有讲究（2026-09-30 实测）：**前缀必须先写、标准属性后写**。
       esbuild 的 CSS 前缀降级遇到同块内「标准 + 前缀」两条时，
       若标准写在前面，它会把标准那条当作「已被前缀覆盖」删掉；
       反过来写（前缀在前）两条都会留下 —— 与 .band-cap / .band-readout 的既有写法一致。 */
    -webkit-backdrop-filter: blur(var(--glass-blur));
    backdrop-filter: blur(var(--glass-blur));
  }
  /* 编号（SECTOR 0x）：原型把它放在 h2 **之后**，字距拉开、色退到 --muted */
  .section-head span {
    font-size: var(--fs-xs);
    color: var(--muted);
    letter-spacing: 0.08em;
  }
  .section-head h2 {
    margin: 0;
    font-size: var(--fs-h2);
  }

  .display {
    margin: 0;
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    font-weight: 800;
  }
  .lede {
    max-width: 33em;
    margin: var(--sp-5) 0 0;
    font-size: var(--fs-lede);
  }
  .coord {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin: var(--sp-5) 0 0;
    font-size: var(--fs-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--glass-line);
  }
  .index li {
    border-bottom: 1px solid var(--hair);
  }
  /* ---- 文章条目：v10.6 玻璃浮起（原型的 .entry a 那套）----------------------
     v10.6 的观感关键**不是加了个背景**，而是三层叠在一起：
       ① 常态：透明，只有一条发丝分隔线
       ② 悬停：整块玻璃浮起（::before 那层 fade-in，不是给自己上 background）
       ③ 同时左移 6px + 日期变绿 + 标题下那条绿线横向长出来
     为什么用 ::before 而不是直接改 background：
       background 的 transition 在 transparent ↔ 半透明玻璃之间会经过"脏色"，
       而 opacity 是纯合成层，没有中间态。原型实测过这点，照搬。
     ★ 悬停位移只 6px（原型值）—— 位移大了在长列表里会晃，这是刻意的克制。 */
  .index a {
    display: block;
    position: relative;
    isolation: isolate;
    padding: var(--sp-5) var(--sp-4);
    margin: 0 calc(var(--sp-4) * -1);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--dur-hover) var(--ease-glass),
      box-shadow var(--dur-hover) var(--ease-glass);
  }
  .index a::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--glass-bg);
    /* ★ 前缀在前、标准在后（理由见 .section-head 处的注释） */
    -webkit-backdrop-filter: blur(var(--glass-blur-hot));
    backdrop-filter: blur(var(--glass-blur-hot));
    opacity: 0;
    transition: opacity var(--dur-hover) var(--ease-glass);
  }
  .index a:hover,
  .index a:focus-visible {
    transform: translateX(6px);
    box-shadow: var(--glass-shadow);
  }
  .index a:hover::before,
  .index a:focus-visible::before {
    opacity: 1;
  }
  .index .date {
    display: inline-block;
    font-size: var(--fs-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    transition: color var(--dur-hover) var(--ease-glass);
  }
  .index a:hover .date,
  .index a:focus-visible .date {
    color: var(--accent-ink);
  }
  .index .title {
    position: relative;
    display: block;
    margin: var(--sp-2) 0 var(--sp-2);
    font-size: var(--fs-item);
    line-height: var(--lh-item);
    letter-spacing: var(--ls-item);
    font-weight: 800;
    transition: transform var(--dur-hover) var(--ease-glass);
  }
  /* 标题下方那条绿线：scaleX(0→1)，从左侧长出来。
     transform 而不是 width —— 只走合成层，长列表里不触发 layout。 */
  .index .title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.18em;
    width: min(100%, 12em);
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-hover) var(--ease-glass);
  }
  .index a:hover .title::after,
  .index a:focus-visible .title::after {
    transform: scaleX(1);
  }
  .index .tags {
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  .frames {
    display: flex;
    gap: var(--sp-4);
    align-items: flex-start;
  }
  .f-main {
    flex: 1 1 auto;
  }
  .f-main :global(img) {
    width: 100%;
    height: auto;
  }
  .f-thumbs {
    flex: 0 0 31%;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }
  .f-thumbs :global(img) {
    width: 100%;
    /* 手机上 .f-thumbs 变行排（两缩略图并排）。flex 项的 min-width:auto 会取 width:100% 的
       内容最小尺寸（= 整个容器宽），两张就顶成 200% 宽 → 整页横向溢出（390px 视口实测
       scrollWidth 673）。显式 min-width:0 才让它们能平分这一行。 */
    min-width: 0;
    height: auto;
  }
  /* S3 的图现在是 /gallery 的链接（2026-09-26）→ 锚点成了新的 flex 项，
     上面那条 min-width:0 防的是 flex 项，所以必须跟着搬到锚点上；
     line-height:0 消掉 inline 锚点里 img 下方那条基线空隙，版面尺寸不变。 */
  .frames :global(a.frame) {
    display: block;
    min-width: 0;
    line-height: 0;
  }
  .frames :global(a.frame:focus-visible) {
    outline: 2px solid var(--accent-ink);
    outline-offset: 2px;
  }

  .empty {
    margin: 0;
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    color: var(--accent-ink);
  }

  @media (max-width: 767px) {
    .frames {
      flex-direction: column;
      gap: var(--sp-3);
    }
    .f-thumbs {
      flex-direction: row;
      width: 100%;
    }
  }

  /* ============================================================
     B2 动效层（2026-09-26 站主批准移植；清单与原型行号见 docs/b2-port-notes.md）
     四层：交互 120ms · 叙事 640ms · 循环 8/16s linear · 硬切 800ms steps(1)
     时长与曲线一律走 tokens.css，这里不写字面量。
     硬约束：只动 transform / opacity / color / background-color，**不动 layout**。
     ============================================================ */

  /* ---- 聚焦：JS 打开时才生效。带外条目不禁用，只是弱化；聚焦回到 1 ---- */
  html.js .field-item {
    opacity: var(--focus-min);
    transform: translateY(12px);
    transition: opacity var(--dur-enter) var(--ease), transform var(--dur-enter) var(--ease);
  }
  /* 揭示的真正载体是 transform —— 基准 opacity 恒为 --focus-min，
     所以最坏情况只是「没动画」，绝不会出现「内容永久不可见」 */
  html.js .field-item.is-revealed {
    transform: none;
  }
  html.js .field-item.is-focused {
    opacity: 1;
  }
  /* 聚焦时角标升级（原型：这才是聚焦的主要载体，透明度只是辅助） */
  html.js .field-item .bracket::before,
  html.js .field-item .bracket::after {
    border-color: var(--hair);
  }
  html.js .field-item.is-focused .bracket::before,
  html.js .field-item.is-focused .bracket::after {
    border-color: var(--ink);
  }

  /* L 形角标：左下 + 右上对角 */
  .bracket {
    position: relative;
    padding: 1rem;
  }
  .bracket::before,
  .bracket::after {
    content: '';
    position: absolute;
    width: 1.4rem;
    height: 1rem;
    border: 0 solid var(--hair);
    transition: border-color var(--dur-fast) var(--ease-interact);
  }
  .bracket::before {
    left: 0;
    bottom: 0;
    border-left-width: 1px;
    border-bottom-width: 1px;
  }
  .bracket::after {
    right: 0;
    top: 0;
    border-right-width: 1px;
    border-top-width: 1px;
  }

  /* ---- 交互层：悬停微亮 + 位移，按压缩一下（走 token，不写字面量） ----
     ★★ v10.6 冲突修正（2026-09-30）★★
     这一条原来把 .index a 也包进去了，并给了 --dur-fast(120ms) 的 transform 过渡。
     它**排在 v10.6 玻璃规则之后、特异性相同** ⇒ 后写的赢 ⇒ 把我 260ms 的玻璃浮起
     压成了 120ms，位移也从 translateX(6px) 变回 translateY(-2px)。
     （实测抓到的：computed transition 是 `0.12s background, transform, border-color, color`，
       而我写的那条根本没生效。）

     ⇒ 把 .index a 从这一条里**摘出去**，交回给上面 v10.6 的玻璃规则统一管。
        只剩 .links a 这个不参与玻璃的元件用 120ms 快反馈
        （它是小控件，"跟手"比"有重量感"重要，v10.6 的分层原则本来就是这样）。
        （外壳移除后 .rail-tick 已不存在，从这条里摘掉了。） */
  .links a {
    transition:
      background var(--dur-fast) var(--ease-interact),
      transform var(--dur-fast) var(--ease-interact),
      border-color var(--dur-fast) var(--ease-interact),
      color var(--dur-fast) var(--ease-interact);
  }
  /* .index a 的悬停位移与配色已由上面的 v10.6 玻璃规则接管，
     这里**刻意不再重复声明** —— 重复就会再次造成同样的覆盖问题。 */
  .index a:active,
  .links a:active {
    transform: scale(0.995);
  }
  /* 点击绿色闪烁（JS 加 180ms）—— 只改背景与描边，不动布局 */
  a.is-flash,
  button.is-flash {
    background: var(--accent-wash);
    outline: 1px solid var(--accent);
  }

  /* ---- 穿字让位：滚动中经过视口中央的文字朝纸退一档 ----
     原型用 color-mix 调色，这里改用 opacity（同样只动 paint，
     且不引入 color-mix 的兼容面；"退 18%" 的观感一致）。
     （旧版是让给「中扫描带」的 ±12px 窗口；扫描带随外壳移除后，
       这段改为给首屏下滑时压到中线的正文做让位，选择器按本页真实类名重列。） */
  .display.is-yielding,
  .section-head h2.is-yielding,
  .links a.is-yielding,
  .index .title.is-yielding {
    opacity: 0.82;
  }
  .lede.is-yielding,
  .coord span.is-yielding,
  .index .date.is-yielding,
  .index .tags.is-yielding,
  .empty.is-yielding,
  .section-head span.is-yielding {
    opacity: 0.82;
  }

  /* ---- 首屏入场：错位 rise-in（错位用 nth-child，与原型一致） ----
     原来挂在旧 s1 身份舱 .pod-s1 > * 上；身份已上移进 .hero，
     所以这里改挂 .hero-copy 的四个子元素（eyebrow / h1 / lede / coord）。 */
  @keyframes rise-in {
    from { opacity: 0; transform: translateY(10px) }
    to { opacity: 1; transform: none }
  }
  .hero-copy > * {
    animation: rise-in 800ms var(--ease) both;
  }
  .hero-copy > *:nth-child(1) { animation-delay: 200ms }
  .hero-copy > *:nth-child(2) { animation-delay: 290ms }
  .hero-copy > *:nth-child(3) { animation-delay: 380ms }
  .hero-copy > *:nth-child(4) { animation-delay: 470ms }

  @media (prefers-reduced-motion: reduce) {
    html.js .field-item {
      opacity: 1 !important;
      transform: none !important;
    }
    * {
      transition-duration: 1ms !important;
      animation: none !important;
    }
  }

  @media (max-width: 767px) {
    /* 小屏取消聚焦弱化与入场位移：带子在窄屏覆盖比例大，弱化反而看不懂（与原型一致） */
    html.js .field-item,
    html.js .field-item.is-revealed {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }


</style>
