  /* ====================== 技术栈 · 语言占比 ======================
     ★★ 必须给 reduced-motion 终态（见文件末尾）：条本体初值 scaleX(0)、
        图例与明细初值 opacity:0 —— 动画一旦被全局 `animation:none` 禁掉，
        它们就永久停在"还没开始播放" = 整块内容凭空消失。这是可用性问题。 */
  .langbar {
    margin-top: var(--sp-5);
    font-family: var(--mono);
  }
  .langbar-hd {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.55rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .langbar-hd b {
    color: var(--ink);
    font-weight: 600;
    letter-spacing: 0.1em;
  }
  .langbar-hd .of {
    color: var(--hair);
  }
  /* 条本体：高 12px 胶囊，段间 2px 缝（缝用背景色，不用 border —— 缩放时线宽不跳） */
  .langbar-track {
    display: flex;
    gap: 2px;
    height: 12px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--hair);
  }
  .langbar-track > i {
    display: block;
    height: 100%;
    /* 生长用 scaleX 而不是 width —— 只走合成层，不触发 layout */
    transform-origin: left center;
    transform: scaleX(0);
    animation: lang-grow 0.9s var(--ease) forwards;
    animation-delay: calc(var(--i, 0) * 90ms + 180ms);
  }
  @keyframes lang-grow {
    to { transform: scaleX(1); }
  }
  .langbar-legend {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(148px, 1fr));
    gap: 0.4rem 1.4rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }
  .langbar-legend li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    opacity: 0;
    animation: lang-fade 0.5s ease forwards;
    animation-delay: calc(var(--i, 0) * 90ms + 520ms);
  }
  @keyframes lang-fade {
    to { opacity: 1; }
  }
  /* 图例色块：方形（比圆点更贴本站工业感），**纯色** ——
