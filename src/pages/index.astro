  /* ====================== 滚动视差（原型 v6 新增③：纯 CSS scroll-driven）======================
     四层从慢到快制造纵深：网格 -9vh / 玻璃卡 -26,-18,-34vh / 标题 +6vh。
     ★ 用 CSS scroll-driven animations 而不是 JS scroll 监听：
         零 JS（首页内联预算只剩约 1.5 KB）、跑在合成器线程不掉帧。
     ★ 降级：@supports 判断，不支持的浏览器视差完全不生效但页面照常（渐进增强）。
     ★ DNA 不加 .par-slow —— 原型 DOM 上也没有（原型注释：视差已按站主要求移除）。 */
  @supports (animation-timeline: scroll()) {
    .par, .par-fast, .par-slow { will-change: transform; }

    .bg-grid.par {
      animation: par-grid linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 100vh;
    }
    @keyframes par-grid {
      to { transform: translate3d(0, -9vh, 0) scale(1.06); }
    }

    .band-glass.par-fast {
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root block);
      animation-range: 0 100vh;
    }
    .band-glass.g1.par-fast { animation-name: par-glass-1; }
    .band-glass.g2.par-fast { animation-name: par-glass-2; }
    .band-glass.g3.par-fast { animation-name: par-glass-3; }
    @keyframes par-glass-1 { to { transform: translate3d(0, -26vh, 0); } }
    @keyframes par-glass-2 { to { transform: translate3d(0, -18vh, 0); } }
    @keyframes par-glass-3 { to { transform: translate3d(0, -34vh, 0); } }

    /* 标题反向轻移（反视差）—— 只在首屏生效 */
    .band-copy.par {
      animation: par-copy linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 70vh;
    }
    @keyframes par-copy {
      to { transform: translate3d(0, 6vh, 0); opacity: 0.55; }
    }
  }

  /* ====================== 无障碍 / 降级 ====================== */
  @media (prefers-reduced-motion: reduce) {
    /* 滚动带：减弱动效时停止滚动（保留静态排版） */
    .marquee-row { animation: none !important; transform: none !important; }
    .bg-inf-logo .lg-box { animation: none !important; }
    /* ★ 视差必须显式关掉 —— 这是最容易漏的一处降级 */
    .par, .par-slow, .par-fast { animation-timeline: none !important; transform: none !important; }
    /* 语言占比条：动画一禁，scaleX(0)/opacity:0 的初值就是永久不可见 ⇒ 必须给终态 */
    .langbar-track > i { transform: scaleX(1) !important; }
    .langbar-legend li,
    .langbar-detail > div { opacity: 1 !important; }
    /* 背景肌理：停掉呼吸与位移，但保留静态网格与同心环（它们是肌理，不是动效） */
    .bg-grid, .bg-ring { animation: none !important; transform: none !important; }
    * {
      transition-duration: 1ms !important;
      animation: none !important;
    }
  }
  @media (hover: none) {
    .bg-ring, .band-glass, .band-grid { transform: none !important; }
  }
  @media (max-width: 767px) {
    .entry a { grid-template-columns: 1fr; gap: 0.4rem; }
    .entry .s { grid-column: 1; }
    .dna-stack { display: none; }        /* 手机上 3D 太重且挤 */
    .band-glass.g2, .band-glass.g3 { display: none; }
    .scroll-hint { display: none; }
  }
