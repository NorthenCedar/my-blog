        const blocks = document.querySelectorAll('.band-copy > :not(.display), .section-head, .entry, .card');
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en, i) => {
            if (!en.isIntersecting) return;
            const el = en.target;
            io.unobserve(el);
            const anim = el.animate(
              [{ opacity: 0, transform: 'translateY(16px)' }, { opacity: 1, transform: 'none' }],
              { duration: 820, delay: (i % 4) * 90, easing: 'cubic-bezier(.16,1,.3,1)', fill: 'both' }
            );
            const settle = () => { el.style.removeProperty('opacity'); anim.cancel(); };
