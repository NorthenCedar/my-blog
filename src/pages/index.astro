           放出来（正常路径下内联早已被 settle 摘掉，这里不会命中；动画还在跑的不碰，别打断入场）。 */
        addEventListener('pageshow', () => {
          blocks.forEach((b) => {
            if (b.style.opacity === '0' && !b.getAnimations().length) b.style.removeProperty('opacity');
          });
        });
      }
    })();
  </script>

