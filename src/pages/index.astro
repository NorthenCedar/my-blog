---
/**
 * 首页 = 视觉原型 nc-rhine-v7/index.html（v10.6 最终版）**逐段照抄**。
 *
 * ── 本轮的立场（站主 2026-09-30 原话：「直接换成原型，不要改本站的像原型」）──
 *   这个文件不以「本站旧首页」为源去逼近原型，而是**以原型文件为源**：
 *   结构、类名、CSS、JS 一律照抄原型，只在下面这几处做接驳 —— 因为它们是
 *   「原型里的占位」与「本站的真实数据」的接口，不换就上不了线：
 *     ① 导航      href="#" / "#s2"  → NAV_LINKS 的真实路由
 *     ② 文章      原型 3 条 demo    → content/posts 的真实文章（可点进正文）
 *     ③ 站名/自述 原型写死的文案     → content/site.md（主题不持有文案，有测试守着）
 *     ④ 素材路径  ./inf-mask.png 等 → 站内 /art/…（图片一律进仓库，零第三方请求）
 *     ⑤ 卡片内容  原型的迭代史      → content/pages/log.md（站主拍板）
 *     ⑥ 技术栈数字 原型那组手抄数   → 构建期实测（站主拍板：「根据现在的数据做」）
 *
 * ── 刻意不搬的原型件 ──────────────────────────────────────────
 *   · 右下角 .panel（PROTO CONTROL 调试面板）—— 原型注释自己写明「原型专用」
 *   · 页脚「运行 — 天 / PV — UV —」占位文本 —— 站上早接了真实计数（SiteStats）
 *   · @font-face —— 本站 fonts.css 已自托管同名字体，原型那份指向原型目录
 *   · <script type="importmap"> + 内联 three —— 本站走 src/scripts/dna3d.ts
 *     （懒加载 + 具名导出收口，657 KB → 542 KB，见 tests/build-output.test.ts）
 *
 * ── 保留的本站基础设施（与「换视觉」无关，删了是超范围的破坏）──
 *   · Base 外壳（head / meta / canonical / RSS / .pt 页面过渡 / 自托管字体）
 *   · BootIntro 开场动画（站主 2026-09-26 审定）
 *   · SiteStats 真实计数（替代原型页脚的占位文本）
 */
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import BootIntro from '../components/BootIntro.astro';
import NavDrawer from '../components/NavDrawer.astro';
import SiteStats from '../components/SiteStats.astro';
import { NAV_LINKS } from '../lib/nav';
import { getVisiblePosts } from '../lib/posts';
import { getSite } from '../lib/site';
import { isoDate, sortLogItems } from '../lib/log-order';
import { readLanguageStats } from '../lib/lang-stats';

const site = await getSite();
const posts = await getVisiblePosts();

// ── S3 的四张卡 ────────────────────────────────────────────────
// 原型这一屏写的是它自己的迭代史（「v4 改了什么」）；站主拍板换成**站点更新日志**。
// 排序与日期复用日志页那套（sortLogItems / isoDate），两处永远同序。
const HOME_LOG_LIMIT = 4;
const logEntry = await getEntry('pages', 'log');
const logData = (logEntry?.data ?? {}) as unknown as {
  items?: Parameters<typeof sortLogItems>[0];
};
const logItems = sortLogItems(logData.items ?? [])
  .filter((it) => (it.changes?.length ?? 0) > 0)
  .slice(0, HOME_LOG_LIMIT);

// ── 技术栈那条语言占比 ──────────────────────────────────────────
// 构建期实测（src/lib/lang-stats.ts）：不写死任何数字。
// 拿不到数据就返回空数组 ⇒ 整块不渲染，不显示一条全是 0 的假条。
const langSlices = readLanguageStats();

// 原型 S2 只露三篇。不覆盖 posts —— OS 状态条与导航还依赖全量列表。
const HOME_POST_LIMIT = 3;
const recentPosts = posts.slice(0, HOME_POST_LIMIT);

// 坐标行三个字段都可选：缺任何一个就整行不渲染，不渲染空值
const hasCoord = Boolean(site.lat && site.lon && site.status);

// 滚动带要用到的品牌词：从 wordmark 里取第一段（去掉空格与撇号之后的部分）。
// 不写死字面量 —— tests/content-invariants.test.ts 禁止站点文案出现在 src/ 里。
const brandWord = site.wordmark.split(/[\s']/)[0];

// 首屏主标题的逐字切分（开场揭幕时"一个字一个字滑上来"用）。
//   · 断行规则与原型一致：按**第一个空格**断（原型那里是硬 <br>）。
//   · 这里的 index 是**整串累计**的，不按行重置 ⇒ 两行连着一路滑上来。
//   · ★ 拆字后必须另给一份视觉隐藏的完整原文（视觉那半标 aria-hidden），
//     否则屏幕阅读器会把标题一个字母一个字母念出来。
const titleLines: { ch: string; i: number }[][] = (() => {
  const w = site.wordmark;
  const cut = w.indexOf(' ');
  const rows = cut > 0 ? [w.slice(0, cut), w.slice(cut + 1)] : [w];
  let acc = 0;
  return rows
    .filter((r) => r.length > 0)
    .map((row) => [...row].map((ch) => ({ ch, i: acc++ })));
})();
---

<Base description={site.metaDescription} current="index" chrome="console">
  {/* ===== 开场门控：必须在覆盖层之前**同步**执行，否则会先闪一下再隐藏 =====
       不播的两情形：reduced-motion / 无 JS / 本会话已播。
       ≤767px **照播**，但换成 1.5 s 的极简版（加 .boot-mini，由 CSS 压时间轴）。
       方向是 fail-safe：默认不显示，只有判定"该播"才挂 .boot-on。
       `.js` 这个字面量有断言守着（tests/b2-motion.test.ts「门控脚本只落首页」），别改。 */}
  <script is:inline>
    document.documentElement.classList.add('js');
    try {
      var play =
        !matchMedia('(prefers-reduced-motion: reduce)').matches &&
        !sessionStorage.getItem('boot-intro');
      if (play) {
        document.documentElement.classList.add('boot-on');
        if (innerWidth < 768) document.documentElement.classList.add('boot-mini');
      }
      sessionStorage.setItem('boot-intro', '1'); /* 进入播放即记：刷新不重播；skip 也不重播 */
    } catch (e) {
      /* 无痕 / 禁用 storage：退化成"可能重播一次"，不影响可用性 */
    }
  </script>

  <BootIntro />

  {/* ===== 背景层（原型 .bg）=====
       三层错速：底部绿雾 / 72px 呼吸网格（带 .par 滚动视差）/ 左下同心环。
       ★ 它们能被看见，靠的是 .paper-wrap 的底色是**半透明**的 —— 纯色会把这一层盖死。
       ★ 纯装饰 ⇒ aria-hidden + pointer-events:none。 */}
  <div class="bg" aria-hidden="true">
    <div class="bg-wash"></div>
    <div class="bg-grid par"></div>
    <div class="bg-ring"></div>
  </div>

  {/* ===== 首屏 · 深墨绿场（原型 .band）=====
       层次（从后往前）：深墨绿渐变场 → 明度爬升 → 场内网格 → 流场线 → DNA → 玻璃卡 → 文案。
       ★ DNA 必须在**底色之上、文案之下**（原型 v6.2 层叠修订：放到底色下面会被闷成灰线）。

       ⚠️ 本站唯一的结构加法：margin-inline: calc(50% - 50vw)。
          原型里 .band 是顶层元素直接吃满视口，收窄到 --wrap 的是它的内容层 .band-inner；
          本站多一层 Base 的全局 .shell（max-width + padding），会把**背景一起框窄**。
          不加这条，首屏就是"中间一块"而不是整屏（站主 2026-09-30 报过）。
          ★ 不写 width:100vw —— vw 含滚动条宽度 ⇒ 横向溢出。 */}
  <header class="band" id="s1">
    {/* 真 3D DNA：three.js 把 canvas 注入这里。模型 /dna-slim.glb 走 public/。
        空容器 ⇒ 没 WebGL / 加载失败时首屏只是没有模型，其余照常。 */}
    <div class="dna-stack" id="dnaStack" aria-hidden="true"></div>

    <div class="band-core" aria-hidden="true"></div>
    <div class="band-grid" aria-hidden="true"></div>

    {/* 弹性流场线（原型移植自 wodniack.dev <a-waves>）：
        几十条平行竖线被 Perlin 噪声推动 + 鼠标扰动。SVG 由 JS 建（src/scripts/rhgrid.ts）。 */}
    <div class="rh-grid" id="rhGrid" aria-hidden="true">
      <svg class="rh-grid__svg" id="rhGridSvg" xmlns="http://www.w3.org/2000/svg"></svg>
    </div>

    <div class="band-glass g1 par-fast" aria-hidden="true"></div>
    <div class="band-glass g2 par-fast" aria-hidden="true"></div>
    <div class="band-glass g3 par-fast" aria-hidden="true"></div>

    <div class="band-inner">
      <div class="topbar">
        <div class="wordmark">
          {site.wordmark}
          <small>RHINE GLASS · v10.6</small>
        </div>
        {/* 原型的 nav 是 flex-wrap 的胶囊按钮（横排）。
            ≤1023px 由站点抽屉接管（纯 CSS、零 JS）：原型靠 nav flex-wrap 换行，
            本站导航有 9 项，换行会占掉半屏，抽屉更干净 —— 这是本站在原型之上的一处加法。 */}
        <nav aria-label="主导航">
          {NAV_LINKS.map((l) => (
            <a href={l.href} aria-current={l.key === 'index' ? 'page' : undefined}>{l.label}</a>
          ))}
          <a href="/rss.xml">RSS</a>
        </nav>
        <NavDrawer current="index" />
      </div>

      {/* 首屏 ∞ 落款：官方描边 logo（左环＋、右环−）。
          原型 v10.1 定案：**不靠写死的 top/vw 定位**（vw/vh 会随视口把 logo 推出画面），
          改成走正常文档流 —— 放在 topbar 之后、文案之前，天然落在 wordmark 下方。 */}
      <div class="bg-inf-logo" aria-hidden="true">
        <div class="lg-box">
          <div class="lg-glow"></div>
          <div class="lg-base"></div>
        </div>
      </div>

      <div class="band-copy par">
        <p class="eyebrow"><i></i>POD 01 · 身份 · {site.status}</p>
        {/* ★ 原型这里是一条固定文案 + 硬 <br> 折行。本站 wordmark 是内容层字段，不能写死，
            所以按第一个空格断行 —— 与原型一致；若 wordmark 是一个词，照常单行渲染。
            ★ 2026-09-30：为了开场揭幕的"逐字上滑"，整串被拆成逐字 <span>（见 titleLines）。
              拆了字就必须**另给一份完整原文给屏幕阅读器**（.display-sr），视觉那半标 aria-hidden。
              .dch 是裸的 inline-block、不改行高 ⇒ 排版与拆字之前逐字节等宽等高（见样式表注释）。 */}
        <h1 class="display" tabindex="-1">
          <span class="display-sr">{site.wordmark}</span>
          {titleLines.map((row) => (
            <span class="dline" aria-hidden="true">
              {row.map((c) => (
                <span class="dch" style={`--i:${c.i}`}>{c.ch}</span>
              ))}
            </span>
          ))}
        </h1>
        <p class="lede">{site.intro}</p>
        {hasCoord && (
          <p class="coord">
            <span>SITE {site.name}</span>
            <span>LAT {site.lat}</span>
            <span>LON {site.lon}</span>
            <span>STATUS {site.status}</span>
          </p>
        )}
      </div>
    </div>

    <div class="scroll-hint" aria-hidden="true"><s></s>SCROLL</div>
  </header>

  {/* ===== 晨昏带（原型 v4）：深墨绿 → 暖灰绿 → 灰白 → 纸白 =====
       末段渐隐到 transparent（不是 --paper），否则背景层会被这条硬边一刀切断。 */}
  <div class="dusk" aria-hidden="true"></div>

  {/* ===== 纸白正文区（原型 .paper-wrap）=====
       百褶 ∞ 底纹 position:fixed 挂视口 ⇒ 滚动时始终居中（原型 v9.1 定案）。
       ★ 同上：这条 full-bleed 负 margin 是为了让原型那套「.section 自带 --wrap 居中」
          在本站的 .shell 里仍然成立。 */}
  <div class="paper-wrap">
    <div class="paper-inf" aria-hidden="true"></div>

    <section class="section" id="s2">
      <div class="section-head"><h2>最近写的</h2><span>SECTOR 02</span></div>
      <ul class="entry-list">
        {recentPosts.map((p) => (
          <li class="entry">
            {/* 原型版式：date / 大标题 / 标签 / 摘要。摘要用 p.summary（真实字段）。 */}
            <a href={p.url}>
              <time datetime={p.date}>{p.date}</time>
              <span class="t">{p.title}</span>
              <span class="tags">{p.tags.join(' / ')}</span>
              {p.summary && <span class="s">{p.summary}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>

    {/* 字母滚动带：S2 与 S3 之间的纹理分隔。两行反向对跑（46s / 52s）。
        ★ 无缝原理：「跑 -50%」必须真有第二份内容 —— 所以每组词渲染两遍（第二遍 .dup）。
        ★ 词条一律从站点数据派生，不写死站名（有测试守着）。 */}
    <div class="marquee" aria-hidden="true">
      {[
        { dir: 'up', items: ['SHUFFLE', '01', site.name, 'dot', 'RHINE LAB', '02', 'NOTE', 'dot'] },
        { dir: 'down', items: ['ARCHIVE', '03', '自由热烈', 'dot', brandWord.toUpperCase(), '04', 'SILK', 'dot'] },
      ].map((row) => (
        <div class={`marquee-row ${row.dir}`}>
          {[0, 1].map((pass) =>
            row.items.map((it) => (
              <span class={`marquee-item${pass === 1 ? ' dup' : ''}`}>
                {it === 'dot' ? (
                  <span class="dot" />
                ) : /^\d{2}$/.test(it) ? (
                  <>
                    <span class="num">0</span>
                    {it[1]}
                  </>
                ) : (
                  it
                )}
              </span>
            ))
          )}
        </div>
      ))}
    </div>

    {/* ===== S3：更新记录（原型 #s3 的四张玻璃卡）=====
         站主拍板：原型写的是它自己的迭代史，照抄无意义 ⇒ 渲染 content/pages/log.md 最近 4 条。 */}
    <section class="section" id="s3">
      <div class="section-head"><h2>最近改了什么</h2><span>SECTOR 03</span></div>
      {logItems.length > 0 ? (
        <div class="cards">
          {logItems.map((it) => {
            const first = (it.changes ?? [])[0] ?? '';
            const more = (it.changes?.length ?? 0) > 1 ? `（共 ${it.changes!.length} 项）` : '';
            return (
              <div class="card">
                <span class="k">{isoDate(it.date)}</span>
                <h3>{it.version ?? isoDate(it.date)}</h3>
                <p>{first}{more}</p>
              </div>
            );
          })}
        </div>
      ) : (
        <p class="empty">更新日志还是空的 —— 往 content/pages/log.md 加一条就会出现在这一屏。</p>
      )}
    </section>

    {/* ===== 技术栈 · 语言占比（原型 #s5 那条 GitHub 风格条形图）=====
         数字一律构建期实测。结构与动效照抄原型：条本体 scaleX 生长（错开 90ms）+ 图例 + 明细。 */}
    {langSlices.length > 0 && (
      <section class="section" id="s5">
        <div class="section-head"><h2>技术栈</h2><span>SECTOR 05</span></div>

        <div class="langbar" aria-labelledby="langbar-hd">
          <div class="langbar-hd" id="langbar-hd">
            <b>LANGUAGE COMPOSITION</b>
            <span>按字节 · <span class="of">不含图片与字体</span></span>
          </div>

          <div
            class="langbar-track"
            role="img"
            aria-label={`语言占比：${langSlices.map((s) => `${s.name} ${s.pct}%`).join('、')}`}
          >
            {langSlices.map((s, i) => (
              <i
                style={`--i:${i}; width:${s.pct}%; background:${
                  /* ★★ 末端刻意**不用** --accent-bright：这条在**纸白底**上，
                     #4caf50 对纸只有 2.66:1（tests/tokens.test.ts 守的就是这条），
                     亮绿只许出现在深色底上。深绿→主绿已足够分出主次。 */
                  i === 0
                    ? 'linear-gradient(90deg,var(--accent-ink) 0%,var(--accent) 100%)'
                    : i === 1 ? 'var(--accent-ink)'
                    : i === 2 ? 'var(--accent)'
                    : i === 3 ? 'var(--signal)'
                    : 'var(--muted)'
                }`}
              />
            ))}
          </div>

          <ul class="langbar-legend">
            {langSlices.map((s, i) => (
              <li style={`--i:${i}`}>
                <span
                  class="dot"
                  style={`background:${
                    i === 0 ? 'var(--accent)'
                    : i === 1 ? 'var(--accent-ink)'
                    : i === 2 ? 'var(--accent)'
                    : i === 3 ? 'var(--signal)'
                    : 'var(--muted)'
                  }`}
                />
                <span class="nm">{s.name}</span>
                <span class="pct">{s.pct}%</span>
              </li>
            ))}
          </ul>

          {/* 明细：语言 / 字节 / 占比。占比用第二个 dd（不是原型那个裸 span）——
              <dl> 里 <div> 只允许包 dt/dd。 */}
          <dl class="langbar-detail">
            {langSlices.map((s, i) => (
              <div style={`--i:${i}`}>
                <dt>{s.name}</dt>
                <dd>{s.bytes.toLocaleString('en-US')} B</dd>
                <dd class="pct">{s.pct}%</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}
  </div>

  {/* ===== 页脚（原型 .foot）=====
       原型这里是「运行 — 天 / PV — UV —」两行占位；站主拍板不搬占位文本 ⇒
       换成站上已有的真实计数（SiteStats）。版式照抄原型的 .foot / .foot-in。 */}
  <footer class="foot">
    <div class="foot-in">
      <SiteStats since={site.since} tone="paper" />
    </div>
  </footer>

  {/* ===== 动效（照抄原型，去掉原型调试面板那三件事）=====
       三件：① 指针视差（只写 --mx/--my 两个 CSS 变量，位移全交给 CSS）
             ② 百褶 ∞ 只在纸白区显形（它是 fixed 挂视口的，不限定会飘到首屏/页脚）
             ③ 条目首次进视口时用 Web Animations 揭示一次
       ★ 滚动视差走 CSS scroll-driven（见样式表末尾的 @supports 块），不用 JS 滚动监听。
       ★ 不用 innerHTML（本站硬约束，有测试守着）。 */}
  <script>
    (() => {
      const root = document.documentElement;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const noHover = !matchMedia('(hover: hover)').matches;

      /* 1) 指针视差：原型的两段式 —— 动了才起 rAF，静止后自停，不常驻空转。 */
      if (!reduce && !noHover) {
        let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0, live = false;
        const K = 0.12; /* 原型实测阻尼：太大发抖，太小发木 */
        const loop = () => {
          cx += (tx - cx) * K;
          cy += (ty - cy) * K;
          if (Math.abs(tx - cx) < 0.0004 && Math.abs(ty - cy) < 0.0004) { cx = tx; cy = ty; raf = 0; }
          else raf = requestAnimationFrame(loop);
          root.style.setProperty('--mx', cx.toFixed(4));
          root.style.setProperty('--my', cy.toFixed(4));
        };
        addEventListener('pointermove', (e) => {
          tx = (e.clientX / innerWidth - 0.5) * 2;
          ty = (e.clientY / innerHeight - 0.5) * 2;
          if (!live) { live = true; cx = tx; cy = ty; }
          if (!raf) raf = requestAnimationFrame(loop);
        }, { passive: true });
      }

      /* 2) 百褶 ∞：fixed 挂视口 ⇒ 必须限定只在纸白区里出现。滚动时零 JS 参与。
            ★ 淡入淡出靠 CSS 的 transition（.paper-inf）。第一次隐藏必须**瞬时**：
              此刻先把过渡摘掉、强制一次样式计算把 opacity:0 定下来，再把过渡交还 CSS，
              否则开场会在首屏正中"淡出"一个幽灵 ∞。之后每次切换都会走过渡。 */
      const paperWrap = document.querySelector('.paper-wrap');
      const paperInf = document.querySelector('.paper-inf');
      if (paperWrap && paperInf && 'IntersectionObserver' in window) {
        paperInf.style.transition = 'none';
        paperInf.style.opacity = '0';
        paperInf.getBoundingClientRect(); /* 强制样式计算：让上面这组值成为"当前值" */
        paperInf.style.removeProperty('transition');
        new IntersectionObserver((es) => {
          for (const e of es) paperInf.style.opacity = e.isIntersecting ? '' : '0';
