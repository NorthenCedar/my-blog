  {/* ===== 动效层（B2）：揭示 + 聚焦 =====
       站主 2026-09-30 拍板去掉 console 外壳 ⇒ 刻度尺填充、HUD 读数、扫描带 tick
       这三段**连同 DOM 一起删除**（不是留着不显示）—— 否则就是死代码。
       保留的两段：① 入场揭示（.field-item 首次进视口）② 聚焦弱化（滚过中线的条目）。
       规矩不变：只读 DOM + 写 class/style，不动布局；reduced-motion 下不补间、不位移。 */}
  <script>
    (() => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = Array.from(document.querySelectorAll('.field-item'));
      // 刻度尺 / HUD / 扫描带的引用已随外壳一起删除（2026-09-30），
      // 不留 `document.getElementById(...)` 的空引用 —— 元素是 null，读属性就是死代码。

      /* 1) 入场揭示：每个条目第一次进入视口时显形，只播一次。
            揭示的载体是 transform（不是 opacity）—— 基准 opacity 恒为 --focus-min，
            所以最坏情况只是「没动画」，绝不会「内容永久不可见」。 */
      if ('IntersectionObserver' in window) {
        const reveal = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('is-revealed');
            reveal.unobserve(e.target);
          }
        }, { rootMargin: '0px 0px -12% 0px', threshold: 0.01 });
        items.forEach((el, i) => {
          // 同屏一起揭示的条目做 90ms 错位（spec §1.1：层间错位 80–120ms）
          if (!reduce) el.style.transitionDelay = (i % 3) * 90 + 'ms';
          reveal.observe(el);
        });
      } else {
        items.forEach((el) => el.classList.add('is-revealed'));
      }

      /* 2) 聚焦：扫描带是**一条线**（视口中线），焦点 = 中线真正压住的那一个条目。
            旧实现把「中部 25vh」当成带，条目够矮时一屏能塞进两三个 ⇒ 谁赢由
            IntersectionObserver 的回调顺序决定 ⇒ 绿线压着上一篇、读数却显示下一篇
            （站主 2026-09-28 报的就是这个，实测 73 个滚动位置里 26 个不一致）。
            现在只看中线：压住谁就报谁；区段之间的留白谁也没压住 ⇒ 报「—」（站主 2026-09-28 定）。
            条目互不重叠，中线最多压住一个，所以找到即收工，不需要再排序。
            选人挂在下面 4) 的 rAF 里 —— 每帧至多算一次，不额外加滚动监听器。 */
      let current = null;
      const setFocus = (el) => {
        if (el === current) return;
        items.forEach((i) => i.classList.toggle('is-focused', i === el));
        current = el;
      };
      const pickFocus = () => {
        const cy = innerHeight / 2;
        for (const el of items) {
          const r = el.getBoundingClientRect();
          if (r.top <= cy && r.bottom >= cy) return setFocus(el);
        }
        setFocus(null);
      };

      /* 3) 穿字让位：中线 ±12px 内的文字朝纸退一档，中线离开后回位。
            原第 3 段「刻度填充 + HUD 读数」已随外壳删除（2026-09-30）——
            它读写的 #railFill / #hudPct / #hudSec 三个节点都不存在了。
            选择器按本页真实类名重列：旧 .tier-head 已改名为原型 .section-head，
            旧 .pod-tag（s1 身份舱）随身份上移进首屏而不复存在，一并摘掉。 */
      const yieldEls = Array.from(document.querySelectorAll(
        '.display,.lede,.coord span,.entry time,.entry .t,.entry .tags,.entry .s,.section-head h2,.section-head span,.card h3,.card p,.empty,.links a'
      ));
      let yieldQueued = false;
      const updateYield = () => {
        yieldQueued = false;
        pickFocus(); // 焦点与让位同帧结算：读数、透明度、字色三者永远对着同一条中线
        const cy = innerHeight / 2, half = 12;
        for (const el of yieldEls) {
          const r = el.getBoundingClientRect();
          if (!r.height) continue;
          const hit = r.bottom >= cy - half && r.top <= cy + half;
          if (hit !== el.classList.contains('is-yielding')) el.classList.toggle('is-yielding', hit);
        }
      };
      const queueYield = () => {
        if (yieldQueued) return;
        yieldQueued = true;
        requestAnimationFrame(updateYield);
      };

      /* 4) 点击绿色闪烁：pointerdown（捕获阶段）命中 a/button → .is-flash 180ms */
      document.addEventListener('pointerdown', (e) => {
        const t = e.target && e.target.closest ? e.target.closest('a,button') : null;
        if (!t) return;
        t.classList.add('is-flash');
        setTimeout(() => t.classList.remove('is-flash'), 180);
      }, true);

      /* 滚动只驱动「穿字让位」一件事了（刻度与读数的监听随外壳一起删掉）。
         首帧也跑一次：直接刷新在中段时，让位状态立刻是对的。 */
      addEventListener('scroll', queueYield, { passive: true });
      addEventListener('resize', queueYield);
      updateYield();

      /* 5) 首屏鼠标视差（原型同一套通道）：只写 --mx / --my 两个 CSS 变量，
            位移全交给 CSS —— 玻璃卡、DNA、细网格都读这两个变量。
            原型用「pointermove 起 rAF、静止后自停」的两段式；本站**复用一个常驻 rAF**，
            顺手把 queueYield 收进来一起结算（静止时一帧只做几次读属性 + 一次比较）。
            好处是滚动让位与视差永远同一帧出结果，不会"字让位了玻璃卡还在飘"。
            性能守门：真正的开销在 rhgrid 那条线（Perlin + 116 个 path 的 d），
            所以做成 **只有指针进过页面才常驻** —— 一次不动的用户，这条 rAF 都不起。 */
      const reduceMx = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const hoverable = window.matchMedia('(hover: hover)').matches;
      if (!reduceMx && hoverable) {
        let tx = 0, ty = 0, cx = 0, cy = 0, running = false;
        const K = 0.12; /* 原型实测阻尼：太大发抖，太小发木 */
        const rootEl = document.documentElement;
        window.addEventListener('pointermove', (e) => {
          tx = (e.clientX / innerWidth - 0.5) * 2;
          ty = (e.clientY / innerHeight - 0.5) * 2;
          if (!running) {
            running = true;
            cx = tx; cy = ty; /* 首帧直接落位，不做从 0 飘过去的假动作 */
            requestAnimationFrame(tick);
          }
        }, { passive: true });
        const tick = () => {
          cx += (tx - cx) * K;
          cy += (ty - cy) * K;
          rootEl.style.setProperty('--mx', cx.toFixed(4));
          rootEl.style.setProperty('--my', cy.toFixed(4));
          updateYield();
          requestAnimationFrame(tick);
        };
      }
    })();
  </script>

