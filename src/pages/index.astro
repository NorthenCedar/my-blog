---
/**
 * 首页 · console 外壳（B1）
 * 零动效：本文件里没有任何 transition / animation / 监听器。
 * `.field-item` 与 `data-label` 是留给 B2 动效层的挂点，B1 不消费它们。
 */
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import BootIntro from '../components/BootIntro.astro';
import NavDrawer from '../components/NavDrawer.astro';
import SiteStats from '../components/SiteStats.astro';
import { NAV_LINKS } from '../lib/nav';
import { getVisiblePosts } from '../lib/posts';
import { getSite } from '../lib/site';
import { isoDate, sortLogItems } from '../lib/log-order';
import { readLanguageStats } from '../lib/lang-stats';

const site = await getSite();
const posts = await getVisiblePosts();

// ── S3「最近改了什么」的四张卡 ──────────────────────────────────────
// 原型这一屏（#s3）是四张玻璃卡，写的是原型自己的迭代说明。
// 本站不能照抄那几段话 —— 那是原型的历史，不是这个站的。
// 真实对应物是**更新日志**（content/pages/log.md，站点内容层）：
// 取最近 4 条，一条一张卡。排序与日期格式化复用日志页那套（sortLogItems / isoDate），
// 保证「首页卡片」与「/log 页」永远同一顺序、同一写法 —— 不在这里另起炉灶。
const HOME_LOG_LIMIT = 4;
const logEntry = await getEntry('pages', 'log');
const logData = (logEntry?.data ?? {}) as unknown as {
  items?: Parameters<typeof sortLogItems>[0];
};
const logItems = sortLogItems(logData.items ?? [])
  .filter((it) => (it.changes?.length ?? 0) > 0)
  .slice(0, HOME_LOG_LIMIT);

// ── 技术栈那条语言占比 ─────────────────────────────────────────────
// 构建期实测（见 src/lib/lang-stats.ts）：不写死任何数字。
// 拿不到数据（仓库结构变了）就返回空数组 ⇒ 整块不渲染，不显示一条全是 0 的假条。
const langSlices = readLanguageStats();

// 首页 S2「最近写的」只露最新的三篇（站主 2026-09-28）。
// 这里**不覆盖 posts**：posts 已是按日期倒序的全量列表，OS 状态条的 POSTS 读数
// 与导航都还依赖它 —— 截断只发生在 S2 这一处渲染上，站点总量不该跟着首页走。
const HOME_POST_LIMIT = 3;
const recentPosts = posts.slice(0, HOME_POST_LIMIT);

// 2026-09-30 站主要求「相册不放主页了」⇒ 首页不再需要相册 manifest。
// 原来这里 import 了 public/gallery/manifest.json 并取 home.shots / mainSrcset，
// 现在整块移掉了 —— 相册页 /gallery 仍在自己消费那个 manifest，接口没变。
// 同时删掉的还有 <Base> 的 intro 门控对相册图的依赖（见下方注释）。
// ★ 注意：gen-gallery-webp.mjs 仍要在 build 里跑（相册页还要它产 WebP）。

// 坐标行三个字段都可选：缺任何一个就整行不渲染，不渲染空值
const hasCoord = Boolean(site.lat && site.lon && site.status);

// 滚动带要用到的品牌词：从 wordmark 里取第一段（去掉空格与撇号之后的部分）。
// 不写死字面量 —— tests/content-invariants.test.ts 禁止站点文案出现在 src/ 里。
const brandWord = site.wordmark.split(/[\s']/)[0];

// 首页区段（2026-09-30 站主要求：**相册从首页拿掉**）。
// 「相册」不再占首页一个区段 —— 首页回到四段：身份 → 文章 → 项目 → 找到我。
// 相册页 /gallery 本身保留，从导航进（站主原话「相册不放主页了」）。
// 区段编号表原本是给左刻度尺做定位与读数的（top = 各段在整页里的相对位置）。
// 2026-09-30：刻度尺随 console 外壳一并删除 ⇒ 这张表已无人引用，删掉，不留在源码里养灰。
---

<Base description={site.metaDescription} current="index" chrome="console">
  {/* ===== 两态门控（B2）=====
      默认（无 JS）= 页面完整可读：正文不弱化、仪表不显示死指针；
      JS 到位后给 <html> 挂 .js，才有聚焦弱化与扫描仪表。
      放在槽内最前面：脚本同步执行，等 .field-item 被解析时类已就位，不会闪。
      只落在首页 —— 不动 Base，其余 13 页产物逐字节不变。 */}
  {/* ===== 开场门控（B3）：必须在覆盖层之前**同步**执行，否则会先闪一下再隐藏 =====
      不播的四种情形（#6 + 站主 Q3）：reduced-motion / 无 JS / 本会话已播 / ≤767px。
      方向是 fail-safe：默认不显示，只有判定"该播"才挂 .boot-on（锁滚动也挂在这个类上）。
      `.js` 这个字面量有断言守着（tests/b2-motion.test.ts「门控脚本只落首页」），别改。 */}
  <script is:inline>
    document.documentElement.classList.add('js');
    try {
      var play =
        !matchMedia('(prefers-reduced-motion: reduce)').matches &&
        innerWidth >= 768 &&
        !sessionStorage.getItem('boot-intro');
      if (play) document.documentElement.classList.add('boot-on');
      sessionStorage.setItem('boot-intro', '1'); /* 进入播放即记：刷新不重播（#6）；skip 也不重播（#16） */
    } catch (e) {
      /* 无痕 / 禁用 storage：退化成"可能重播一次"，不影响可用性 */
    }
  </script>

  {/* 开场覆盖层（装饰 + skip 按钮）。只落首页；JS 与门控见 BootIntro.astro */}
  <BootIntro />

  {/* ===== 背景肌理层（原型 .bg）=====
      三样都是装饰、都挂视口（fixed），只在**纸白区**透出来：
        · .bg-wash 底部绿雾（46vh 的极淡绿，从纸往下沉一档）
        · .bg-grid 72px 细网格 + 11s 呼吸（原型唯一保留的循环动效）
        · .bg-ring 左下角同心环，随指针极缓位移 + 微转
      ★ 它们能被看见，靠的是 .paper-wrap 的背景是**半透明**的（原型写法，见下方 CSS）——
        本站原先是纯色 var(--paper)，会把这一层完全盖死。
      ★ 没有任何信息承载 ⇒ aria-hidden，且 pointer-events:none。 */}
  <div class="bg" aria-hidden="true">
    <div class="bg-wash"></div>
    <div class="bg-grid"></div>
    <div class="bg-ring"></div>
  </div>

  {/* ===== 背景装饰层（B2）：四样全是装饰，不承载任何信息 =====
      堆叠计划：0 装饰 < 1 正文 .tier < 2 扫描带 < 3 刻度尺 < 4 HUD < 5 OS 状态条
      （装饰层是 position:fixed，若正文不给 z-index，定位元素会画在静态正文之上 —— 水印会盖到字上。） */}
  {/* 莱茵标志（＋∞−）：一处定义。注意外层**不要**再写 viewBox —— 符号自带，
      外层再写会双重映射并把上下裁掉（原型里踩过）。 */}
  <svg class="svg-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <symbol id="rhine-logo" viewBox="0 6 24 12">
      <g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4c2 2.67 4 4 6 4a4 4 0 0 0 2.83-6.83M19.04 8.14a4 4 0 0 0-1.04-.14c-2 0-4 1.33-6 4" />
        <path d="M4.7 12h2.6M6 10.7v2.6" stroke-width="1.8" />
        <path d="M16.7 12h2.6" stroke-width="1.8" />
      </g>
    </symbol>
  </svg>

  {/* ===== 首屏 · 深墨绿场（原型 v10.6 最终版）=====
      站主 2026-09-30 拍板「统一换成视觉原型」，并明确「去掉外壳，换成原型 topbar」。
      所以下面这一整块取代了原先的 console 外壳（左刻度尺 / 顶 HUD / 中扫描带 / 底 OS 状态条）——
      那四样**全部移除**，不保留、不叠在首屏上。

      ⚠️ 命名：原型里这个容器叫 `.band`，但本站 `.band` 已经是「中扫描带」那条 1px 线的名字。
      同名会撞车，所以这里叫 **.hero**，扫描带那套连人带 CSS 一起删掉，不留歧义。

      层次（从后往前）：深墨绿渐变场 → 流场线 → DNA canvas → 三块玻璃卡 → topbar/文案。
      DNA 必须在**底色之上、文案之下**（原型 v6 踩过：放到底色下面会被闷成灰线）。 */}
  <header class="hero" id="s1">
    {/* 明度爬升层（原型 .band-core）：顶部透明、越往下越亮，把首屏下半段的死黑提起来，
        好让 .dusk 晨昏带接得上。必须在 DNA / 流场线之下 ⇒ 放最前面。 */}
    <div class="hero-core" aria-hidden="true"></div>

    {/* 流场线：原型移植自 wodniack.dev，几十条平行竖线被 Perlin 噪声持续推动 + 鼠标扰动。
        SVG 由 JS 建（见下面的脚本），这里是空容器。纯装饰 ⇒ aria-hidden，且 pointer-events:none。 */}
    <div class="rh-grid" id="rhGrid" aria-hidden="true">
      <svg class="rh-grid__svg" id="rhGridSvg" xmlns="http://www.w3.org/2000/svg"></svg>
    </div>

    {/* 真 3D DNA：three.js 把 canvas 注入这里。模型 dna-slim.glb 走 public/。
        空容器 ⇒ 没 WebGL / 加载失败时首屏只是没有模型，其余照常。 */}
    <div class="dna-stack" id="dnaStack" aria-hidden="true"></div>

    {/* 三块玻璃卡：原型是纯装饰的「舱窗」，错落在首屏里制造前后关系。 */}
    <div class="hero-glass g1" aria-hidden="true"></div>
    <div class="hero-glass g2" aria-hidden="true"></div>
    <div class="hero-glass g3" aria-hidden="true"></div>

    <div class="hero-inner">
      <div class="topbar">
        <div class="wordmark">
          {site.wordmark}
          <small>RHINE GLASS · v10.6</small>
        </div>
        <nav aria-label="主导航">
          {NAV_LINKS.map((l) => (
            <a href={l.href} aria-current={l.key === 'index' ? 'page' : undefined}>{l.label}</a>
          ))}
          <a href="/rss.xml">RSS</a>
        </nav>
        {/* 移动端抽屉：原型 topbar 在窄屏收起导航，这里复用站点原有的抽屉组件，
            保证 ≤1023px 仍有完整导航入口。 */}
        <NavDrawer current="index" />
      </div>

      {/* 首屏 ∞ 落款：官方描边 logo（左环＋、右环−、左环外侧白点）。
          原型 v10.1 定案：**不靠写死的 top/vw 定位**（vw/vh 会随视口缩放把 logo 推出画面），
          改成走正常文档流 —— 放在 topbar 之后、文案之前，天然落在 wordmark 下方。
          常驻动效是「小幅摆动」，不转整圈（站主 v10 轮选的）。 */}
      <div class="hero-logo" aria-hidden="true">
        <div class="lg-box">
          <div class="lg-glow"></div>
          <div class="lg-base"></div>
        </div>
      </div>

      {/* 身份：POD 01。内容与旧首页 s1 完全一致（wordmark / intro / 坐标行），
          一个字没动 —— 站主要的是换视觉，不是换内容。 */}
      <div class="hero-copy">
        <p class="eyebrow"><i></i>POD 01 · 身份 · {site.status}</p>
        {/* ★ 原型这里是一条固定文案 + 一个 <br> 硬折行，不是靠容器宽度自然折。
            本站站点名的 wordmark 是内容层字段（content/site.md），不能写死，
            所以按第一个空格断行：wordmark 的「名」与「姓」拆成两行，与原型一致；
            以后站主改成一个词的 wordmark，这段代码不产出空标签，照常单行渲染。 */}
        <h1 class="display" tabindex="-1">
          {site.wordmark.includes(' ') ? (
            <>
              {site.wordmark.slice(0, site.wordmark.indexOf(' '))}
              <br />
              {site.wordmark.slice(site.wordmark.indexOf(' ') + 1)}
            </>
          ) : (
            site.wordmark
          )}
        </h1>
        <p class="lede">{site.intro}</p>
        {hasCoord && (
          <p class="coord">
            <span>SITE {site.name}</span>
            <span>LAT {site.lat}</span>
            <span>LON {site.lon}</span>
            <span>STATUS {site.status}</span>
          </p>
        )}
      </div>
    </div>

    <div class="scroll-hint" aria-hidden="true"><s></s>SCROLL</div>
  </header>

  {/* ===== 晨昏带（原型 v4）：深墨绿 → 暖灰绿 → 灰白 → 纸白，40vh =====
      它解决的是「深场与纸白之间那道硬缝」。站主 v5 轮要求末段渐隐到 transparent，
      这样背景能从缝里透上来，不会出现一条生硬的边界线。 */}
  <div class="dusk" aria-hidden="true"></div>

  {/* ===== 纸白正文区（原型 .paper-wrap）=====
      百褶 ∞ 底纹挂在这里（position:fixed 挂视口 ⇒ 滚动时始终居中，站主 v9.1 定的）。
      站主 v10.6 指定用**原始素材** inf-orig.webp（墨迹自带右偏 189.5px），不做任何居中补偿。 */}
  <div class="paper-wrap">
    <div class="paper-inf" aria-hidden="true"></div>

  {/* 身份区段已上移进首屏 .hero（POD 01），这里不再重复渲染 s1。 */}

  <section class="tier" id="s2">
    {/* 标题改成原型的 .section-head 语序（h2 在前、编号在后），
        站点旧版是「编号在前」—— 站主要统一换成原型视觉，这里跟着换。 */}
    <div class="section-head"><h2>最近写的</h2><span>SECTOR 02</span></div>
    <ul class="entry-list">
      {recentPosts.map((p) => (
        <li class="entry field-item" data-label={`文章 · ${p.title}`}>
          {/* 原型的条目版式：date / 大标题 / 标签 / 摘要，四行一竖列。
              本站旧版是「date · title · tags」挤在一行的 bracket 版式 ——
              站主要的就是原型这个「一行一篇、像目录」的排法。
              ★ 摘要用 p.summary（PostMeta 的真实字段），一个字的假数据都没编。 */}
          <a href={p.url}>
            <time datetime={p.date}>{p.date}</time>
            <span class="t">{p.title}</span>
            <span class="tags">{p.tags.join(' / ')}</span>
            {p.summary && <span class="s">{p.summary}</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* 字母滚动带：SECTOR 02 与 03 之间的纹理分隔（原型最终版有，本站原先缺这一层）。
      两行反向对跑，上行 46s、下行 52s —— 速度不同才不会看成一块整板在平移。
      内容纯装饰 ⇒ 整块 aria-hidden，读屏跳过。
      ★ 无缝原理：浏览器默认不克隆节点，所以「跑 -50%」必须真有第二份内容。
        这里把两组 span 各写两遍（第二遍 .dup），跑 -50% 才正好接上。 */}
  <div class="marquee" aria-hidden="true">
    {/* ★ 词条一律从站点数据派生，**不写死任何站点文案**。
        tests/content-invariants.test.ts 守着这条架构原则（"src/ 里不出现站名"）——
        站名字面量一写进 src/ 就是测试失败，
        因为站点文案的唯一来源是 content/site.md。
        所以：站名取 site.name，品牌词取 site.wordmark 的第一个词，
        其余是纯装饰词条（与站点无关，属于视觉语言的一部分）。
        ★ 无缝原理：浏览器不会帮你克隆节点，"跑 -50%" 必须真有第二份内容 ——
          所以每组词都渲染两遍（第二遍 .dup），动画位移 -50% 才正好接上。 */}
    {[
      { dir: 'up', items: ['SHUFFLE', '01', site.name, 'dot', 'RHINE LAB', '02', 'NOTE', 'dot'] },
      { dir: 'down', items: ['ARCHIVE', '03', '玻璃拟态', 'dot', brandWord.toUpperCase(), '04', 'SILK', 'dot'] },
    ].map((row) => (
      <div class={`marquee-row ${row.dir}`}>
        {[0, 1].map((pass) =>
          row.items.map((it) => (
            <span class={`marquee-item${pass === 1 ? ' dup' : ''}`}>
              {it === 'dot' ? (
                <span class="dot" />
              ) : /^\d{2}$/.test(it) ? (
                <>
                  <span class="num">0</span>
                  {it[1]}
                </>
              ) : (
                it
              )}
            </span>
          ))
        )}
      </div>
    ))}
  </div>

  {/* ===== S3：更新记录（原型 #s3 的四张玻璃卡）=====
       原型这一屏写的是它自己的迭代说明（"v4 改了什么"），照抄到本站毫无意义 ——
       那是原型的历史。**真实对应物是更新日志**，所以这里渲染 content/pages/log.md 的最近 4 条。
       结构照抄原型 .cards / .card（玻璃卡 + 等宽小标签 + 标题 + 说明），
       内容一条都不手写 —— 站主往 log.md 加一条，首页这张卡自己就换。 */}
  <section class="tier" id="s3">
    <div class="section-head"><h2>最近改了什么</h2><span>SECTOR 03</span></div>
    {logItems.length > 0 ? (
      <div class="cards">
        {logItems.map((it) => {
          const first = (it.changes ?? [])[0] ?? '';
          const more = (it.changes?.length ?? 0) > 1 ? `（共 ${it.changes!.length} 项）` : '';
          return (
            <div class="card field-item" data-label={`更新 · ${it.version ?? isoDate(it.date)}`}>
              <span class="k">{isoDate(it.date)}</span>
              <h3>{it.version ?? isoDate(it.date)}</h3>
              <p>{first}{more}</p>
            </div>
          );
        })}
      </div>
    ) : (
      <div class="field-item" data-label="更新 · 空态">
        <p class="empty">更新日志还是空的 —— 往 content/pages/log.md 加一条就会出现在这一屏。</p>
      </div>
    )}
  </section>

  {/* ===== S4：技术栈 · 语言占比（原型 #s5 那条 GitHub 风格条形图）=====
       ★ 数字一律构建期实测（src/lib/lang-stats.ts），一个字都不写死 ——
         原型那段是手抄的旧数据，站主当时就纠正过一次「那个图片里的是旧的，你根据现在的数据做」。
         写死必然过期，而且没人会发现。
       结构与动效照抄原型：条本体 scaleX 生长（错开 90ms）+ 图例 + 明细表，
       色值全部走 token（本站铁律：组件里不出现字面色值）。 */}
  {langSlices.length > 0 && (
    <section class="tier" id="s4">
      <div class="section-head"><h2>技术栈</h2><span>SECTOR 04</span></div>

      <div class="langbar field-item" data-label="技术栈 · 语言占比" aria-labelledby="langbar-hd">
        <div class="langbar-hd" id="langbar-hd">
          <b>LANGUAGE COMPOSITION</b>
          <span>按字节 · <span class="of">不含图片与字体</span></span>
        </div>

        {/* 条本体：每段的宽度 = 占比；--i 只用来错开生长动画的 delay */}
        <div
          class="langbar-track"
          role="img"
          aria-label={`语言占比：${langSlices.map((s) => `${s.name} ${s.pct}%`).join('、')}`}
        >
          {langSlices.map((s, i) => (
            <i
              style={`--i:${i}; width:${s.pct}%; background:${
                /* ★ 第一段（占比最大的语言）用同色系渐变，其余纯色。
                   ★★ 末端刻意**不用** --accent-bright：这条在**纸白底**上，
                   #4caf50 对纸只有 2.66:1（tests/tokens.test.ts 守的就是这条），
                   亮绿只许出现在深色底上。深绿→主绿已经足够分出主次。 */
                i === 0
                  ? 'linear-gradient(90deg,var(--accent-ink) 0%,var(--accent) 55%,var(--accent) 100%)'
                  : i === 1 ? 'var(--accent-ink)'
