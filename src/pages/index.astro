---
/**
 * 首页 = 视觉原型 nc-rhine-v7/index.html（v10.6 最终版）**逐段照抄**。
 *
 * ── 本轮的立场（站主 2026-09-30 原话：「直接换成原型，不要改本站的像原型」）──
 *   这个文件不以「本站旧首页」为源去逼近原型，而是**以原型文件为源**：
 *   结构、类名、CSS、JS 一律照抄原型，只在下面这几处做接驳 —— 因为它们是
 *   「原型里的占位」与「本站的真实数据」的接口，不换就上不了线：
 *     ① 导航      href="#" / "#s2"  → NAV_LINKS 的真实路由
 *     ② 文章      原型 3 条 demo    → content/posts 的真实文章（可点进正文）
 *     ③ 站名/自述 原型写死的文案     → content/site.md（主题不持有文案，有测试守着）
 *     ④ 素材路径  ./inf-mask.png 等 → 站内 /art/…（图片一律进仓库，零第三方请求）
 *     ⑤ 卡片内容  原型的迭代史      → content/pages/log.md（站主拍板）
 *     ⑥ 技术栈数字 原型那组手抄数   → 构建期实测（站主拍板：「根据现在的数据做」）
 *
 * ── 刻意不搬的原型件 ──────────────────────────────────────────
 *   · 右下角 .panel（PROTO CONTROL 调试面板）—— 原型注释自己写明「原型专用」
 *   · 页脚「运行 — 天 / PV — UV —」占位文本 —— 站上早接了真实计数（SiteStats）
 *   · @font-face —— 本站 fonts.css 已自托管同名字体，原型那份指向原型目录
 *   · <script type="importmap"> + 内联 three —— 本站走 src/scripts/dna3d.ts
 *     （懒加载 + 具名导出收口，657 KB → 542 KB，见 tests/build-output.test.ts）
 *
 * ── 保留的本站基础设施（与「换视觉」无关，删了是超范围的破坏）──
 *   · Base 外壳（head / meta / canonical / RSS / .pt 页面过渡 / 自托管字体）
 *   · BootIntro 开场动画（站主 2026-09-26 审定）
 *   · SiteStats 真实计数（替代原型页脚的占位文本）
 */
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import BootIntro from '../components/BootIntro.astro';
import NavDrawer from '../components/NavDrawer.astro';
import SiteStats from '../components/SiteStats.astro';
import { NAV_LINKS } from '../lib/nav';
import { getVisiblePosts } from '../lib/posts';
import { getSite } from '../lib/site';
import { isoDate, sortLogItems } from '../lib/log-order';
import { readLanguageStats } from '../lib/lang-stats';

const site = await getSite();
const posts = await getVisiblePosts();

// ── S3 的四张卡 ────────────────────────────────────────────────
// 原型这一屏写的是它自己的迭代史（「v4 改了什么」）；站主拍板换成**站点更新日志**。
// 排序与日期复用日志页那套（sortLogItems / isoDate），两处永远同序。
const HOME_LOG_LIMIT = 4;
const logEntry = await getEntry('pages', 'log');
const logData = (logEntry?.data ?? {}) as unknown as {
  items?: Parameters<typeof sortLogItems>[0];
};
const logItems = sortLogItems(logData.items ?? [])
  .filter((it) => (it.changes?.length ?? 0) > 0)
  .slice(0, HOME_LOG_LIMIT);

// ── 技术栈那条语言占比 ──────────────────────────────────────────
// 构建期实测（src/lib/lang-stats.ts）：不写死任何数字。
// 拿不到数据就返回空数组 ⇒ 整块不渲染，不显示一条全是 0 的假条。
const langSlices = readLanguageStats();

// 原型 S2 只露三篇。不覆盖 posts —— OS 状态条与导航还依赖全量列表。
const HOME_POST_LIMIT = 3;
const recentPosts = posts.slice(0, HOME_POST_LIMIT);

// 坐标行三个字段都可选：缺任何一个就整行不渲染，不渲染空值
const hasCoord = Boolean(site.lat && site.lon && site.status);

// 滚动带要用到的品牌词：从 wordmark 里取第一段（去掉空格与撇号之后的部分）。
// 不写死字面量 —— tests/content-invariants.test.ts 禁止站点文案出现在 src/ 里。
const brandWord = site.wordmark.split(/[\s']/)[0];
---

<Base description={site.metaDescription} current="index" chrome="console">
  {/* ===== 开场门控（B3）：必须在覆盖层之前**同步**执行，否则会先闪一下再隐藏 =====
       不播的四种情形：reduced-motion / 无 JS / 本会话已播 / ≤767px。
       方向是 fail-safe：默认不显示，只有判定"该播"才挂 .boot-on。
       `.js` 这个字面量有断言守着（tests/b2-motion.test.ts「门控脚本只落首页」），别改。 */}
  <script is:inline>
    document.documentElement.classList.add('js');
    try {
      var play =
        !matchMedia('(prefers-reduced-motion: reduce)').matches &&
        innerWidth >= 768 &&
        !sessionStorage.getItem('boot-intro');
      if (play) document.documentElement.classList.add('boot-on');
      sessionStorage.setItem('boot-intro', '1'); /* 进入播放即记：刷新不重播；skip 也不重播 */
    } catch (e) {
      /* 无痕 / 禁用 storage：退化成"可能重播一次"，不影响可用性 */
    }
  </script>

  <BootIntro />

  {/* ===== 背景层（原型 .bg）=====
       三层错速：底部绿雾 / 72px 呼吸网格（带 .par 滚动视差）/ 左下同心环。
       ★ 它们能被看见，靠的是 .paper-wrap 的底色是**半透明**的 —— 纯色会把这一层盖死。
       ★ 纯装饰 ⇒ aria-hidden + pointer-events:none。 */}
  <div class="bg" aria-hidden="true">
    <div class="bg-wash"></div>
    <div class="bg-grid par"></div>
    <div class="bg-ring"></div>
  </div>

  {/* ===== 首屏 · 深墨绿场（原型 .band）=====
       层次（从后往前）：深墨绿渐变场 → 明度爬升 → 场内网格 → 流场线 → DNA → 玻璃卡 → 文案。
       ★ DNA 必须在**底色之上、文案之下**（原型 v6.2 层叠修订：放到底色下面会被闷成灰线）。

       ⚠️ 本站唯一的结构加法：margin-inline: calc(50% - 50vw)。
          原型里 .band 是顶层元素直接吃满视口，收窄到 --wrap 的是它的内容层 .band-inner；
          本站多一层 Base 的全局 .shell（max-width + padding），会把**背景一起框窄**。
          不加这条，首屏就是"中间一块"而不是整屏（站主 2026-09-30 报过）。
          ★ 不写 width:100vw —— vw 含滚动条宽度 ⇒ 横向溢出。 */}
  <header class="band" id="s1">
    {/* 真 3D DNA：three.js 把 canvas 注入这里。模型 /dna-slim.glb 走 public/。
        空容器 ⇒ 没 WebGL / 加载失败时首屏只是没有模型，其余照常。 */}
    <div class="dna-stack" id="dnaStack" aria-hidden="true"></div>

    <div class="band-core" aria-hidden="true"></div>
    <div class="band-grid" aria-hidden="true"></div>

    {/* 弹性流场线（原型移植自 wodniack.dev <a-waves>）：
        几十条平行竖线被 Perlin 噪声推动 + 鼠标扰动。SVG 由 JS 建（src/scripts/rhgrid.ts）。 */}
    <div class="rh-grid" id="rhGrid" aria-hidden="true">
      <svg class="rh-grid__svg" id="rhGridSvg" xmlns="http://www.w3.org/2000/svg"></svg>
    </div>

    <div class="band-glass g1 par-fast" aria-hidden="true"></div>
    <div class="band-glass g2 par-fast" aria-hidden="true"></div>
    <div class="band-glass g3 par-fast" aria-hidden="true"></div>

    <div class="band-inner">
      <div class="topbar">
        <div class="wordmark">
          {site.wordmark}
          <small>RHINE GLASS · v10.6</small>
        </div>
        {/* 原型的 nav 是 flex-wrap 的胶囊按钮（横排）。
            ≤1023px 由站点抽屉接管（纯 CSS、零 JS）：原型靠 nav flex-wrap 换行，
            本站导航有 9 项，换行会占掉半屏，抽屉更干净 —— 这是本站在原型之上的一处加法。 */}
        <nav aria-label="主导航">
          {NAV_LINKS.map((l) => (
            <a href={l.href} aria-current={l.key === 'index' ? 'page' : undefined}>{l.label}</a>
          ))}
          <a href="/rss.xml">RSS</a>
        </nav>
        <NavDrawer current="index" />
      </div>

      {/* 首屏 ∞ 落款：官方描边 logo（左环＋、右环−）。
          原型 v10.1 定案：**不靠写死的 top/vw 定位**（vw/vh 会随视口把 logo 推出画面），
          改成走正常文档流 —— 放在 topbar 之后、文案之前，天然落在 wordmark 下方。 */}
      <div class="bg-inf-logo" aria-hidden="true">
        <div class="lg-box">
          <div class="lg-glow"></div>
          <div class="lg-base"></div>
        </div>
      </div>

      <div class="band-copy par">
        <p class="eyebrow"><i></i>POD 01 · 身份 · {site.status}</p>
        {/* ★ 原型这里是一条固定文案 + 硬 <br> 折行。本站 wordmark 是内容层字段，不能写死，
            所以按第一个空格断行 —— 与原型一致；若 wordmark 是一个词，照常单行渲染。 */}
        <h1 class="display" tabindex="-1">
          {site.wordmark.includes(' ') ? (
            <>
              {site.wordmark.slice(0, site.wordmark.indexOf(' '))}
              <br />
              {site.wordmark.slice(site.wordmark.indexOf(' ') + 1)}
            </>
          ) : (
            site.wordmark
          )}
        </h1>
        <p class="lede">{site.intro}</p>
        {hasCoord && (
          <p class="coord">
            <span>SITE {site.name}</span>
            <span>LAT {site.lat}</span>
            <span>LON {site.lon}</span>
            <span>STATUS {site.status}</span>
          </p>
        )}
      </div>
    </div>

    <div class="scroll-hint" aria-hidden="true"><s></s>SCROLL</div>
  </header>

  {/* ===== 晨昏带（原型 v4）：深墨绿 → 暖灰绿 → 灰白 → 纸白 =====
       末段渐隐到 transparent（不是 --paper），否则背景层会被这条硬边一刀切断。 */}
  <div class="dusk" aria-hidden="true"></div>

  {/* ===== 纸白正文区（原型 .paper-wrap）=====
       百褶 ∞ 底纹 position:fixed 挂视口 ⇒ 滚动时始终居中（原型 v9.1 定案）。
       ★ 同上：这条 full-bleed 负 margin 是为了让原型那套「.section 自带 --wrap 居中」
          在本站的 .shell 里仍然成立。 */}
  <div class="paper-wrap">
    <div class="paper-inf" aria-hidden="true"></div>

    <section class="section" id="s2">
      <div class="section-head"><h2>最近写的</h2><span>SECTOR 02</span></div>
      <ul class="entry-list">
        {recentPosts.map((p) => (
          <li class="entry">
            {/* 原型版式：date / 大标题 / 标签 / 摘要。摘要用 p.summary（真实字段）。 */}
            <a href={p.url}>
              <time datetime={p.date}>{p.date}</time>
              <span class="t">{p.title}</span>
              <span class="tags">{p.tags.join(' / ')}</span>
              {p.summary && <span class="s">{p.summary}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>

    {/* 字母滚动带：S2 与 S3 之间的纹理分隔。两行反向对跑（46s / 52s）。
        ★ 无缝原理：「跑 -50%」必须真有第二份内容 —— 所以每组词渲染两遍（第二遍 .dup）。
        ★ 词条一律从站点数据派生，不写死站名（有测试守着）。 */}
    <div class="marquee" aria-hidden="true">
      {[
        { dir: 'up', items: ['SHUFFLE', '01', site.name, 'dot', 'RHINE LAB', '02', 'NOTE', 'dot'] },
        { dir: 'down', items: ['ARCHIVE', '03', '玻璃拟态', 'dot', brandWord.toUpperCase(), '04', 'SILK', 'dot'] },
      ].map((row) => (
        <div class={`marquee-row ${row.dir}`}>
          {[0, 1].map((pass) =>
            row.items.map((it) => (
              <span class={`marquee-item${pass === 1 ? ' dup' : ''}`}>
                {it === 'dot' ? (
                  <span class="dot" />
                ) : /^\d{2}$/.test(it) ? (
                  <>
                    <span class="num">0</span>
                    {it[1]}
                  </>
                ) : (
                  it
                )}
              </span>
            ))
          )}
        </div>
      ))}
    </div>

    {/* ===== S3：更新记录（原型 #s3 的四张玻璃卡）=====
         站主拍板：原型写的是它自己的迭代史，照抄无意义 ⇒ 渲染 content/pages/log.md 最近 4 条。 */}
    <section class="section" id="s3">
      <div class="section-head"><h2>最近改了什么</h2><span>SECTOR 03</span></div>
      {logItems.length > 0 ? (
        <div class="cards">
          {logItems.map((it) => {
            const first = (it.changes ?? [])[0] ?? '';
            const more = (it.changes?.length ?? 0) > 1 ? `（共 ${it.changes!.length} 项）` : '';
            return (
              <div class="card">
                <span class="k">{isoDate(it.date)}</span>
                <h3>{it.version ?? isoDate(it.date)}</h3>
                <p>{first}{more}</p>
              </div>
            );
          })}
        </div>
      ) : (
        <p class="empty">更新日志还是空的 —— 往 content/pages/log.md 加一条就会出现在这一屏。</p>
      )}
    </section>

    {/* ===== 技术栈 · 语言占比（原型 #s5 那条 GitHub 风格条形图）=====
         数字一律构建期实测。结构与动效照抄原型：条本体 scaleX 生长（错开 90ms）+ 图例 + 明细。 */}
    {langSlices.length > 0 && (
      <section class="section" id="s5">
        <div class="section-head"><h2>技术栈</h2><span>SECTOR 05</span></div>

        <div class="langbar" aria-labelledby="langbar-hd">
          <div class="langbar-hd" id="langbar-hd">
            <b>LANGUAGE COMPOSITION</b>
            <span>按字节 · <span class="of">不含图片与字体</span></span>
          </div>

          <div
            class="langbar-track"
            role="img"
            aria-label={`语言占比：${langSlices.map((s) => `${s.name} ${s.pct}%`).join('、')}`}
          >
            {langSlices.map((s, i) => (
              <i
                style={`--i:${i}; width:${s.pct}%; background:${
                  /* ★★ 末端刻意**不用** --accent-bright：这条在**纸白底**上，
                     #4caf50 对纸只有 2.66:1（tests/tokens.test.ts 守的就是这条），
                     亮绿只许出现在深色底上。深绿→主绿已足够分出主次。 */
                  i === 0
                    ? 'linear-gradient(90deg,var(--accent-ink) 0%,var(--accent) 100%)'
                    : i === 1 ? 'var(--accent-ink)'
                    : i === 2 ? 'var(--accent)'
                    : i === 3 ? 'var(--signal)'
                    : 'var(--muted)'
                }`}
              />
            ))}
          </div>

          <ul class="langbar-legend">
            {langSlices.map((s, i) => (
              <li style={`--i:${i}`}>
                <span
                  class="dot"
                  style={`background:${
                    i === 0 ? 'var(--accent)'
                    : i === 1 ? 'var(--accent-ink)'
                    : i === 2 ? 'var(--accent)'
                    : i === 3 ? 'var(--signal)'
                    : 'var(--muted)'
                  }`}
                />
                <span class="nm">{s.name}</span>
                <span class="pct">{s.pct}%</span>
              </li>
            ))}
          </ul>

          {/* 明细：语言 / 字节 / 占比。占比用第二个 dd（不是原型那个裸 span）——
              <dl> 里 <div> 只允许包 dt/dd。 */}
          <dl class="langbar-detail">
            {langSlices.map((s, i) => (
              <div style={`--i:${i}`}>
                <dt>{s.name}</dt>
                <dd>{s.bytes.toLocaleString('en-US')} B</dd>
                <dd class="pct">{s.pct}%</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}
  </div>

  {/* ===== 页脚（原型 .foot）=====
       原型这里是「运行 — 天 / PV — UV —」两行占位；站主拍板不搬占位文本 ⇒
       换成站上已有的真实计数（SiteStats）。版式照抄原型的 .foot / .foot-in。 */}
  <footer class="foot">
    <div class="foot-in">
      <SiteStats since={site.since} tone="paper" />
    </div>
  </footer>

  {/* ===== 动效（照抄原型，去掉原型调试面板那三件事）=====
       三件：① 指针视差（只写 --mx/--my 两个 CSS 变量，位移全交给 CSS）
             ② 百褶 ∞ 只在纸白区显形（它是 fixed 挂视口的，不限定会飘到首屏/页脚）
             ③ 条目首次进视口时用 Web Animations 揭示一次
       ★ 滚动视差走 CSS scroll-driven（见样式表末尾的 @supports 块），不用 JS 滚动监听。
       ★ 不用 innerHTML（本站硬约束，有测试守着）。 */}
  <script>
    (() => {
      const root = document.documentElement;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const noHover = !matchMedia('(hover: hover)').matches;

      /* 1) 指针视差：原型的两段式 —— 动了才起 rAF，静止后自停，不常驻空转。 */
      if (!reduce && !noHover) {
        let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0, live = false;
        const K = 0.12; /* 原型实测阻尼：太大发抖，太小发木 */
        const loop = () => {
          cx += (tx - cx) * K;
          cy += (ty - cy) * K;
          if (Math.abs(tx - cx) < 0.0004 && Math.abs(ty - cy) < 0.0004) { cx = tx; cy = ty; raf = 0; }
          else raf = requestAnimationFrame(loop);
          root.style.setProperty('--mx', cx.toFixed(4));
          root.style.setProperty('--my', cy.toFixed(4));
        };
        addEventListener('pointermove', (e) => {
          tx = (e.clientX / innerWidth - 0.5) * 2;
          ty = (e.clientY / innerHeight - 0.5) * 2;
          if (!live) { live = true; cx = tx; cy = ty; }
          if (!raf) raf = requestAnimationFrame(loop);
        }, { passive: true });
      }

      /* 2) 百褶 ∞：fixed 挂视口 ⇒ 必须限定只在纸白区里出现。滚动时零 JS 参与。 */
      const paperWrap = document.querySelector('.paper-wrap');
      const paperInf = document.querySelector('.paper-inf');
      if (paperWrap && paperInf && 'IntersectionObserver' in window) {
        paperInf.style.opacity = '0';
        new IntersectionObserver((es) => {
          for (const e of es) paperInf.style.opacity = e.isIntersecting ? '' : '0';
        }, { rootMargin: '0px 0px -30% 0px', threshold: 0 }).observe(paperWrap);
      }

      /* 3) 揭示：首次进视口播一次，播完即 unobserve。
            ★ 初值 opacity:0 由**这里**写（不是 CSS）⇒ 无 JS / JS 报错时内容照常可见，
              不会出现「动画没跑成 ⇒ 整页空白」这种最坏情况。 */
      if (!reduce && 'IntersectionObserver' in window) {
        const blocks = document.querySelectorAll('.band-copy > *, .section-head, .entry, .card');
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en, i) => {
            if (!en.isIntersecting) return;
            en.target.animate(
              [{ opacity: 0, transform: 'translateY(16px)' }, { opacity: 1, transform: 'none' }],
              { duration: 820, delay: (i % 4) * 90, easing: 'cubic-bezier(.16,1,.3,1)', fill: 'both' }
            );
            io.unobserve(en.target);
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.02 });
        blocks.forEach((b) => { b.style.opacity = '0'; io.observe(b); });
      }
    })();
  </script>

  {/* ===== 真 3D DNA + 流场线 =====
       这两块走**外部 module**（Astro 打包成 /_astro/*.js）：
       首页内联脚本有 7168 B 预算守护，three 与 Perlin 噪声装不进去。
       three 本体再往下拆一层动态 import —— 只有真要画的时候才下载那 542 KB。 */}
  <script>
    import '../scripts/dna3d';
    import '../scripts/rhgrid';
  </script>
</Base>

<style>
  /* ============================================================================
     首页样式 = 原型 nc-rhine-v7/index.html 的 <style> 逐条搬过来。
     ----------------------------------------------------------------------------
     ★ 三处**必须**的本土化（不改就会在本站坏掉，不是"优化"）：
       ① 原型的全局重置（`* { box-sizing }` / `body { font }` / `html { scroll-behavior }`）
          **不搬** —— Astro 的 scoped 样式会给选择器加 [data-astro-cid]，
          `*{...}` 会变成 `*[...]`，只匹配带 cid 的元素 ⇒ 整条静默失效。
          这些重置本站 base.css 里本来就有，不需要重复。
       ② 运行时注入的 DOM（three.js 的 canvas、rhgrid 造的 SVG path）
          **一律写 :global()** —— 它们没有 cid 属性，scoped 后代选择器打不到。
          补刀：SVG path 默认 fill:black，失效后是黑块不是"看不到"。
       ③ alpha 一律写 **8 位 hex**（本站铁律：组件里不写 rgba()）。
     ============================================================================ */

  /* 原型 :root 里那几个本站还没有的变量 —— 只在首页作用域补，不动全局 tokens.css。
     ★ 必须写 :global(:root)：scoped 的 `:root` 会变成 `:root[data-astro-cid]`，
       而 <html> 上没有这个属性 ⇒ 整块失效（原型用它定义 --line-1 / --paper-0 等）。 */
  :global(:root) {
    --line-1: var(--hair);    /* 原型发丝线 ← 本站 --hair */
    --paper-0: var(--paper);  /* 原型纸白底 ← 本站 --paper */
    --ink-3: var(--muted);    /* 原型三级墨 ← 本站 --muted */
    --mono: 'IBM Plex Mono';
    --font-display: Archivo, 'IBM Plex Sans', 'PingFang SC', 'Microsoft YaHei', sans-serif;
    --font-mono: 'IBM Plex Mono';
    --tilt: 1deg;
    --shift-a: 14px;
    --shift-b: 7px;
    --shift-c: 3px;
    --mx: 0;
    --my: 0;
    --dur-tap: 180ms;
    --dur-stagger: 90ms;
  }

  /* ★ 本站必需的第四条本土化：Base 的 .shell 自带上下留白（--sp-7 / --sp-8），
     而原型没有这一层 —— 首屏是从**视口顶端**开始的。不清掉就会在深墨绿场上方
     露出一条纸白（上一轮站主报的「主页为什么是这个比例」的另一半原因）。
     用 body.chrome-console 精确命中首页（Base 给首页的 body 挂这个类），
     不影响其余 13 页。★ 整条必须 :global()：.shell 不在本文件里，scoped 打不到。 */
  :global(body.chrome-console .shell) {
    padding: 0;
  }

  /* ====================== 背景层 ====================== */
  .bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .bg-wash {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 46vh;
    background: linear-gradient(0deg, #2d7d460b, transparent);
  }
  /* 72px 呼吸网格：只动 opacity ⇒ 不重绘网格，合成器驱动 */
  .bg-grid {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    background-image:
      linear-gradient(90deg, #7fd89a12 1px, transparent 1px),
      linear-gradient(0deg, #7fd89a12 1px, transparent 1px);
    background-size: 72px 72px;
    transform: translate3d(
      calc(var(--mx) * var(--shift-c) * 2),
      calc(var(--my) * var(--shift-c) * 2),
      0
    );
    transition: transform 160ms linear;
    animation: breathe 11s ease-in-out infinite;
  }
  @keyframes breathe {
    0%, 100% { opacity: 0.34; }
    50% { opacity: 0.72; }
  }
  .bg-ring {
    position: absolute;
    left: -10vw;
    bottom: -12vh;
    width: min(56vw, 660px);
    aspect-ratio: 1;
    background: repeating-radial-gradient(
      circle at 50% 50%,
      transparent 0 118px,
      #1a1a1a12 118px 119px
    );
    transform: translate3d(
        calc(var(--mx) * var(--shift-a)),
        calc(var(--my) * var(--shift-a)),
        0
      )
      rotate(calc(var(--mx) * 0.6deg));
    transition: transform 120ms linear;
    will-change: transform;
  }

  /* ====================== DNA（真 3D，three.js 注入 canvas）======================
     ★ 原型 v10.3 那个根本坑：**先缩放、再按 k 折算平移**。
       three 的 object.position 在父空间里平移、不受自身 scale 影响 ⇒
       先平移后缩放会让螺旋轴被推离旋转中心 k 倍 ⇒ 屏幕上"左右移来移去"。 */
  .dna-stack {
    position: absolute;
    right: -6vw;
    top: 54%;
    /* ★ width 必须**显式算出来**：absolute + width:auto + 子 canvas width:100% 是循环依赖，
       配上 aspect-ratio 会收敛到随父容器宽度而变的点（本站实测发散到 3455px）。
       直接 calc 出确定宽度，把循环从根上掐断。 */
    width: calc(min(140vh, 1520px) * 900 / 3200);
    height: min(140vh, 1520px);
    z-index: 1;
    opacity: 0.8;
    transform: translate3d(calc(var(--mx) * 16px), calc(var(--my) * 16px - 50%), 0) rotate(24deg);
    mask-image: radial-gradient(ellipse 62% 84% at 50% 50%, #000 52%, transparent 98%);
    -webkit-mask-image: radial-gradient(ellipse 62% 84% at 50% 50%, #000 52%, transparent 98%);
    pointer-events: none;
  }
  /* ★★ :global() 是必须的：canvas 是运行时注入的，拿不到 cid 属性。
     否则整条规则静默失效 ⇒ canvas 用自己的像素缓冲当 CSS 尺寸，把容器撑爆。 */
  .dna-stack :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 900ms var(--ease-glass);
  }
  .dna-stack :global(canvas.is-ready) {
    opacity: 1;
  }

  /* ====================== 首屏 ∞ 落款 ======================
     原型 v10.1：走正常文档流（不用 vw/vh 定位 —— 窗口一宽 logo 就被推出画面）。
     常驻动效是**小幅摆动**（站主选的），不转整圈。 */
  .bg-inf-logo {
    position: relative;
    z-index: 0;
    pointer-events: none;
    align-self: flex-start;
    margin: 0.9rem 0 0;
  }
  .bg-inf-logo .lg-box {
    position: relative;
    width: clamp(150px, 15vw, 208px);
    aspect-ratio: 722 / 570; /* = 素材本体尺寸（inf-mask.png 722×570） */
    transform-origin: 50% 50%;
    opacity: 0.92;
    animation: logo-sway 7.5s ease-in-out infinite;
  }
  /* ★ 站主定稿值：±4.2° / translateY(-7px) / 7.5s —— 照抄，不自作主张缩放 */
  @keyframes logo-sway {
    0%, 100% { transform: rotate(-4.2deg); }
    50% { transform: rotate(4.2deg) translateY(-7px); }
  }
  /* ★ mask 素材必须是**黑底白图的不透明 PNG** + 显式 mask-mode:luminance ——
     透明图 + 灰 alpha 会被按亮度解读 ⇒ 糊成灰白方块（原型踩过）。 */
  .bg-inf-logo .lg-base {
    position: absolute;
    inset: 0;
    background: var(--logo-ink); /* 原型定色 #e9efe9 */
    -webkit-mask: url('/art/inf-mask.png') center / contain no-repeat;
    mask: url('/art/inf-mask.png') center / contain no-repeat;
    -webkit-mask-mode: luminance;
    mask-mode: luminance;
  }
  .bg-inf-logo .lg-glow {
    position: absolute;
    inset: 0;
    background: var(--logo-glow); /* 原型定色 #8fe0b0 */
    opacity: 0.18;
    -webkit-mask: url('/art/inf-mask-edge.png') center / contain no-repeat;
    mask: url('/art/inf-mask-edge.png') center / contain no-repeat;
    -webkit-mask-mode: luminance;
    mask-mode: luminance;
  }

  /* ====================== 百褶 ∞ 底纹（纸白区）======================
     ★ v10.6 站主指定：用**原始素材** inf-orig.webp（墨迹自带右偏 189.5px），
       不做任何居中补偿 —— 他要的就是原图本来的样子。 */
  .paper-wrap {
    position: relative;
    isolation: isolate;
    /* ★ 半透明 + fixed：纯色会把上面那层 .bg 肌理整个盖死（原型就是半透明的）；
       fixed 让这层纸不随滚动走，滚到底也不会露出下面的色带。 */
    background: linear-gradient(
        180deg,
        #fafaf7eb 0%,
        var(--paper) 18%,
        var(--paper) 82%,
        #fafaf7eb 100%
      )
      fixed;
    /* ★ 同 .band：逃出 .shell 的宽度，好让里面的 .section 按原型那样自己居中 */
    margin-inline: calc(50% - 50vw);
    /* ★ overflow-x: clip —— 滚动带那份用于无缝循环的复制内容会排到 1813px 宽，
       .marquee 自己 overflow:hidden 只裁视觉，scrollWidth 要父级收。
       用 clip 而不是 hidden：clip 不创建滚动容器，不会带坏 sticky 与滚动监听。 */
    overflow-x: clip;
  }
  .paper-inf {
    position: fixed;
    left: 50%;
    top: 50%;
    width: min(128vw, 1600px);
    aspect-ratio: 1572 / 878;
    transform: translate(-50%, -50%);
    background: url('/art/inf-orig.webp') center / contain no-repeat;
    opacity: 0.2;
    pointer-events: none;
    z-index: -1;
    will-change: opacity;
  }

  /* ====================== 弹性流场线（移植 wodniack.dev <a-waves>）======================
     原型的三个关键约束（漏一个就会"鼠标放上去就没了"）：
       ① clamp(±100) 位移限幅  ② 阻尼 .925  ③ 回弹 .005 */
  .rh-grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    opacity: 0.22;
    pointer-events: none; /* 事件走 window，铺满首屏时"离开组件"无意义 */
    /* ★ 必须裁掉溢出的 path：JS 建 SVG 时两侧各外扩 90px，这些点在 .band 的
       overflow:hidden 之外**仍计入文档 scrollWidth**（390px 视口实测多 12px）。 */
    overflow: hidden;
    mask-image: radial-gradient(ellipse 74% 64% at 56% 46%, #000 14%, transparent 84%);
    -webkit-mask-image: radial-gradient(ellipse 74% 64% at 56% 46%, #000 14%, transparent 84%);
  }
  .rh-grid__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: block;
    pointer-events: none;
  }
  /* ★★ :global() 必须：这些 <path> 是运行时 createElementNS 造的，没有 cid。
     不带 :global() 时 computed 是 stroke:none / fill:rgb(0,0,0) ⇒
     一根线都没有，反而是黑色实心多边形糊在首屏上。 */
  .rh-grid :global(path) {
    fill: none;
    stroke: var(--on-band-sub);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
    opacity: 0.62;
  }

  /* ====================== 首屏 · 深墨绿场 ====================== */
  .band {
    position: relative;
    /* ★ 逃出 .shell 的宽度回到整屏（原型 .band 本来就是顶层元素） */
    margin-inline: calc(50% - 50vw);
    min-height: 100vh;
    min-height: 100svh; /* 手机地址栏收放时不跳 */
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: var(--on-band);
    perspective: 1400px;
    /* ★ 底色必须是**半透明**的（原型 v5.4 最终值）：实心色会把压在后面的
       .bg 循环动效完全闷死，整张深场变成一块没有呼吸的死色。 */
    background:
      radial-gradient(110% 70% at 12% 0%, #2d7d462e 0%, transparent 58%),
      radial-gradient(90% 60% at 88% 88%, #e877220f 0%, transparent 62%),
      linear-gradient(
        178deg,
        #090c0cee 0%,
        #101814e0 34%,
        #1a251fcc 62%,
        #34413ab3 100%
      );
    isolation: isolate;
  }
  /* 明度爬升层：顶部透明、越往下越提亮，把首屏下半段的死黑提起来接上晨昏带 */
  .band-core {
    flex: 1;
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      transparent 0%,
      transparent 24%,
      #1b26208c 78%,
      #26332c66 100%
    );
  }
  .band-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.5;
    background-image:
      linear-gradient(90deg, #ffffff0a 1px, transparent 1px),
      linear-gradient(0deg, #ffffff0a 1px, transparent 1px);
    background-size: 64px 64px;
    transform: translate3d(
      calc(var(--mx) * var(--shift-c) * 2),
      calc(var(--my) * var(--shift-c) * 2),
      0
    );
    transition: transform 160ms linear;
  }
  /* 三块玻璃「舱窗」：错落制造前后关系，位移量逐块递增（22 / 34 / 44px） */
  .band-glass {
    position: absolute;
    z-index: 1;
    pointer-events: none;
    border-radius: 14px;
    border: 1px solid var(--dglass-line);
    background: linear-gradient(160deg, #ffffff14, #ffffff05);
    /* ★ 前缀必须写在标准属性**之前**，否则 esbuild 会删掉标准那条 */
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.1);
    backdrop-filter: blur(var(--glass-blur)) saturate(1.1);
    transition: transform 140ms linear;
    will-change: transform;
  }
  .band-glass.g1 {
    top: 11%; right: 6%; width: min(22vw, 240px); height: min(30vh, 220px);
    transform: translate3d(calc(var(--mx) * 22px), calc(var(--my) * 22px), 0)
      rotateY(calc(var(--mx) * var(--tilt))) rotateX(calc(var(--my) * var(--tilt) * -1));
  }
  .band-glass.g2 {
    top: 47%; right: 26%; width: min(15vw, 164px); height: min(20vh, 140px); opacity: 0.72;
    transform: translate3d(calc(var(--mx) * 34px), calc(var(--my) * 34px), 0)
      rotateY(calc(var(--mx) * var(--tilt)));
  }
  .band-glass.g3 {
    top: 15%; right: 30%; width: min(10vw, 110px); height: min(13vh, 92px); opacity: 0.5;
    transform: translate3d(calc(var(--mx) * 44px), calc(var(--my) * 44px), 0)
      rotateY(calc(var(--mx) * var(--tilt)));
  }
  /* 卡面游走高光：光源随指针在卡里移动 —— 玻璃"活着"的关键 */
  .band-glass::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      60% 55% at calc(50% + var(--mx) * 40%) calc(50% + var(--my) * 40%),
      #ffffff26,
      transparent 70%
    );
  }
  .band-inner {
    position: relative;
    z-index: 2;
    max-width: var(--wrap);
    margin: 0 auto;
    padding: var(--gutter);
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
  }
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    flex-wrap: wrap;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.14em;
    font-size: 0.9rem;
  }
  .wordmark small {
    display: block;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--on-band-meta);
    font-size: 0.7rem;
  }
  /* 导航 = 原型胶囊按钮（不是下划线文字链）：悬停位移 + 亮边 + 掠光 */
  nav {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  nav a {
    position: relative;
    padding: 0.42rem 0.82rem;
    border-radius: 999px;
    font-size: var(--fs-sm);
    color: var(--on-band-sub);
    border: 1px solid transparent;
    overflow: hidden;
    transition:
      transform var(--dur-tap) var(--ease-interact),
      color var(--dur-tap) var(--ease-interact),
      background-color var(--dur-tap) var(--ease-interact),
      border-color var(--dur-tap) var(--ease-interact);
  }
  /* 掠光：悬停时一道斜光从左扫到右 */
  nav a::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(115deg, transparent 30%, #ffffff26 50%, transparent 70%);
    transform: translateX(-120%);
    transition: transform var(--dur-hover) var(--ease-glass);
  }
  nav a:hover,
  nav a:focus-visible {
    color: var(--on-band);
    background: #ffffff14;
    border-color: var(--dglass-line);
    transform: translateY(-2px);
  }
  nav a:hover::before,
  nav a:focus-visible::before {
    transform: translateX(120%);
  }
  /* 当前页：淡绿底 + 绿描边（不是下划线） */
  nav a[aria-current] {
    color: var(--on-band);
    background: #2d7d4624;
    border-color: #4caf5059;
  }
  .band-copy {
    margin-top: auto;
    padding-bottom: 2.6rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: 0.22em;
    color: var(--on-band-meta);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .eyebrow i {
    width: 6px;
    height: 6px;
    background: var(--signal);
    border-radius: 50%;
    display: block;
    box-shadow: 0 0 8px 2px #e8772266;
  }
  .display {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 9.2vw, 6.4rem); /* 原型 --fs-display 原值 */
    line-height: 0.88;
    letter-spacing: -0.045em;
    margin: 0 0 1.1rem;
  }
  .lede {
    max-width: 40.5rem; /* 原型 .lede 量度：578px @17px */
    color: var(--on-band-sub);
    font-size: 1.0625rem;
    line-height: 1.62;
  }
  .coord {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--on-band-meta);
    letter-spacing: 0.06em;
  }
  /* SCROLL 提示：左下角横排（一条 28px 短横线 + 2.2s 绿色跑光） */
  .scroll-hint {
    position: absolute;
    left: var(--gutter);
    bottom: 1rem;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--on-band-meta);
    letter-spacing: 0.2em;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .scroll-hint s {
    display: block;
    width: 28px;
    height: 1px;
    background: #ffffff33;
    position: relative;
    overflow: hidden;
    text-decoration: none;
  }
  .scroll-hint s::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent-bright);
    animation: hint 2.2s var(--ease) infinite;
  }
  @keyframes hint {
    0% { transform: translateX(-100%); }
    60%, 100% { transform: translateX(100%); }
  }

  /* ====================== 晨昏带 ====================== */
  .dusk {
    position: relative;
    height: min(46vh, 400px);
    background: linear-gradient(
      180deg,
      var(--dusk-4) 0%,
      var(--dusk-5) 30%,
      var(--dusk-6) 58%,
      #ecebe4b8 78%,
      #fafaf747 92%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 74%, #0000008c 90%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0%, #000 74%, #0000008c 90%, transparent 100%);
  }
  .dusk::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.5;
    background-image:
      linear-gradient(90deg, #ffffff14 1px, transparent 1px),
      linear-gradient(0deg, #ffffff14 1px, transparent 1px);
    background-size: 72px 72px;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 72%);
    mask-image: linear-gradient(180deg, #000 0%, transparent 72%);
  }

  /* ====================== 字母滚动带 ======================
     两份内容并排 + 跑 -50% ⇒ 无缝。两行反向，速度不同（46s / 52s）。 */
  .marquee {
    position: relative;
    overflow: hidden;
    padding: 1.5rem 0 2.1rem;
    border-top: 1px solid var(--line-1);
    border-bottom: 1px solid var(--line-1);
    background: var(--paper-0);
    user-select: none;
    z-index: 1;
  }
  .marquee-row {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .marquee-row.up { animation: marquee-left 46s linear infinite; }
  .marquee-row.down { animation: marquee-right 52s linear infinite; margin-top: 0.34rem; }
  @keyframes marquee-left {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }
  @keyframes marquee-right {
    from { transform: translate3d(-50%, 0, 0); }
    to { transform: translate3d(0, 0, 0); }
  }
  .marquee-item {
    display: inline-flex;
    align-items: baseline;
    gap: 1.4rem;
    padding-right: 2.6rem;
