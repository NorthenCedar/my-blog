---
import Base from '../layouts/Base.astro';
import PostIndex from '../components/PostIndex.astro';
import { getVisiblePosts } from '../lib/posts';
import { getSite } from '../lib/site';

const posts = await getVisiblePosts();
const site = await getSite();
---
<Base description={site.metaDescription} current="index">
  <Fragment slot="band">
    <div>
      <h1 class="hero-title">{site.name}</h1>
      <p class="lede">{site.intro}</p>
    </div>
  </Fragment>

  <PostIndex posts={posts} heading="最近写的" />
</Base>

<style>
  .hero-title {
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    margin: 0;
    font-weight: 800;
  }
  .lede {
    max-width: 33em;
    margin: var(--sp-5) 0 0;
    font-size: var(--fs-lede);
    color: var(--on-band-sub);
  }
</style>
