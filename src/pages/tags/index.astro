---
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import TagsPlate from '../../components/TagsPlate.astro';
import TagFlowMenu from '../../components/TagFlowMenu.astro';
import { getAllTags, getVisiblePosts } from '../../lib/posts';

const posts = await getVisiblePosts();
const tags = await getAllTags(posts);
const items = tags.map(({ tag, count }) => ({
  text: tag,
  link: '/tags/' + encodeURIComponent(tag) + '/',
  meta: count + ' 篇',
  bandText: posts.filter((post) => post.tags.includes(tag)).map((post) => post.title),
}));
---
<Base title="标签" current="tags" chrome="page" bodyClass="tags-plate">
  <Fragment slot="plate"><TagsPlate /></Fragment>

  <header class="pagehead">
    <PageTitle>标签</PageTitle>
  </header>

  <TagFlowMenu items={items} />
</Base>
