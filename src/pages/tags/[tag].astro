---
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import TagsPlate from '../../components/TagsPlate.astro';
import TagFlowMenu from '../../components/TagFlowMenu.astro';
import { getAllTags, getPostsByTag } from '../../lib/posts';

// 只为已登记且有可见文章的标签生成详情。
export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map(({ tag }) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const posts = await getPostsByTag(tag!);
const items = posts.map(post => ({
  text: post.title,
  link: post.url,
  meta: post.draft ? post.date + ' · 草稿' : post.date,
  bandText: [post.summary],
}));
---

<Base title={posts.length ? tag : '没有这个标签'} current="tags" chrome="page" bodyClass="tags-plate">
  <Fragment slot="plate"><TagsPlate /></Fragment>
  <header class="pagehead">
    <PageTitle>{posts.length ? tag : '没有这个标签'}</PageTitle>
    <p class="tag-summary">
      <a href="/tags/">全部标签</a>
      {posts.length > 0 && <span>{posts.length} 篇文章</span>}
    </p>
  </header>
  {posts.length > 0
    ? <TagFlowMenu items={items} articles />
    : <p class="prose">这个标签没有文章，或者它还没登记。</p>}
</Base>

<style>
  .tag-summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-3);
    margin: var(--sp-2) 0 0;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .tag-summary a {
    color: var(--accent-ink);
    text-underline-offset: 0.18em;
  }
</style>
