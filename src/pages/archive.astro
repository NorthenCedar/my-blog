---
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import PostIndex from '../components/PostIndex.astro';
import { getArchive } from '../lib/posts';

const groups = await getArchive();
/* 搜索/年月筛选/排序（站主 2026-09-26 要求，参考图是「搜索框 + 年份 + 月份 + 排序(倒序/正序/清空)」）。
   两条关键设计：
   ① **年份与月份的选项从内容推导**，不硬编码 —— 明年写了 2027 的文章，
      这里自动多出「2027」选项、页面顶部自动多出一个 2027 分组（站主问的就是这个）；
   ② 分组与行都渲染在服务端（无 JS 也能看全），客户端**只做显示/隐藏与重排** ——
      所以关掉 JS 时页面仍然完整可读，不会白屏。 */
const years = groups.map((g) => g.year);
const months = [...new Set(groups.flatMap((g) => g.posts.map((p) => p.date.slice(5, 7))))].sort();
const total = groups.reduce((n, g) => n + g.posts.length, 0);

/* ===== INDEX TAPE 索引卷尺（2026-10-01）—— 刻度数据在构建期算好，输出纯 HTML =====
   ★ 刻度从内容推导，不写死年份：明年发文自动多一根 2027 刻度（同既有归档口径，
     tests/build-output.test.ts 守着「年份分组与文章日期对得上」）。
   ★ 位置用「百分比」打进 data-pos —— 年份等距分布在竖条上（卷尺的「刚性等分刻度」）。
     百分比是计算值，不是写死的文案/色值，不触「不写死」红线。 */
const tapeYearCount = groups.length;
/* 主刻度：年份。等距分布（i / (n-1)），单年时居中 50%。 */
const tapeTicks = groups.map((g, i) => ({
  year: g.year,
  count: g.posts.length,
  pos: tapeYearCount === 1 ? 50 : (i / (tapeYearCount - 1)) * 100,
  months: [...new Set(g.posts.map((p) => p.date.slice(5, 7)))].sort(),
}));
/* 次级刻度：月份。散布在「本年份刻度 → 下一个年份刻度」之间（时间上介于两年之间）。
   最早一年没有下方空间 ⇒ 省略它的月份刻度（竖条底部就是终点）。 */
const tapeMonthTicks: { month: string; pos: number }[] = [];
for (let i = 0; i < tapeTicks.length - 1; i++) {
  const from = tapeTicks[i].pos;
  const to = tapeTicks[i + 1].pos;
  const ms = tapeTicks[i].months;
  ms.forEach((m, j) => {
    tapeMonthTicks.push({ month: m, pos: from + (to - from) * ((j + 1) / (ms.length + 1)) });
  });
}
---
{
  /* 归档迁移（2026-09-26）：chrome='band' → 'page'（内页外壳）。
     **'page' 不渲染 <slot name="band" />** ⇒ 标题必须搬进正文流（外壳的 .pagehead），
     漏搬会静默消失且构建照常成功（前四页同一个坑）。
     **刻意不写 `max-width: var(--measure)`** —— 这与 about/404 **不同**，理由值得写在这：
     那两页的拍板 D 是"页头对齐**正文列**"，因为它们的内容列是 `.prose`（34em）；
     归档没有正文列，它的内容列是 <PostIndex> 的**通栏列表**（`.index` 不限宽，
     只有 `.title` 限 22em、`.summary` 限 40em）。页头若收成 34em，下缘实线会短于列表的上缘线，两条线错位。
     **版心要对齐的是内容，不是习惯**（/gallery 当时同理：页头与网格同为通栏）。
     另：`PostIndex` 无需主题化（已读全文：它只用 --hair/--ink/--muted/--accent，从未在深色底上渲染过），
     所以本页虽然与 6 个 tags 页共用它，迁移不碰它一个字节。 */
}
<Base title="归档" current="archive" chrome="page" bodyClass="archive-plate">
  <header class="pagehead">
    <PageTitle>归档</PageTitle>
    <p class="lede">共 {total} 篇。可以按关键词、年份、月份筛。</p>
  </header>

  {/* 筛选条。无 JS 时它不出现（`html.js` 才显示）—— 没有脚本时一排放着也点不动，不如不显示。 */}
  <form class="filters" data-filters hidden>
    <label class="f f-q">
      <span class="f-label">搜索</span>
      <input type="search" name="q" data-q placeholder="标题 / 描述关键词" autocomplete="off" />
    </label>
    <label class="f">
      <span class="f-label">年份</span>
      <select name="year" data-year>
        <option value="all">全部</option>
        {years.map((y) => <option value={y}>{y}</option>)}
      </select>
    </label>
    <label class="f">
      <span class="f-label">月份</span>
      <select name="month" data-month>
        <option value="all">全部</option>
        {months.map((m) => <option value={m}>{String(Number(m))} 月</option>)}
      </select>
    </label>
    <div class="f f-sort" role="group" aria-label="排序">
      <span class="f-label">排序</span>
      <button type="button" data-sort="desc" aria-pressed="true">倒序</button>
      <button type="button" data-sort="asc" aria-pressed="false">正序</button>
      <button type="button" data-clear>清空</button>
    </div>
    <p class="f-count" data-count role="status" aria-live="polite"></p>
  </form>

  <div data-groups>
    {groups.map((g) => (
      <section class="yeargroup" data-year={g.year}>
        <PostIndex posts={g.posts} heading={g.year} />
      </section>
    ))}
  </div>
  <p class="f-empty" data-empty hidden>没有匹配的文章。</p>

  {/* ===== INDEX TAPE 索引卷尺（2026-10-01）—— 右侧 sticky 竖向刻度尺 =====
      ★ 装置是**叠加层**：归档列表本身服务端渲染完整，卷尺默认 hidden + aria-hidden，
        脚本到位才露面；无 JS 时它**不存在**（不是藏起来）。
      ★ 数据全从上面 tapeTicks / tapeMonthTicks 来（构建期算好，纯 HTML）。
      ★ 读数区显示「当前年份 · N 篇」，游标随滚动连续走 + 惯性过冲，卷过的刻度留墨。

      ★★ 2026-10-04 搬进 `plate` 槽（`.shell` **之外**）—— 修过渡期间跳位 596px。
        病根：`position: fixed` 的包含块不是视口，而是**最近的建立了层叠上下文的祖先**，
        而页面过渡给 `.shell` 加的**不止 transform，还有 `filter: blur()`**
        （`transition.css` 的 `pt-shell`，18%–58% 那段）—— **filter 同样建立包含块**，
        第一轮只查 `transform`/`will-change` 因而漏判，量出来 `.tape` 中心
        常态 401.0 / 过渡中 997.0（视口中心 450）⇒ 偏 **+596px**，
        读数器正好压到年份刻度上（站主截图里那两个「2026」叠在一起）。
        `.shell` 的 `filter` 还会把它自己裁到 `62..1153`，底端刻度一并顶出视口。
        `Base.astro` 的 `plate` 槽就是为这类装饰层建的（关于页同类问题实测 91px）。
        ⚠ 槽的注记写「用它的人必须保证 z-index 退到内容之下」——**对纯装饰层成立，
          对本装置不成立**：`.tape` 要在正文**之上**，所以保留 `z-index: 2`
          （`Topbar.astro:81-85` 给 `main`/`footer` 的是 `z-index:1` 的层叠上下文，
          2 > 1 ⇒ 移出 `#main` 之后仍然压在正文之上，与原来同层同序）。 */}
  <Fragment slot="plate">
    <aside class="tape" data-tape hidden aria-hidden="true">
      <span class="tape-readout" data-tape-readout>
        <em data-tape-year>{years[0]}</em>
        <i data-tape-count>0</i>
      </span>
      <div class="tape-track" data-tape-track>
        {tapeMonthTicks.map((t) => (
          <span class="tape-tick is-month" style={`top: ${t.pos}%`} data-pos={t.pos.toFixed(2)}></span>
        ))}
        {tapeTicks.map((t) => (
          <span
            class="tape-tick is-year"
            style={`top: ${t.pos}%`}
            data-year={t.year}
            data-count={t.count}
            data-pos={t.pos.toFixed(2)}
          >
            <i>{t.year}</i>
            <b>{t.count}</b>
          </span>
        ))}
      </div>
      <span class="tape-cursor" data-tape-cursor></span>
    </aside>
  </Fragment>
</Base>

<script>
  // 归档筛选：纯客户端显示/隐藏 + 重排（不改数据、不请求接口）。
  // 缩小到 1.4 KB 左右是有意的：这个页面本来没有脚本，加的是"读列表"的工具，不该比内容还重。
  const bar = document.querySelector<HTMLFormElement>('[data-filters]');
  const groupsBox = document.querySelector<HTMLElement>('[data-groups]');
  if (bar && groupsBox) {
    bar.hidden = false;
    const q = bar.querySelector<HTMLInputElement>('[data-q]')!;
    const yearSel = bar.querySelector<HTMLSelectElement>('[data-year]')!;
    const monthSel = bar.querySelector<HTMLSelectElement>('[data-month]')!;
    const countEl = bar.querySelector<HTMLElement>('[data-count]')!;
    const emptyEl = document.querySelector<HTMLElement>('[data-empty]')!;
    const rows = [...groupsBox.querySelectorAll<HTMLLIElement>('.index li')];
    const groups = [...groupsBox.querySelectorAll<HTMLElement>('.yeargroup')];
    const desc = bar.querySelector<HTMLButtonElement>('[data-sort="desc"]')!;
    const asc = bar.querySelector<HTMLButtonElement>('[data-sort="asc"]')!;
    let dir: 1 | -1 = -1; // 默认倒序（新的在上面）

    const apply = () => {
      const needle = q.value.trim().toLowerCase();
      const y = yearSel.value;
      const m = monthSel.value;
      let shown = 0;
      for (const li of rows) {
        const ok =
          (!needle || (li.dataset.q ?? '').includes(needle)) &&
          (y === 'all' || li.dataset.year === y) &&
          (m === 'all' || li.dataset.month === m);
        li.hidden = !ok;
        if (ok) shown++;
      }
      for (const g of groups) {
        g.hidden = ![...g.querySelectorAll<HTMLElement>('.index li')].some((li) => !li.hidden);
      }
      // 排序：组按年份、组内按日期；用 append 移动节点（不重渲染、不丢已挂的事件）
      [...groups]
        .sort((a, b) => (Number(a.dataset.year) - Number(b.dataset.year)) * dir)
        .forEach((g) => groupsBox.append(g));
      for (const g of groups) {
        const ul = g.querySelector('.index')!;
        [...ul.children].sort((a, b) => String((a as HTMLElement).dataset.date).localeCompare(String((b as HTMLElement).dataset.date)) * dir).forEach((li) => ul.append(li));
      }
      countEl.textContent = shown === rows.length ? `共 ${shown} 篇` : `筛出 ${shown} / ${rows.length} 篇`;
      emptyEl.hidden = shown > 0;
      desc.setAttribute('aria-pressed', String(dir === -1));
      asc.setAttribute('aria-pressed', String(dir === 1));
    };

    q.addEventListener('input', apply);
    yearSel.addEventListener('change', apply);
    monthSel.addEventListener('change', apply);
    desc.addEventListener('click', () => { dir = -1; apply(); });
    asc.addEventListener('click', () => { dir = 1; apply(); });
    bar.querySelector('[data-clear]')!.addEventListener('click', () => {
      q.value = '';
      yearSel.value = 'all';
      monthSel.value = 'all';
      dir = -1;
      apply();
      q.focus();
    });
    apply();
  }
</script>

<script>
  // 索引卷尺装置（与上面的筛选脚本刻意分开成独立入口）：
  // 只读 DOM（刻度 data-pos / 年份分组），不引用筛选脚本的任何状态。
  import '../scripts/index-tape';
</script>

<style>
  .lede {
    margin: var(--sp-3) 0 0;
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  /* 筛选条：站上是纸底 + 发丝线 + 直角的语言，所以不用圆角胶囊，用细边框的直方块 */
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4);
    margin: var(--sp-6) 0 0;
    padding: var(--sp-3) 0;
    border-top: 1px solid var(--hair);
    border-bottom: 1px solid var(--hair);
  }
  .f {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin: 0;
  }
  .f-label {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .f-q {
    flex: 1 1 260px;
  }
  .filters input[type='search'] {
    flex: 1;
    min-width: 0;
    padding: 0.4em 0.6em;
    font: inherit;
    font-size: var(--fs-sm);
    color: var(--ink);
    background: var(--panel);
    border: 1px solid var(--hair);
  }
  .filters input[type='search']:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: 1px;
  }
  .filters select {
    padding: 0.35em 0.5em;
    font: inherit;
    font-size: var(--fs-sm);
    color: var(--ink);
    background: var(--panel);
    border: 1px solid var(--hair);
  }
  .f-sort button {
    padding: 0.35em 0.7em;
    font: inherit;
    font-size: var(--fs-xs);
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--hair);
  }
  .f-sort button:hover {
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .f-sort button[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent-wash);
    color: var(--accent-ink);
  }
  .f-count {
    margin: 0 0 0 auto;
    font-size: var(--fs-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .yeargroup + .yeargroup {
    margin-top: var(--sp-8);
  }
  .f-empty {
    margin: var(--sp-8) 0 0;
    color: var(--muted);
  }
  @media (max-width: 767px) {
    .f-q {
      flex-basis: 100%;
    }
    .f-count {
      margin-left: 0;
      flex-basis: 100%;
    }
  }

  /* ===== INDEX TAPE 索引卷尺（2026-10-01）=====
     ★ 右侧 fixed 竖条，垂直居中 —— 「进度尺」形态，游标沿刻度随滚动走。
     ★ **2026-10-04 已搬进 Base 的 `plate` 槽（markup 在 `.shell` 之外）**：
       固定定位铺到视口右缘，不占文档流、不推挤列表；归档列表 .title/.summary 都限宽，
       右侧有留白 ⇒ 竖条（约 44px 宽）不遮正文。
       ⚠ 别把它搬回普通 slot（会落进 `.shell`）：`.shell` 在过渡期间带 `filter: blur()`
         ⇒ 成为 fixed 的包含块 ⇒ 实测跳位 596px。理由与读数见 markup 处注记。
     ★ 颜色全 token：未卷过的刻度淡灰 --hair，卷过的 --accent-ink（脚本加 .past 类），
       游标 --accent-ink，读数数字 --ink。 */
  .tape {
    position: fixed;
    right: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    /* ★ z-index 保持 2 —— `plate` 槽的注记要求「退到内容之下」是对**纯装饰层**说的，
       本装置必须在正文之上（Topbar.astro:81-85 给 main/footer 的是 z-index:1 的
       层叠上下文，2 > 1）。搬出 `#main` 后这条依然成立，见 markup 注记的推导。 */
    z-index: 2;               /* 在正文之上（正文 z-index:1），在顶栏浮层/灯箱之下 */
    width: 44px;
    height: min(60vh, 460px);
    min-height: 180px;
    pointer-events: auto;
  }
  /* 无 JS 时整块不出现（脚本到位才摘 [hidden]）；显式写，免得上游给 .tape 加 display */
  .tape[hidden] {
    display: none;
  }
  .tape-readout {
    position: absolute;
    top: -1.4rem;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0;
    font-family: "IBM Plex Mono", Consolas, "Courier New", monospace;
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .tape-readout em {
    font-style: normal;
    color: var(--accent-ink);
    font-weight: 700;
    font-size: var(--fs-sm);
  }
  .tape-readout i {
    font-style: normal;
    color: var(--muted);
  }
  /* 轨道：竖条本体，刻度从这里向**左**伸出（右缘对齐竖条右边） */
  .tape-track {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 20px;
  }
  .tape-tick {
    position: absolute;
    right: 0;
    transform: translateY(-50%);
    display: block;
  }
  /* 年份主刻度：长横线 + 年份数字（刻度的「大齿」） */
  .tape-tick.is-year {
    width: 20px;
    height: 1px;
    background: var(--hair);
  }
  .tape-tick.is-year i {
    position: absolute;
    right: 26px;
    top: 50%;
    transform: translateY(-50%);
    font-style: normal;
    font-family: "IBM Plex Mono", Consolas, "Courier New", monospace;
    font-size: var(--fs-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .tape-tick.is-year b {
    display: none;   /* 篇数放读数区，刻度旁只印年份（避免拥挤） */
  }
  /* 月份次级刻度：短横线（刻度的「小齿」） */
  .tape-tick.is-month {
    width: 8px;
    height: 1px;
    background: var(--hair);
    opacity: 0.6;
  }
  /* 卷过的刻度留墨（脚本按「已滚过」加 .past） */
  .tape-tick.past {
    background: var(--accent-ink);
  }
  .tape-tick.past.is-year i {
    color: var(--accent-ink);
  }
  /* 游标：一根横贯的短横，指示当前位置 */
  .tape-cursor {
    position: absolute;
    right: -6px;
    left: -6px;
    top: 0;
    height: 2px;
    background: var(--accent-ink);
    transform: translateY(-50%);
    box-shadow: 0 0 0 1px var(--paper);
  }

  /* ===== 移动端（≤767px）：完全隐藏卷尺（口径 #9 展示型留极简版 → 此处拍板「完全不渲染」）=====
     ★ 手机屏幕窄，右侧竖条没地方放；归档列表本身完整可读，装置是纯叠加层。 */
  @media (max-width: 767px) {
    .tape {
      display: none;
    }
  }
</style>
