---
/**
 * 螺旋盘 HELIX（2026-10-07）—— 内页**第十一台**装置：**独立页**这一侧。
 *
 * 站主原话：「能不能给我点高级的感觉，这个只能往下划，给我点可互动的感觉，比如身处画廊的
 * 感觉……照片组成一个3D的螺旋结构，左右拖动可以螺旋旋转换照片」。
 *
 * ★★ 装置本体在 `src/components/SpiralPlate.astro` —— **本页只是它的一个消费方**
 *   （另一个是 `/gallery/`，以 `mode="embed"` 嵌在显影板与相册入口条之间）。
 *   几何、降级链、灯箱、样式、脚本全在组件里 ⇒ 本页不再有一行 `.sp-*`。
 *
 * 本页提供两样**组件自己不该管**的东西：
 *   ① 页头（标题 + 读数）—— 那是外壳的版面，走共用的 PageTitle / PageReadout；
 *   ② `#sp-pos` —— 页头那行「POS 001 / 082」里的当前位置，由装置脚本回写。
 *   组件脚本对它做了**判空**：/gallery 页内没有这个元素，也不会因此崩。
 *
 * ── 它和 /gallery 的关系（**不替换，是叠加**）──────────────────────────
 *   入口条 + 砖墙（/gallery 与 /gallery/<册名>/）负责「找得到」：
 *     按册分条、有编目号、点进去是整册的砖墙 —— 它是**目录层**。
 *   螺旋盘负责「走得进去」：一次只把注意力交给一张，左右拖动沿着螺旋走 —— 它是**画廊层**。
 *
 * ★★ 2026-10-07 顺手修的一处既有疏漏：本页原来直接写 `<h1 class="pagehead-title">` +
 *   `<p class="readout">`，但那两个类名的样式**只写在 `gallery/index.astro` 里**
 *   （Astro 的 scoped 样式只作用写它的那个文件）⇒ 本页这行读数其实一个样式都没吃到
 *   （等宽字体、颜色、间距全丢）。现在两边都走共用组件。
 */
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import PageReadout from '../../components/PageReadout.astro';
import SpiralPlate from '../../components/SpiralPlate.astro';
import manifest from '../../../public/gallery/manifest.json';

const albums = manifest.albums as { total: number }[];
/* 页头读数只要三个数（总帧数 / 册数 / 零填充宽度）—— **不拍平**那一份：
   拍平是装置的事（在组件里算）。两者同源（都读 manifest），但各自的活儿各自干。 */
const N = albums.reduce((n, a) => n + a.total, 0);
const PAD = String(N).padStart(3, '0');
---

<Base title="螺旋盘" current="gallery" chrome="page">
  <header class="pagehead">
    <PageTitle>螺旋盘</PageTitle>
    <PageReadout>
      <span>FRAMES <em>{N}</em></span>
      <span>ALBUMS <em>{albums.length}</em></span>
      <span>POS <em id="sp-pos">001</em> / {PAD}</span>
    </PageReadout>
  </header>

  {/* mode="page"：滚轮接管（端点让路）+ 渲染"回到相册"的回头路。 */}
  <SpiralPlate mode="page" />
</Base>