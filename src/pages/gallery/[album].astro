---
/**
 * 相册页（一册一页）—— `/gallery/<册名>/`，2026-10-07 随「入口条」一起落地。
 *
 * 站主原话：「点击放大的照片就进入这个文件夹，**就像现在本站的照片砖墙一样**，
 *   **不过是单独的一页**」⇒ 这一页就是**原来的砖墙**（`PhotoWall`），
 *   只是从"/gallery 下面那一大段"变成"点进某个文件夹之后才看到的那一页"。
 *   2026-10-13：AlbumScene 按单册 layout 增强为散片或悬浮切片，砖墙保留作完整索引。
 *
 * ── 地址为什么长这样 ──────────────────────────────────────────────
 *   `/gallery/<册名>/` 与磁盘上的图片目录**同名**：图片就在 `/gallery/<册名>/01-800.webp`。
 *   所以「进入这个文件夹」这句话在地址栏上也成立。
 *   册名是中文 ⇒ 链接走 `encodeURIComponent`（与 `/tags/<中文>/` 同一条口径，见 AlbumRow）。
 *
 * ── ★★ 路由守卫（这条不能删）────────────────────────────────────
 *   本文件是动态路由 `[album]`，与静态路由 `gallery/spiral.astro` 处在**同一个位置**。
 *   实测 Astro 7.3.5 对"两个页面产出同一个路径"**没有任何检测/警告** ——
 *   谁后写谁覆盖，结果是**静默少一页**（不是报错，最难查）。
 *   ⇒ 把保留段挡在**构建期**：宁可构建红一次、把文件夹改个名，
 *     也不要线上少一页还没人知道。加相册时若撞到，报错信息会直接告诉你改哪个目录。
 */

import Base from '../../layouts/Base.astro';
import AlbumScene from '../../components/AlbumScene.astro';
import InteractiveAlbum from '../../components/InteractiveAlbum.astro';
import GalleryInf from '../../components/GalleryInf.astro';
import manifest from '../../../public/gallery/manifest.json';
import '../../vendor/react-bits/DomeGallery.css';
import '../../vendor/react-bits/InfiniteMenu.css';

type File = { w: number; h: number; url: string };
type Frame = { alt: string; src: string; files: File[] };
type Album = { id: string; title: string; titleEn?: string; cover?:string; layout?: 'scatter' | 'slices' | 'dome' | 'infinite' | 'wall' | 'willow'; date: string; total: number; frames: Frame[] };

/* ★ 一册一页 —— 相册清单从 manifest 读（"有几个文件夹就放几个"）：
   站主往 content/gallery/ 丢一个新文件夹，构建时生成脚本写进 manifest，
   这里就自动多一页，/gallery 也自动多一条入口。**没有一处写死册数。**
 *
 * ★★★ **`getStaticPaths` 里只许引用 `import` 进来的东西，不许引用 frontmatter 顶层的
 *   const / let**。实测（Astro 7.3.5）：预渲染分片会被打包器摇一遍，顶层的中间量要么被
 *   内联进组件函数、要么整个被删掉 ⇒ `getStaticPaths` 跑到那一步直接
 *   `ReferenceError: albums is not defined`，而**构建日志里那行错也不指向本文件**
 *   （报的是 `dist/.prerender/chunks/…` 的行号）。踩过一次，所以下面两个量就地定义。
 *   对照 `posts/[slug].astro` / `tags/[tag].astro`：它们只调用导入的函数 ⇒ 一直没事。 */
export async function getStaticPaths() {
  /* 保留段：`spiral` 是 `/gallery/spiral/`（螺旋盘独立页）；`index` 是 `/gallery/` 自己。
     撞上就**构建期报错**（见文件头"路由守卫"）。 */
  const reserved = new Set(['spiral', 'index']);
  const list = manifest.albums as Album[];
  return list.map((album, i) => {
    if (reserved.has(album.id)) {
      throw new Error(
        `相册文件夹名「${album.id}」与 /gallery/${album.id}/ 的保留路由撞车（Astro 不会替你报这个错，` +
          `它会静默覆盖）⇒ 请把 content/gallery/${album.id}/ 改名，或换一个保留字表。`,
      );
    }
    return { params: { album: album.id }, props: { album, no: i + 1 } };
  });
}

const { album, no } = Astro.props as { album: Album; no: number };
const layout = album.layout;
const interactive = layout === 'dome' || layout === 'infinite' || layout === 'willow';
const shareFrame = album.frames.find(frame=>frame.src===album.cover)??album.frames[0];
const shareImage = shareFrame?.files.reduce<File | undefined>((largest, file) => !largest || file.w > largest.w ? file : largest, undefined)?.url;
---

<Base title={album.title} description={`${album.title} · ${album.total} 张照片 · ${album.date}`} shareImage={shareImage} shareImageAlt={shareFrame?.alt} current="gallery" chrome="page" bodyClass="gallery-inf-plate" fullWidth>
  {/* 视口底纹 ∞ —— 与 `/gallery/`、`/gallery/spiral/` 同一份（站主 2026-10-08「三条路都换」）。 */}
  <Fragment slot="plate"><GalleryInf /></Fragment>

  {interactive
    ? <InteractiveAlbum album={{ ...album, layout }} no={no} />
    : <AlbumScene album={{ ...album, layout }} no={no} />}
</Base>

<script>
  import '../../scripts/album-return';
</script>
